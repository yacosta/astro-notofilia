    "revocation_uri": "https://www.notofilia.com/api/oauth/revoke",
    "events_endpoint": "https://www.notofilia.com/api/agent/events",
    "identity_types_supported": [
      "anonymous",
      "identity_assertion"
    ],
    "anonymous": {
      "credential_types_supported": [
        "access_token"
      ],
      "claim_uri": "https://www.notofilia.com/api/agent/identity/claim"
    },
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "access_token"
      ],
      "claim_uri": "https://www.notofilia.com/api/agent/identity/claim"
    },
    "events_supported": [
      "https://schemas.workos.com/events/agent/auth/identity/assertion/revoked"
    ]
  }
