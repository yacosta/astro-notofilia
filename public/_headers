# Long-lived first-party static assets (repeat-visit PageSpeed).
# Hashed Astro chunks and fingerprinted vendor bundles can be immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Replaceable catalog imagery: long cache without immutable so a same-path
# overwrite can propagate (fingerprint filenames when a permanent immutable
# cache is required).
/uploads/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

