# Long-lived first-party static assets (repeat-visit PageSpeed).
# Hashed Astro chunks and fingerprinted uploads/fonts can be immutable.
# Unhashed /support.js + /webmcp.js need ≥30d for Lighthouse; use 1y so
# PageSpeed stops flagging them. Cloudflare Pages replaces edge objects on
# deploy; purge browser cache via a new filename if a hotfix must ship faster.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/catalog-fonts.css
  Cache-Control: public, max-age=31536000

/favicon.png
  Cache-Control: public, max-age=31536000

/support.js
  Cache-Control: public, max-age=31536000

/webmcp.js
  Cache-Control: public, max-age=31536000
