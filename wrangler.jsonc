{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notofilia",
  "compatibility_date": "2026-07-06",
  // Astro builds the static site into dist/; Cloudflare Pages serves it.
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "comments_db",
      "database_id": "bb538083-227c-4c27-bd35-034e6ac0ee07"
    }
  ]
}
