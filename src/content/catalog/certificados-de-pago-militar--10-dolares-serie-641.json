  "i18n": {
    "en": {
      "path": "/en/collection/military-payment-certificates/10-dollars-series-641/",
      "title": "MPC Series 641 $10 EE. UU. Vietnam | Notofilia",
      "description": "MPC Series 641 $10 Vietnam (1965–1968): Schwan-887 / Pick M63, PMG 53 AU. Notofilia.",
      "ogTitle": "MPC Series 641 $10 Vietnam (1965–1968) | Notofilia",
      "ogDescription": "MPC Series 641 $10 de Vietnam (1965–1968). Schwan-887 / Pick M63; PMG 53 About Uncirculated. Notofilia.",
      "template": "<div lang=\"en\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  <main data-pagefind-meta=\"url:/en/collection/military-payment-certificates/10-dollars-series-641/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"MPC Series 641 — Diez Dólares\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/en/collection/military-payment-certificates/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Military Payment Certificates (MPC)</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">United States &middot; Military Payment Certificate &middot; Series 641</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Ten Dollars &mdash; Series 641</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$10.00 &middot; Aug 31 1965 &ndash; Oct 21 1968 &middot; Exclusive use in Vietnam</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"mpc-641-10\"\n            aria-label=\"Enlarge image of the certificado de pago militar\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/mpc-series-641-10-dollars.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/mpc-series-641-10-dollars.jpg\"\n                alt=\"Certificado de pago militar de ten dollars, Series 641: obverse con portrait of mujer de perfil y reverse con la cabeza de la Estatua de la Libertad\"\n                width=\"800\"\n                height=\"713\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\" aria-hidden=\"true\"></span>Enlarge</span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Obverse (top) and reverse (bottom) — Notofilia.com Collection</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Country</span>\n              <span style=\"font-size:19px; color:#221f19;\">United States &mdash; exclusive circulation in Vietnam</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Issuing Entity</span>\n              <span style=\"font-size:19px; color:#221f19;\">U.S. Department of Defense (<em>US Department of Defense</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Type of Issue</span>\n              <span style=\"font-size:19px; color:#221f19;\">Military Payment Certificate (<em>Military Payment Certificate</em>, MPC) &mdash; scrip for authorized personnel; no Treasury note</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denomination</span>\n              <span style=\"font-size:19px; color:#221f19;\">$10.00 (Ten Dollars)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Series / Validity</span>\n              <span style=\"font-size:19px; color:#221f19;\">Series 641 &mdash; issued August 31, 1965; withdrawn October 21, 1968</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Printer</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bureau of Engraving and Printing (BEP) &mdash; color lithography (offset), no intaglio</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Catalog Reference</span>\n              <span style=\"font-size:19px; color:#221f19;\">Schwan-887 &middot; Pick M63</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Print run</span>\n              <span style=\"font-size:19px; color:#221f19;\">Approx. 20,400,000 $10 bills (Series 641 can exceed $283 million in total face value)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rarity</span>\n              <span style=\"font-size:19px; color:#221f19;\">Common in circulated grades (circulation ~20.4 million); About Uncirculated and above are quoted at a premium. First printing regular issue (S887-1) &mdash;serial with final letter&mdash;, not replacement ticket</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Grade</span>\n              <span style=\"font-size:19px; color:#221f19;\">PMG 53 About Uncirculated &middot; cert. 2371285-006</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serial Number / Plate</span>\n              <span style=\"font-size:19px; color:#221f19;\">J01130273&nbsp;J &middot; plate 42 &middot; first impression (S887-1)</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Enlarged Certificado\"\n              data-zoom-dialog=\"mpc-641-10\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Close\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Zoom out\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Zoom in\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/mpc-series-641-10-dollars.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/mpc-series-641-10-dollars.jpg\"\n                    alt=\"MPC Series 641 de ten dollars, enlarged view del obverse and reverse\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Drag to move &middot; Mouse wheel to zoom</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Historical Context</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">The Series 641 was the first issue of MPC used exclusively in Vietnam and coincided with the arrival of the first large-scale American combat units. It circulated from August 31, 1965 to October 21, 1968, when a<em>C-Day</em>unannounced, it was replaced by Series 661. It was one of the longest-running and most abundant series on the program.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Like the rest of the MPCs, these banknotes could only be used in military establishments by authorized personnel. Convertible to local currency when leaving &mdash; but not the other way around&mdash; and to US dollars only when leaving the MPC zone. This limited the black market and protected the local economy from excess dollars.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Because of the large print run and the many examples veterans brought home, Series 641 &mdash;including the $10&mdash; is relatively common in circulated grades. Uncirculated examples (<em>Uncirculated</em>) if they are quoted at a clear premium compared to circulated ones; In addition, counterfeits of the $10 of this series are known, which makes careful authentication recommended.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Color Scheme</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Obverse:</strong>main print in brown/sepia on beige guilloché background, with two large reddish-orange rosettes framing the numeral &ldquo;10&rdquo; on both sides of the portrait.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverse:</strong>same brown-sepia palette with orange-reddish rays and the word &ldquo;TEN&rdquo; in red to the left and right of the head of the Statue of Liberty. Both sides have the black stripe with the MPC regulatory text.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Portrait and Obverse Images</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Center:</strong>profile bust to the right of a classical female figure, engraving by Marcus Baldwin. The vignette comes from the 1896 $2 Silver Certificate bill (Educational Series), from the allegory of<em>Commerce</em>.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Legends:</strong>&ldquo;SERIES 641&rdquo; on portrait; numeral &ldquo;10&rdquo; in the four corners; Black serial numbers on the upper right and lower left.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Regulatory text:</strong>lower strip &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; and the clause of exclusive use in military establishments by authorized personnel.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverse Images</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Head of the Statue of Liberty from the front, with seven-pointed radiating crown, engraved by Richard M. Bower. The portrait occupies an octagonal frame/shield on a background of wavy fan lines.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">On the left and right, the word &ldquo;TEN&rdquo; in red sans-serif typeface; numeral &ldquo;10&rdquo; in the four corners; same regulation black stripe on the base. Oak leaves and laurel branches adorn the top corners.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Signatures and Seals</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Unlike Treasury or Federal Reserve notes, MPCs do not bear the signatures of treasurer or secretary of the Treasury, nor the seal of the Department of the Treasury: they were issued under the authority of the Department of Defense.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legacy for Collectors</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Series 641 is one of the most sought after by those who collect Vietnam War paper: the first series exclusive to the theater, colorful design and frequent presence in veterans' collections. The $10 is not uncommon in circulated grades (it usually trades near face value in Fine), but Uncirculateds do command notable premiums.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Replacement bills (with a digit at the end of the serial number instead of a letter) are much rarer. It's a good idea to keep an eye out for documented $10 counterfeits in this series when purchasing high-grade examples.</p>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Sources</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Bureau of Engraving and Printing &mdash;<a href=\"https://www.bep.gov/media/1041/download?inline=\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates 1946&ndash;1973<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>Schwan, Fred.<em>Comprehensive Catalog of Military Payment Certificates</em>&mdash; Schwan-887</li>\n              <li>Art-Hanoi &mdash;<a href=\"https://art-hanoi.com/collection/vnpaper/641.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">MPC Series 641<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a>(Pick M63)</li>\n              <li>World Banknotes &amp; Coins Museum &mdash;<a href=\"https://www.worldbanknotescoins.com/2014/11/us-military-payment-certificate-10-dollars-mpc-series-641.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Series 641 $10<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>ANA / Fred Schwan &mdash;<a href=\"https://www.money.org/uploads/Mili.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates (PDF)<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
      "recordTitle": "Diez Dólares — Series 641",
      "eyebrow": "United States · Military Payment Certificate · Series 641"
    }
