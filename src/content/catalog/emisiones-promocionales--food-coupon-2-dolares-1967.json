          <picture>\n              <source srcset=\"/uploads/usda-food-coupon-2-dollars-1967.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/usda-food-coupon-2-dollars-1967.jpg\"\n                alt=\"Cupón de alimentos USDA de dos dólares, Serie 1967, anverso con viñetas Agricultural Abundance y Healthier Families, número de serie D 45320051 A\"\n                width=\"1024\"\n                height=\"488\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso — Colección de Notofilia.com</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento de Agricultura de los EE. UU. (<em>U.S. Department of Agriculture</em>, USDA)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Documento</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cupón de Alimentos (<em>Food Coupon</em>) &mdash; escrip fiscal del Programa de Cupones de Alimentos (<em>Food Stamp Program</em>), no billete de curso legal</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">VALUE 2 DOLLARS</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bureau of Engraving and Printing (BEP), Washington, D.C.</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">Series 1967</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Color</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tinta calcográfica azul oscuro sobre papel crema</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">D 45320051 A</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Cupón ampliado\"\n              data-zoom-dialog=\"usda-food-coupon-2-dollars-1967\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button type=\"button\" data-zoom-out\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span data-zoom-percent style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  data-zoom-in aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/usda-food-coupon-2-dollars-1967.webp\" type=\"image/webp\" />\n                  <img data-zoom-image\n                    src=\"/uploads/usda-food-coupon-2-dollars-1967.jpg\"\n                    alt=\"Cupón de alimentos USDA, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"position:absolute; bottom:16px; left:50%; transform:translateX(-50%); font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic; pointer-events:none;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Serie temprana del programa moderno:</strong> emitidos tras el <em>Food Stamp Act</em> de 1964, los cupones de la Serie 1967 pertenecen a la primera generación de diseño del programa permanente. Aún muestran lemas alegóricos &mdash;&ldquo;Agricultural Abundance&rdquo; y &ldquo;Healthier Families&rdquo;&mdash; que vinculan la asistencia alimentaria con la política agrícola y el bienestar familiar, antes del rediseño bicentenario de 1975 que introdujo retratos y motivos patrióticos.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Impresos por el BEP:</strong> el pie de imprenta &ldquo;BUREAU OF ENGRAVING AND PRINTING&rdquo; confirma la fabricación federal con estándares de seguridad de moneda. El texto &ldquo;NON-TRANSFERABLE EXCEPT UNDER CONDITIONS PRESCRIBED BY THE SECRETARY OF AGRICULTURE&rdquo; deja claro que no era curso legal libre, sino un vale canjeable solo por alimentos elegibles.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">En la colección:</strong> esta pieza precede cronológicamente a la Serie 2000-B de esta misma página y documenta el aspecto de los cupones en la década de 1960, cuando el programa aún operaba con libretas de papel y requisito de compra (eliminado en 1977).</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Cupón</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Viñeta izquierda:</strong> granja con granero, silos y campos &mdash; lema &ldquo;Agricultural Abundance.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Viñeta derecha:</strong> familia ante un horizonte urbano/industrial &mdash; lema &ldquo;Healthier Families.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Centro:</strong> medallón guilloché con VALUE 2 DOLLARS.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Encabezado:</strong> &ldquo;U.S. DEPARTMENT OF AGRICULTURE / FOOD COUPON&rdquo;, con &ldquo;DO NOT FOLD&rdquo; y &ldquo;DO NOT SPINDLE.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Pie:</strong> &ldquo;SERIES 1967&rdquo; y &ldquo;BUREAU OF ENGRAVING AND PRINTING.&rdquo;</span>\n              </li>\n            </ul>\n          </section>\n\n          <p style=\"margin-top:40px; font-size:15px;\"><a href=\"/coleccion/food-coupons-usda/\" style=\"color:#6b521f;\">&larr; Volver al catálogo Food Coupons USDA</a></p>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n\n\n</div>",
