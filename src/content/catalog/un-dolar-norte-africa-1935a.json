  "styles": "body { margin: 0; }\n    a { color: #6b521f; text-decoration: underline; text-decoration-color: rgba(138,109,59,0.35); }\n    a:hover { color: #5c4826; }\n    ::selection { background: rgba(138,109,59,0.25); }",
  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/un-dolar-norte-africa-1935a/\" id=\"main-content\" tabindex=\"-1\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/reserva-federal/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Sistema de la Reserva Federal</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Certificado de Plata &middot; Sello Amarillo &middot; Emisión de Emergencia &middot; 1942&ndash;1943</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Un Dólar &ldquo;Norte de África&rdquo;</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$1.00 &middot; Serie de 1935-A &middot; Sello Amarillo (&ldquo;Yellow Seal&rdquo;)</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos &mdash; emitido para las tropas estadounidenses en el Norte de África</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento del Tesoro de los Estados Unidos (<em>United States Treasury</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">$1.00 (Un Dólar)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Certificado de Plata (<em>Silver Certificate</em>) con sello del Tesoro en tinta amarilla en lugar del azul habitual &mdash; emisión de emergencia conocida como &ldquo;North Africa Note&rdquo;</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año de Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie de 1935-A &mdash; impreso e introducido en circulación en 1942</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Friedberg FR-2306</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">B52497547C</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"north-africa-1-1935a\"\n            aria-label=\"Ampliar imagen del billete\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/us-silver-certificate-1-dollar-north-africa-1935a.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/us-silver-certificate-1-dollar-north-africa-1935a.jpg\"\n                alt=\"Certificado de plata de un dólar con sello amarillo de emergencia Norte de África, serie 1935-A, anverso y reverso\"\n                width=\"564\"\n                height=\"477\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete ampliado\"\n              data-zoom-dialog=\"north-africa-1-1935a\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/us-silver-certificate-1-dollar-north-africa-1935a.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/us-silver-certificate-1-dollar-north-africa-1935a.jpg\"\n                    alt=\"Certificado de plata de un dólar Norte de África, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico: Moneda de Emergencia para la Operación Torch</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El 8 de noviembre de 1942, las fuerzas aliadas al mando del general Dwight D. Eisenhower desembarcaron en el Norte de África francés &mdash;Marruecos y Argelia&mdash; en la llamada <strong style=\"color:#1c1a15;\">Operación Torch</strong>, el primer gran desembarco conjunto angloestadounidense de la Segunda Guerra Mundial y la primera vez que el general George Patton comandó tropas en combate.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Ante el temor de que grandes sumas de efectivo estadounidense cayeran en manos del Eje en caso de un revés militar, el Tesoro imprimió una emisión especial de certificados de plata de $1, $5 y $10 con un llamativo <strong style=\"color:#1c1a15;\">sello amarillo</strong> en lugar del azul habitual de los certificados de plata &mdash;el único caso en la historia de esta serie&mdash;, para poder identificarlos y declararlos sin valor de inmediato si eran capturados.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Esta misma emisión de &ldquo;sello amarillo&rdquo; volvió a utilizarse al año siguiente durante la invasión aliada de Sicilia en 1943. Al igual que ocurrió con los billetes &ldquo;Hawái&rdquo; en el Pacífico, muchos ejemplares fueron conservados como recuerdo por los soldados en lugar de cambiarse por moneda corriente, por lo que hoy sobreviven en cantidad suficiente para el coleccionismo, aunque siguen siendo muy apreciados como reliquia de la Segunda Guerra Mundial.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Esquema de Color</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> impresión principal en tinta negra sobre papel blanco, con el sello del Tesoro y los números de serie en tinta amarilla/dorada &mdash;la marca distintiva exclusiva de esta emisión de emergencia entre todos los certificados de plata.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> impresión completa en tinta verde clásica (<em>greenback</em>), idéntica al diseño estándar de la serie 1935.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Retrato e Imágenes del Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Centro:</strong> retrato ovalado de George Washington, primer presidente de los Estados Unidos.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Derecha:</strong> sello del Tesoro de los Estados Unidos en llamativa tinta amarilla, sustituyendo al sello azul estándar de los certificados de plata contemporáneos.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Superior:</strong> cláusula &ldquo;THIS CERTIFIES THAT THERE IS ON DEPOSIT IN THE TREASURY OF THE UNITED STATES OF AMERICA ONE DOLLAR IN SILVER PAYABLE TO THE BEARER ON DEMAND&rdquo;.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Imágenes del Reverso</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Diseño estándar de la serie 1935: el Gran Sello de los Estados Unidos completo, con el ojo de la providencia sobre la pirámide inconclusa a la izquierda y el águila calva sosteniendo el escudo, flechas y rama de olivo a la derecha, enmarcando la gran palabra &ldquo;ONE&rdquo; en el centro.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Firmas</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">W. A. Julian</strong> &mdash; Tesorero de los Estados Unidos (<em>Treasurer of the United States</em>), a la izquierda.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Henry Morgenthau, Jr.</strong> &mdash; Secretario del Tesoro (<em>Secretary of the Treasury</em>), a la derecha.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legado para Coleccionistas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Junto con los billetes &ldquo;Hawái&rdquo; de sello marrón emitidos para el Pacífico, los certificados de &ldquo;sello amarillo&rdquo; del Norte de África representan el otro gran capítulo de la moneda de emergencia estadounidense de la Segunda Guerra Mundial: dos soluciones distintas &mdash;una para cada teatro de guerra&mdash; al mismo problema de proteger el dinero estadounidense de una eventual captura enemiga.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">De esta emisión Fr. 2306 se imprimieron <strong style=\"color:#1c1a15;\">26.916.000</strong> billetes regulares y <strong style=\"color:#1c1a15;\">144.000</strong> con estrella &mdash; <strong style=\"color:#1c1a15;\">27.060.000</strong> en total.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\" aria-labelledby=\"tirada-norte-africa-heading\">\n            <h2 id=\"tirada-norte-africa-heading\" style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Tirada de impresión — $1 Norte de África (1935-A)</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 14px;\">Certificado de Plata de $1, Serie 1935-A, sello amarillo de emergencia (&ldquo;North Africa&rdquo;). Las cifras siguientes se obtienen de los rangos de número de serie documentados para las corridas con sello amarillo.<sup style=\"font-size:12px;\">1</sup></p>\n\n            <div style=\"width:100%; overflow-x:auto; margin:0 0 16px; -webkit-overflow-scrolling:touch;\">\n              <table style=\"width:100%; min-width:420px; border-collapse:collapse; font-size:16px; line-height:1.45; color:#332e22;\">\n                <caption style=\"caption-side:top; text-align:left; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; color:#5c4e33; margin:0 0 10px;\">Total de impresión &mdash; Fr. 2306 / Fr. 2306★</caption>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:left; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Tipo</th>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:right; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Billetes impresos</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">Billetes regulares de sello amarillo &mdash; Fr. 2306</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">26.916.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">Reemplazos con estrella &mdash; Fr. 2306★</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">144.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; font-weight:600;\">Total bruto, incluidas estrellas</td>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; text-align:right; font-variant-numeric:tabular-nums; font-weight:600;\">27.060.000</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 14px;\">La producción documentada de billetes regulares consistió en <strong style=\"color:#1c1a15;\">ocho corridas</strong> de sello amarillo repartidas en <strong style=\"color:#1c1a15;\">cinco bloques</strong> de número de serie, con un total de <strong style=\"color:#1c1a15;\">26.916.000</strong> billetes regulares.</p>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 10px;\"><strong style=\"color:#1c1a15;\">Desglose de billetes regulares</strong></p>\n            <div style=\"width:100%; overflow-x:auto; margin:0 0 16px; -webkit-overflow-scrolling:touch;\">\n              <table style=\"width:100%; min-width:420px; border-collapse:collapse; font-size:16px; line-height:1.45; color:#332e22;\">\n                <caption style=\"caption-side:top; text-align:left; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; color:#5c4e33; margin:0 0 10px;\">Bloques de serie &mdash; billetes regulares</caption>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:left; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Bloque de serie</th>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:right; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Corridas</th>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:right; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Billetes impresos</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">B&ndash;C</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">3</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">3.000.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">C&ndash;C</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">2</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">3.904.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">F&ndash;C</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">1</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">12.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">I&ndash;C</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">1</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">10.000.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">R&ndash;C</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">1</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">10.000.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; font-weight:600;\">Total regulares</td>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; text-align:right; font-variant-numeric:tabular-nums; font-weight:600;\">8</td>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; text-align:right; font-variant-numeric:tabular-nums; font-weight:600;\">26.916.000</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 10px;\"><strong style=\"color:#1c1a15;\">Desglose de billetes con estrella</strong></p>\n            <div style=\"width:100%; overflow-x:auto; margin:0 0 16px; -webkit-overflow-scrolling:touch;\">\n              <table style=\"width:100%; min-width:420px; border-collapse:collapse; font-size:16px; line-height:1.45; color:#332e22;\">\n                <caption style=\"caption-side:top; text-align:left; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; color:#5c4e33; margin:0 0 10px;\">Rangos de serie con estrella</caption>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:left; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Rango de número de serie</th>\n                    <th scope=\"col\" style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.22); text-align:right; font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Billetes impresos</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">★&nbsp;68364001&nbsp;A&ndash;★&nbsp;68388000&nbsp;A</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">24.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">★&nbsp;70956001&nbsp;A&ndash;★&nbsp;71004000&nbsp;A</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">48.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19;\">★&nbsp;79560001&nbsp;A&ndash;★&nbsp;79632000&nbsp;A</td>\n                    <td style=\"padding:8px 10px; border-bottom:1px solid rgba(10,10,9,0.10); color:#221f19; text-align:right; font-variant-numeric:tabular-nums;\">72.000</td>\n                  </tr>\n                  <tr>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; font-weight:600;\">Total estrellas</td>\n                    <td style=\"padding:8px 10px; border-top:1px solid rgba(10,10,9,0.22); color:#221f19; text-align:right; font-variant-numeric:tabular-nums; font-weight:600;\">144.000</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Los tres rangos documentados de estrellas suman <strong style=\"color:#1c1a15;\">144.000</strong> billetes de reemplazo.</p>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 8px;\"><strong style=\"color:#1c1a15;\">Total de impresión</strong></p>\n            <ul style=\"margin:0 0 14px; padding:0 0 0 22px; font-size:19px; line-height:1.65; color:#332e22;\">\n              <li style=\"margin:0 0 4px;\">Billetes regulares: 26.916.000</li>\n              <li style=\"margin:0 0 4px;\">Reemplazos con estrella: 144.000</li>\n              <li style=\"margin:0 0 4px;\">Total de billetes impresos: <strong style=\"color:#1c1a15;\">27.060.000</strong></li>\n              <li style=\"margin:0;\">Valor facial combinado: <strong style=\"color:#1c1a15;\">$27.060.000</strong></li>\n            </ul>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Las estrellas se produjeron para reemplazar pliegos imperfectos detectados tras la numeración. Por ello, los catálogos suelen listar <strong style=\"color:#1c1a15;\">26.916.000</strong> como tirada regular Fr. 2306 y <strong style=\"color:#1c1a15;\">144.000</strong> por separado bajo Fr. 2306★. La cifra <strong style=\"color:#1c1a15;\">27.060.000</strong> es el total bruto al sumar ambas producciones.</p>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Impresión:</strong> se imprimieron en total <strong style=\"color:#1c1a15;\">26.916.000</strong> Certificados de Plata de $1 Serie 1935-A del Norte de África con sello amarillo regulares, junto con <strong style=\"color:#1c1a15;\">144.000</strong> reemplazos con estrella, lo que da una tirada bruta combinada de <strong style=\"color:#1c1a15;\">27.060.000</strong> billetes.</p>\n\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Las entregas del Bureau of Engraving and Printing para esta emisión especial de $1 se registran entre <strong style=\"color:#1c1a15;\">el 4 de septiembre de 1942 y el 24 de abril de 1944</strong>.<sup style=\"font-size:12px;\">2</sup></p>\n\n            <p style=\"font-size:15px; line-height:1.6; color:#5c4e33; margin:0; font-style:italic;\"><strong style=\"font-style:normal; color:#1c1a15;\">Nota de verificación:</strong> un resumen de 2019 de la Society of Paper Money Collectors citó una tirada regular menor de 17.012.000. Esa cifra, sin embargo, no cuadra con los rangos de serie documentados completos, cuyas ocho corridas de sello amarillo suman 26.916.000. Por ello, la cifra basada en rangos de serie es el número de catálogo más sólido.</p>\n          </section>\n\n\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>1. USPaperMoney.info &mdash; rangos de serie de la emisión especial $1 Norte de África (sello amarillo) y totales derivados: <a href=\"https://www.uspapermoney.info/serials/all___s.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">uspapermoney.info <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a>; también <a href=\"https://www.uspapermoney.info/serials/s1935zs.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Series 1935&ndash;1935D $1 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>2. USPaperMoney.info &mdash; fechas de entrega BEP, $1 Norte de África (4 sep. 1942&ndash;24 abr. 1944): <a href=\"https://www.uspapermoney.info/general/deliv_s.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">uspapermoney.info <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Friedberg, Arthur L. &amp; Ira S. <em>Paper Money of the United States</em> (FR-2306 / FR-2306★).</li>\n              <li>Society of Paper Money Collectors &mdash; contraste con la cifra de 17.012.000 citada en un resumen de 2019; se priorizan los rangos de serie documentados.</li>\n              <li>Bureau of Engraving and Printing &mdash; <a href=\"https://www.bep.gov\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">bep.gov <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Heritage Auctions &mdash; <a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Numista &mdash; <a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
