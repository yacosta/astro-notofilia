  "i18n": {
    "en": {
      "path": "/en/collection/military-payment-certificates/20-dollars-series-692/",
      "title": "MPC Seriess 692 $20 EE. UU. Vietnam | Notofilia",
      "description": "MPC Seriess 692 $20 de Vietnam (1970–1973): Schwan-938 / Pick M98, Chief Ouray y presa Hoover. Notofilia.",
      "ogTitle": "MPC Seriess 692 $20 Vietnam (1970–1973) | Notofilia",
      "ogDescription": "MPC Seriess 692 $20 de Vietnam (1970–1973). Schwan-938 / Pick M98; Chief Ouray y presa Hoover. Notofilia.",
      "template": "<div lang=\"en\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  <main data-pagefind-meta=\"url:/en/collection/military-payment-certificates/20-dollars-series-692/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"MPC Seriess 692 — Veinte Dólares\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/en/collection/military-payment-certificates/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Military Payment Certificates (MPC)</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">United States &middot; Military Payment Certificate &middot; Series 692</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Twenty Dollars &mdash; Series 692</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$20.00 &middot; Oct 7 1970 &ndash; Mar 15 1973 &middot; Exclusive use in Vietnam</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"mpc-692-20\"\n            aria-label=\"Enlarge image of the certificado de pago militar Seriess 692\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/mpc-series-692-20-dollars.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/mpc-series-692-20-dollars.jpg\"\n                alt=\"Certificado de pago militar de veinte dólares, Seriess 692: obverse con el portrait of Ute Chief Ouray y reverse con la presa Hoover\"\n                width=\"800\"\n                height=\"708\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\" aria-hidden=\"true\"></span>Enlarge</span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Obverse (top) and reverse (bottom) — Notofilia.com Collection</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Country</span>\n              <span style=\"font-size:19px; color:#221f19;\">United States &mdash; exclusive circulation in Vietnam</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Issuing Entity</span>\n              <span style=\"font-size:19px; color:#221f19;\">U.S. Department of Defense (<em>US Department of Defense</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Type of Issue</span>\n              <span style=\"font-size:19px; color:#221f19;\">Military Payment Certificate (<em>Military Payment Certificate</em>, MPC) &mdash; scrip for authorized personnel; no Treasury note</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denomination</span>\n              <span style=\"font-size:19px; color:#221f19;\">$20.00 (Twenty Dollars)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Series / Validity</span>\n              <span style=\"font-size:19px; color:#221f19;\">Series 692 &mdash; issued October 7, 1970; withdrawn March 15, 1973 (the MPC program's final official series)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Printer</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bureau of Engraving and Printing (BEP) &mdash; color lithography (offset), no intaglio</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Catalog Reference</span>\n              <span style=\"font-size:19px; color:#221f19;\">Schwan-938 &middot; Pick M98</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Print run</span>\n              <span style=\"font-size:19px; color:#221f19;\">Approx. 6,400,000 $20 bills (Series 692: more than $214 million in total face value of all denominations)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rarity</span>\n              <span style=\"font-size:19px; color:#221f19;\">Among the most sought-after denominations in Series 692 (along with the $10); it trades well above face value in circulated grades. Regular second-printing issue (S938-2) &mdash;serial E&hellip;E&mdash;, not a replacement banknote</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serial Number / Plate</span>\n              <span style=\"font-size:19px; color:#221f19;\">E05725119&nbsp;E &middot; plate 16 &middot; second printing (S938-2)</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Enlarged Certificado\"\n              data-zoom-dialog=\"mpc-692-20\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Close\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button type=\"button\" data-zoom-out\n                  disabled=\"true\"\n                  aria-label=\"Zoom out\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span data-zoom-percent style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  data-zoom-in aria-label=\"Zoom in\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/mpc-series-692-20-dollars.webp\" type=\"image/webp\" />\n                  <img data-zoom-image\n                    src=\"/uploads/mpc-series-692-20-dollars.jpg\"\n                    alt=\"MPC Seriess 692 de veinte dólares, enlarged view del obverse and reverse\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:calc(100vw - 16px); max-height:calc(100vh - 16px); width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"position:absolute; bottom:16px; left:50%; transform:translateX(-50%); font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic; pointer-events:none;\">Drag to move &middot; Mouse wheel to zoom</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Historical Context</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Series 692 was the last official MPC issue put into circulation. It entered Vietnam on October 7, 1970 and whole denominations were withdrawn on March 15, 1973 (fractional ones on June 1, 1971, when US coins were reintroduced). It is the series that closes the military scrip program started in 1946.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Like the rest of the MPCs, these banknotes could only be used in military establishments by authorized personnel. Convertible to local currency when leaving &mdash; but not the other way around&mdash; and to US dollars only when leaving the MPC zone. This limited the black market and protected the local economy from excess dollars.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">The &mdash; design, often cited as the most &ldquo; American &rdquo; program &mdash;, combines BEP vignettes with national themes: indigenous people, eagles, bison. The $20 with the<a href=\"/en/collection/military-payment-certificates/profile-chief-ouray/\">Chief Ouray</a>It is one of the most recognizable and sought-after pieces of the entire MPC series.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Color Scheme</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Obverse:</strong>main print in violet/purple on a beige background, with large ornamental numerals &ldquo;20&rdquo; in the upper corners and the legends &ldquo;TWENTY&rdquo; / &ldquo;DOLLARS&rdquo; in lower bands.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverse:</strong>same violet palette; The hydroelectric dam occupies a central oval flanked by two large &ldquo;20&rdquo; on radiating rose windows. Top and bottom purple stripes with MPC regulatory text.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Portrait and Obverse Images</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Center:</strong>portrait of<a href=\"/en/collection/military-payment-certificates/profile-chief-ouray/\">Ute Chief Ouray</a>(c. 1833&ndash;1880), leader of the band Uncompahgre, recognized by the U.S. government for negotiating peace treaties. Cartoon recorded by the Bureau of Engraving and Printing.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Legends:</strong>&ldquo;SERIES 692&rdquo; and &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; vertically on the right; numeral &ldquo;20&rdquo; in the upper corners; Black serial numbers on both sides.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Regulatory text:</strong>block on the left with the clause of exclusive use in military establishments by authorized personnel.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverse Images</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Hoover Dam (<em>Hoover Dam</em>) in a central oval: the wall, the spillways and the hills of the Colorado. It is one of the most recognizable engineering vignettes on American military paper money.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">To the left and right, large numerals &ldquo;20&rdquo; on radiant rosettes in violet; upper and lower stripes with &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; and the regulatory clause of use.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Signatures and Seals</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Unlike Treasury or Federal Reserve notes, MPCs do not bear the signatures of treasurer or secretary of the Treasury, nor the seal of the Department of the Treasury: they were issued under the authority of the Department of Defense.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legacy for Collectors</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Series 692 closes the MPC cycle and is a favorite among collectors for its &ldquo;American&rdquo; aesthetic and for being the last one put into circulation. The $20 with<a href=\"/en/collection/military-payment-certificates/profile-chief-ouray/\">Ouray</a>It is, along with $10, the denomination that best holds a premium over face value.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Replacement banknotes (series ending in a digit instead of the letter E) are much scarcer. This specimen is a regular second printing issue (S938-2), with serial E&hellip;E.</p>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Sources</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Bureau of Engraving and Printing &mdash;<a href=\"https://www.bep.gov/media/1041/download?inline=\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates 1946&ndash;1973<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>Schwan, Fred.<em>Comprehensive Catalog of Military Payment Certificates</em>&mdash; Schwan-938</li>\n              <li>World Banknotes &amp; Coins Museum &mdash;<a href=\"https://www.worldbanknotescoins.com/2014/11/us-military-payment-certificate-20-dollars-mpc-series-692.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Series 692 $20<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a>(Pick M98)</li>\n              <li>Banknote.ws &mdash;<a href=\"http://banknote.ws/COLLECTION/countries/AME/USA/USA-MIL/USAM0098.htm\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">P-M98 Series 692 $20<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>ANA / Fred Schwan &mdash;<a href=\"https://www.money.org/uploads/Mili.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates (PDF)<span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
      "recordTitle": "Veinte Dólares — Seriess 692",
      "eyebrow": "United States · Military Payment Certificate · Seriess 692"
    }
