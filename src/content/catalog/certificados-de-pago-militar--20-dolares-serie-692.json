  "styles": "body { margin: 0; }\n    a { color: #6b521f; text-decoration: underline; text-decoration-color: rgba(138,109,59,0.35); }\n    a:hover { color: #5c4826; }\n    ::selection { background: rgba(138,109,59,0.25); }",
  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  <main data-pagefind-meta=\"url:/coleccion/certificados-de-pago-militar/20-dolares-serie-692/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"MPC Serie 692 — Veinte Dólares\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/certificados-de-pago-militar/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Certificados de Pago Militar (MPC)</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Estados Unidos &middot; Military Payment Certificate &middot; Serie 692</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Veinte Dólares &mdash; Serie 692</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$20.00 &middot; 7 oct. 1970 &ndash; 15 mar. 1973 &middot; Uso exclusivo en Vietnam</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"mpc-692-20\"\n            aria-label=\"Ampliar imagen del certificado de pago militar Serie 692\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/mpc-series-692-20-dollars.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/mpc-series-692-20-dollars.jpg\"\n                alt=\"Certificado de pago militar de veinte dólares, Serie 692: anverso con el retrato del jefe ute Ouray y reverso con la presa Hoover\"\n                width=\"800\"\n                height=\"708\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\" aria-hidden=\"true\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos &mdash; circulación exclusiva en Vietnam</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento de Defensa de los EE. UU. (<em>U.S. Department of Defense</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Certificado de Pago Militar (<em>Military Payment Certificate</em>, MPC) &mdash; scrip para personal autorizado; no billete del Tesoro</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">$20.00 (Veinte Dólares)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Vigencia</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie 692 &mdash; emitida el 7 de octubre de 1970; retirada el 15 de marzo de 1973 (última serie oficial del programa MPC)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bureau of Engraving and Printing (BEP) &mdash; litografía en color (offset), no intaglio</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Schwan-938 &middot; Pick M98</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tirada</span>\n              <span style=\"font-size:19px; color:#221f19;\">Aprox. 6.400.000 billetes de $20 (Serie 692: más de 214 millones de dólares en valor facial total de todas las denominaciones)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Entre las denominaciones más buscadas de la Serie 692 (junto al $10); cotiza claramente por encima del facial en grados circulados. Emisión regular de segunda impresión (S938-2) &mdash;serial E&hellip;E&mdash;, no billete de reemplazo</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie / Placa</span>\n              <span style=\"font-size:19px; color:#221f19;\">E05725119&nbsp;E &middot; placa 16 &middot; segunda impresión (S938-2)</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Certificado ampliado\"\n              data-zoom-dialog=\"mpc-692-20\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/mpc-series-692-20-dollars.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/mpc-series-692-20-dollars.jpg\"\n                    alt=\"MPC Serie 692 de veinte dólares, vista ampliada del anverso y reverso\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">La Serie 692 fue la última emisión oficial de MPC puesta en circulación. Entró en Vietnam el 7 de octubre de 1970 y las denominaciones enteras se retiraron el 15 de marzo de 1973 (las fraccionarias, el 1 de junio de 1971, al reintroducirse monedas estadounidenses). Es la serie que cierra el programa de scrip militar iniciado en 1946.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Como el resto de los MPC, estos billetes solo podían usarse en establecimientos militares por personal autorizado. Convertibles a moneda local al salir de permiso &mdash;pero no a la inversa&mdash; y a dólares estadounidenses únicamente al abandonar la zona MPC. Así se limitaba el mercado negro y se protegía la economía local del exceso de dólares.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">El diseño &mdash;a menudo citado como el más &ldquo;americano&rdquo; del programa&mdash; combina viñetas del BEP con temas nacionales: indígenas, águilas, bisontes. El $20 con el <a href=\"/coleccion/certificados-de-pago-militar/perfil-jefe-ouray/\">jefe Ouray</a> es una de las piezas más reconocibles y cotizadas de toda la serie MPC.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Esquema de Color</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> impresión principal en violeta/púrpura sobre fondo beige, con grandes numerales &ldquo;20&rdquo; ornamentales en las esquinas superiores y las leyendas &ldquo;TWENTY&rdquo; / &ldquo;DOLLARS&rdquo; en bandas inferiores.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> misma paleta violeta; la presa hidroeléctrica ocupa un óvalo central flanqueado por dos grandes &ldquo;20&rdquo; sobre rosetones radiantes. Franjas púrpuras superior e inferior con el texto reglamentario del MPC.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Retrato e Imágenes del Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Centro:</strong> retrato del <a href=\"/coleccion/certificados-de-pago-militar/perfil-jefe-ouray/\">jefe ute Ouray</a> (c. 1833&ndash;1880), líder de la banda Uncompahgre, reconocido por el gobierno de EE. UU. por negociar tratados de paz. Viñeta grabada por el Bureau of Engraving and Printing.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Leyendas:</strong> &ldquo;SERIES 692&rdquo; y &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; en vertical a la derecha; numeral &ldquo;20&rdquo; en las esquinas superiores; números de serie en negro a ambos lados.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Texto reglamentario:</strong> bloque a la izquierda con la cláusula de uso exclusivo en establecimientos militares por personal autorizado.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Imágenes del Reverso</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Presa Hoover (<em>Hoover Dam</em>) en un óvalo central: el muro, los aliviaderos y las colinas del Colorado. Es una de las viñetas de ingeniería más reconocibles del papel moneda militar estadounidense.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">A izquierda y derecha, grandes numerales &ldquo;20&rdquo; sobre rosetones radiantes en violeta; franjas superior e inferior con &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; y la cláusula reglamentaria de uso.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Firmas y Sellos</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">A diferencia de los billetes del Tesoro o de la Reserva Federal, los MPC no llevan firmas de tesorero ni secretario del Tesoro, ni el sello del Departamento del Tesoro: se emitían bajo autoridad del Departamento de Defensa.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legado para Coleccionistas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">La Serie 692 cierra el ciclo MPC y es favorita entre coleccionistas por su estética &ldquo;americana&rdquo; y por ser la última puesta en circulación. El $20 con <a href=\"/coleccion/certificados-de-pago-militar/perfil-jefe-ouray/\">Ouray</a> es, junto al $10, la denominación que mejor sostiene prima sobre el facial.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Los billetes de reemplazo (serie que termina en dígito en lugar de la letra E) son bastante más escasos. Este ejemplar es emisión regular de segunda impresión (S938-2), con serial E&hellip;E.</p>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Bureau of Engraving and Printing &mdash; <a href=\"https://www.bep.gov/media/1041/download?inline=\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates 1946&ndash;1973 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Schwan, Fred. <em>Comprehensive Catalog of Military Payment Certificates</em> &mdash; Schwan-938</li>\n              <li>World Banknotes &amp; Coins Museum &mdash; <a href=\"https://www.worldbanknotescoins.com/2014/11/us-military-payment-certificate-20-dollars-mpc-series-692.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Series 692 $20 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a> (Pick M98)</li>\n              <li>Banknote.ws &mdash; <a href=\"http://banknote.ws/COLLECTION/countries/AME/USA/USA-MIL/USAM0098.htm\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">P-M98 Series 692 $20 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>ANA / Fred Schwan &mdash; <a href=\"https://www.money.org/uploads/Mili.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates (PDF) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
