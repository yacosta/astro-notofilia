  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  <main data-pagefind-meta=\"url:/coleccion/pop-art/warhol-basquiat/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Warhol — Basquiat\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/pop-art/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Pop Art</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:780px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Rency Art &middot; Arte / Homenaje &middot; 2022</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Warhol — Basquiat</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$2.00 &middot; Firmado a mano por Rency</p>\n        </div>\n\n        <div style=\"width:100%; max-width:780px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            onClick=\"{{ openZoom }}\"\n            data-zoom-trigger=\"rency-warhol-basquiat-scan\"\n            aria-label=\"Ampliar imagen del billete Rency Art\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/rency-warhol-basquiat-scan-v4-640.webp 640w, uploads/rency-warhol-basquiat-scan-v4.webp 800w\" sizes=\"(max-width: 600px) 100vw, 780px\" type=\"image/webp\" />\n              <img\n                src=\"uploads/rency-warhol-basquiat-scan-v4.webp\"\n                alt=\"Warhol Basquiat Famous Artists Pop Art, billete de dos dólares Rency Art firmado, anverso y reverso\"\n                width=\"1396\"\n                height=\"1178\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto; object-fit:contain; background:#fff;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) &mdash; Colección de Notofilia.com</span>\n\n          <sc-if value=\"{{ zoomOpen }}\" hint-placeholder-val=\"{{ false }}\">\n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete ampliado\"\n              data-zoom-dialog=\"rency-warhol-basquiat-scan\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n              onClick=\"{{ closeZoom }}\"\n              onWheel=\"{{ onWheel }}\"\n            >\n              <button onClick=\"{{ closeZoom }}\" data-zoom-close aria-label=\"Cerrar\" style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\">&times;</button>\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button onClick=\"{{ zoomOutHandler }}\" disabled=\"{{ zoomOutDisabled }}\" aria-label=\"Alejar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">{{ zoomPercent }}</span>\n                <button onClick=\"{{ zoomInHandler }}\" disabled=\"{{ zoomInDisabled }}\" aria-label=\"Acercar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&#43;</button>\n              </div>\n              <div style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\" onClick=\"{{ stopPropagation }}\" onPointerDown=\"{{ onPointerDown }}\" onPointerMove=\"{{ onPointerMove }}\" onPointerUp=\"{{ onPointerUp }}\" onPointerLeave=\"{{ onPointerUp }}\">\n                <picture>\n                  <source srcset=\"uploads/rency-warhol-basquiat-scan-v4.webp\" type=\"image/webp\" />\n                  <img src=\"uploads/rency-warhol-basquiat-scan-v4.webp\" alt=\"Warhol — Basquiat — vista ampliada\" draggable=\"false\" style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\" />\n                </picture>\n              </div>\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          </sc-if>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Artista</span>\n              <span style=\"font-size:19px; color:#221f19;\">Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Título</span>\n              <span style=\"font-size:19px; color:#221f19;\">WARHOL BASQUIAT Famous Artists Pop Art — Genuine $2 U.S. Bill<span style=\"display:block; margin-top:6px; font-style:italic; color:#4a4331;\">Warhol Basquiat — Artistas célebres pop art — Billete genuino de 2 dólares EE. UU.</span></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año</span>\n              <span style=\"font-size:19px; color:#221f19;\">2022</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Medio</span>\n              <span style=\"font-size:19px; color:#221f19;\">Giclée de bellas artes sobre billete genuino de dos dólares de curso legal (<em>Fine Art Giclée on Genuine $2 U.S. Bill</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación Facial</span>\n              <span style=\"font-size:19px; color:#221f19;\">$2.00 (dos dólares — moneda de curso legal estadounidense)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">Aprox. 6&quot; &times; 2,5&quot; (152 &times; 64 mm)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Edición</span>\n              <span style=\"font-size:19px; color:#221f19;\">Edición de arte — firmada a mano por Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firma</span>\n              <span style=\"font-size:19px; color:#221f19;\">Firmado a mano por el artista Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Clasificación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Rency Art / exonumia contemporánea — <em>no</em> es una emisión bancaria catalogable en Pick ni Friedberg</span>\n            </div>\n            <div style=\"border-bottom:1px solid rgba(10,10,9,0.12);\"></div>\n          </div>\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Sobre la Obra</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Esta pieza rinde homenaje a Andy Warhol y Jean-Michel Basquiat —dos figuras fundacionales del pop art y el arte callejero de las décadas de 1980— mediante una intervención giclée sobre billete genuino de dos dólares.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Encaja en la línea de Rency de dialogar con iconos del arte contemporáneo mientras subvierte el soporte de la moneda nacional. El ejemplar de Notofilia está <strong style=\"color:#1c1a15;\">firmado a mano por el artista</strong>.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Homenaje dual:</strong> referencia visual a Andy Warhol y Jean-Michel Basquiat, dos pilares del pop art y el arte urbano contemporáneo.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Frases coloridas:</strong> serie de expresiones pop superpuestas en la tradición de las obras de Rency sobre moneda.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Giclée sobre $2 bill:</strong> impresión de alta calidad sobre billete federal genuino de dos dólares.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Firma del artista:</strong> firmado a mano por Rency en el reverso.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Grabado original:</strong> elementos del reverso estándar del billete de dos dólares visibles junto a la intervención.</span>\n              </li>\n            </ul>\n          </section>\n\n          \n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
  "logic": "class Component extends DCLogic {\n  state = {\n    zoomOpen: false,\n    scale: 1,\n    offsetX: 0,\n    offsetY: 0,\n    dragging: false,\n    dragStartX: 0,\n    dragStartY: 0,\n    dragOffsetStartX: 0,\n    dragOffsetStartY: 0\n  };\n\n  focusClose = () => {\n    const closeBtn = document.querySelector('[data-zoom-dialog=\"rency-warhol-basquiat-scan\"] [data-zoom-close]');\n    if (closeBtn) { closeBtn.focus(); return; }\n    requestAnimationFrame(this.focusClose);\n  };\n\n  focusTrigger = () => {\n    const trigger = document.querySelector('[data-zoom-trigger=\"rency-warhol-basquiat-scan\"]');\n    if (trigger) trigger.focus();\n  };\n\n  openZoom = () => {\n    this.setState({ zoomOpen: true, scale: 1, offsetX: 0, offsetY: 0 });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusClose));\n  };\n\n  closeZoom = () => {\n    this.setState({ zoomOpen: false });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusTrigger));\n  };\n\n  stopPropagation = (e) => e.stopPropagation();\n\n  zoomIn = () => {\n    this.setState(s => ({ scale: Math.min(4, Math.round((s.scale + 0.5) * 10) / 10) }));\n  };\n\n  zoomOut = () => {\n    this.setState(s => {\n      const next = Math.max(1, Math.round((s.scale - 0.5) * 10) / 10);\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onWheel = (e) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? -0.25 : 0.25;\n    this.setState(s => {\n      const next = Math.min(4, Math.max(1, Math.round((s.scale + delta) * 100) / 100));\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onPointerDown = (e) => {\n    if (this.state.scale <= 1) return;\n    this.setState({\n      dragging: true,\n      dragStartX: e.clientX,\n      dragStartY: e.clientY,\n      dragOffsetStartX: this.state.offsetX,\n      dragOffsetStartY: this.state.offsetY\n    });\n  };\n\n  onPointerMove = (e) => {\n    if (!this.state.dragging) return;\n    const dx = e.clientX - this.state.dragStartX;\n    const dy = e.clientY - this.state.dragStartY;\n    this.setState({ offsetX: this.state.dragOffsetStartX + dx, offsetY: this.state.dragOffsetStartY + dy });\n  };\n\n  onPointerUp = () => this.setState({ dragging: false });\n\n  onKeyDown = (e) => {\n    if (e.key === \"Escape\" && this.state.zoomOpen) this.closeZoom();\n  };\n\n  componentDidMount() {\n    document.addEventListener(\"keydown\", this.onKeyDown);\n    if (typeof document !== \"undefined\" && document.documentElement) {\n      document.documentElement.lang = \"es\";\n    }\n  }\n\n  componentWillUnmount() {\n    document.removeEventListener(\"keydown\", this.onKeyDown);\n  }\n\n  renderVals() {\n    const s = this.state;\n    return {\n      zoomOpen: s.zoomOpen,\n      openZoom: this.openZoom,\n      closeZoom: this.closeZoom,\n      stopPropagation: this.stopPropagation,\n      zoomInHandler: this.zoomIn,\n      zoomOutHandler: this.zoomOut,\n      onWheel: this.onWheel,\n      onPointerDown: this.onPointerDown,\n      onPointerMove: this.onPointerMove,\n      onPointerUp: this.onPointerUp,\n      zoomInDisabled: s.scale >= 4,\n      zoomOutDisabled: s.scale <= 1,\n      zoomPercent: Math.round(s.scale * 100) + \"%\",\n      imgTransform: `translate(${s.offsetX}px, ${s.offsetY}px) scale(${s.scale})`,\n      imgCursor: s.scale > 1 ? (s.dragging ? \"grabbing\" : \"grab\") : \"default\"\n    };\n  }\n}",
