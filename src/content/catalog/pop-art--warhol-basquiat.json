lay:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Title</span>\n              <span style=\"font-size:19px; color:#221f19;\">WARHOL BASQUIAT Famous Artists Pop Art — Genuine $2 U.S. Bill<span style=\"display:block; margin-top:6px; font-style:italic; color:#4a4331;\">Warhol Basquiat — Celebrated Pop-Art Artists — Genuine U.S. Two-Dollar Bill</span></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Year</span>\n              <span style=\"font-size:19px; color:#221f19;\">2022</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Medium</span>\n              <span style=\"font-size:19px; color:#221f19;\">Fine-art giclée on a genuine legal-tender two-dollar bill (<em>Fine Art Giclée on Genuine $2 U.S. Bill</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Face denomination</span>\n              <span style=\"font-size:19px; color:#221f19;\">$2.00 (two dollars — U.S. legal tender)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensions</span>\n              <span style=\"font-size:19px; color:#221f19;\">Approx. 6&quot; &times; 2.5&quot; (152 &times; 64 mm)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Edition</span>\n              <span style=\"font-size:19px; color:#221f19;\">Art edition — hand-signed by Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Signature</span>\n              <span style=\"font-size:19px; color:#221f19;\">Hand-signed by artist Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Classification</span>\n              <span style=\"font-size:19px; color:#221f19;\">Rency Art / contemporary exonumia —<em>no</em>is a bank issue catalogable in neither Pick nor Friedberg</span>\n            </div>\n            <div style=\"border-bottom:1px solid rgba(10,10,9,0.12);\"></div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Enlarged banknote\"\n              data-zoom-dialog=\"rency-warhol-basquiat-scan\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button data-zoom-close aria-label=\"Close\" style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\">&times;</button>\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button disabled=\"true\" aria-label=\"Zoom out\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button disabled=\"false\" aria-label=\"Zoom in\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&#43;</button>\n              </div>\n              <div style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\">\n                <picture>\n                  <source srcset=\"/uploads/rency-warhol-basquiat-scan-v4.webp\" type=\"image/webp\" />\n                  <img src=\"/uploads/rency-warhol-basquiat-scan-v4.webp\" alt=\"Warhol — Basquiat — enlarged view\" draggable=\"false\" style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\" />\n                </picture>\n              </div>\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Drag to move &middot; Mouse wheel to zoom</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">About the Work</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">This piece pays tribute to Andy Warhol and Jean-Michel Basquiat—two foundational figures of pop art and street art of the 1980s—through a giclée intervention on a genuine two-dollar bill.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">It fits into Rency's line of dialogue with icons of contemporary art while subverting the support of the national currency. The Notofilia specimen is<strong style=\"color:#1c1a15;\">Hand-signed by the artist</strong>.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Obverse</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Dual tribute:</strong>a visual reference to Andy Warhol and Jean-Michel Basquiat, two leading figures of pop art and contemporary urban art.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorful phrases:</strong>a series of superimposed pop expressions in the tradition of Rency's works on currency.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Giclée on $2 bill:</strong>High quality printing on genuine federal two dollar bill.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverse</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Artist's Signature:</strong>hand signed by Rency on the verso.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Original engraving:</strong>elements of the standard back of the two-dollar bill visible next to the intervention.</span>\n              </li>\n            </ul>\n          </section>\n\n          \n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
