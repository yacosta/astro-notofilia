  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/polimero-mundial/malasia-ringgit/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Bank Negara Malaysia — 5 y 50 Ringgit\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/polimero-mundial/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Billetes de Polímero Mundial</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 56px;\">\n        <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Billetes de Polímero Mundial &middot; Malasia</span>\n        <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Bank Negara Malaysia</h1>\n        <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Dos billetes de polímero: 5 Ringgit de circulación y 50 Ringgit conmemorativo</p>\n      </div>\n\n      <!-- ============ 5 RINGGIT ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">5 Ringgit &middot; 2004</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Lima Ringgit &middot; Tuanku Abdul Rahman &middot; Torres Petronas</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Malasia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bank Negara Malaysia (banco central de Malasia)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cinco Ringgit (RM5)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero &mdash; sustrato Guardian&reg;, desarrollado por Securency (hoy CCL Secure)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Note Printing Australia (NPA), con sede en Melbourne, Australia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">2004 &mdash; variante en polímero de la Cuarta Serie<sup style=\"font-size:12px;\">1</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firma</span>\n              <span style=\"font-size:19px; color:#221f19;\">Zeti Akhtar Aziz, Gobernadora de Bank Negara Malaysia<sup style=\"font-size:12px;\">2</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">135 &times; 65 mm<sup style=\"font-size:12px;\">3</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Billete corriente de circulación cotidiana en Malasia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-47a, Standard Catalog of World Paper Money</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"malaysia-5-ringgit-2004-polimero\"\n            aria-label=\"Ampliar imagen del billete de 5 Ringgit\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/malaysia-bank-negara-5-ringgit-2004-polimero.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/malaysia-bank-negara-5-ringgit-2004-polimero.jpg\"\n                alt=\"Billete de 5 Ringgit de polímero de Bank Negara Malaysia, anverso arriba con retrato de Tuanku Abdul Rahman, reverso abajo con las Torres Petronas y el aeropuerto internacional de Kuala Lumpur\"\n                width=\"564\"\n                height=\"542\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">La Cuarta Serie en polímero:</strong> Bank Negara Malaysia introdujo esta variante de polímero del billete de 5 Ringgit en 2004, dentro de la migración gradual de su Cuarta Serie de billetes al nuevo sustrato plástico.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Tecnología Guardian&reg;:</strong> impreso por Note Printing Australia (NPA), con sede en Melbourne, sobre sustrato Guardian&reg; desarrollado por Securency (hoy CCL Secure), con las ventanas de seguridad y el registro transparente característicos de esta tecnología.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato de Tuanku Abdul Rahman, primer Yang di-Pertuan Agong (jefe de Estado) de Malasia.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> las Torres Petronas, el Aeropuerto Internacional de Kuala Lumpur (KLIA) y un mapa con Putrajaya y Cyberjaya.<sup style=\"font-size:12px;\">4</sup></span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Ventana transparente:</strong> recorte translúcido con la imagen de sombra de la Oficina del Primer Ministro en Putrajaya.<sup style=\"font-size:12px;\">5</sup></span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Microimpresión:</strong> textos de seguridad en tamaño diminuto distribuidos en distintas áreas del billete.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> predominan tonos verdes, con un subimpreso multicolor de fondo.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 50 RINGGIT ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">50 Ringgit &middot; 1998</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Lima Puluh Ringgit &middot; XVI Juegos de la Mancomunidad, Kuala Lumpur 1998</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Malasia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bank Negara Malaysia (banco central de Malasia)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cincuenta Ringgit (RM50) &mdash; billete conmemorativo</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero &mdash; sustrato Guardian&reg;, desarrollado por Securency (hoy CCL Secure) &mdash; el primer billete de polímero emitido en Malasia<sup style=\"font-size:12px;\">6</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Note Printing Australia (NPA), con sede en Melbourne, Australia<sup style=\"font-size:12px;\">7</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">1998, por los XVI Juegos de la Mancomunidad de Kuala Lumpur<sup style=\"font-size:12px;\">8</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firma</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ahmad bin Mohd Don, Gobernador de Bank Negara Malaysia<sup style=\"font-size:12px;\">9</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">152 &times; 76 mm<sup style=\"font-size:12px;\">10</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Emisión conmemorativa limitada a 500.000 juegos, vendidos en sobre a RM80 cada uno; pieza histórica muy buscada por coleccionistas<sup style=\"font-size:12px;\">11</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-45, Standard Catalog of World Paper Money</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"malaysia-50-ringgit-1998-polimero\"\n            aria-label=\"Ampliar imagen del billete de 50 Ringgit\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/malaysia-bank-negara-50-ringgit-1998-polimero.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/malaysia-bank-negara-50-ringgit-1998-polimero.jpg\"\n                alt=\"Billete conmemorativo de 50 Ringgit de polímero de Bank Negara Malaysia, anverso arriba con retrato de Tuanku Abdul Rahman y el horizonte de Kuala Lumpur, reverso abajo con el Estadio Nacional de Bukit Jalil y el logo de los Juegos de la Mancomunidad de 1998\"\n                width=\"564\"\n                height=\"562\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">El primer polímero de Malasia:</strong> Bank Negara Malaysia emitió este billete conmemorativo de 50 Ringgit en 1998 para celebrar los XVI Juegos de la Mancomunidad, celebrados ese año en Kuala Lumpur &mdash;el primer billete de polímero puesto en circulación por el país.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Impreso por Note Printing Australia:</strong> con sede en Melbourne, NPA imprimió este billete sobre sustrato Guardian&reg; (desarrollado por Securency, hoy CCL Secure) con doble ventana de seguridad, una de las combinaciones de seguridad más elaboradas de la época para un billete de circulación.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato de Tuanku Abdul Rahman, un horizonte central de Kuala Lumpur con las Torres Petronas y la Torre KL, y el Aeropuerto Internacional de Kuala Lumpur (KLIA) de fondo.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> el Estadio Nacional de Bukit Jalil (Stadium Utama Bukit Jalil) junto al logo oficial de los Juegos de la Mancomunidad Kuala Lumpur &lsquo;98 (XVI edición).<sup style=\"font-size:12px;\">12</sup></span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Ventana con OVD dorado:</strong> ventana transparente a la izquierda con un dispositivo óptico variable (OVD) de color dorado que muestra el retrato del Agong.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Segunda ventana:</strong> recorte transparente con forma de ala de mariposa, junto a motivos translúcidos multicolores de gran complejidad.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> subimpreso multicolor en amarillo, azul y púrpura.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Numista. &ldquo;5 Ringgit &mdash; Malaysia&rdquo;, nota #203048. <em>en.numista.com</em>: variante de polímero de la Tercera Serie, en circulación desde 1999.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">2. Numista, nota #203048: billete firmado por Zeti Akhtar Aziz, Gobernadora de Bank Negara Malaysia.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">3. LA Currency. &ldquo;MYR &mdash; Malaysian Ringgit.&rdquo; <em>lacurrency.com</em>: dimensiones de 135 &times; 65 mm para el billete de 5 Ringgit.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">4. Numista, nota #203048: reverso con el Aeropuerto Internacional de Kuala Lumpur, las Torres Petronas y un mapa geográfico que representa Putrajaya y Cyberjaya (Multimedia Super Corridor).</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">5. Numista, nota #203048: marca de agua con ventana transparente y la imagen de sombra de la Oficina del Primer Ministro en Putrajaya.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">6. Malaysian Banknotes Blog. &ldquo;Kuala Lumpur 98 XVI Commonwealth Games &mdash; Commemorative Polymer Note.&rdquo; <em>malaysianbanknotes.blogspot.com</em>: &ldquo;It was the first polymer banknote issued in Malaysia.&rdquo;</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">7. Carousell Malaysia, listado de venta del billete RM50 conmemorativo: &ldquo;Printer: Note Printing Australia.&rdquo;</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">8. Bank Negara Malaysia. &ldquo;Kuala Lumpur 98 &mdash; XVI Commonwealth Games RM50 Commemorative Polymer Banknote.&rdquo; <em>bnm.gov.my</em>: emitido el 1 de junio de 1998.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">9. Banknote World. &ldquo;Malaysia 50 Ringgit Banknote, 1998, P-45.&rdquo; <em>banknoteworld.com</em>: billete firmado por Ahmad bin Mohd Don.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">10. Banknote World, íd.: dimensiones de 152 &times; 76 mm.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">11. Bank Negara Malaysia, <em>bnm.gov.my</em>, íd.: emisión limitada a 500.000 sets, vendidos a RM80 cada uno en todos los bancos comerciales a partir del 1 de junio de 1998.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">12. Bank Negara Malaysia, <em>bnm.gov.my</em>, íd.: reverso con el Estadio Nacional de Bukit Jalil y el logo de los Juegos de la Mancomunidad de Kuala Lumpur &lsquo;98 (XVI edición).</p>\n      </div>\n\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n     \n     data-zoom-dialog=\"note-1\" hidden class=\"catalog-zoom-dialog\">\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"\" type=\"image/webp\" />\n          <img\n            src=\"\"\n            alt=\"Billete de Bank Negara Malaysia, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
