  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/colombia/banco-de-colombia-1-peso-oro-1919/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"El Banco de Colombia — Cédula Hipotecaria 1 Peso Oro (1919)\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/colombia/banca-libre/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Banca Libre</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Títulos y Cédulas Históricas &middot; Bogotá &middot; 1919</span>\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">El Banco de Colombia</h1>\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Cédula Hipotecaria &middot; Serie Z &middot; Un Peso en Oro Legal</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colombia (Bogotá)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Banco de Colombia, establecido en Bogotá</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Documento</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cédula hipotecaria &mdash; título valor con respaldo inmobiliario y circulación fiduciaria autorizada</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Un Peso en Oro Legal, equivalente a cuatro chelines (&pound; 0.4.0) moneda inglesa</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Papel de seguridad de época, con fibras ligeras</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Litografía Nacional / Imprenta privada comercial, Bogotá</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Número</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie Z, N.&deg; 103.697</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Lugar y Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bogotá, 1.&deg; de enero de 1919</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmantes</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ernesto Michelsen &middot; Eduardo Collins &middot; Liborio Maldonado C.</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Marco Legal</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ley 24 de 1905 y contrato entre el Gobierno Nacional y El Banco de Colombia del 6 de febrero de 1912</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">Formato intermedio de cédula bancaria, aprox. 145 &times; 80 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Listada en secciones de banca privada y títulos financieros de emergencia de Colombia</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"colombia-banco-de-colombia-1-peso-oro-1919\"\n            aria-label=\"Ampliar imagen de la cédula\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/colombia-banco-de-colombia-1-peso-oro-1919.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/colombia-banco-de-colombia-1-peso-oro-1919.jpg\"\n                alt=\"Cédula hipotecaria de El Banco de Colombia, anverso arriba con viñeta de cóndor andino en rojo, reverso abajo con marco guilloché azul y texto contractual\"\n                width=\"564\"\n                height=\"697\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Una cédula, no un billete de banco:</strong> a diferencia de los billetes de circulación de los bancos de la era de banca libre, esta pieza es una cédula hipotecaria &mdash;un título de deuda respaldado por hipotecas inmobiliarias, autorizado a circular con fuerza fiduciaria bajo un marco legal específico: la Ley 24 de 1905 y el contrato suscrito entre el Gobierno Nacional y El Banco de Colombia el 6 de febrero de 1912.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">La equivalencia en libras esterlinas:</strong> el texto expresa el valor de la cédula tanto en pesos oro como en su equivalente exacto en chelines de moneda inglesa (&pound;0.4.0) &mdash;un mecanismo de estabilización que buscaba anclar la confianza del instrumento a un patrón monetario internacional reconocido, en el contexto financiero posterior a la Primera Guerra Mundial.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Un contrato públicamente reproducido:</strong> el reverso reproduce textualmente las cláusulas del contrato de concesión con el Estado, incluyendo la Cláusula 8.&ordf; sobre las autorizaciones de emisión y el control de los libros comerciales del banco &mdash;una práctica de transparencia contractual poco habitual en los billetes convencionales de la época.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en la Cédula</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Viñeta superior:</strong> cóndor andino en tinta roja con las alas completamente desplegadas, símbolo heráldico nacional.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Texto principal:</strong> &ldquo;EL BANCO DE COLOMBIA pagará al portador UN PESO EN ORO LEGAL, (equivalente a cuatro chelines (&pound; 0.4.0) moneda inglesa). Esta cédula hipotecaria se emite en la fecha de conformidad con la ley 24 de 1905 y el contrato celebrado entre el Gobierno Nacional y el Banco de Colombia el 6 de Febrero de 1912&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Firmas:</strong> Ernesto Michelsen, Eduardo Collins y Liborio Maldonado C., directores y administradores de la entidad.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> marco rectangular de encajes geométricos guilloché en azul; al centro, paneles con las cláusulas contractuales, destacando la mención de la Cláusula 8.&ordf; sobre autorizaciones de emisión y control de libros comerciales.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Trama litográfica bicolor:</strong> superposición de grabado negro y rojo sobre una red fina de líneas azul pizarra, como defensa contra la reproducción fotomecánica no autorizada.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración:</strong> serie &ldquo;103.697&rdquo; estampada en ambos lados del anverso en tinta carmín, mediante prensa de impacto independiente.</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Cédula ampliada\"\n     \n     data-zoom-dialog=\"note-1\" hidden class=\"catalog-zoom-dialog\">\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"/uploads/colombia-banco-de-colombia-1-peso-oro-1919.webp\" type=\"image/webp\" />\n          <img\n            src=\"/uploads/colombia-banco-de-colombia-1-peso-oro-1919.jpg\"\n            alt=\"Cédula hipotecaria de El Banco de Colombia, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
