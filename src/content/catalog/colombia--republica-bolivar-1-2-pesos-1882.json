 margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"colombia-republica-bolivar-2-pesos-1882\"\n            aria-label=\"Ampliar imagen del billete de Dos Pesos\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/colombia-republica-bolivar-2-pesos-1882.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/colombia-republica-bolivar-2-pesos-1882.jpg\"\n                alt=\"Billete de Dos Pesos de la República Bolívar de Colombia, anverso con escudo nacional, reverso en transparencia inversa, 1882\"\n                width=\"564\"\n                height=\"431\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso y reverso &mdash; Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete de Dos Pesos ampliado\"\n              data-zoom-dialog=\"colombia-republica-bolivar-2-pesos-1882\" hidden style=\"display:none\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n            >\n              <button\n               