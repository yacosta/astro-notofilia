  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/colombia/departamento-de-antioquia-centavos/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Departamento de Antioquia — Vales de 10 y 20 Centavos\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/colombia/banca-libre/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Banca Libre</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 56px;\">\n        <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Colombia &middot; Medellín</span>\n        <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Departamento de Antioquia</h1>\n        <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Dos vales departamentales: diez centavos (1961) y veinte centavos (1901)</p>\n      </div>\n\n      <!-- ============ 10 CENTAVOS, 1961 ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Vale de Diez Centavos &middot; 1961</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Serie VII &middot; Medellín, enero de 1961</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            data-zoom-trigger=\"colombia-departamento-de-antioquia-10-centavos-1961\"\n            aria-label=\"Ampliar imagen del vale de diez centavos\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/colombia-departamento-de-antioquia-10-centavos-1961.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/colombia-departamento-de-antioquia-10-centavos-1961.jpg\"\n                alt=\"Vale de Diez Centavos del Departamento de Antioquia, anverso arriba con texto tipográfico de emisión y número de serie en tinta azul, reverso abajo con la leyenda Diez Centavos en orla decorativa\"\n                width=\"564\"\n                height=\"642\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colombia (Medellín, Antioquia)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento de Antioquia (Gobernación), emitido en Medellín</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Diez Centavos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Papel</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Imprenta Departamental (Medellín)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie VII, Medellín, enero de 1961</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Secretario de Hacienda &middot; El Subsecretario &middot; El Administrador General del Tesoro</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">Formato pequeño de emergencia, aprox. 95 &times; 55 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Vale departamental de fracción de peso, poco documentado fuera de colecciones especializadas</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick n.&deg; S101 (emisiones especializadas / regionales de Colombia)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Un vale del propio Departamento:</strong> a diferencia de las libranzas bancarias privadas, este vale de 1961 fue emitido directamente por la administración del Departamento de Antioquia, con las firmas del Secretario de Hacienda, el Subsecretario y el Administrador General del Tesoro.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Amortizable con rentas futuras:</strong> el texto del anverso especifica que el vale es &ldquo;amortizable con rentas del Dpto. del próximo cuatrienio&rdquo;, es decir, un instrumento de deuda de corto plazo respaldado por los ingresos fiscales departamentales de los cuatro años siguientes a su emisión &mdash;el mismo mecanismo empleado seis décadas antes en el vale de 1901.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Impresión local:</strong> producido por la Imprenta Departamental de Medellín con recursos tipográficos básicos, en lugar de una casa impresora de seguridad internacional.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> diseño tipográfico sencillo con bordes geométricos a ambos flancos, número de serie estampado en tinta azul, y el texto de emisión: &ldquo;Vale DIEZ CENTAVOS. Amortizable con rentas del Dpto. del próximo cuatrienio. Medellín, Enero de 1961.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Firmas impresas:</strong> &ldquo;Por el Srio. de Hacienda, el Subsecretario&rdquo;, con la referencia &ldquo;Serie VII&rdquo; y el pie de imprenta departamental.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> marco simétrico con la denominación repetida &ldquo;DIEZ CENTAVOS / 10 / CENTAVOS&rdquo; en tinta negra sobre subimpreso rojo pálido, y la firma de &ldquo;El Administrador General del Tesoro&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Bordes guilloché simplificados:</strong> patrones de líneas finas alrededor de los márgenes, un recurso visual básico contra la falsificación por duplicación primitiva.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración mecánica:</strong> matriz de serie en tinta azul, estampada con una numeradora mecánica independiente tras la impresión.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> tono naranja-marrón con texto en negro y subimpreso pálido en rojo.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 20 CENTAVOS, 1901 ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Vale de Veinte Centavos &middot; 1901</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Serie X &middot; Medellín, enero de 1901 &middot; Guerra de los Mil Días</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            data-zoom-trigger=\"colombia-departamento-de-antioquia-20-centavos-1901\"\n            aria-label=\"Ampliar imagen del vale de veinte centavos\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/colombia-departamento-de-antioquia-20-centavos-1901.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/colombia-departamento-de-antioquia-20-centavos-1901.jpg\"\n                alt=\"Vale de Veinte Centavos del Departamento de Antioquia, anverso arriba con texto tipográfico de emisión y número de serie en tinta azul, reverso abajo con roseta geométrica en tinta morada y sello de la Oficina de Emisión\"\n                width=\"564\"\n                height=\"757\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colombia (Medellín, Antioquia)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento de Antioquia (Gobernación), emitido en Medellín</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Veinte Centavos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Papel</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Imprenta Oficial, Medellín</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie X, Medellín, enero de 1901</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Secretario de Hacienda &middot; El Subsecretario &middot; El Administrador General del Tesoro</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">Formato pequeño de emergencia, aprox. 95 &times; 55 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Vale departamental de fracción de peso emitido en plena Guerra de los Mil Días; poco documentado fuera de colecciones especializadas</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick n.&deg; S102 (emisiones especializadas / regionales de Colombia)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Papel de emergencia en plena guerra civil:</strong> este vale se emitió en enero de 1901, en el punto más álgido de la Guerra de los Mil Días (1899&ndash;1902), cuando la emisión descontrolada de papel moneda por el Banco Nacional para financiar el conflicto llevó a Colombia a una hiperinflación que alcanzó el 389% en 1901, con una tasa media superior al 100% anual entre 1900 y 1903.<sup style=\"font-size:12px;\">1</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Respaldado por el fisco departamental:</strong> el texto del anverso especifica que el vale es &ldquo;á cargo del Departamento de Antioquia&rdquo;, aceptado &ldquo;en toda clase de transacciones&rdquo;, y &ldquo;amortizado con producto del próximo cuatrienio de rentas&rdquo; &mdash;un mecanismo de deuda departamental de corto plazo para paliar la escasez de circulante durante la guerra.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">La Oficina de Emisión:</strong> el sello morado superpuesto en el reverso, con la leyenda &ldquo;Oficina de Emisión&rdquo;, corresponde al control administrativo departamental sobre la circulación de este papel de emergencia.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> marco decorativo detallado con la declaración legal completa: &ldquo;Vale VEINTE CENTAVOS á cargo del Departamento de Antioquia. Se recibe en toda clase de transacciones, y será amortizado con producto del próximo cuatrienio de rentas. Medellín, Enero de 1901.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> retícula geométrica elaborada con roseta central en tinta morada; un gran &ldquo;20&rdquo; descansa dentro de un escudo decorativo, flanqueado por &ldquo;VEINTE CENTAVOS&rdquo; y el sello morado de la Oficina de Emisión.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración de seis dígitos:</strong> estampada tras la impresión en tinta azul oscuro, para el control contable de la emisión.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Guilloché intrincado:</strong> patrones circulares repetitivos en el reverso, un recurso básico contra la falsificación química o fotográfica primitiva.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> marco en tinta negra sobre un complejo subimpreso morado-rojizo en el reverso.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">1. Museo Nacional de Colombia, &ldquo;Piezas en Diálogo&rdquo; (diciembre 2017&ndash;marzo 2018): la rápida expansión monetaria del Banco Nacional durante la Guerra de los Mil Días elevó la inflación media a más del 100% anual entre 1900 y 1903, con un pico del 389% en 1901 (Hernández, 2001, p. 84).</p>\n      </div>\n\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Vale ampliado\"\n      style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n    >\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"\" type=\"image/webp\" />\n          <img\n            src=\"\"\n            alt=\"Vale del Departamento de Antioquia, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
