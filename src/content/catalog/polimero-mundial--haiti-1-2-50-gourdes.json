1; margin:0;\">Dr. François Duvalier &middot; Escudo de Armas de Haití</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom1 }}\"\n            data-zoom-trigger=\"haiti-1-gourde-1980-tyvek\"\n            aria-label=\"Ampliar imagen del billete de 1 Gourde\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/haiti-brh-1-gourde-1980-tyvek.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/haiti-brh-1-gourde-1980-tyvek.jpg\"\n                alt=\"Billete experimental de Tyvek de 1 Gourde de Haití, anverso arriba con retrato de François Duvalier, reverso abajo con el escudo de armas de Haití\"\n                width=\"564\"\n                height=\"555\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Haití</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banque de la République d'Haïti</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Une Gourde (1 Gourde)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tyvek&reg; &mdash; sustrato sintético experimental de DuPont, hilado de polietileno de alta densidad<sup style=\"font-size:12px;\">1</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">American Bank Note Company (ABNC)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ley del 17 de agosto de 1979; emitido hacia 1980</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">156 &times; 65 mm aprox.</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-230A</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato del Dr. François Duvalier (&ldquo;Papa Doc&rdquo;, 1907&ndash;1971), presidente vitalicio de Haití, en óvalo central.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> Escudo de Armas de Haití, con la palmera real y tambores de guerra tradicionales, en orlas circulares.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Sustrato antirroturas:</strong> impreso sobre película plástica porosa Tyvek, sin marcas de agua tradicionales pero con tramas geométricas microimpresas.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración:</strong> números de serie duales en azul acero, grabados por impacto.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> tinta marrón oscuro sobre fondo azul y verde claro; reverso en sepia.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 2 GOURDES ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Deux Gourdes &middot; 1980</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Dr. François Duvalier &middot; Escudo de Armas de Haití</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom2 }}\"\n            data-zoom-trigger=\"haiti-2-gourdes-1980-tyvek\"\n            aria-label=\"Ampliar imagen del billete de 2 Gourdes\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/haiti-brh-2-gourdes-1980-tyvek.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/haiti-brh-2-gourdes-1980-tyvek.jpg\"\n                alt=\"Billete experimental de Tyvek de 2 Gourdes de Haití, anverso arriba con retrato de François Duvalier, reverso abajo con el escudo de armas de Haití\"\n                width=\"564\"\n                height=\"555\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Haití</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banque de la République d'Haïti</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Deux Gourdes (2 Gourdes)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tyvek&reg; &mdash; sustrato sintético experimental de DuPont</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">American Bank Note Company (ABNC)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ley del 17 de agosto de 1979; emitido hacia 1980</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">156 &times; 65 mm aprox.</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-231A</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato del Dr. François Duvalier en óvalo central, flanqueado por medallones barrocos con el numeral &ldquo;2&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> Escudo de Armas de Haití al centro, con un cuadro de los artículos legales de emisión.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Grabado intaglio:</strong> alto relieve táctil característico de la maquinaria de ABNC en el retrato y las orlas.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración:</strong> doble número de serie simétrico en rojo carmín, impreso con fechador tipográfico independiente.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> tinta calcográfica azul oscuro con fondos de seguridad en rosa y ocre; reverso monocromático azul.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 50 GOURDES ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Cinquante Gourdes &middot; 1980</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Presidente Lysius Félicité Salomon &middot; Escudo de Armas de Haití</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom50 }}\"\n            data-zoom-trigger=\"haiti-50-gourdes-1980-tyvek\"\n            aria-label=\"Ampliar imagen del billete de 50 Gourdes\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/haiti-brh-50-gourdes-1980-tyvek.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/haiti-brh-50-gourdes-1980-tyvek.jpg\"\n                alt=\"Billete experimental de Tyvek de 50 Gourdes de Haití, anverso arriba con retrato del Presidente Lysius Salomon, reverso abajo con el escudo de armas de Haití\"\n                width=\"564\"\n                height=\"484\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Haití</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banque de la République d'Haïti</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cinquante Gourdes (50 Gourdes)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tyvek&reg; &mdash; sustrato sintético experimental de DuPont, precursor del polímero moderno</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">American Bank Note Company (ABNC)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ley del 17 de agosto de 1979; emitido entre 1980 y 1982</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">160 &times; 68 mm aprox.</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-235A (variantes Aa/Ab según prefijo de serie)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico: el Pionero Mundial del Dinero Plástico</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Antes de Australia, hubo Tyvek&reg;:</strong> impresos por American Bank Note Company entre 1980 y 1982, estos billetes de Haití figuran entre los primerísimos intentos mundiales de moneda plástica, junto a Costa Rica y la Isla de Man, casi una década antes de que Australia introdujera el polímero moderno en 1988.<sup style=\"font-size:12px;\">2,3</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Un experimento fallido por el clima:</strong> el Tyvek&reg; resultó extremadamente resistente a la rotura, pero el calor y la humedad tropical del Caribe hicieron que la tinta se corriera y se desprendiera con el uso, dificultando el reconocimiento de los billetes; el proyecto fue retirado de circulación tras un período relativamente breve.<sup style=\"font-size:12px;\">4,5</sup></p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato del Presidente Lysius Félicité Salomon Jeune (1815&ndash;1888), impulsor del sistema postal y fundador del Banco Nacional de Haití en el siglo XIX; dos grandes medallones con el número &ldquo;50&rdquo; flanquean el retrato.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> Escudo de Armas de Haití, con la palmera real coronada por el gorro frigio, rodeada de trofeos militares, cañones y banderas, bajo el lema &ldquo;L'Union Fait la Force&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Grabado intaglio multicapa:</strong> relieves mecánicos en los textos perimetrales y los marcos guilloché, con la textura táctil clásica de ABNC.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> tinta negra y gris oscuro con fondo de seguridad en rosa y ocre; reverso en tonalidades grisáceas profundas.</span>\n              </li>\n            </ul>\n          </div>\n\n          <div style=\"margin-top:44px; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <h3 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h3>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Numismatic News, &ldquo;The Road to Polymer Bank Notes&rdquo;: en 1955, Jim White, investigador de DuPont, descubrió el material posteriormente llamado Tyvek, un hilado de fibras de polietileno de alta densidad.</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">2. Numismatic News, íd.: &ldquo;Bank notes made of Tyvek were subsequently printed in the early 1980s by the American Bank Note Company for three countries: Haiti, Costa Rica, and the Isle of Man&hellip; In 1980, Haiti released its Tyvek notes.&rdquo;</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">3. Wikipedia, &ldquo;Polymer banknote&rdquo;: el polímero moderno fue desarrollado por el Reserve Bank of Australia y emitido por primera vez en 1988.</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">4. Coin Update, &ldquo;The Tyvek banknotes of Haiti&rdquo;: &ldquo;the hot and humid climate of Haiti (and Costa Rica) caused the ink to smear. After some time in circulation, many of the notes were difficult to recognize.&rdquo;</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">5. Mintage World, &ldquo;Haiti Banknotes Made of Tyvek&rdquo;: &ldquo;The experiment failed because of the hot and humid climate of Haiti causing the ink to smear. Over a period of time, they became difficult to recognise and hence were withdrawn.&rdquo;</p>\n          </div>\n        </div>\n      </section>\n\n    </div>\n  </main>\n\n  <sc-if value=\"{{ zoomOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n      style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n      onClick=\"{{ closeZoom }}\"\n      onWheel=\"{{ onWheel }}\"\n    >\n      <button\n        onClick=\"{{ closeZoom }}\"\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          onClick=\"{{ zoomOutHandler }}\"\n          disabled=\"{{ zoomOutDisabled }}\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">{{ zoomPercent }}</span>\n        <button\n          onClick=\"{{ zoomInHandler }}\"\n          disabled=\"{{ zoomInDisabled }}\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n        onClick=\"{{ stopPropagation }}\"\n        onPointerDown=\"{{ onPointerDown }}\"\n        onPointerMove=\"{{ onPointerMove }}\"\n        onPointerUp=\"{{ onPointerUp }}\"\n        onPointerLeave=\"{{ onPointerUp }}\"\n      >\n        <sc-if value=\"{{ isZoom1 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/haiti-brh-1-gourde-1980-tyvek.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/haiti-brh-1-gourde-1980-tyvek.jpg\"\n              alt=\"Billete de 1 Gourde, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n        <sc-if value=\"{{ isZoom2 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/haiti-brh-2-gourdes-1980-tyvek.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/haiti-brh-2-gourdes-1980-tyvek.jpg\"\n              alt=\"Billete de 2 Gourdes, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n        <sc-if value=\"{{ isZoom50 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/haiti-brh-50-gourdes-1980-tyvek.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/haiti-brh-50-gourdes-1980-tyvek.jpg\"\n              alt=\"Billete de 50 Gourdes, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  </sc-if>\n\n  \n\n</div>",
  "logic": "class Component extends DCLogic {\n  state = {\n    activeNote: null, // \"1\" | \"2\" | \"50\" | null\n    scale: 1,\n    offsetX: 0,\n    offsetY: 0,\n    dragging: false,\n    dragStartX: 0,\n    dragStartY: 0,\n    dragOffsetStartX: 0,\n    dragOffsetStartY: 0\n  };\n\n  triggers = {\n    \"1\": \"haiti-1-gourde-1980-tyvek\",\n    \"2\": \"haiti-2-gourdes-1980-tyvek\",\n    \"50\": \"haiti-50-gourdes-1980-tyvek\"\n  };\n\n  focusClose = () => {\n    const closeBtn = document.querySelector(\"[data-zoom-close]\");\n    if (closeBtn) { closeBtn.focus(); return; }\n    requestAnimationFrame(this.focusClose);\n  };\n\n  focusTrigger = (note) => {\n    const trigger = document.querySelector(`[data-zoom-trigger=\"${this.triggers[note]}\"]`);\n    if (trigger) trigger.focus();\n  };\n\n  openZoom = (note) => {\n    this.setState({ activeNote: note, scale: 1, offsetX: 0, offsetY: 0 });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusClose));\n  };\n\n  openZoom1 = () => this.openZoom(\"1\");\n  openZoom2 = () => this.openZoom(\"2\");\n  openZoom50 = () => this.openZoom(\"50\");\n\n  closeZoom = () => {\n    const note = this.state.activeNote;\n    this.setState({ activeNote: null });\n    requestAnimationFrame(() => requestAnimationFrame(() => this.focusTrigger(note)));\n  };\n\n  stopPropagation = (e) => e.stopPropagation();\n\n  zoomIn = () => {\n    this.setState(s => ({ scale: Math.min(4, Math.round((s.scale + 0.5) * 10) / 10) }));\n  };\n\n  zoomOut = () => {\n    this.setState(s => {\n      const next = Math.max(1, Math.round((s.scale - 0.5) * 10) / 10);\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onWheel = (e) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? -0.25 : 0.25;\n    this.setState(s => {\n      const next = Math.min(4, Math.max(1, Math.round((s.scale + delta) * 100) / 100));\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onPointerDown = (e) => {\n    if (this.state.scale <= 1) return;\n    this.setState({\n      dragging: true,\n      dragStartX: e.clientX,\n      dragStartY: e.clientY,\n      dragOffsetStartX: this.state.offsetX,\n      dragOffsetStartY: this.state.offsetY\n    });\n  };\n\n  onPointerMove = (e) => {\n    if (!this.state.dragging) return;\n    const dx = e.clientX - this.state.dragStartX;\n    const dy = e.clientY - this.state.dragStartY;\n    this.setState({ offsetX: this.state.dragOffsetStartX + dx, offsetY: this.state.dragOffsetStartY + dy });\n  };\n\n  onPointerUp = () => this.setState({ dragging: false });\n\n  onKeyDown = (e) => {\n    if (e.key === \"Escape\" && this.state.activeNote) this.closeZoom();\n  };\n\n  componentDidMount() {\n    document.addEventListener(\"keydown\", this.onKeyDown);\n    if (typeof document !== \"undefined\" && document.documentElement) {\n      document.documentElement.lang = \"es\";\n    }\n  }\n\n  componentWillUnmount() {\n    document.removeEventListener(\"keydown\", this.onKeyDown);\n  }\n\n  renderVals() {\n    const s = this.state;\n    const note = s.activeNote;\n    return {\n      zoomOpen: !!note,\n      isZoom1: note === \"1\",\n      isZoom2: note === \"2\",\n      isZoom50: note === \"50\",\n      openZoom1: this.openZoom1,\n      openZoom2: this.openZoom2,\n      openZoom50: this.openZoom50,\n      closeZoom: this.closeZoom,\n      stopPropagation: this.stopPropagation,\n      zoomInHandler: this.zoomIn,\n      zoomOutHandler: this.zoomOut,\n      onWheel: this.onWheel,\n      onPointerDown: this.onPointerDown,\n      onPointerMove: this.onPointerMove,\n      onPointerUp: this.onPointerUp,\n      zoomInDisabled: s.scale >= 4,\n      zoomOutDisabled: s.scale <= 1,\n      zoomPercent: Math.round(s.scale * 100) + \"%\",\n      imgTransform: `translate(${s.offsetX}px, ${s.offsetY}px) scale(${s.scale})`,\n      imgCursor: s.scale > 1 ? (s.dragging ? \"grabbing\" : \"grab\") : \"default\"\n    };\n  }\n}",
  "legacyFile": "billete-haiti-1-2-50-gourdes-tyvek.dc.html",
  "sourceHash": "36e5da05d8bd1e26"
}
