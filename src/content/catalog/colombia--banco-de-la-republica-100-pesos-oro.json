ight:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n              >&#43;</button>\n            </div>\n\n            <div\n              style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n            >\n              <picture>\n                <source srcset=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1969-specimen.webp\" type=\"image/webp\" />\n                <img data-zoom-image\n                  src=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1969-specimen.jpg\"\n                  alt=\"Billete ampliado\"\n                  draggable=\"false\"\n                  style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                />\n              </picture>\n            </div>\n\n            <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n          </div>\n        \n\n          <div data-zoom-dialog=\"1980\" hidden style=\"display:none\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-label=\"Billete ampliado: 1 de enero de 1980\"\n            style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n          >\n            <button\n              data-zoom-close\n              aria-label=\"Cerrar\"\n              style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n            >&times;</button>\n\n            <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n              <button\n                disabled=\"true\"\n                data-zoom-out aria-label=\"Alejar\"\n                style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n              >&minus;</button>\n              <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\" data-zoom-percent>100%</span>\n              <button\n                disabled=\"false\"\n                data-zoom-in aria-label=\"Acercar\"\n                style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n              >&#43;</button>\n            </div>\n\n            <div\n              style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n            >\n              <picture>\n                <source srcset=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1980-specimen.webp\" type=\"image/webp\" />\n                <img data-zoom-image\n                  src=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1980-specimen.jpg\"\n                  alt=\"Billete ampliado\"\n                  draggable=\"false\"\n                  style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                />\n              </picture>\n            </div>\n\n            <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n          </div>\n        \n\n          <div data-zoom-dialog=\"1983\" hidden style=\"display:none\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-label=\"Billete ampliado: 1 de enero de 1983\"\n            style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n          >\n            <button\n              data-zoom-close\n              aria-label=\"Cerrar\"\n              style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n            >&times;</button>\n\n            <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n              <button\n                disabled=\"true\"\n                data-zoom-out aria-label=\"Alejar\"\n                style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n              >&minus;</button>\n              <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\" data-zoom-percent>100%</span>\n              <button\n                disabled=\"false\"\n                data-zoom-in aria-label=\"Acercar\"\n                style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n              >&#43;</button>\n            </div>\n\n            <div\n              style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n            >\n              <picture>\n                <source srcset=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1983-specimen.webp\" type=\"image/webp\" />\n                <img data-zoom-image\n                  src=\"/uploads/colombia-banco-de-la-republica-100-pesos-oro-1983-specimen.jpg\"\n                  alt=\"Billete ampliado\"\n                  draggable=\"false\"\n                  style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                />\n              </picture>\n            </div>\n\n            <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n          </div>\n        \n\n        <div style=\"width:100%; max-width:760px;\">\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Diseño Común</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato de Francisco de Paula Santander, prócer y expresidente de la Nueva Granada, con la denominación &ldquo;100&rdquo; en las cuatro esquinas y la leyenda &ldquo;PAGARÁ AL PORTADOR &hellip; CIEN PESOS ORO&rdquo;, junto con la fecha de emisión y las firmas de Gerente y Secretario.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> viñeta del Capitolio Nacional de Bogotá, sede del Congreso de la República, salvo en la muestra de 1983 que retoma en cambio la Villa de Leyva.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Cuatro Especímenes, Cuatro Décadas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El ejemplar del <strong style=\"color:#1c1a15;\">7 de agosto de 1947</strong>, impreso por American Bank Note Company, lleva la sobreimpresión en inglés &ldquo;SPECIMEN&rdquo; propia de la producción ABNC de mediados de siglo para la banca centralizada colombiana.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El del <strong style=\"color:#1c1a15;\">2 de enero de 1969</strong>, de la Serie Y e impreso por Thomas De La Rue &amp; Company, Limited, mantiene el mismo diseño general con Santander en el anverso y el Capitolio Nacional en el reverso, con la sobreimpresión roja &ldquo;SPECIMEN&rdquo; y numeración en ceros repetida en ambas esquinas.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El del <strong style=\"color:#1c1a15;\">1 de enero de 1980</strong>, también impreso por Thomas De La Rue &amp; Company, Limited, lleva la palabra &ldquo;SPECIMEN&rdquo; sobreimpresa en rojo en ambas caras, dos óvalos &ldquo;NO VALUE&rdquo;, el sello circular de la casa impresora, la inscripción &ldquo;SPECIMEN N.&deg; 027&rdquo; y numeración de serie en ceros, además de pequeñas perforaciones de cancelación &mdash;marcas propias de los ejemplares de muestra o archivo, nunca puestos en circulación.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">El del <strong style=\"color:#1c1a15;\">1 de enero de 1983</strong> refleja ya la nacionalización editorial de la moneda colombiana, con la leyenda castellana &ldquo;MUESTRA SIN VALOR&rdquo; y un reverso que sustituye el Capitolio Nacional por la Villa de Leyva, población colonial emblemática del patrimonio colombiano.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Los Especímenes como Herramienta Bancaria</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Los especímenes como estos eran distribuidos por la casa impresora entre bancos centrales corresponsales y archivos propios para aprobación de diseño, lo que explica su excelente estado de conservación frente a los billetes de circulación ordinaria.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legado para Coleccionistas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Reunir el Cien Pesos Oro de distintos años de emisión permite trazar, en un solo billete, la evolución de las firmas, los impresores y las variantes de seguridad del papel moneda colombiano durante la segunda mitad del siglo XX &mdash;una forma de coleccionismo tan accesible como reveladora de la historia institucional del Banco de la República.</p>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Pick, Albert. <em>Standard Catalog of World Paper Money.</em></li>\n              <li>Hernández, Pedro Pablo. <em>Monedas y Billetes de Colombia.</em></li>\n              <li>Restrepo, Jorge Emilio. <em>Coins of Colombia.</em></li>\n              <li>Heritage Auctions — <a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Numista — <a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Banco de la República — <a href=\"https://www.banrep.gov.co\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">banrep.gov.co<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
