ba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación Facial</span>\n              <span style=\"font-size:19px; color:#221f19;\">$2.00 (dos dólares — moneda de curso legal estadounidense)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">Aprox. 6&quot; &times; 2,5&quot; (152 &times; 64 mm)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Edición</span>\n              <span style=\"font-size:19px; color:#221f19;\">Edición de arte — firmada a mano por Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firma</span>\n              <span style=\"font-size:19px; color:#221f19;\">Firmado a mano por el artista Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Clasificación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Rency Art / exonumia contemporánea — <em>no</em> es una emisión bancaria catalogable en Pick ni Friedberg</span>\n            </div>\n   