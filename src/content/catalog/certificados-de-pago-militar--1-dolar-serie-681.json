  "styles": "body { margin: 0; }\n    a { color: #6b521f; text-decoration: underline; text-decoration-color: rgba(138,109,59,0.35); }\n    a:hover { color: #5c4826; }\n    ::selection { background: rgba(138,109,59,0.25); }",
  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  <main data-pagefind-meta=\"url:/coleccion/certificados-de-pago-militar/1-dolar-serie-681/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"MPC Serie 681 — Un Dólar (Vietnam, 1969–1970)\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/certificados-de-pago-militar/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Certificados de Pago Militar (MPC)</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Estados Unidos &middot; Military Payment Certificate &middot; Serie 681</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">MPC Serie 681 &mdash; Un Dólar (Vietnam, 1969&ndash;1970)</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0 0 16px;\">$1.00 &middot; 11 ago. 1969 &ndash; 7 oct. 1970 &middot; Uso exclusivo en Vietnam</p>\n\n          <p style=\"font-size:19px; line-height:1.55; color:#332e22; margin:0;\">Es la serie que los veteranos de Vietnam reconocen de inmediato: piloto de la USAF al anverso y F-100 Super Sabre al reverso. Circuló solo en Vietnam de 1969 a 1970, en los últimos años del programa MPC.</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos &mdash; circulación exclusiva en Vietnam</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento de Defensa de los EE. UU. (<em>U.S. Department of Defense</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Certificado de Pago Militar (<em>Military Payment Certificate</em>, MPC) &mdash; scrip para personal autorizado; no billete del Tesoro</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">$1.00 (Un Dólar)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Vigencia</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie 681 &mdash; emitida el 11 de agosto de 1969; retirada el 7 de octubre de 1970</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bureau of Engraving and Printing (BEP) &mdash; litografía en color (offset), no intaglio</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Fr. M915 &middot; Schwan S915-1 &middot; Pick M79</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tirada</span>\n              <span style=\"font-size:19px; color:#221f19;\">22.400.000 billetes regulares de $1. El catálogo Greensheet/CPG registra esa tirada; el serial regular más alto documentado es C22400000C</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Reemplazos</span>\n              <span style=\"font-size:19px; color:#221f19;\">S915-1r, numerados hasta C00560000 (560.000). Sustituyen regulares defectuosos; no se suman a los 22,4 millones puestos en circulación</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">112 &times; 66 mm (formato estándar del $1 MPC; 70 billetes por pliego)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">UNC ordinario no es raro. Escasez significativa desde PMG/PCGS 67; 68 es rareza de grado</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Población PMG</span>\n              <span style=\"font-size:19px; color:#221f19;\">S915-1: 568 ejemplares; 48 en 67 y solo 2 superiores (máximo 68 EPQ). Reemplazos S915-1r: 14 certificados. Instantánea, no medida completa de supervivencia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Valoración</span>\n              <span style=\"font-size:19px; color:#221f19;\">Greysheet/CPG (ago. 2026): aprox. 70 USD en grado 65 y 195 USD en grado 67, emisión regular. Valoración de catálogo, no oferta de compra</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Conservación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Sin certificar. Uncirculated plausible en fotografías, no confirmado</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie / Placa</span>\n              <span style=\"font-size:19px; color:#221f19;\">C10102847C &middot; placa 3 &middot; emisión regular S915-1 (prefijo y sufijo C)</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"mpc-681-1\"\n            aria-label=\"Ampliar imagen del certificado de pago militar Serie 681\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/mpc-series-681-1-dollar-c10102847.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/mpc-series-681-1-dollar-c10102847.jpg\"\n                alt=\"Certificado de pago militar de un dólar, Serie 681: anverso con piloto de la USAF y reverso con cuatro F-100 Super Sabre en formación\"\n                width=\"900\"\n                height=\"1125\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\" aria-hidden=\"true\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Certificado ampliado\"\n              data-zoom-dialog=\"mpc-681-1\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/mpc-series-681-1-dollar-c10102847.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/mpc-series-681-1-dollar-c10102847.jpg\"\n                    alt=\"MPC Serie 681 de un dólar, vista ampliada del anverso y reverso\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastre para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">La Serie 681 rompió con la tradición alegórica del programa MPC. Donde las series anteriores recurrían a figuras simbólicas, esta muestra al personal y al material de las fuerzas armadas estadounidenses: un piloto de la USAF en el anverso, cuatro F-100 Super Sabre en el reverso. Es la razón por la que hoy es la serie que los veteranos de Vietnam reconocen de inmediato.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Circuló exclusivamente en Vietnam del 11 de agosto de 1969 al 7 de octubre de 1970. Sustituyó a la Serie 661 en un <a href=\"/glosario/#c-day\"><em>C-Day</em></a> no anunciado &mdash;el cambio se ejecutaba sin aviso previo, precisamente para que nadie pudiera acumular la serie saliente&mdash; y fue a su vez reemplazada por la <a href=\"/coleccion/certificados-de-pago-militar/20-dolares-serie-692/\">Serie 692</a>, última emisión oficial del programa.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Como el resto de los MPC, estos billetes solo podían usarse en establecimientos militares por personal autorizado. Eran convertibles a moneda local al salir de permiso &mdash;pero no a la inversa&mdash; y a dólares estadounidenses únicamente al abandonar la zona MPC. El mecanismo limitaba el mercado negro de divisas y protegía la economía local del exceso de dólares.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Rareza en Uncirculated</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El salto de calidad &mdash;y de precio&mdash; se concentra en los grados certificados más altos. La tabla resume la rareza práctica de la emisión regular.</p>\n            <div style=\"overflow-x:auto; margin:0 0 16px; -webkit-overflow-scrolling:touch;\">\n              <table style=\"width:100%; min-width:28rem; border-collapse:collapse; font-size:17px; line-height:1.5; color:#221f19;\">\n                <caption style=\"caption-side:top; text-align:left; font-size:15px; color:#5c4e33; margin:0 0 10px; font-style:italic;\">Rareza práctica del $1 Serie 681 regular (S915-1) en grados Uncirculated certificados</caption>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.18); font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Grado certificado</th>\n                    <th scope=\"col\" style=\"text-align:left; padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.18); font-size:13px; letter-spacing:0.08em; text-transform:uppercase; color:#5c4e33; font-weight:600;\">Rareza práctica</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.12); font-weight:600; color:#1c1a15;\">UNC 60–62</th>\n                    <td style=\"padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.12); color:#332e22;\">Disponible; no es raro</td>\n                  </tr>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.12); font-weight:600; color:#1c1a15;\">Choice UNC 63–64</th>\n                    <td style=\"padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.12); color:#332e22;\">Disponible, cada vez más buscado</td>\n                  </tr>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.12); font-weight:600; color:#1c1a15;\">Gem UNC 65 EPQ</th>\n                    <td style=\"padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.12); color:#332e22;\">Moderadamente escaso</td>\n                  </tr>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.12); font-weight:600; color:#1c1a15;\">Gem UNC 66 EPQ</th>\n                    <td style=\"padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.12); color:#332e22;\">Más escaso, pero se obtiene con regularidad</td>\n                  </tr>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; border-bottom:1px solid rgba(10,10,9,0.12); font-weight:600; color:#1c1a15;\">Superb Gem UNC 67 EPQ</th>\n                    <td style=\"padding:10px 0; border-bottom:1px solid rgba(10,10,9,0.12); color:#332e22;\">Genuinamente escaso</td>\n                  </tr>\n                  <tr>\n                    <th scope=\"row\" style=\"text-align:left; padding:10px 12px 10px 0; font-weight:600; color:#1c1a15;\">Superb Gem UNC 68 EPQ</th>\n                    <td style=\"padding:10px 0; color:#332e22;\">Muy raro / territorio de grado máximo</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Los Gem ordinarios siguen accesibles; la prima se dispara a partir de 67 EPQ, como refleja la valoración de catálogo.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">El censo de PMG (arriba) sitúa el umbral: el 67 es escaso, no extremadamente raro; el 68 es una rareza de conservación. Las poblaciones cambian, y PMG advierte que no miden por sí solas la rareza superviviente.</p>\n            <aside aria-labelledby=\"mpc681-claim-heading\" style=\"margin-top:22px; padding:18px 20px; border:1px solid rgba(107,82,31,0.38); background:rgba(138,109,59,0.10);\">\n              <h3 id=\"mpc681-claim-heading\" style=\"font-size:20px; font-weight:600; color:#1c1a15; margin:0 0 10px; font-style:normal;\">Sobre este valor</h3>\n              <p style=\"margin:0 0 8px; font-size:14px; letter-spacing:0.06em; text-transform:uppercase; color:#5c4e33;\">Tipo de cifra: <span style=\"text-transform:none; letter-spacing:0; font-weight:600; color:#1c1a15;\">Valoración de catálogo</span></p>\n              <p style=\"margin:0 0 10px; font-size:17px; line-height:1.6; color:#332e22;\">Se trata de una valoración de catálogo o guía de precios de referencia (Greysheet/CPG). No equivale a una oferta de compra ni a un remate cerrado; el mercado puede situarse por encima o por debajo.</p>\n              <p style=\"margin:0 0 4px; font-size:15px; color:#332e22;\"><strong style=\"color:#1c1a15;\">Moneda:</strong> USD</p>\n              <p style=\"margin:0 0 12px; font-size:15px; color:#332e22;\"><strong style=\"color:#1c1a15;\">Fecha de la valoración citada:</strong> <time datetime=\"2026-08\">agosto de 2026</time></p>\n              <p style=\"margin:0; font-size:15px; color:#5c4e33;\"><a href=\"/editorial/\" style=\"color:#6b521f;\">Política editorial y de valoración</a></p>\n            </aside>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Este ejemplar</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">El serial C10102847C termina en sufijo C: es la emisión regular S915-1, no la variedad de reemplazo. Los reemplazos de MPC se identifican por la ausencia de esa letra final.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Por las fotografías, el billete se ve nítido y un grado Uncirculated es plausible. No se puede confirmar con alta certeza: la funda de plástico, el brillo y el ángulo de cámara pueden ocultar un pliegue leve, una marca de conteo, un planchado o una alteración de superficie. PMG define los grados 60–64 como Uncirculated con distinto manejo o centrado; 65 y superiores exigen centrado por encima de la media y Exceptional Paper Quality original. Un solo pliegue a través del diseño suele pasar el billete a About Uncirculated.</p>\n          </section>\n\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Esquema de Color</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> impresión principal en púrpura sobre fondo de guilloché rosa-terracota, con el retrato del piloto a la derecha y un rosetón estrellado a la izquierda bajo el número de serie.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> jets en naranja-rojo sobre un campo de líneas horizontales púrpura y estelas blancas; franjas rojas superior e inferior con el texto reglamentario del MPC.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Retrato e Imágenes del Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Derecha:</strong> piloto de la Fuerza Aérea de EE. UU. con casco de vuelo, gafas sobre la frente y máscara de oxígeno al cuello, en un óvalo grabado. Continúa el tema USAF de las fracciones de la misma serie (submarino <em>Thomas Edison</em> y el paseo espacial de Edward White).</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Leyendas:</strong> &ldquo;SERIES 681&rdquo; sobre el retrato; numeral &ldquo;1&rdquo; en las cuatro esquinas; &ldquo;ONE DOLLAR&rdquo; en cápsula inferior; número de serie en negro a la izquierda sobre el rosetón estrellado.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\" aria-hidden=\"true\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Texto reglamentario:</strong> franja inferior &ldquo;MILITARY PAYMENT CERTIFICATE&rdquo; y la cláusula de uso exclusivo en establecimientos militares por personal autorizado.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Imágenes del Reverso</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Cuatro cazas F-100 Super Sabre de la USAF en formación diagonal ascendente, con &ldquo;USAF&rdquo; en las alas y el número de aparato visible en el fuselaje. La viñeta se asocia a los Thunderbirds, que volaron el F-100 entre 1956 y 1968.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Numeral &ldquo;1&rdquo; en blanco con contorno rojo en las esquinas superior izquierda e inferior derecha; &ldquo;ONE DOLLAR&rdquo; en cápsula a la izquierda; mismas franjas reglamentarias en rojo.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Firmas y Sellos</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">A diferencia de los billetes del Tesoro o de la Reserva Federal, los MPC no llevan firmas de tesorero ni secretario del Tesoro, ni el sello del Departamento del Tesoro: se emitían bajo autoridad del Departamento de Defensa.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Legado para Coleccionistas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Para muchos coleccionistas de papel de Vietnam, el $1 de la Serie 681 es la puerta de entrada al programa MPC. Es asequible, se consigue con regularidad y concentra en un solo billete todo lo que distingue a la serie: el retrato del piloto, los cazas en formación y el esquema púrpura sobre guilloché rosa que no se repite en ninguna otra emisión.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">También es una pieza de set. La Serie 681 completa &mdash;de 5 centavos a 20 dólares&mdash; es armable sin una inversión desproporcionada, algo poco habitual en emisiones militares. La dificultad no está en encontrar los billetes, sino en el grado: como se detalla arriba, el salto de calidad se paga a partir de 67 EPQ.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Para quien busque el escalón siguiente, la variedad de reemplazo (S915-1r) es el objetivo natural: comparte diseño y denominación, pero su supervivencia certificada es de otro orden. Este ejemplar es emisión regular.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Véase también el <a href=\"/coleccion/certificados-de-pago-militar/10-dolares-serie-641/\">$10 de la Serie 641</a> y el <a href=\"/coleccion/certificados-de-pago-militar/20-dolares-serie-692/\">$20 de la Serie 692</a>.</p>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Bureau of Engraving and Printing &mdash; <a href=\"https://www.bep.gov/media/1041/download?inline=\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates 1946&ndash;1973 (PDF; se inicia una descarga) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Friedberg, Arthur L. y Ira S. <em>Paper Money of the United States</em> &mdash; Fr. M915. <a href=\"https://www.coin-currency.com/page8.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">The Coin &amp; Currency Institute <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Schwan, Fred. <em>Comprehensive Catalog of Military Payment Certificates</em> &mdash; S915-1 (regular) y S915-1r (reemplazo)</li>\n              <li>Schwan, Fred. <em>Military Payment Certificates</em> (1997), ISBN 0-931960-54-1</li>\n              <li>ANA / Fred Schwan &mdash; <a href=\"https://www.money.org/uploads/Mili.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military Payment Certificates (PDF; se inicia una descarga) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Currency Price Guide (Greysheet/CPG) &mdash; tirada regular de 22.400.000; cotización aprox. 70 USD (grado 65) y 195 USD (grado 67), agosto de 2026. <a href=\"https://www.greysheet.com/publications/greensheet\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Greensheet / CPG <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>PMG Registry &mdash; población S915-1 (568 ejemplares; 48 en 67; 2 superiores; máximo 68 EPQ) y 14 reemplazos S915-1r certificados. Instantánea; las cifras cambian. <a href=\"https://notes.www.collectors-society.com/registry/notes/SlotScoreDetail.aspx?SlotID=5896\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Ficha S915-1 (serial más alto C22400000C) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>PMG &mdash; <a href=\"https://www.pmgnotes.com/paper-money-grading/grading-scale/\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Escala de grados (UNC 60&ndash;64 frente a 65+ EPQ) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>PMG &mdash; <a href=\"https://www.pmgnotes.com/news/article/4845/aim-high-with-military-payment-certificates/\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Aim High with Military Payment Certificates <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a> (diseño de la Serie 681)</li>\n              <li>Art-Hanoi &mdash; <a href=\"https://art-hanoi.com/collection/vnpaper/681.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">MPC Series 681 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a> (Pick M79)</li>\n              <li>CoinWeek / PCGS &mdash; <a href=\"https://coinweek.com/vietnam-era-1969-military-payment-certificate-series-681/\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Vietnam-Era 1969 Military Payment Certificate Series 681 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>CoinWeek &mdash; <a href=\"https://coinweek.com/money-of-necessity-u-s-military-payment-certificates/\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Money of Necessity: U.S. Military Payment Certificates <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>World Banknotes &amp; Coins Museum &mdash; <a href=\"https://www.worldbanknotescoins.com/2014/11/us-military-payment-certificate-one-dollar-mpc-series-681.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Series 681 $1 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Banknote.ws &mdash; <a href=\"http://banknote.ws/COLLECTION/countries/AME/USA/USA-MIL/USAM0079.htm\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">P-M79 Series 681 $1 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Society of Paper Money Collectors &mdash; <a href=\"https://collectingpapermoney.spmc.org/wiki/Collecting_U.S._Military_Payment_Certificates_%28MPC%29\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Collecting U.S. Military Payment Certificates (MPC) <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Wikipedia &mdash; <a href=\"https://en.wikipedia.org/wiki/Military_payment_certificate\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">Military payment certificate <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
