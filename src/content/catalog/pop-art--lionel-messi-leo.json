  </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Title</span>\n              <span style=\"font-size:19px; color:#221f19;\">Leo Messi — You Have To Fight To Reach Your Dream — &ldquo;Life is Beautiful&rdquo;<span style=\"display:block; margin-top:6px; font-style:italic; color:#4a4331;\">Leo Messi — You have to fight to achieve your dream — &ldquo;Life is beautiful&rdquo;</span></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Year</span>\n              <span style=\"font-size:19px; color:#221f19;\">2022</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Medium</span>\n              <span style=\"font-size:19px; color:#221f19;\">Fine-art giclée on a genuine legal-tender two-dollar bill (<em>Fine Art Giclée on Genuine $2 U.S. Bill</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Face denomination</span>\n              <span style=\"font-size:19px; color:#221f19;\">$2.00 (two dollars — U.S. legal tender)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensions</span>\n              <span style=\"font-size:19px; color:#221f19;\">Approx. 6&quot; &times; 2.5&quot; (152 &times; 64 mm)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Edition</span>\n              <span style=\"font-size:19px; color:#221f19;\">Limited edition numbered 2/222 — 222 copies</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Signature</span>\n              <span style=\"font-size:19px; color:#221f19;\">Hand-signed by artist Rency</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Classification</span>\n              <span style=\"font-size:19px; color:#221f19;\">Rency Art / contemporary exonumia —<em>no</em>is a bank issue catalogable in neither Pick nor Friedberg</span>\n            </div>\n            <div style=\"border-bottom:1px solid rgba(10,10,9,0.12);\"></div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Enlarged banknote\"\n              data-zoom-dialog=\"rency-lionel-messi-scan\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button data-zoom-close aria-label=\"Close\" style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\">&times;</button>\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button disabled=\"true\" aria-label=\"Zoom out\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button disabled=\"false\" aria-label=\"Zoom in\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&#43;</button>\n              </div>\n              <div style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\">\n                <picture>\n                  <source srcset=\"/uploads/rency-lionel-messi-scan-v3.webp\" type=\"image/webp\" />\n                  <img src=\"/uploads/rency-lionel-messi-scan-v3.webp\" alt=\"Lionel Messi — Leo — enlarged view\" draggable=\"false\" style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\" />\n                </picture>\n              </div>\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Drag to move &middot; Mouse wheel to zoom</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">About the Work</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Limited and highly coveted edition of<strong style=\"color:#1c1a15;\">Rency Art</strong>on a genuine two-dollar bill, dedicated to the greatest soccer player in history. Each example is numbered,<strong style=\"color:#1c1a15;\">Hand-signed by the artist</strong>and includes an original inscription &ldquo;Leo 2022&rdquo; traced on the reverse.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">This giclée work combines the rebellious spirit of graffiti and pop art with officially recognized legal tender, creating a truly unique piece. Rency's vibrant colors and distinctive style transform the two-dollar bill into a collector's item that speaks to the tradition of the<em>street art</em>anonymous.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Rency is an elusive, highly sought-after figure in the street-art world who remains anonymous in the tradition of other celebrated urban artists. The edition is limited to 222 examples numbered 1 through 222; numbers were originally assigned at random, making each piece a distinct example within the series.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">The Notophilia copy is preserved in perfect condition. These works are usually presented in a transparent display carrier (approx. 6&quot; &times; 3&quot;) to protect and display the piece.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Obverse</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Portrait of Lionel Messi:</strong>Vibrantly colored pop art giclée on the genuine two-dollar bill, with Rency's signature aesthetic.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Phrase “Life is Beautiful”:</strong>part of the artist's thematic series combining motivational phrases with pop iconography.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Pop art graffiti colors:</strong>intense palette superimposed on the original intaglio design of the legal tender bill.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverse</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Inscription “Leo 2022”:</strong>dedication drawn by hand by the artist on the back of the bill.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Rency Signature:</strong>personally hand signed by the artist.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Edition numbering:</strong>numbered copy within the limited edition of 222 pieces.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Sources</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Descriptive material from the original distributor of the Lionel Messi Rency Art $2 Bill edition</li>\n              <li>Private collection Notofilia.com</li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n</div>",
