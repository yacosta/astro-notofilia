d rgba(10,10,9,0.12);\">\n            <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Numeración</span>\n            <span style=\"font-size:19px; color:#221f19;\">Serie A, No. 2002</span>\n          </div>\n          <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n            <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n            <span style=\"font-size:19px; color:#221f19;\">P. L. Gust (President) · O. L. Gust (Treasurer)</span>\n          </div>\n          <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n            <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n            <span style=\"font-size:19px; color:#221f19;\">Shafer WI-100-1a</span>\n          </div>\n        </div>\n<button\n            data-zoom-trigger=\"ringling-1\"\n            aria-label=\"Ampliar imagen del scrip de un dólar\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/ringling-bros-50th-anniversary-baraboo-1-dollar-640.webp 640w, /uploads/ringling-bros-50th-anniversary-baraboo-1-dollar.webp 1400w\" sizes=\"(max-width: 792px) 100vw, 712px\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/ringling-bros-50th-anniversary-baraboo-1-dollar.jpg\"\n                alt=\"Scrip del 50º aniversario de Ringling Bros. de un dólar, Baraboo, Wisconsin: anverso con el retrato conjunto de los cinco hermanos Ringling (arriba) y reverso verde del Golden Jubilee con la carpa del circo, un tigre y un león (abajo), 1933\"\n                width=\"1400\"\n                height=\"1511\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — imagen de tipo; ejemplar de colección Serie A Nº 2002</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Scrip de un dólar ampliado\"\n              data-zoom-dialog=\"ringling-1\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button disabled=\"\" aria-label=\"Alejar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\"></span>\n                <button disabled=\"\" aria-label=\"Acercar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&#43;</button>\n              </div>\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/ringling-bros-50th-anniversary-baraboo-1-dollar.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/ringling-bros-50th-anniversary-baraboo-1-dollar.jpg\"\n                    alt=\"Scrip de un dólar de Ringling Bros., vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:; user-select:none;\"\n                  />\n                </picture>\n              </div>\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        \n\n        <section style=\"margin-top:44px;\">\n          <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Diseño</h3>\n          <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> a diferencia de los fraccionarios, presenta el retrato conjunto (jugate) de los cinco hermanos Ringling en óvalo a la izquierda, la denominación &ldquo;ONE DOLLAR&rdquo; en cartucho central, leones en las esquinas superiores y elefantes en las inferiores, con letra de serie A en azul. Firmas de P. L. Gust y O. L. Gust. <strong style=\"color:#1c1a15;\">Reverso:</strong> viñeta verde compartida con las demás denominaciones de la serie (véase &ldquo;Diseño Común del Reverso&rdquo; más abajo).</p>\n        </section>\n\n      </section>\n\n<section style=\"max-width:760px; margin:56px auto 0; padding-top:44px; border-top:1px solid rgba(10,10,9,0.15);\">\n        <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Diseño Común del Reverso</h2>\n        <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Las cuatro denominaciones (5&cent;, 10&cent;, 15&cent; y $1) comparten un reverso idéntico impreso en tinta verde: un tigre de Bengala y un león erguidos flanquean una viñeta central de la carpa principal (&ldquo;Big Top&rdquo;) del circo, coronada por un óvalo con &ldquo;50th ANNIVERSARY&rdquo; y las fechas &ldquo;1883&rdquo; y &ldquo;1933&rdquo;. Debajo, la leyenda &ldquo;GOLDEN JUBILEE CELEBRATING THE FOUNDING OF RINGLING BROS. SHOWS AT BARABOO, WIS.&rdquo; resume el propósito conmemorativo de la emisión.</p>\n      </section>\n\n      <blockquote style=\"max-width:760px; margin:44px auto 0; padding:28px 0 0; border-top:1px solid rgba(10,10,9,0.15);\">\n        <p style=\"font-size:20px; font-style:italic; line-height:1.7; color:#4a4331; margin:0 0 10px;\">Ringling Bros. Circus se fundó en Baraboo en 1883, cuando los cinco hermanos Ringling presentaron su primer espectáculo itinerante en la ciudad. Cincuenta años después, en plena Gran Depresión, el circo &mdash;ya fusionado con Barnum &amp; Bailey desde 1919&mdash; regresó a su pueblo natal para una función especial de aniversario. La Cámara de Comercio aprovechó la ocasión para emitir este scrip, inyectando cerca de $50,000 en circulación local y dejando, de paso, uno de los conjuntos de exonumia circense más codiciados por los coleccionistas de memorabilia del &ldquo;Greatest Show on Earth&rdquo;.</p>\n        <span style=\"font-size:14px; letter-spacing:0.08em; color:#5c4e33;\">&mdash; Nota de contexto histórico</span>\n      </blockquote>\n\n      <section style=\"max-width:760px; margin:32px auto 0; padding-top:24px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n        <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n          <li>Baraboo Circus World Museum &mdash; Historical Archives</li>\n          <li>Heritage Auctions — <a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n          <li>Numista — <a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n        </ul>\n      </section>\n\n    </div>\n  </main>\n\n  \n\n</div>",
