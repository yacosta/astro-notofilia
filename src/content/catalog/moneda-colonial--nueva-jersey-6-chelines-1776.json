  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/moneda-colonial/nueva-jersey-6-chelines-1776/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Colonia de Nueva Jersey — Seis Chelines (1776)\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/moneda-colonial/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Moneda Colonial</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Colonia de Nueva Jersey &middot; Burlington &middot; 1776</span>\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Colonia de Nueva Jersey</h1>\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Seis Chelines &middot; Bill of Credit, en vísperas de la independencia</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Colonia</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colonia de Nueva Jersey (actual Estados Unidos)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Seis Chelines (6s)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Papel de trapo de época</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Isaac Collins, Burlington, Nueva Jersey</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">25 de marzo de 1776, decimocuarto año del reinado de Jorge III</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmantes</span>\n              <span style=\"font-size:19px; color:#221f19;\">Jo. Johnston &middot; Rob. Smith &middot; Jo. Smyth</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick/Friedberg n.&deg; NJ-178</span>\n            </div>\n          </div>\n<button\n            data-zoom-trigger=\"newjersey-6-shillings-1776\"\n            aria-label=\"Ampliar imagen del billete\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/newjersey-6-shillings-1776-colonial.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/newjersey-6-shillings-1776-colonial.jpg\"\n                alt=\"Billete colonial de Seis Chelines de Nueva Jersey, anverso arriba con sello rojo estampado y firmas manuscritas, reverso abajo con la impresión de una hoja natural y la advertencia To counterfeit is Death\"\n                width=\"564\"\n                height=\"696\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Los últimos meses bajo la Corona:</strong> este billete se emitió el 25 de marzo de 1776, apenas unos meses antes de la Declaración de Independencia de julio de ese año, todavía bajo la autoridad formal del rey Jorge III &mdash;lo que lo convierte en un testimonio de los últimos meses de la moneda colonial británica en Norteamérica.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">La hoja de Benjamin Franklin:</strong> el reverso presenta la impresión de una hoja natural, una técnica de transferencia de nervaduras foliares pionera de Benjamin Franklin y su socio de imprenta. Cada hoja tiene un patrón de venas microscópicamente único e imposible de replicar a mano, lo que la convirtió en una de las medidas anti-falsificación más efectivas del papel moneda colonial americano.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> &ldquo;THIS BILL of Six Shillings Proclamation, is emitted by a LAW of the Colony of NEW-JERSEY, passed in the Fourteenth Year of the Reign of his Majesty King GEORGE the Third. Dated MARCH 25, 1776.&rdquo;</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Sello estampado en rojo:</strong> diseño circular de seguridad en tinta roja en el margen izquierdo, junto al número de serie y las firmas manuscritas de los tres funcionarios coloniales.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> impresión detallada de una hoja natural al centro, con el texto &ldquo;Printed by Isaac Collins in New-Jersey, Burlington&rdquo; y la advertencia legal &ldquo;To counterfeit is Death&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Bordes ornamentales:</strong> filas de rosetas y grecas geométricas repetidas en los cuatro márgenes de ambas caras, típicas de la tipografía colonial de imprenta.</span>\n              </li>\n            </ul>\n          </div>\n\n          <div style=\"margin-top:44px; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Referencia de catálogo según Eric P. Newman, <em>The Early Paper Money of America</em>, y el sistema Friedberg de billetes coloniales y continentales de EE. UU. (designación NJ-178).</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">2. La técnica de impresión de hojas naturales como medida anti-falsificación es ampliamente documentada como una innovación de la imprenta de Benjamin Franklin, adoptada por varias colonias americanas —incluida Nueva Jersey— en sus emisiones de papel moneda del siglo XVIII.</p>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n     \n     data-zoom-dialog=\"note-1\" hidden class=\"catalog-zoom-dialog\">\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"/uploads/newjersey-6-shillings-1776-colonial.webp\" type=\"image/webp\" />\n          <img\n            src=\"/uploads/newjersey-6-shillings-1776-colonial.jpg\"\n            alt=\"Billete colonial de Nueva Jersey, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
