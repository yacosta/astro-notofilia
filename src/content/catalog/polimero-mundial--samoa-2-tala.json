  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/polimero-mundial/samoa-2-tala/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Central Bank of Samoa — 2 Tala (Specimen)\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/polimero-mundial/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Billetes de Polímero Mundial</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Billetes de Polímero Mundial &middot; Samoa</span>\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Central Bank of Samoa</h1>\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">2 Tala &middot; Ejemplar Specimen &middot; Jubileo de Oro de Malietoa Tanumafili II</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"samoa-2-tala-specimen\"\n            aria-label=\"Ampliar imagen del billete\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/samoa-central-bank-2-tala-1990-polimero-specimen.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/samoa-central-bank-2-tala-1990-polimero-specimen.jpg\"\n                alt=\"Billete specimen de 2 Tala de polímero del Central Bank of Samoa, anverso arriba con retrato de Malietoa Tanumafili II y sobreimpresión SPECIMEN, reverso abajo con escena familiar samoana en un fale tradicional\"\n                width=\"564\"\n                height=\"569\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Samoa (Samoa Occidental)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Central Bank of Samoa (Faletupe Tutotonu o Samoa)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Dos Tala (Lua Tala / Two Tala) &mdash; ejemplar specimen, no de circulación</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg;</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Note Printing Australia (NPA), Melbourne</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">29 de septiembre de 1991 (fechado 1990 ND en la nota original)<sup style=\"font-size:12px;\">1</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmante</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tuilaepa Sailele Malielegaoi (Ministro de Finanzas)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">140 &times; 72 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Hito Numismático</span>\n              <span style=\"font-size:19px; color:#221f19;\">Primer y único billete de polímero emitido por Samoa hasta la serie de De La Rue de 2008; retirado de circulación en 2011<sup style=\"font-size:12px;\">2</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-31 (variantes a&ndash;e según año de reimpresión)</span>\n            </div>\n          </div>\n\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Un jubileo de oro:</strong> el billete se emitió para conmemorar el Jubileo de Oro &mdash;el 50.&deg; aniversario&mdash; de Malietoa Tanumafili II como Jefe de Estado (O le Ao o le Malo) de Samoa, cargo que ocupó desde la independencia del país en 1962 hasta su fallecimiento en 2007.<sup style=\"font-size:12px;\">1</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">La nota plástica de mayor permanencia:</strong> puesto en circulación en 1990/91, este 2 Tala se convirtió en uno de los billetes de polímero de mayor duración en el mundo, reimprimiéndose con variaciones menores al menos siete veces antes de su retiro definitivo en 2011, cuando fue reemplazado por una moneda de 2 Tala.<sup style=\"font-size:12px;\">3</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Un ejemplar de muestra:</strong> este ejemplar particular lleva la sobreimpresión oficial &ldquo;SPECIMEN&rdquo; en tinta roja y numeración en ceros (o el bloque &ldquo;SPECIMEN No 0899&rdquo; en el reverso), reservada para el control interno de la banca central y nunca puesta en circulación como moneda de curso legal.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato grabado de Malietoa Tanumafili II (1913&ndash;2007); al fondo izquierdo, un paisaje con viviendas circulares tradicionales (fale) frente a una iglesia costera.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> escena comunitaria samoana con una familia y ancianos reunidos en un fale abierto, sobre esteras tejidas; arriba a la derecha, el Escudo de Armas de Samoa (cruz cristiana sobre mapa estrellado, rodeado de ramas de olivo).</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Ventana de polímero estilizada:</strong> apertura transparente con la forma de un fale o cuenco tradicional samoano, grabada en relieve óptico mate.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Registro perfecto traslúcido:</strong> un medallón circular blanco en el margen izquierdo encierra una estrella azul de cinco puntas que coincide con precisión al mirar la nota a contraluz.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Sobreimpresión de muestra:</strong> texto &ldquo;SPECIMEN&rdquo; en tinta roja en el anverso y bloque numerado &ldquo;SPECIMEN No 0899&rdquo; en el reverso, junto a la serie &ldquo;AAA 000000&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> azul, verde claro, amarillo y subtonos terracota multicolor.</span>\n              </li>\n            </ul>\n          </div>\n\n          <div style=\"margin-top:44px; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <h3 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h3>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Wikipedia, &ldquo;Samoan tālā&rdquo;: &ldquo;On 29 September 1991, a $2 note was issued to commemorate the Golden Jubilee (50th anniversary) of Malietoa Tanumafili II as head of state. It was the first and only fully polymer note issued by Samoa.&rdquo;</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">2. Wikipedia, &ldquo;Samoan tālā&rdquo;: &ldquo;These were withdrawn in 2011 and replaced with the 2-tālā coin.&rdquo;</p>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">3. KOLEKSI WANG KERTAS, &ldquo;Replacement banknote and polymer banknote&rdquo;: &ldquo;This banknote was placed in circulation and has the distinction of having the longest period [of circulation]&hellip; has been reprinted with minor variations at least 7 times.&rdquo;</p>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n     \n     data-zoom-dialog=\"note-1\" hidden class=\"catalog-zoom-dialog\">\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"/uploads/samoa-central-bank-2-tala-1990-polimero-specimen.webp\" type=\"image/webp\" />\n          <img\n            src=\"/uploads/samoa-central-bank-2-tala-1990-polimero-specimen.jpg\"\n            alt=\"Billete specimen de 2 Tala de Samoa, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
