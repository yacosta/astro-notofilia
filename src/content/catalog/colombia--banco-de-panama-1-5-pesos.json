de-panama-5-pesos\"\n            aria-label=\"Ampliar imagen del billete de Cinco Pesos\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source\n                type=\"image/webp\"\n                srcset=\"uploads/colombia-banco-de-panama-5-pesos-640.webp 640w, uploads/colombia-banco-de-panama-5-pesos.webp 1199w\"\n                sizes=\"(max-width:640px) 100vw, min(100vw, 720px)\"\n              />\n              <source\n                type=\"image/jpeg\"\n                srcset=\"uploads/colombia-banco-de-panama-5-pesos-640.jpg 640w, uploads/colombia-banco-de-panama-5-pesos.jpg 1199w\"\n                sizes=\"(max-width:640px) 100vw, min(100vw, 720px)\"\n              />\n              <img\n                src=\"uploads/colombia-banco-de-panama-5-pesos.jpg\"\n                alt=\"Billete de Cinco Pesos de El Banco de Panamá, anverso y reverso, con retrato, barco, globo terráqueo y tren, N.° 3487\"\n                width=\"1199\"\n                height=\"1312\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso y reverso &mdash; Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete de Cinco Pesos ampliado\"\n              data-zoom-dialog=\"colombia-banco-de-panama-5-pesos\" hidden style=\"display:none\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n            >\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\"></span>\n                <button\n                  disabled=\"\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"uploads/colombia-banco-de-panama-5-pesos.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"uploads/colombia-banco-de-panama-5-pesos.jpg\"\n                    alt=\"Billete de Cinco Pesos de El Banco de Panamá, vista ampliada\"\n                    width=\"1199\"\n                    height=\"1312\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cinco Pesos, pagadero al portador y a la vista en efectivo</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número</span>\n              <span style=\"font-size:19px; color:#221f19;\">N.&deg; 3487</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick n.&deg; S722</span>\n            </div>\n          </div>\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Panamá, territorio colombiano:</strong> hasta su separación en 1903, Panamá formó parte de Colombia como Estado Soberano y luego como Departamento, bajo soberanía de los Estados Unidos de Colombia y, después, de la República de Colombia. Los billetes emitidos en el istmo durante estos años circularon como moneda colombiana y se catalogan tradicionalmente dentro de la sección de bancos regionales y privados de Colombia.<sup style=\"font-size:12px;\">1</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">El segundo Banco de Panamá:</strong> en 1869, al caducar la licencia del Banco de Circulación y Descuento de Pérez y Planas, Ricardo Planas se asoció en Nueva York con William Francis Kelly para fundar un nuevo banco de emisión, giro y descuento bajo el nombre de El Banco de Panamá. A la sociedad se invitó también a José Agustín Arango, cuñado de Planas, quien aportó el mismo 40% que Kelly, mientras Planas conservó el 20% restante. El banco emitió su propio papel moneda, impreso por la Compañía Americana de Billetes de Banco (American Banknote Company) de Nueva York.<sup style=\"font-size:12px;\">2</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Apertura y ocaso:</strong> según el historiador Fernando Barriga del Diestro, El Banco de Panamá abrió sus puertas el 14 de agosto de 1869, coincidiendo con una época adversa para la economía del istmo: la apertura del ferrocarril transcontinental en el Estado de Utah le restó importancia a la ruta panameña, varias compañías extranjeras abandonaron el país y el gobierno debió recurrir a préstamos del propio banco en medio de la crisis. A esto se sumó un incendio que afectó las oficinas y centros de negocios de Planas y Cía., y el retiro del socio Kelly &mdash;factores que llevaron a la liquidación del banco, al punto de que hacia 1875 no existía ya ningún banco panameño.<sup style=\"font-size:12px;\">4</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Sin banco central:</strong> como en el resto del país, la banca panameña de la época operó durante el periodo de banca libre colombiana (1871&ndash;1886), cuando cada banco emitía billetes respaldados por su propio crédito, sin curso forzoso ni autoridad monetaria unificada.<sup style=\"font-size:12px;\">3</sup></p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en los Billetes</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso del Un Peso:</strong> retrato central grabado, encabezado &ldquo;El Banco de Panamá&rdquo; en marco ornamental, y la denominación &ldquo;UN PESO&rdquo; repetida a ambos lados junto con la numeración de serie.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Viñeta del Cinco Pesos:</strong> retrato de Antonio Planas en óvalo a la izquierda y, a la derecha, una viñeta alegórica con barco, globo terráqueo y tren &mdash;símbolos del comercio y el progreso que representaba el istmo como cruce interoceánico.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reversos ornamentales:</strong> ambos billetes muestran medallones y orlas grabadas con el nombre del banco al centro, en verde para el Un Peso y en azul para el Cinco Pesos.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Impresor:</strong> ambos ejemplares llevan el pie de imprenta de la Compañía Americana de Billetes de Banco de Nueva York, casa que grabó buena parte del papel moneda colombiano de la época.</span>\n              </li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Standard Catalog of World Paper Money &mdash; sección de Colombia, bancos regionales y departamentales (incluye Panamá, 1861&ndash;1903).</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">2. &ldquo;Bancos de Panamá.&rdquo; <em>Wikipedia, la enciclopedia libre</em>, consultado en 2026.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">3. Meisel Roca, Adolfo. &ldquo;Los bancos comerciales en la era de la banca libre, 1871&ndash;1923.&rdquo; En <em>Banco de la República: antecedentes, evolución y estructura</em>, Banco de la República, 1990.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">4. Barriga del Diestro, Fernando, cit. en historia de El Banco de Panamá (1869&ndash;1875).</p>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
