  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/polimero-mundial/nicaragua-10-20-cordobas/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Banco Central de Nicaragua — 10 y 20 Córdobas\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/polimero-mundial/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Billetes de Polímero Mundial</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 56px;\">\n        <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Billetes de Polímero Mundial &middot; Nicaragua</span>\n        <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Banco Central de Nicaragua</h1>\n        <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Dos billetes de polímero: 10 y 20 Córdobas</p>\n      </div>\n\n      <!-- ============ 10 CORDOBAS ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">10 Córdobas &middot; 2009</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Castillo de la Inmaculada Concepción &middot; Hacienda San Jacinto</p>\n        </div>\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button data-zoom-trigger=\"nicaragua-10-cordobas-2007\" aria-label=\"Ampliar imagen del billete de 10 córdobas\" style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\">\n            <picture>\n              <source srcset=\"uploads/nicaragua-bcn-10-cordobas-2007-polimero.webp\" type=\"image/webp\" />\n              <img src=\"uploads/nicaragua-bcn-10-cordobas-2007-polimero.jpg\" alt=\"Billete de 10 córdobas de polímero del Banco Central de Nicaragua, anverso arriba con el Castillo de la Inmaculada Concepción, reverso abajo con la Hacienda San Jacinto\" width=\"564\" height=\"575\" loading=\"eager\" decoding=\"async\" style=\"display:block; width:100%; height:auto;\" />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\"><span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>Ampliar</span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span><span style=\"font-size:19px; color:#221f19;\">Nicaragua</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span><span style=\"font-size:19px; color:#221f19;\">Banco Central de Nicaragua</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span><span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg;</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span><span style=\"font-size:19px; color:#221f19;\">De La Rue (Reino Unido)</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span><span style=\"font-size:19px; color:#221f19;\">Decreto del 12 de septiembre de 2007; circulación desde mayo de 2009</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmante</span><span style=\"font-size:19px; color:#221f19;\">Antenor Rosales Bolaños (Presidente del BCN)</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span><span style=\"font-size:19px; color:#221f19;\">Pick-201</span></div>\n          </div>\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> el Castillo de la Inmaculada Concepción, fortaleza del siglo XVII en el río San Juan, construida contra incursiones piratas.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> la Hacienda San Jacinto, Managua, escenario de la batalla de 1856 contra los filibusteros de William Walker.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Doble ventana:</strong> una circular con el numeral &ldquo;10&rdquo; en relieve mate, otra en cuarto de círculo con las murallas de la fortaleza.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> verde esmeralda, verde oliva y azul turquesa multicolor.</span></li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 20 CORDOBAS ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">20 Córdobas &middot; 2009</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Costa Caribe &middot; Baile del Palo de Mayo</p>\n        </div>\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button data-zoom-trigger=\"nicaragua-20-cordobas-2007\" aria-label=\"Ampliar imagen del billete de 20 córdobas\" style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\">\n            <picture>\n              <source srcset=\"uploads/nicaragua-bcn-20-cordobas-2007-polimero.webp\" type=\"image/webp\" />\n              <img src=\"uploads/nicaragua-bcn-20-cordobas-2007-polimero.jpg\" alt=\"Billete de 20 córdobas de polímero del Banco Central de Nicaragua, anverso arriba con vivienda de la Costa Caribe, reverso abajo con el baile del Palo de Mayo\" width=\"564\" height=\"551\" loading=\"lazy\" decoding=\"async\" style=\"display:block; width:100%; height:auto;\" />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\"><span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>Ampliar</span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span><span style=\"font-size:19px; color:#221f19;\">Nicaragua</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span><span style=\"font-size:19px; color:#221f19;\">Banco Central de Nicaragua</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span><span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg;</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span><span style=\"font-size:19px; color:#221f19;\">De La Rue (Reino Unido)</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span><span style=\"font-size:19px; color:#221f19;\">Decreto del 12 de septiembre de 2007; circulación desde mayo de 2009</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmante</span><span style=\"font-size:19px; color:#221f19;\">Antenor Rosales Bolaños (Presidente del BCN)</span></div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\"><span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span><span style=\"font-size:19px; color:#221f19;\">Pick-202</span></div>\n          </div>\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Una serie dedicada al patrimonio nacional:</strong> ambas denominaciones fueron impresas por De La Rue bajo el decreto del Consejo Directivo del Banco Central de Nicaragua del 12 de septiembre de 2007, entrando en circulación en mayo de 2009; el billete de 20 celebra la cultura afrocaribeña de la Costa Caribe con el tradicional baile del Palo de Mayo, mientras el de 10 conmemora dos hitos de la defensa territorial nicaragüense frente a piratas y filibusteros.</p>\n          </div>\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> una joven indígena moliendo grano, junto a una vivienda rústica de paja y pilotes de la Costa Caribe.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> mujeres danzando el Palo de Mayo alrededor de un poste adornado; el Escudo de Armas de Nicaragua con cinco volcanes entre dos océanos.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Doble ventana:</strong> una circular con el &ldquo;20&rdquo; en relieve óptico mate, otra vertical con la silueta de la joven moliendo grano.</span></li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\"><span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span><span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> ocre, naranja, marrón y subtonos dorados multicolor.</span></li>\n            </ul>\n          </div>\n\n          <div style=\"margin-top:44px; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <h3 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h3>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">Referencia de catálogo y fechas de emisión según Standard Catalog of World Paper Money (Pick-201/202); el Castillo de la Inmaculada Concepción y la batalla de San Jacinto (1856) son hitos documentados de la historia nacional de Nicaragua frente a las incursiones piratas coloniales y la invasión filibustera de William Walker.</p>\n          </div>\n        </div>\n      </section>\n\n    </div>\n  </main>\n\n  \n    <div role=\"dialog\" aria-modal=\"true\" aria-label=\"Billete ampliado\" style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\">\n      <button data-zoom-close aria-label=\"Cerrar\" style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\">&times;</button>\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button disabled=\"true\" aria-label=\"Alejar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button disabled=\"false\" aria-label=\"Acercar\" style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\">&#43;</button>\n      </div>\n      <div style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\">\n        \n          <picture><source srcset=\"uploads/nicaragua-bcn-10-cordobas-2007-polimero.webp\" type=\"image/webp\" /><img src=\"uploads/nicaragua-bcn-10-cordobas-2007-polimero.jpg\" alt=\"Billete de 10 córdobas, vista ampliada\" draggable=\"false\" style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\" /></picture>\n        \n        \n          <picture><source srcset=\"uploads/nicaragua-bcn-20-cordobas-2007-polimero.webp\" type=\"image/webp\" /><img src=\"uploads/nicaragua-bcn-20-cordobas-2007-polimero.jpg\" alt=\"Billete de 20 córdobas, vista ampliada\" draggable=\"false\" style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\" /></picture>\n        \n      </div>\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
