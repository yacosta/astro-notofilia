  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/certificado-de-oro-10-dolares-1928/\" id=\"main-content\" tabindex=\"-1\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/departamento-del-tesoro-de-ee-uu/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Departamento del Tesoro de EE. UU.</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Certificado de Oro &middot; Estados Unidos &middot; 1928</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Certificado de Oro</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$10.00 &middot; Serie de 1928</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            onClick=\"{{ openZoom }}\"\n            data-zoom-trigger=\"gold-certificate-1928\"\n            aria-label=\"Ampliar imagen del billete\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/us-treasury-gold-certificate-10-dollars-1928.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                alt=\"Certificado de oro de diez dólares de Estados Unidos, serie de 1928, anverso y reverso\"\n                width=\"564\"\n                height=\"477\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n\n          <sc-if value=\"{{ zoomOpen }}\" hint-placeholder-val=\"{{ false }}\">\n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete ampliado\"\n              data-zoom-dialog=\"gold-certificate-1928\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n              onClick=\"{{ closeZoom }}\"\n              onWheel=\"{{ onWheel }}\"\n            >\n              <button\n                onClick=\"{{ closeZoom }}\"\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  onClick=\"{{ zoomOutHandler }}\"\n                  disabled=\"{{ zoomOutDisabled }}\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">{{ zoomPercent }}</span>\n                <button\n                  onClick=\"{{ zoomInHandler }}\"\n                  disabled=\"{{ zoomInDisabled }}\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n                onClick=\"{{ stopPropagation }}\"\n                onPointerDown=\"{{ onPointerDown }}\"\n                onPointerMove=\"{{ onPointerMove }}\"\n                onPointerUp=\"{{ onPointerUp }}\"\n                onPointerLeave=\"{{ onPointerUp }}\"\n              >\n                <picture>\n                  <source srcset=\"uploads/us-treasury-gold-certificate-10-dollars-1928.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                    alt=\"Certificado de oro de diez dólares de Estados Unidos, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          </sc-if>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento del Tesoro de los Estados Unidos (<em>United States Treasury</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">$10.00 (Diez Dólares)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Certificado de Oro (<em>Gold Certificate</em>) &mdash; tamaño pequeño (<em>small-size note</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año de Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie de 1928 (primer año del formato y tamaño físico actual de los billetes de EE. UU.)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Friedberg FR-2400</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie / Distrito</span>\n              <span style=\"font-size:19px; color:#221f19;\">A69869993A (letra de distrito K &mdash; Boston, Massachusetts)</span>\n            </div>\n          </div>\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Esquema de Color</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> impresión principal en tinta negra, con el sello numérico y los números de serie en tinta dorada/amarilla viva &mdash; un distintivo exclusivo de los Certificados de Oro de esta era.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> impresión completa en tinta verde clásica (<em>greenback</em>).</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Retrato e Imágenes del Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Centro:</strong> retrato ovalado de Alexander Hamilton, el primer Secretario del Tesoro de los Estados Unidos.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Izquierda:</strong> sello circular del Tesoro en color dorado con la inscripción &ldquo;Gold Certificate&rdquo;; sobre él, la cláusula legal.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Derecha:</strong> la palabra &ldquo;TEN&rdquo; impresa en letras grandes de diseño grisáceo con líneas finas de seguridad.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Imágenes del Reverso</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Viñeta grabada en detalle del edificio del Departamento del Tesoro de los Estados Unidos en Washington D.C., enmarcado por un borde verde ornamental con la denominación &ldquo;10 TEN&rdquo; en las cuatro esquinas.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Cláusula de Redención</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Parte inferior del anverso:</strong> &ldquo;IN GOLD COIN PAYABLE TO THE BEARER ON DEMAND&rdquo; (pagadero al portador en monedas de oro a la vista).</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Parte superior:</strong> &ldquo;This certifies that there have been deposited in the Treasury of the United States of America Ten Dollars in gold coin&hellip;&rdquo;</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Firmas</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">W. O. Woods</strong> &mdash; Tesorero de los Estados Unidos (<em>Treasurer of the United States</em>), a la izquierda.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">A. W. Mellon</strong> &mdash; Secretario del Tesoro (<em>Secretary of the Treasury</em>), a la derecha.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>Friedberg, Arthur L. &amp; Ira S. <em>Paper Money of the United States.</em></li>\n              <li>Bureau of Engraving and Printing — <a href=\"https://www.bep.gov\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">bep.gov</a></li>\n              <li>Heritage Auctions — <a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com</a></li>\n              <li>Numista — <a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com</a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
  "logic": "class Component extends DCLogic {\n  state = {\n    zoomOpen: false,\n    scale: 1,\n    offsetX: 0,\n    offsetY: 0,\n    dragging: false,\n    dragStartX: 0,\n    dragStartY: 0,\n    dragOffsetStartX: 0,\n    dragOffsetStartY: 0\n  };\n\n  focusClose = () => {\n    const closeBtn = document.querySelector('[data-zoom-dialog=\"gold-certificate-1928\"] [data-zoom-close]');\n    if (closeBtn) { closeBtn.focus(); return; }\n    requestAnimationFrame(this.focusClose);\n  };\n\n  focusTrigger = () => {\n    const trigger = document.querySelector('[data-zoom-trigger=\"gold-certificate-1928\"]');\n    if (trigger) trigger.focus();\n  };\n\n  openZoom = () => {\n    this.setState({ zoomOpen: true, scale: 1, offsetX: 0, offsetY: 0 });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusClose));\n  };\n\n  closeZoom = () => {\n    this.setState({ zoomOpen: false });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusTrigger));\n  };\n\n  stopPropagation = (e) => e.stopPropagation();\n\n  zoomIn = () => {\n    this.setState(s => ({ scale: Math.min(4, Math.round((s.scale + 0.5) * 10) / 10) }));\n  };\n\n  zoomOut = () => {\n    this.setState(s => {\n      const next = Math.max(1, Math.round((s.scale - 0.5) * 10) / 10);\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onWheel = (e) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? -0.25 : 0.25;\n    this.setState(s => {\n      const next = Math.min(4, Math.max(1, Math.round((s.scale + delta) * 100) / 100));\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onPointerDown = (e) => {\n    if (this.state.scale <= 1) return;\n    this.setState({\n      dragging: true,\n      dragStartX: e.clientX,\n      dragStartY: e.clientY,\n      dragOffsetStartX: this.state.offsetX,\n      dragOffsetStartY: this.state.offsetY\n    });\n  };\n\n  onPointerMove = (e) => {\n    if (!this.state.dragging) return;\n    const dx = e.clientX - this.state.dragStartX;\n    const dy = e.clientY - this.state.dragStartY;\n    this.setState({ offsetX: this.state.dragOffsetStartX + dx, offsetY: this.state.dragOffsetStartY + dy });\n  };\n\n  onPointerUp = () => this.setState({ dragging: false });\n\n  onKeyDown = (e) => {\n    if (e.key === \"Escape\" && this.state.zoomOpen) this.closeZoom();\n  };\n\n  componentDidMount() {\n    document.addEventListener(\"keydown\", this.onKeyDown);\n    if (typeof document !== \"undefined\" && document.documentElement) {\n      document.documentElement.lang = \"es\";\n    }\n  }\n\n  componentWillUnmount() {\n    document.removeEventListener(\"keydown\", this.onKeyDown);\n  }\n\n  renderVals() {\n    const s = this.state;\n    return {\n      zoomOpen: s.zoomOpen,\n      openZoom: this.openZoom,\n      closeZoom: this.closeZoom,\n      stopPropagation: this.stopPropagation,\n      zoomInHandler: this.zoomIn,\n      zoomOutHandler: this.zoomOut,\n      onWheel: this.onWheel,\n      onPointerDown: this.onPointerDown,\n      onPointerMove: this.onPointerMove,\n      onPointerUp: this.onPointerUp,\n      zoomInDisabled: s.scale >= 4,\n      zoomOutDisabled: s.scale <= 1,\n      zoomPercent: Math.round(s.scale * 100) + \"%\",\n      imgTransform: `translate(${s.offsetX}px, ${s.offsetY}px) scale(${s.scale})`,\n      imgCursor: s.scale > 1 ? (s.dragging ? \"grabbing\" : \"grab\") : \"default\"\n    };\n  }\n}",
