type=\"image/webp\" />\n              <img\n                src=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                alt=\"Certificado de oro de diez dólares de Estados Unidos, serie de 1928, anverso y reverso\"\n                width=\"564\"\n                height=\"477\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Estados Unidos</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Departamento del Tesoro de los Estados Unidos (<em>United States Treasury</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">$10.00 (Diez Dólares)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Certificado de Oro (<em>Gold Certificate</em>) &mdash; tamaño pequeño (<em>small-size note</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Año de Serie</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie de 1928 (primer año del formato y tamaño físico actual de los billetes de EE. UU.)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Friedberg FR-2400</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Número de Serie / Distrito</span>\n              <span style=\"font-size:19px; color:#221f19;\">A69869993A (bloque A; los certificados de oro no usan letra de distrito de la Reserva Federal)</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete ampliado\"\n              data-zoom-dialog=\"gold-certificate-1928\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button type=\"button\" data-zoom-out\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span data-zoom-percent style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  data-zoom-in aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:100vw; max-height:100vh; width:100vw; height:100vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.webp\" type=\"image/webp\" />\n                  <img data-zoom-image\n                    src=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                    alt=\"Certificado de oro de diez dólares de Estados Unidos, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:100vw; max-height:100vh; width:100vw; height:100vh; object-fit:contain; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"position:absolute; bottom:16px; left:50%; transform:translateX(-50%); font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic; pointer-events:none;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Esquema de Color</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> impresión principal en tinta negra, con el sello numérico y los números de serie en tinta dorada/amarilla viva &mdash; un distintivo exclusivo de los Certificados de Oro de esta era.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> impresión completa en tinta verde clásica (<em>greenback</em>).</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Retrato e Imágenes del Anverso</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Centro:</strong> retrato ovalado de <a href=\"/coleccion/moneda-colonial/perfil-alexander-hamilton/\">Alexander Hamilton</a>, el primer Secretario del Tesoro de los Estados Unidos.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Izquierda:</strong> sello circular del Tesoro en color dorado con la inscripción &ldquo;Gold Certificate&rdquo;; sobre él, la cláusula legal.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Derecha:</strong> la palabra &ldquo;TEN&rdquo; impresa en letras grandes de diseño grisáceo con líneas finas de seguridad.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Imágenes del Reverso</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Viñeta grabada en detalle del edificio del Departamento del Tesoro de los Estados Unidos en Washington D.C., enmarcado por un borde verde ornamental con la denominación &ldquo;10 TEN&rdquo; en las cuatro esquinas.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Cláusula de Redención</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Parte inferior del anverso:</strong> &ldquo;IN GOLD COIN PAYABLE TO THE BEARER ON DEMAND&rdquo; (pagadero al portador en monedas de oro a la vista).</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Parte superior:</strong> &ldquo;This certifies that there have been deposited in the Treasury of the United States of America Ten Dollars in gold coin&hellip;&rdquo;</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Firmas</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">W. O. Woods</strong> &mdash; Tesorero de los Estados Unidos (<em>Treasurer of the United States</em>), a la izquierda.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">A. W. Mellon</strong> &mdash; Secretario del Tesoro (<em>Secretary of the Treasury</em>), a la derecha.</span>\n              </li>\n            </ul>\n          </section>\n\n          \n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Numeración y retirada del oro</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">En los certificados de oro de tamaño pequeño, la primera letra del número de serie <strong style=\"color:#1c1a15;\">no identifica un Banco de la Reserva Federal</strong>: el Tesoro numeraba en bloques consecutivos (A&hellip;A, luego B&hellip;A, y así sucesivamente). El ejemplar de esta ficha, <strong style=\"color:#1c1a15;\">A69869993A</strong>, pertenece al bloque A de la Serie 1928.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">USPaperMoney.info documenta los regulares de $10 Serie 1928 entre <strong style=\"color:#1c1a15;\">A&nbsp;000&nbsp;00001&nbsp;A</strong> y <strong style=\"color:#1c1a15;\">B&nbsp;333&nbsp;56000&nbsp;A</strong>. Las estrellas empiezan en <strong style=\"color:#1c1a15;\">*&nbsp;000&nbsp;00001&nbsp;A</strong>; el final de ese rango de reemplazo no está publicado (figura como desconocido).</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Los certificados de oro de tamaño pequeño llevan sello y numeración amarillos. Circulación del formato reducido comenzó en julio de 1929. En 1933 el gobierno retiró el oro de la circulación privada y estos certificados dejaron de ser redimibles en metal; su tenencia privada estuvo prohibida hasta 1964. La Serie 1934 de certificados de oro, con reverso naranja, se destinó solo a operaciones entre bancos de la Reserva Federal y no llegó al público.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">La obligación de este ejemplar sigue leyendo el pago en moneda de oro a la vista: es el texto de la Serie 1928, anterior a la cláusula de 1934 (“as authorized by law”).</p>\n          </section>\n<section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Fuentes</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>USPaperMoney.info — rangos de serie de certificados de oro $10 Serie 1928 y tipos de sello: <a href=\"https://www.uspapermoney.info/serials/all___d.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">resumen $10 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a>; <a href=\"https://www.uspapermoney.info/general/types.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">tipos de moneda <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a>; <a href=\"https://www.uspapermoney.info/history/1928.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">diseños 1928–29 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a>; <a href=\"https://www.uspapermoney.info/history/1934.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">rediseño 1934 <span aria-hidden=\"true\">↗</span> <span>(nueva ventana)</span><span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a>.</li>\n              <li>Friedberg, Arthur L. &amp; Ira S. <em>Paper Money of the United States.</em></li>\n              <li>Bureau of Engraving and Printing — <a href=\"https://www.bep.gov\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">bep.gov<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Heritage Auctions — <a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n              <li>Numista — <a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com<span style=\"font-style:italic; font-weight:400;\"> (se abre en una pestaña nueva)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
