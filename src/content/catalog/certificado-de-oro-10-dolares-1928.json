    "en": {
      "path": "/en/collection/gold-certificate-10-dollars-1928/",
      "title": "Gold Certificate $10 de 1928 | Notofilia",
      "description": "Gold Certificate $10 Series 1928 (Fr. 2400): yellow seal; serials A00000001A–B33356000A.",
      "ogTitle": "Gold Certificate $10 — Series de 1928",
      "ogDescription": "Gold Certificate de $10, serie de 1928. Referencia Friedberg FR-2400. Colección privada Notofilia.",
      "template": "<div lang=\"en\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/en/collection/gold-certificate-10-dollars-1928/\" id=\"main-content\" tabindex=\"-1\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/en/collection/us-department-of-the-treasury/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; U.S. Department of the Treasury</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Gold Certificate &middot; United States &middot; 1928</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Gold Certificate</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">$10.00 &middot; 1928 Series</p>\n        </div>\n\n        <div style=\"width:100%; max-width:660px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"gold-certificate-1928\"\n            aria-label=\"Enlarge image of the banknote\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                alt=\"Certificado de oro de ten dollars de United States, serie de 1928, obverse and reverse\"\n                width=\"564\"\n                height=\"477\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>Enlarge</span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Obverse (top) and reverse (bottom) — Notofilia.com Collection</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Country</span>\n              <span style=\"font-size:19px; color:#221f19;\">United States</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Issuing Entity</span>\n              <span style=\"font-size:19px; color:#221f19;\">U.S. Department of the Treasury (<em>United States Treasury</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denomination</span>\n              <span style=\"font-size:19px; color:#221f19;\">$10.00 (Ten Dollars)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Type of Issue</span>\n              <span style=\"font-size:19px; color:#221f19;\">Gold Certificate (<em>Gold Certificate</em>) &mdash; small size (<em>small-size note</em>)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Series Year</span>\n              <span style=\"font-size:19px; color:#221f19;\">Series of 1928 (first year of the current format and physical size of U.S. banknotes)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Catalog Reference</span>\n              <span style=\"font-size:19px; color:#221f19;\">Friedberg FR-2400</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serial Number/District</span>\n              <span style=\"font-size:19px; color:#221f19;\">A69869993A (A block; Gold Certificates do not use a Federal Reserve district letter)</span>\n            </div>\n          </div>\n\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Enlarged banknote\"\n              data-zoom-dialog=\"gold-certificate-1928\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Close\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button type=\"button\" data-zoom-out\n                  disabled=\"true\"\n                  aria-label=\"Zoom out\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span data-zoom-percent style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  data-zoom-in aria-label=\"Zoom in\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:100vw; max-height:100vh; width:100vw; height:100vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.webp\" type=\"image/webp\" />\n                  <img data-zoom-image\n                    src=\"/uploads/us-treasury-gold-certificate-10-dollars-1928.jpg\"\n                    alt=\"Certificado de oro de ten dollars de United States, enlarged view\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:100vw; max-height:100vh; width:100vw; height:100vh; object-fit:contain; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"position:absolute; bottom:16px; left:50%; transform:translateX(-50%); font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic; pointer-events:none;\">Drag to move &middot; Mouse wheel to zoom</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Color Scheme</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Obverse:</strong>main impression in black ink, with the numeral seal and serial numbers in bright gold/yellow ink &mdash; a unique hallmark of Gold Certificates of this era.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Reverse:</strong>Full print in classic green ink (<em>greenback</em>).</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Portrait and Obverse Images</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Center:</strong>oval portrait of<a href=\"/en/collection/colonial-paper-money/profile-alexander-hamilton/\">Alexander Hamilton</a>, the first U.S. Secretary of the Treasury.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Left:</strong>gold-colored circular Treasury seal bearing the inscription &ldquo;Gold Certificate&rdquo;; above it, the legal clause.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Right:</strong>the word &ldquo;TEN&rdquo; printed in large grayish design letters with thin security lines.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Reverse Images</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Detailed engraved vignette of the United States Treasury Building in Washington, D.C., framed by an ornamental green border with the denomination &ldquo;10 TEN&rdquo; in all four corners.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Redemption Clause</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Lower portion of the obverse:</strong>&ldquo;IN GOLD COIN PAYABLE TO THE BEARER ON DEMAND&rdquo;.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Top:</strong>&ldquo;This certifies that there have been deposited in the Treasury of the United States of America Ten Dollars in gold coin&hellip;&rdquo;</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Signatures</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">W. O. Woods</strong>&mdash; Treasurer of the United States (<em>Treasurer of the United States</em>), on the left.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">A. W. Mellon</strong>&mdash; Secretary of the Treasury (<em>Secretary of the Treasury</em>), on the right.</span>\n              </li>\n            </ul>\n          </section>\n\n          \n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Serial numbering and the gold recall</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">On small-size Gold Certificates the first letter of the serial number <strong style=\"color:#1c1a15;\">does not identify a Federal Reserve Bank</strong>: the Treasury numbered consecutive blocks (A&hellip;A, then B&hellip;A, and so on). The specimen on this record, <strong style=\"color:#1c1a15;\">A69869993A</strong>, is in the A block of Series 1928.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">USPaperMoney.info records Series 1928 $10 regulars from <strong style=\"color:#1c1a15;\">A&nbsp;000&nbsp;00001&nbsp;A</strong> through <strong style=\"color:#1c1a15;\">B&nbsp;333&nbsp;56000&nbsp;A</strong>. Star notes begin at <strong style=\"color:#1c1a15;\">*&nbsp;000&nbsp;00001&nbsp;A</strong>; the published table leaves the end of that replacement range unknown.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Small-size Gold Certificates have yellow seals and serials. The reduced format entered circulation in July 1929. In 1933 the government withdrew gold from private circulation and these certificates ceased to be redeemable in metal; private ownership was banned until 1964. Series 1934 Gold Certificates, with orange backs, were issued only among Federal Reserve Banks and never to the public.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">This specimen still carries the Series 1928 gold-coin demand clause, not the 1934 wording (“as authorized by law”).</p>\n          </section>\n<section style=\"margin-top:32px; border-top:1px solid rgba(10,10,9,0.12); padding-top:24px;\">\n            <h2 style=\"font-size:13px; letter-spacing:0.18em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 12px; font-style:normal;\">Sources</h2>\n            <ul style=\"margin:0; padding:0 0 0 20px; font-size:15px; line-height:1.7; color:#5c4e33; font-style:italic;\">\n              <li>USPaperMoney.info — Series 1928 $10 Gold Certificate serial ranges and seal types: <a href=\"https://www.uspapermoney.info/serials/all___d.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">$10 summary <span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\"> (opens in a new tab)</span></a>; <a href=\"https://www.uspapermoney.info/general/types.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">currency types <span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\"> (opens in a new tab)</span></a>; <a href=\"https://www.uspapermoney.info/history/1928.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">1928–29 designs <span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\"> (opens in a new tab)</span></a>; <a href=\"https://www.uspapermoney.info/history/1934.html\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">1934 redesign <span aria-hidden=\"true\">↗</span> <span>(new window)</span><span style=\"font-style:italic; font-weight:400;\"> (opens in a new tab)</span></a>.</li>\n              <li>Friedberg, Arthur L. &amp; Ira S.<em>Paper Money of the United States.</em></li>\n              <li>Bureau of Engraving and Printing —<a href=\"https://www.bep.gov\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">bep.gov<span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>Heritage Auctions —<a href=\"https://www.ha.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">ha.com<span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n              <li>Numista —<a href=\"https://en.numista.com\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#6b521f;\">numista.com<span style=\"font-style:italic; font-weight:400;\">(opens in a new tab)</span></a></li>\n            </ul>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
      "recordTitle": "Gold Certificate",
      "eyebrow": "Gold Certificate · United States · 1928"
    }
  }
