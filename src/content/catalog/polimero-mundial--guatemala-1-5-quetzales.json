n:0;\">General José María Orellana &middot; Edificio del Banco de Guatemala</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom1 }}\"\n            data-zoom-trigger=\"guatemala-1-quetzal-2007-polimero\"\n            aria-label=\"Ampliar imagen del billete de 1 Quetzal\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/guatemala-banco-de-guatemala-1-quetzal-2007-polimero.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/guatemala-banco-de-guatemala-1-quetzal-2007-polimero.jpg\"\n                alt=\"Billete de 1 Quetzal de polímero del Banco de Guatemala, anverso arriba con retrato del General José María Orellana y un quetzal en vuelo, reverso abajo con el edificio del Banco de Guatemala\"\n                width=\"564\"\n                height=\"482\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Guatemala</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banco de Guatemala</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Un Quetzal</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg; de polipropileno</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Canadian Bank Note Company (CBN)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Autorización del 20 de diciembre de 2006; introducido masivamente en agosto de 2007</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">María Antonieta Del Cid de Bonilla (Presidenta) &middot; Lizardo Arturo Sosa López (Gerente General)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">156 &times; 68 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-115 (también listado como P-109 por su fecha base de autorización)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Un homenaje al padre del Quetzal:</strong> el General José María Orellana (1872&ndash;1926), presidente de Guatemala, encabezó la reforma monetaria que instituyó el Quetzal como moneda nacional en 1924 mediante el Decreto Legislativo 897, sustituyendo al peso guatemalteco y fundando el primer banco central del país; su retrato preside este billete que lleva su nombre de moneda.<sup style=\"font-size:12px;\">1</sup></p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato del General José María Orellana; en la parte superior izquierda, un quetzal en vuelo con el plumaje extendido.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> la fachada del edificio principal del Banco de Guatemala, en el Centro Cívico de la Ciudad de Guatemala; a la izquierda, una ilustración inspirada en el arte maya (la &ldquo;Placa de Leyden&rdquo;), y a la derecha una reproducción calada de la medalla de la moneda original.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Ventana transparente romboidal:</strong> apertura de diseño geométrico limpio en el borde izquierdo del anverso, con líneas ópticas sutiles.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Dispositivo ópticamente variable (OVD):</strong> parche metálico reflectante con el escudo nacional de Guatemala en el extremo superior derecho.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Tinta magnética variable (OVMI):</strong> el numeral central &ldquo;1&rdquo; cambia de brillo y tonalidad según el ángulo de observación.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> verde esmeralda, verde oliva y subtonos grises multicolor.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 5 QUETZALES ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">5 Quetzales &middot; 2011</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">General Justo Rufino Barrios &middot; Homenaje a la Educación Primaria</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom5 }}\"\n            data-zoom-trigger=\"guatemala-5-quetzales-2011-polimero\"\n            aria-label=\"Ampliar imagen del billete de 5 Quetzales\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/guatemala-banco-de-guatemala-5-quetzales-2011-polimero.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/guatemala-banco-de-guatemala-5-quetzales-2011-polimero.jpg\"\n                alt=\"Billete de 5 Quetzales de polímero del Banco de Guatemala, anverso arriba con retrato del General Justo Rufino Barrios y un quetzal en vuelo, reverso abajo con una escena de aula de clases\"\n                width=\"564\"\n                height=\"484\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Guatemala</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banco de Guatemala</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cinco Quetzales</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg; de polipropileno</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Canadian Bank Note Company (CBN)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Autorización del 19 de mayo de 2010; puesto en circulación en noviembre de 2011</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">Edgar Baltazar Barquín Durán (Presidente) &middot; Edgar Alfredo Alvarado (Gerente General)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Dimensiones</span>\n              <span style=\"font-size:19px; color:#221f19;\">151 &times; 67 mm</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-122a (primera serie de polímero)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">El Reformador y la educación pública:</strong> el General Justo Rufino Barrios (1835&ndash;1885), conocido como &ldquo;El Reformador&rdquo; y promotor de la Unión Centroamericana, decretó en 1875 la enseñanza primaria gratuita, laica y obligatoria en Guatemala &mdash;el reverso de este billete rinde homenaje directo a ese legado educativo con la leyenda que recuerda el decreto.<sup style=\"font-size:12px;\">2</sup></p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato del General Justo Rufino Barrios sobre un intrincado fondo guilloché, con una viñeta del quetzal nacional en pleno vuelo hacia la izquierda.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> escena de aula de escuela primaria, con una maestra enseñando a tres estudiantes junto a una pizarra y abecedarios; la leyenda inferior recuerda: &ldquo;El General Justo Rufino Barrios estableció la enseñanza primaria, gratuita, laica, y obligatoria&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Ventana de polímero en forma de libro:</strong> apertura totalmente transparente a la derecha del anverso, con la silueta de un libro abierto grabado en relieve óptico mate.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Registro perfecto traslúcido:</strong> medallón maya con un rostro indígena que coincide con precisión milimétrica en ambas caras al trasluz.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Bandas metálicas OVD:</strong> detalles en tintas brillantes e iridiscentes en el área del escudo de armas que cambian de color según la inclinación.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> morado, púrpura, terracota y amarillo multicolor.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Banco de Guatemala, &ldquo;Historia de la moneda en Guatemala&rdquo;, <em>banguat.gob.gt</em>: el Quetzal fue instituido como unidad monetaria por el Decreto Legislativo 897 de 1924, bajo la presidencia del General José María Orellana, sustituyendo al peso guatemalteco.</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">2. Ministerio de Educación de Guatemala / historiografía nacional: el Decreto Gubernativo de 1875, bajo el gobierno del General Justo Rufino Barrios, estableció la instrucción primaria pública, gratuita y obligatoria en el país.</p>\n      </div>\n\n    </div>\n  </main>\n\n  <sc-if value=\"{{ zoomOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n      style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n      onClick=\"{{ closeZoom }}\"\n      onWheel=\"{{ onWheel }}\"\n    >\n      <button\n        onClick=\"{{ closeZoom }}\"\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          onClick=\"{{ zoomOutHandler }}\"\n          disabled=\"{{ zoomOutDisabled }}\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">{{ zoomPercent }}</span>\n        <button\n          onClick=\"{{ zoomInHandler }}\"\n          disabled=\"{{ zoomInDisabled }}\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n        onClick=\"{{ stopPropagation }}\"\n        onPointerDown=\"{{ onPointerDown }}\"\n        onPointerMove=\"{{ onPointerMove }}\"\n        onPointerUp=\"{{ onPointerUp }}\"\n        onPointerLeave=\"{{ onPointerUp }}\"\n      >\n        <sc-if value=\"{{ isZoom1 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/guatemala-banco-de-guatemala-1-quetzal-2007-polimero.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/guatemala-banco-de-guatemala-1-quetzal-2007-polimero.jpg\"\n              alt=\"Billete de 1 Quetzal, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n        <sc-if value=\"{{ isZoom5 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/guatemala-banco-de-guatemala-5-quetzales-2011-polimero.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/guatemala-banco-de-guatemala-5-quetzales-2011-polimero.jpg\"\n              alt=\"Billete de 5 Quetzales, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  </sc-if>\n\n  \n\n</div>",
  "logic": "class Component extends DCLogic {\n  state = {\n    activeNote: null, // \"1\" | \"5\" | null\n    scale: 1,\n    offsetX: 0,\n    offsetY: 0,\n    dragging: false,\n    dragStartX: 0,\n    dragStartY: 0,\n    dragOffsetStartX: 0,\n    dragOffsetStartY: 0\n  };\n\n  triggers = {\n    \"1\": \"guatemala-1-quetzal-2007-polimero\",\n    \"5\": \"guatemala-5-quetzales-2011-polimero\"\n  };\n\n  focusClose = () => {\n    const closeBtn = document.querySelector(\"[data-zoom-close]\");\n    if (closeBtn) { closeBtn.focus(); return; }\n    requestAnimationFrame(this.focusClose);\n  };\n\n  focusTrigger = (note) => {\n    const trigger = document.querySelector(`[data-zoom-trigger=\"${this.triggers[note]}\"]`);\n    if (trigger) trigger.focus();\n  };\n\n  openZoom = (note) => {\n    this.setState({ activeNote: note, scale: 1, offsetX: 0, offsetY: 0 });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusClose));\n  };\n\n  openZoom1 = () => this.openZoom(\"1\");\n  openZoom5 = () => this.openZoom(\"5\");\n\n  closeZoom = () => {\n    const note = this.state.activeNote;\n    this.setState({ activeNote: null });\n    requestAnimationFrame(() => requestAnimationFrame(() => this.focusTrigger(note)));\n  };\n\n  stopPropagation = (e) => e.stopPropagation();\n\n  zoomIn = () => {\n    this.setState(s => ({ scale: Math.min(4, Math.round((s.scale + 0.5) * 10) / 10) }));\n  };\n\n  zoomOut = () => {\n    this.setState(s => {\n      const next = Math.max(1, Math.round((s.scale - 0.5) * 10) / 10);\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onWheel = (e) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? -0.25 : 0.25;\n    this.setState(s => {\n      const next = Math.min(4, Math.max(1, Math.round((s.scale + delta) * 100) / 100));\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onPointerDown = (e) => {\n    if (this.state.scale <= 1) return;\n    this.setState({\n      dragging: true,\n      dragStartX: e.clientX,\n      dragStartY: e.clientY,\n      dragOffsetStartX: this.state.offsetX,\n      dragOffsetStartY: this.state.offsetY\n    });\n  };\n\n  onPointerMove = (e) => {\n    if (!this.state.dragging) return;\n    const dx = e.clientX - this.state.dragStartX;\n    const dy = e.clientY - this.state.dragStartY;\n    this.setState({ offsetX: this.state.dragOffsetStartX + dx, offsetY: this.state.dragOffsetStartY + dy });\n  };\n\n  onPointerUp = () => this.setState({ dragging: false });\n\n  onKeyDown = (e) => {\n    if (e.key === \"Escape\" && this.state.activeNote) this.closeZoom();\n  };\n\n  componentDidMount() {\n    document.addEventListener(\"keydown\", this.onKeyDown);\n    if (typeof document !== \"undefined\" && document.documentElement) {\n      document.documentElement.lang = \"es\";\n    }\n  }\n\n  componentWillUnmount() {\n    document.removeEventListener(\"keydown\", this.onKeyDown);\n  }\n\n  renderVals() {\n    const s = this.state;\n    const note = s.activeNote;\n    return {\n      zoomOpen: !!note,\n      isZoom1: note === \"1\",\n      isZoom5: note === \"5\",\n      openZoom1: this.openZoom1,\n      openZoom5: this.openZoom5,\n      closeZoom: this.closeZoom,\n      stopPropagation: this.stopPropagation,\n      zoomInHandler: this.zoomIn,\n      zoomOutHandler: this.zoomOut,\n      onWheel: this.onWheel,\n      onPointerDown: this.onPointerDown,\n      onPointerMove: this.onPointerMove,\n      onPointerUp: this.onPointerUp,\n      zoomInDisabled: s.scale >= 4,\n      zoomOutDisabled: s.scale <= 1,\n      zoomPercent: Math.round(s.scale * 100) + \"%\",\n      imgTransform: `translate(${s.offsetX}px, ${s.offsetY}px) scale(${s.scale})`,\n      imgCursor: s.scale > 1 ? (s.dragging ? \"grabbing\" : \"grab\") : \"default\"\n    };\n  }\n}",
  "legacyFile": "billete-guatemala-1-5-quetzales-polimero.dc.html",
  "sourceHash": "a1c5c66fd79df679"
}
