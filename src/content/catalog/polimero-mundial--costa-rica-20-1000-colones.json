  "styles": "body { margin: 0; }\n    a { color: #6b521f; text-decoration: underline; text-decoration-color: rgba(138,109,59,0.35); }\n    a:hover { color: #5c4826; }\n    ::selection { background: rgba(138,109,59,0.25); }",
  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/polimero-mundial/costa-rica-20-1000-colones/\" id=\"main-content\" tabindex=\"-1\" data-screen-label=\"Costa Rica — 20 Colones (Tyvek) y 1.000 Colones (Polímero)\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/polimero-mundial/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Billetes de Polímero Mundial</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"text-align:center; max-width:760px; margin:0 auto 56px;\">\n        <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Billetes de Polímero Mundial &middot; Costa Rica</span>\n        <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">Banco Central de Costa Rica</h1>\n        <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Dos billetes sintéticos: 20 Colones en Tyvek&reg; (1983) y 1.000 Colones en polímero (2011)</p>\n      </div>\n\n      <!-- ============ 20 COLONES, TYVEK, 1983 ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Veinte Colones &middot; 1983</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Serie Z &middot; Tyvek&reg; experimental &middot; Cleto González Víquez</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom20 }}\"\n            data-zoom-trigger=\"costarica-20-colones-1983-tyvek\"\n            aria-label=\"Ampliar imagen del billete de veinte colones\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/costarica-bccr-20-colones-1983-tyvek.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/costarica-bccr-20-colones-1983-tyvek.jpg\"\n                alt=\"Billete experimental de Tyvek de 20 Colones del Banco Central de Costa Rica, anverso arriba con retrato de Cleto González Víquez, reverso abajo con la alegoría de la Justicia\"\n                width=\"564\"\n                height=\"476\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Costa Rica</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banco Central de Costa Rica</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Veinte Colones</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Tyvek&reg; &mdash; polietileno sintético experimental de DuPont, no polímero laminado convencional<sup style=\"font-size:12px;\">1</sup></span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">American Bank Note Company (ABNC)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie Z, Acuerdo de la Junta Directiva N.&deg; 6, 28 de junio de 1983</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">Presidente Ejecutivo &middot; Gerente</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rareza</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pieza de alta rareza numismática; retirada de forma acelerada por la pérdida de adherencia de la tinta sobre el sustrato plástico durante la circulación en clima tropical</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-252a (Serie Z de circulación regular)</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Un experimento previo al polímero moderno:</strong> mucho antes de la adopción generalizada del sustrato Guardian&reg;, Costa Rica ensayó el Tyvek&reg; &mdash;un polietileno sintético de alta densidad desarrollado por DuPont&mdash; como alternativa al papel tradicional, en el mismo período experimental en que Haití e Isla de Man probaron el mismo material.<sup style=\"font-size:12px;\">2</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Un fracaso técnico instructivo:</strong> el Tyvek&reg; resultó poco apto para la circulación en climas tropicales húmedos: la tinta no se adhería adecuadamente a su superficie no porosa, lo que llevó a un retiro acelerado de estos billetes y explica su actual rareza entre coleccionistas.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato de Cleto González Víquez, expresidente de Costa Rica, junto a la viñeta de su casa natal en Barva, con la leyenda &ldquo;Barva, cuna del prócer&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> ilustración detallada de la alegoría clásica de la Justicia, rodeada de figuras civiles.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Grabado en talla dulce:</strong> ejecutado por American Bank Note Company, con el relieve de tinta característico de esta casa impresora, adaptado experimentalmente al sustrato de Tyvek&reg;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> anverso en tonos sepia con motivos de palmeras a la derecha; reverso en tinta roja sobre la ilustración alegórica.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:64px auto; border-top:1px solid rgba(10,10,9,0.16);\"></div>\n\n      <!-- ============ 1.000 COLONES, POLÍMERO, 2011 ============ -->\n      <section style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 32px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,3vw,30px); line-height:1.1; color:#1c1a15; margin:0 0 10px;\">Mil Colones &middot; 2011</h2>\n          <p style=\"font-size:19px; font-style:italic; color:#4a4331; margin:0;\">Serie A &middot; Braulio Carrillo Colina &middot; Bosque Seco</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 48px;\">\n          <button\n            onClick=\"{{ openZoom1000 }}\"\n            data-zoom-trigger=\"costarica-1000-colones-2011-polimero\"\n            aria-label=\"Ampliar imagen del billete de mil colones\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/costarica-bccr-1000-colones-2011-polimero.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/costarica-bccr-1000-colones-2011-polimero.jpg\"\n                alt=\"Billete de polímero de 1.000 Colones del Banco Central de Costa Rica, anverso arriba con retrato de Braulio Carrillo Colina, reverso abajo con un venado cola blanca y un árbol de guanacaste en el Bosque Seco\"\n                width=\"564\"\n                height=\"596\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Costa Rica</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">Banco Central de Costa Rica</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Mil Colones</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Polímero puro &mdash; sustrato Guardian&reg; de polipropileno</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Note Printing Australia (NPA), Melbourne</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie A, fecha base de diseño 2009, emitido a partir de 2011 (Acuerdo de la Junta Directiva N.&deg; 11)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick-274a</span>\n            </div>\n          </div>\n\n          <div style=\"margin-top:44px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h3>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Del Tyvek&reg; al polímero moderno:</strong> casi tres décadas después del experimento fallido de Tyvek&reg;, Costa Rica adoptó el polímero laminado Guardian&reg; para su familia de billetes de 2009&ndash;2011, impreso por Note Printing Australia &mdash;la misma tecnología usada por Chile, Malasia y Brunéi, con mejor resistencia y adherencia de tinta que el sustrato experimental de los años ochenta.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h3 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h3>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> retrato de Braulio Carrillo Colina, junto al escudo histórico del Estado de Costa Rica de 1840.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> paisaje del ecosistema Bosque Seco, con un venado cola blanca y un árbol de guanacaste, árbol nacional de Costa Rica.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Doble ventana transparente:</strong> dos aperturas totalmente transparentes en el sustrato, una con la silueta del país y otra con un retrato en relieve óptico.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Numeración correlativa:</strong> par consecutivo con números de serie A005341238 y A005341239, indicativo de billetes sin circular conservados en secuencia.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Colorido:</strong> tonos rojo y magenta predominantes, con subimpreso rosado en ambas caras.</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0 0 6px;\">1. Wikipedia, &ldquo;Polymer banknote&rdquo;: &ldquo;DuPont Tyvek polymer notes were experimentally issued by Haiti, Costa Rica, and The Isle of Man, from 1982.&rdquo;</p>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">2. Ídem: el Tyvek&reg; de DuPont fue un experimento temprano previo al desarrollo del polímero Guardian&reg; moderno, con circulación limitada por sus limitaciones técnicas en climas húmedos.</p>\n      </div>\n\n    </div>\n  </main>\n\n  <sc-if value=\"{{ zoomOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n      style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n      onClick=\"{{ closeZoom }}\"\n      onWheel=\"{{ onWheel }}\"\n    >\n      <button\n        onClick=\"{{ closeZoom }}\"\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button\n          onClick=\"{{ zoomOutHandler }}\"\n          disabled=\"{{ zoomOutDisabled }}\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">{{ zoomPercent }}</span>\n        <button\n          onClick=\"{{ zoomInHandler }}\"\n          disabled=\"{{ zoomInDisabled }}\"\n          aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n        onClick=\"{{ stopPropagation }}\"\n        onPointerDown=\"{{ onPointerDown }}\"\n        onPointerMove=\"{{ onPointerMove }}\"\n        onPointerUp=\"{{ onPointerUp }}\"\n        onPointerLeave=\"{{ onPointerUp }}\"\n      >\n        <sc-if value=\"{{ isZoom20 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/costarica-bccr-20-colones-1983-tyvek.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/costarica-bccr-20-colones-1983-tyvek.jpg\"\n              alt=\"Billete de 20 Colones de Costa Rica, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n        <sc-if value=\"{{ isZoom1000 }}\" hint-placeholder-val=\"{{ false }}\">\n          <picture>\n            <source srcset=\"uploads/costarica-bccr-1000-colones-2011-polimero.webp\" type=\"image/webp\" />\n            <img\n              src=\"uploads/costarica-bccr-1000-colones-2011-polimero.jpg\"\n              alt=\"Billete de 1.000 Colones de Costa Rica, vista ampliada\"\n              draggable=\"false\"\n              style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:{{ imgTransform }}; cursor:{{ imgCursor }}; user-select:none;\"\n            />\n          </picture>\n        </sc-if>\n      </div>\n\n      <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  </sc-if>\n\n  \n\n</div>",
  "logic": "class Component extends DCLogic {\n  state = {\n    activeNote: null, // \"20\" | \"1000\" | null\n    scale: 1,\n    offsetX: 0,\n    offsetY: 0,\n    dragging: false,\n    dragStartX: 0,\n    dragStartY: 0,\n    dragOffsetStartX: 0,\n    dragOffsetStartY: 0\n  };\n\n  images = {\n    \"20\": {\n      jpg: \"uploads/costarica-bccr-20-colones-1983-tyvek.jpg\",\n      webp: \"uploads/costarica-bccr-20-colones-1983-tyvek.webp\",\n      trigger: \"costarica-20-colones-1983-tyvek\"\n    },\n    \"1000\": {\n      jpg: \"uploads/costarica-bccr-1000-colones-2011-polimero.jpg\",\n      webp: \"uploads/costarica-bccr-1000-colones-2011-polimero.webp\",\n      trigger: \"costarica-1000-colones-2011-polimero\"\n    }\n  };\n\n  focusClose = () => {\n    const closeBtn = document.querySelector(\"[data-zoom-close]\");\n    if (closeBtn) { closeBtn.focus(); return; }\n    requestAnimationFrame(this.focusClose);\n  };\n\n  focusTrigger = (note) => {\n    const trigger = document.querySelector(`[data-zoom-trigger=\"${this.images[note].trigger}\"]`);\n    if (trigger) trigger.focus();\n  };\n\n  openZoom = (note) => {\n    this.setState({ activeNote: note, scale: 1, offsetX: 0, offsetY: 0 });\n    requestAnimationFrame(() => requestAnimationFrame(this.focusClose));\n  };\n\n  openZoom20 = () => this.openZoom(\"20\");\n  openZoom1000 = () => this.openZoom(\"1000\");\n\n  closeZoom = () => {\n    const note = this.state.activeNote;\n    this.setState({ activeNote: null });\n    requestAnimationFrame(() => requestAnimationFrame(() => this.focusTrigger(note)));\n  };\n\n  stopPropagation = (e) => e.stopPropagation();\n\n  zoomIn = () => {\n    this.setState(s => ({ scale: Math.min(4, Math.round((s.scale + 0.5) * 10) / 10) }));\n  };\n\n  zoomOut = () => {\n    this.setState(s => {\n      const next = Math.max(1, Math.round((s.scale - 0.5) * 10) / 10);\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onWheel = (e) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? -0.25 : 0.25;\n    this.setState(s => {\n      const next = Math.min(4, Math.max(1, Math.round((s.scale + delta) * 100) / 100));\n      return { scale: next, offsetX: next === 1 ? 0 : s.offsetX, offsetY: next === 1 ? 0 : s.offsetY };\n    });\n  };\n\n  onPointerDown = (e) => {\n    if (this.state.scale <= 1) return;\n    this.setState({\n      dragging: true,\n      dragStartX: e.clientX,\n      dragStartY: e.clientY,\n      dragOffsetStartX: this.state.offsetX,\n      dragOffsetStartY: this.state.offsetY\n    });\n  };\n\n  onPointerMove = (e) => {\n    if (!this.state.dragging) return;\n    const dx = e.clientX - this.state.dragStartX;\n    const dy = e.clientY - this.state.dragStartY;\n    this.setState({ offsetX: this.state.dragOffsetStartX + dx, offsetY: this.state.dragOffsetStartY + dy });\n  };\n\n  onPointerUp = () => this.setState({ dragging: false });\n\n  onKeyDown = (e) => {\n    if (e.key === \"Escape\" && this.state.activeNote) this.closeZoom();\n  };\n\n  componentDidMount() {\n    document.addEventListener(\"keydown\", this.onKeyDown);\n    if (typeof document !== \"undefined\" && document.documentElement) {\n      document.documentElement.lang = \"es\";\n    }\n  }\n\n  componentWillUnmount() {\n    document.removeEventListener(\"keydown\", this.onKeyDown);\n  }\n\n  renderVals() {\n    const s = this.state;\n    const note = s.activeNote;\n    const img = note ? this.images[note] : null;\n    return {\n      zoomOpen: !!note,\n      openZoom20: this.openZoom20,\n      openZoom1000: this.openZoom1000,\n      closeZoom: this.closeZoom,\n      stopPropagation: this.stopPropagation,\n      zoomInHandler: this.zoomIn,\n      zoomOutHandler: this.zoomOut,\n      onWheel: this.onWheel,\n      onPointerDown: this.onPointerDown,\n      onPointerMove: this.onPointerMove,\n      onPointerUp: this.onPointerUp,\n      zoomInDisabled: s.scale >= 4,\n      zoomOutDisabled: s.scale <= 1,\n      zoomPercent: Math.round(s.scale * 100) + \"%\",\n      isZoom20: note === \"20\",\n      isZoom1000: note === \"1000\",\n      imgTransform: `translate(${s.offsetX}px, ${s.offsetY}px) scale(${s.scale})`,\n      imgCursor: s.scale > 1 ? (s.dragging ? \"grabbing\" : \"grab\") : \"default\"\n    };\n  }\n}",
  "legacyFile": "billete-costarica-20-1000-colones-tyvek-polimero.dc.html",
  "sourceHash": "892ce73e44cc7093"
}
