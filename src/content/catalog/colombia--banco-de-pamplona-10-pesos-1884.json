  "styles": "body { margin: 0; }\n    a { color: #6b521f; text-decoration: underline; text-decoration-color: rgba(138,109,59,0.35); }\n    a:hover { color: #5c4826; }\n    ::selection { background: rgba(138,109,59,0.25); }",
  "template": "<div lang=\"es\" style=\"width:100%; min-height:100vh; background:#0a0a09; font-family:'Cormorant Garamond', serif; box-sizing:border-box;\">\n\n  \n\n  \n\n  <main data-pagefind-meta=\"url:/coleccion/colombia/banco-de-pamplona-10-pesos-1884/\" id=\"main-content\" tabindex=\"-1\" style=\"max-width:1180px; margin:0 auto; padding:56px 24px 80px; outline:none;\">\n\n    <a href=\"/coleccion/colombia/\" style=\"display:inline-block; color:#e7ddc4; text-decoration:none; font-size:15px; letter-spacing:0.08em; margin-bottom:24px;\">&larr; Catálogo de Colombia</a>\n\n    <div style=\"background:#d8d2cd; border:1px solid rgba(10,10,9,0.08); border-radius:3px; padding:clamp(28px,4vw,64px); box-shadow:0 30px 70px rgba(0,0,0,0.45);\">\n\n      <div style=\"display:flex; flex-direction:column; align-items:center;\">\n\n        <div style=\"text-align:center; max-width:720px; margin:0 auto 40px;\">\n          <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Banca Libre &middot; Pamplona, Norte de Santander &middot; 1883&ndash;1884</span>\n\n          <h1 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(28px,4vw,44px); line-height:1.08; letter-spacing:0.01em; color:#1c1a15; margin:0 0 12px;\">El Banco de Pamplona</h1>\n\n          <p style=\"font-size:clamp(19px,2vw,23px); font-style:italic; color:#4a4331; margin:0;\">Un Peso (1883) &middot; Diez Pesos (1884)</p>\n        </div>\n\n        <div style=\"width:100%; max-width:760px; margin:0 auto 48px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colombia (Estado Soberano de Santander)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Banco de Pamplona, fundado en 1872</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Bradbury, Wilkinson &amp; Co., Engravers, Londres</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Marco Legal</span>\n              <span style=\"font-size:19px; color:#221f19;\">Escritura de fundación N.&deg; 536 del 10 de octubre de 1882, ante el Notario del Circuito de Pamplona, señor Nicolás Calderón</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Un Peso: Pick n.&deg; S711. Diez Pesos: sin número Pick confirmado en las fuentes consultadas; catalogado en la literatura numismática regional como emisión de la banca libre santandereana (1870&ndash;1885)</span>\n            </div>\n          </div>\n        </div>\n\n        <div id=\"un-peso\" data-screen-label=\"Un Peso 1883\" style=\"width:100%; max-width:760px; margin:0 auto 20px;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,2.6vw,28px); color:#1c1a15; margin:0 0 4px; text-align:center;\">Un Peso</h2>\n          <p style=\"font-size:17px; font-style:italic; color:#4a4331; margin:0 0 28px; text-align:center;\">Serie A, N.&deg; 0062 &middot; Pamplona, 9 de julio de 1883</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 24px;\">\n          <button\n            data-zoom-trigger=\"colombia-banco-de-pamplona-1-peso\"\n            aria-label=\"Ampliar imagen del billete de Un Peso\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/colombia-banco-de-pamplona-1-peso-1883.webp\" type=\"image/webp\" />\n              <img\n                src=\"uploads/colombia-banco-de-pamplona-1-peso-1883.jpg\"\n                alt=\"Billete de Un Peso de El Banco de Pamplona, anverso arriba con viñeta de busto femenino clásico y firmas de directores, reverso abajo en tinta anaranjada\"\n                width=\"564\"\n                height=\"654\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) &mdash; con firmas de tres directores &mdash; Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete de Un Peso ampliado\"\n              data-zoom-dialog=\"colombia-banco-de-pamplona-1-peso\" hidden style=\"display:none\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n            >\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\"></span>\n                <button\n                  disabled=\"\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"uploads/colombia-banco-de-pamplona-1-peso-1883.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"uploads/colombia-banco-de-pamplona-1-peso-1883.jpg\"\n                    alt=\"Billete de Un Peso de El Banco de Pamplona, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px; margin:0 auto;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Un Peso, pagadero al portador a la vista</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Número</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie A, N.&deg; 0062</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Lugar y Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pamplona, 9 de julio de 1883</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">El 2.&deg; Director (Luis Ant. Gómez), El Director Gerente y El 3.er Director, tres firmas estampadas a mano</span>\n            </div>\n          </div>\n\n          <section style=\"margin-top:32px;\">\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">La denominación más pequeña de la serie:</strong> emitido diez meses antes que el billete de Diez Pesos mostrado abajo, este ejemplar &mdash;Serie A, N.&deg; 0062&mdash; representa el extremo inferior de la escala de denominaciones con que El Banco de Pamplona surtía la plaza comercial de Norte de Santander a comienzos de la década de 1880. Lleva la misma escritura de fundación N.&deg; 536 del 10 de octubre de 1882 y la firma de Luis Ant. Gómez como 2.&deg; Director &mdash;el mismo funcionario que rubricó la emisión de mayor denominación&mdash;, evidencia de la continuidad administrativa del banco entre 1883 y 1884.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Viñeta propia:</strong> un busto femenino clásico con diadema, dentro de un óvalo en tinta negra &mdash;muy distinto al oso que ilustra el billete de Diez Pesos&mdash;, confirmando que cada denominación llevaba su propia plancha grabada por Bradbury, Wilkinson &amp; Co. El reverso está impreso en tinta anaranjada, con el número &ldquo;1&rdquo; en gran formato y una firma manuscrita bajo &ldquo;El Cajero&rdquo;.</p>\n          </section>\n        </div>\n\n        <div style=\"width:100%; max-width:760px; margin:56px auto 0; border-top:1px solid rgba(10,10,9,0.12);\"></div>\n\n        <div id=\"diez-pesos\" data-screen-label=\"Diez Pesos 1884\" style=\"width:100%; max-width:760px; margin:44px auto 0;\">\n          <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(22px,2.6vw,28px); color:#1c1a15; margin:0 0 4px; text-align:center;\">Diez Pesos</h2>\n          <p style=\"font-size:17px; font-style:italic; color:#4a4331; margin:0 0 28px; text-align:center;\">Serie C, N.&deg; 1908 &middot; Pamplona, 19 de mayo de 1884</p>\n        </div>\n\n        <div style=\"width:100%; max-width:560px; display:flex; flex-direction:column; gap:14px; margin:0 auto 56px;\">\n          <button\n            data-zoom-trigger=\"colombia-banco-de-pamplona-10-pesos\"\n            aria-label=\"Ampliar imagen del billete\"\n            style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"uploads/colombia-banco-de-pamplona-10-pesos-1884-640.webp 640w, uploads/colombia-banco-de-pamplona-10-pesos-1884-1280.webp 1280w, uploads/colombia-banco-de-pamplona-10-pesos-1884.webp 1816w\" sizes=\"(max-width: 600px) calc(100vw - 48px), 560px\" type=\"image/webp\" />\n              <img\n                src=\"uploads/colombia-banco-de-pamplona-10-pesos-1884.jpg\"\n                alt=\"Billete de Diez Pesos de El Banco de Pamplona, anverso arriba con viñeta de oso y firmas de directores, reverso abajo en tinta verde\"\n                width=\"1816\"\n                height=\"2079\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) &mdash; con firmas de dos directores &mdash; Colección de Notofilia.com</span>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Billete ampliado\"\n              data-zoom-dialog=\"colombia-banco-de-pamplona-10-pesos\" hidden style=\"display:none\"\n              style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n            >\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"uploads/colombia-banco-de-pamplona-10-pesos-1884.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"uploads/colombia-banco-de-pamplona-10-pesos-1884.jpg\"\n                    alt=\"Billete de Diez Pesos de El Banco de Pamplona, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Diez Pesos, pagaderos al portador a la vista</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Serie / Número</span>\n              <span style=\"font-size:19px; color:#221f19;\">Serie C, N.&deg; 1908</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Lugar y Fecha</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pamplona, 19 de mayo de 1884</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmas</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Director Gerente, el 2.&deg; Director (Luis Ant. Gómez) y el 3.er Director (Manuel Cas&hellip;), estampadas a mano</span>\n            </div>\n          </div>\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Pamplona, plaza comercial andina:</strong> ciudad fundada en 1549 en el nororiente del país, Pamplona fue durante el siglo XIX un centro comercial y religioso de primer orden en la región que hoy conforma el departamento de Norte de Santander, con estrechos vínculos comerciales con Venezuela a través de Cúcuta. En este contexto de auge mercantil, la ciudad fundó su propio banco emisor en 1872, en plena era de la banca libre colombiana.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Una segunda escritura, en plena vigencia:</strong> el billete cita la escritura de fundación N.&deg; 536 del 10 de octubre de 1882 ante el notario Nicolás Calderón, lo que indica una reconstitución o renovación formal del banco una década después de su origen, probablemente para ampliar su capital o actualizar sus estatutos conforme a la legislación bancaria vigente.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Uno de tres bancos para llenar un vacío:</strong> la literatura económica sobre el período confirma 1882 como año de fundación de El Banco de Pamplona, consistente con la escritura citada en el billete.<sup style=\"font-size:12px;\">1</sup> Surgió, junto con el Banco del Norte (1881) y el Banco Prendario de Soto (1883), para llenar el vacío dejado por el cierre del primer banco santandereano, el Banco de Santander, en 1879.<sup style=\"font-size:12px;\">1</sup> Santander experimentó, de hecho, el nivel de desregulación bancaria más alto del país: su constitución estatal de 1865 permitía fijar unidades de cuenta distintas al peso e incluso el uso de moneda extranjera en el comercio.<sup style=\"font-size:12px;\">1</sup></p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">El fin abrupto de la banca libre santandereana:</strong> El Banco de Pamplona no logró sobrevivir a los efectos devastadores de la guerra civil de 1884&ndash;1885 &mdash;el mismo conflicto que estalló apenas meses después de emitido este billete&mdash; y debió ser liquidado pocos años más tarde, un destino compartido por buena parte de la banca privada regional colombiana de finales del siglo XIX.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Viñeta central:</strong> grabado de un oso sobre una roca, motivo decorativo poco habitual en la iconografía bancaria colombiana &mdash;característico del repertorio de estampas de reserva que casas grabadoras europeas como Bradbury, Wilkinson &amp; Co. reutilizaban en encargos de distintos países.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Horario de despacho:</strong> nota impresa en el margen izquierdo &mdash;&ldquo;Horas de despacho: de las 11 de la mañana a las 4 de la tarde, los días no feriados&rdquo;&mdash; un detalle operativo poco común que revela el funcionamiento cotidiano de un banco regional decimonónico.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Triple firma manuscrita:</strong> tres firmas distintas al pie del anverso &mdash;El Director Gerente, El 2.&deg; Director y El 3.er Director&mdash;, evidencia de un cuerpo directivo colegiado responsable de autenticar cada billete emitido.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> impreso íntegramente en tinta verde con un guilloché envolvente y el número &ldquo;10&rdquo; en gran formato al centro, además de una segunda firma manuscrita correspondiente a &ldquo;El Cajero&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Pie de imprenta:</strong> &ldquo;Bradbury, Wilkinson &amp; Co., Engravers, London&rdquo; impreso en letra diminuta al pie del anverso, identificando a una de las principales casas grabadoras británicas de billetes y valores del siglo XIX.</span>\n              </li>\n            </ul>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Adicional</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Este ejemplar de circulación, con dos firmas manuscritas de directores y evidentes marcas de manejo y dobleces, contrasta con los especímenes de archivo que rara vez circularon: es un testimonio directo del comercio y la vida bancaria de Pamplona en los años previos a la guerra civil de 1884&ndash;1885, y una pieza poco común dentro de la ya escasa producción documentada de la banca libre del oriente colombiano.</p>\n          </section>\n\n          <section style=\"margin-top:44px; padding-top:36px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <span style=\"display:block; font-size:14px; letter-spacing:0.22em; text-transform:uppercase; color:#5c4e33; margin-bottom:14px;\">Segundo Ejemplar Conocido</span>\n            <h2 style=\"font-family:'Montenegrin Gothic One', serif; font-weight:400; font-size:clamp(20px,2.4vw,26px); color:#1c1a15; margin:0 0 8px;\">Serie C, N.&deg; 2304</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 20px;\">Un segundo billete de esta misma emisión &mdash;misma Serie C y misma fecha de Pamplona, 19 de mayo de 1884&mdash; circula con el número de serie 2304, en lugar del N.&deg; 1908 mostrado arriba. La diferencia entre ambos ejemplares no es de tipo o variedad, sino de tiraje: son dos billetes distintos impresos dentro de la misma emisión y fecha, cada uno con su propio número de serie. La diferencia más notoria está en el reverso: el N.&deg; 1908 lleva dos firmas manuscritas (una rúbrica adicional junto a la de &ldquo;El Cajero&rdquo;), mientras que este ejemplar N.&deg; 2304 lleva una sola firma manuscrita bajo &ldquo;El Cajero&rdquo;. En el anverso, además, la firma de &ldquo;El Director Gerente&rdquo; resulta aquí más legible &mdash;José M. Villamizar&mdash;, donde en el N.&deg; 1908 queda parcialmente cubierta por el sello numérico &ldquo;10&rdquo;.</p>\n            <div style=\"width:100%; max-width:560px; margin:0 auto; display:flex; flex-direction:column; gap:14px;\">\n              <button\n                data-zoom-trigger=\"colombia-banco-de-pamplona-10-pesos-2304\"\n                aria-label=\"Ampliar imagen del segundo ejemplar\"\n                style=\"all:unset; display:block; width:100%; position:relative; cursor:zoom-in;\"\n              >\n                <picture>\n                  <source srcset=\"uploads/colombia-banco-de-pamplona-10-pesos-1884-no2304.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"uploads/colombia-banco-de-pamplona-10-pesos-1884-no2304.jpg\"\n                    alt=\"Billete de Diez Pesos de El Banco de Pamplona, segundo ejemplar Serie C N.º 2304, anverso arriba y reverso abajo\"\n                    width=\"564\"\n                    height=\"651\"\n                    loading=\"lazy\"\n                    decoding=\"async\"\n                    style=\"display:block; width:100%; height:auto;\"\n                  />\n                </picture>\n                <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n                  <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n                  Ampliar\n                </span>\n              </button>\n              <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) &mdash; Serie C, N.&deg; 2304 &mdash; Colección de Notofilia.com</span>\n\n              \n                <div\n                  role=\"dialog\"\n                  aria-modal=\"true\"\n                  aria-label=\"Billete ampliado, segundo ejemplar\"\n                  data-zoom-dialog=\"colombia-banco-de-pamplona-10-pesos-2304\" hidden style=\"display:none\"\n                  style=\"position:fixed; inset:0; z-index:50; background:rgba(5,5,4,0.94); display:flex; flex-direction:column; align-items:center; justify-content:center;\"\n                >\n                  <button\n                    data-zoom-close\n                    aria-label=\"Cerrar\"\n                    style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n                  >&times;</button>\n\n                  <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                    <button\n                      disabled=\"\"\n                      aria-label=\"Alejar\"\n                      style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                    >&minus;</button>\n                    <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\"></span>\n                    <button\n                      disabled=\"\"\n                      aria-label=\"Acercar\"\n                      style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                    >&#43;</button>\n                  </div>\n\n                  <div\n                    style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n                  >\n                    <picture>\n                      <source srcset=\"uploads/colombia-banco-de-pamplona-10-pesos-1884-no2304.webp\" type=\"image/webp\" />\n                      <img\n                        src=\"uploads/colombia-banco-de-pamplona-10-pesos-1884-no2304.jpg\"\n                        alt=\"Billete de Diez Pesos de El Banco de Pamplona, segundo ejemplar, vista ampliada\"\n                        draggable=\"false\"\n                        style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:; user-select:none;\"\n                      />\n                    </picture>\n                  </div>\n\n                  <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n                </div>\n              \n            </div>\n          </section>\n\n        </div>\n      </div>\n\n      <div style=\"width:100%; max-width:760px; margin:44px auto 0; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n        <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n        <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">1. Chávez Salazar, Nelson David. &ldquo;Una revisión microeconómica del episodio de Banca Libre en Colombia: 1865&ndash;1886.&rdquo; <em>Procesos de Mercado: Revista Europea de Economía Política</em>, vol. XIV, n.&deg; 2, oto&ntilde;o de 2017, pp. 259&ndash;289.</p>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
