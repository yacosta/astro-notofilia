h:100%; position:relative; cursor:zoom-in;\"\n          >\n            <picture>\n              <source srcset=\"/uploads/alejandro-ramirez-480.webp 480w, /uploads/alejandro-ramirez-640.webp 640w, /uploads/alejandro-ramirez.webp 903w\" sizes=\"(max-width: 448px) calc(100vw - 48px), 400px\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/alejandro-ramirez.jpg\"\n                alt=\"Retrato litográfico de Alejandro Ramírez y Blanco, intendente de Hacienda de Puerto Rico y Cuba, con uniforme de gala y condecoraciones\"\n                width=\"903\"\n                height=\"1388\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto; border:1px solid rgba(10,10,9,0.12);\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n\n          <div style=\"text-align:center; font-size:14px; line-height:1.6; color:#5c4e33; font-style:italic;\">\n            <span style=\"display:block;\">Litografía de Isidoro Salcedo</span>\n            <span style=\"display:block;\">Biblioteca Nacional de España</span>\n            <span style=\"display:block;\">CC BY-SA 4.0</span>\n          </div>\n\n          \n            <div\n              role=\"dialog\"\n              aria-modal=\"true\"\n              aria-label=\"Retrato ampliado\"\n              data-zoom-dialog=\"alejandro-ramirez\" hidden\n             \n             class=\"catalog-zoom-dialog\">\n              <button\n                data-zoom-close\n                aria-label=\"Cerrar\"\n                style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n              >&times;</button>\n\n              <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n                <button\n                  disabled=\"true\"\n                  aria-label=\"Alejar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&minus;</button>\n                <span style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n                <button\n                  disabled=\"false\"\n                  aria-label=\"Acercar\"\n                  style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n                >&#43;</button>\n              </div>\n\n              <div\n                style=\"overflow:hidden; max-width:92vw; max-height:74vh; touch-action:none;\"\n              >\n                <picture>\n                  <source srcset=\"/uploads/alejandro-ramirez.webp\" type=\"image/webp\" />\n                  <img\n                    src=\"/uploads/alejandro-ramirez.jpg\"\n                    alt=\"Retrato de Alejandro Ramírez, vista ampliada\"\n                    draggable=\"false\"\n                    style=\"display:block; max-width:92vw; max-height:74vh; width:auto; height:auto; transform:; cursor:zoom-in; user-select:none;\"\n                  />\n                </picture>\n              </div>\n\n              <span style=\"margin-top:18px; font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n            </div>\n          \n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          <div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Nacimiento</span>\n              <span style=\"font-size:19px; color:#221f19;\">25 de febrero de 1777 &mdash; Alaejos, Valladolid, España</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Fallecimiento</span>\n              <span style=\"font-size:19px; color:#221f19;\">20 de mayo de 1821 &mdash; La Habana, Cuba</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Profesión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Periodista, Economista e Intendente de Real Hacienda</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Rol Clave</span>\n              <span style=\"font-size:19px; color:#221f19;\">Intendente de Hacienda de Puerto Rico (1813&ndash;1816) y de Cuba (1816&ndash;1821), reformador fiscal ilustrado</span>\n            </div>\n          </div>\n\n          <section style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">1. Formación y Primeros Destinos en Guatemala</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Nacido en Alaejos (Valladolid), Alejandro Ramírez mostró desde joven una notable aptitud administrativa: a los quince años ya trabajaba en la Contaduría de Rentas Decimales de Alcalá de Henares, bajo la protección del cardenal Francisco de Lorenzana.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">En 1794 fue destinado como Contador a la Capitanía General de Guatemala, donde llegaría a ser Secretario del Real Consulado. Durante estos años impulsó mejoras agrícolas en la región y desarrolló la visión reformista ilustrada que marcaría toda su carrera pública.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">2. Intendente de Hacienda de Puerto Rico (1813&ndash;1816)</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Propuesto por el diputado puertorriqueño Ramón Power ante las Cortes de Cádiz, Ramírez juró el cargo de Intendente de Puerto Rico el 14 de diciembre de 1812 y desembarcó en la isla al año siguiente, encontrando una hacienda pública en quiebra.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Abrió los puertos al comercio libre con el extranjero, simplificó el complicado sistema impositivo en una sola contribución y ordenó el retiro de la inflacionaria emisión de papel moneda que circulaba en la isla, devolviendo solidez a las finanzas públicas en tiempo récord.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Fundó además la Sociedad Económica de Amigos del País de Puerto Rico, el Consulado de Agricultura y Comercio, el <em>Diario Económico de Puerto Rico</em> y la Real Lotería de Puerto Rico, la más antigua de América.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">3. Superintendente de Cuba (1816&ndash;1821)</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">En 1816 fue trasladado a La Habana como Intendente de Hacienda y Superintendente de Cuba, cargo en el que replicó y amplió sus reformas: en apenas dos meses resolvió el expediente de tierras realengas de la isla, asentando la propiedad privada y favoreciendo el auge de la agricultura comercial.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Impulsó el fin del estanco del tabaco, la libertad de comercio exterior y numerosas instituciones educativas y científicas, entre ellas la Escuela de Dibujo y Pintura de La Habana, rebautizada en su honor como <strong style=\"color:#1c1a15;\">Academia de San Alejandro</strong>, que existe hasta hoy.</p>\n          </section>\n\n          <section style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">4. Legado para Coleccionistas</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\">Como Intendente de Puerto Rico, Alejandro Ramírez estampó su Visto Bueno en los vales de la <strong style=\"color:#1c1a15;\">Tesorería Nacional de Puerto Rico</strong> emitidos en 1813 para financiar la administración colonial en plena crisis fiscal. Puede verse un ejemplar de esta emisión, con su firma, en la ficha del <a href=\"/coleccion/puerto-rico/tesoreria-nacional-25-pesos-1813/\">25 Pesos de 1813</a> de la colección.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\">Falleció en La Habana en 1821, poco antes de asumir un nuevo destino en Guatemala, dejando tras de sí una reputación excepcional de honestidad y eficacia administrativa en dos de las colonias españolas más importantes del Caribe.</p>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n\n</div>",
