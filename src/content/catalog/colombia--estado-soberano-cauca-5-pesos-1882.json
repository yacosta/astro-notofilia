re>\n              <source srcset=\"/uploads/colombia-estado-soberano-cauca-5-pesos-1882.webp\" type=\"image/webp\" />\n              <img\n                src=\"/uploads/colombia-estado-soberano-cauca-5-pesos-1882.jpg\"\n                alt=\"Vale al portador de Cinco Pesos de El Estado Soberano del Cauca, anverso arriba con escudo de armas del Cauca y rosetón geométrico con el numeral 5, reverso abajo con el texto de refrendación y firmas\"\n                width=\"564\"\n                height=\"498\"\n                loading=\"eager\"\n                decoding=\"async\"\n                style=\"display:block; width:100%; height:auto;\"\n              />\n            </picture>\n            <span style=\"position:absolute; bottom:22px; right:22px; display:flex; align-items:center; gap:8px; background:rgba(10,10,9,0.82); color:#d8d2cd; font-size:13px; letter-spacing:0.08em; padding:8px 14px; border-radius:999px;\">\n              <span style=\"width:6px; height:6px; background:#d8d2cd; transform:rotate(45deg);\"></span>\n              Ampliar\n            </span>\n          </button>\n          <span style=\"font-size:13px; letter-spacing:0.08em; color:#5c4e33; text-align:center; font-style:italic;\">Anverso (arriba) y reverso (abajo) — Colección de Notofilia.com</span>\n<div style=\"display:flex; flex-direction:column;\">\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">País</span>\n              <span style=\"font-size:19px; color:#221f19;\">Colombia (Estado Soberano del Cauca, Popayán)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Entidad Emisora</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Estado Soberano del Cauca, uno de los nueve estados federales de los Estados Unidos de Colombia</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Tipo de Documento</span>\n              <span style=\"font-size:19px; color:#221f19;\">Vale al portador (título de deuda regional, no billete bancario)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Denominación</span>\n              <span style=\"font-size:19px; color:#221f19;\">Cinco Pesos, Clase B</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Material</span>\n              <span style=\"font-size:19px; color:#221f19;\">Papel</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Impresor</span>\n              <span style=\"font-size:19px; color:#221f19;\">Litografía Paredes &amp; Cía., Bogotá</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Marco Legal</span>\n              <span style=\"font-size:19px; color:#221f19;\">Ley N.&deg; 4 de 1881, admisible para el pago de rentas y contribuciones del Estado a razón de un diez por ciento</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Lugar y Fecha de Emisión</span>\n              <span style=\"font-size:19px; color:#221f19;\">Popayán, 1882</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Firmantes</span>\n              <span style=\"font-size:19px; color:#221f19;\">El Presidente del Tribunal Superior de Justicia &middot; El Secretario de Hacienda &middot; El Procurador General del Estado &middot; El Administrador General del Tesoro; refrendado por R. M. Arana (Presidente) y M. S. Barreiro (Secretario)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:200px 1fr; gap:6px 20px; padding:14px 0; border-top:1px solid rgba(10,10,9,0.12); border-bottom:1px solid rgba(10,10,9,0.12);\">\n              <span style=\"font-size:14px; letter-spacing:0.1em; text-transform:uppercase; color:#5c4e33;\">Referencia de Catálogo</span>\n              <span style=\"font-size:19px; color:#221f19;\">Pick n.&deg; S142<sup style=\"font-size:12px;\">1</sup> (S141: 1 Peso &mdash; S143: 10 Pesos, misma serie de Litografía Paredes)</span>\n            </div>\n          </div>\n\n        </div>\n\n        <div style=\"width:100%; max-width:760px;\">\n          \n\n          <div style=\"margin-top:44px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Contexto Histórico y de Emisión</h2>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0 0 12px;\"><strong style=\"color:#1c1a15;\">Un estado dentro de la federación:</strong> bajo la Constitución de Rionegro de 1863, los Estados Unidos de Colombia se organizaron como una federación de nueve estados soberanos con amplia autonomía fiscal, entre ellos el Estado Soberano del Cauca, con capital en Popayán &mdash;cada uno facultado para emitir sus propios vales y billetes de tesorería.</p>\n            <p style=\"font-size:19px; line-height:1.65; color:#332e22; margin:0;\"><strong style=\"color:#1c1a15;\">Respaldado por la ley regional:</strong> este vale se emitió al amparo de la Ley N.&deg; 4 de 1881 del Estado, y era admisible en todas las oficinas de recaudación para el pago de rentas y contribuciones estatales, en la proporción de un diez por ciento &mdash;un mecanismo fiscal habitual entre los estados federales para financiar su tesoro sin depender del Banco Nacional.</p>\n          </div>\n\n          <div style=\"margin-top:36px;\">\n            <h2 style=\"font-size:15px; letter-spacing:0.2em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 14px; font-style:normal;\">Detalles Clave Visibles en el Billete</h2>\n            <ul style=\"list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px;\">\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Anverso:</strong> escudo de armas del Estado Soberano del Cauca a la izquierda; a la derecha, un rosetón geométrico circular que enmarca el numeral &ldquo;5&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Texto principal:</strong> &ldquo;reconoce al portador la suma de CINCO PESOS (sin interés), admisible conforme al artículo 3.&deg; de la ley número 4.&deg; de 1881, en todas las oficinas de recaudación del Estado, en pago de las rentas y contribuciones establecidas o que se establezcan, en la proporción de un diez por ciento&rdquo;.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Firmas:</strong> cuatro rúbricas correspondientes al Presidente del Tribunal Superior de Justicia, el Secretario de Hacienda, el Procurador General del Estado y el Administrador General del Tesoro.</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Reverso:</strong> texto de refrendación &ldquo;Refrendado por ser auténtico y verdadero&rdquo;, firmado por El Presidente (R. M. Arana) y El Secretario (M. S. Barreiro).</span>\n              </li>\n              <li style=\"display:flex; gap:12px; align-items:baseline;\">\n                <span style=\"width:6px; height:6px; min-width:6px; background:#5c4e33; transform:rotate(45deg); position:relative; top:-3px;\"></span>\n                <span style=\"font-size:19px; line-height:1.6; color:#332e22;\"><strong style=\"color:#1c1a15;\">Impresión:</strong> tipografía y ornamentación grabada de la Litografía Paredes &amp; Cía. de Bogotá, casa que imprimió toda la serie de vales de esta emisión, de 1 a 10 pesos.</span>\n              </li>\n            </ul>\n          </div>\n\n          <div style=\"margin-top:44px; padding-top:20px; border-top:1px solid rgba(10,10,9,0.12);\">\n            <h2 style=\"font-size:13px; letter-spacing:0.14em; text-transform:uppercase; color:#5c4e33; font-weight:600; margin:0 0 10px; font-style:normal;\">Notas</h2>\n            <p style=\"font-size:14px; line-height:1.6; color:#5c4e33; margin:0;\">1. Standard Catalog of World Paper Money (Specialized Issues), designación Pick n.&deg; S142, dentro de la sección de emisiones de estados soberanos de Colombia; los vales de la misma serie de Litografía Paredes &amp; Cía. abarcan de Pick S141 (1 Peso) a Pick S143 (10 Pesos).</p>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"Billete ampliado\"\n     \n     data-zoom-dialog=\"note-1\" hidden class=\"catalog-zoom-dialog\">\n      <button\n        data-zoom-close\n        aria-label=\"Cerrar\"\n        style=\"position:absolute; top:24px; right:28px; background:transparent; border:1px solid rgba(231,222,201,0.4); color:#d8d2cd; font-size:22px; line-height:1; width:44px; height:44px; border-radius:50%; cursor:pointer;\"\n      >&times;</button>\n\n      <div style=\"position:absolute; top:24px; left:28px; display:flex; align-items:center; gap:6px; background:rgba(10,10,9,0.5); border:1px solid rgba(231,222,201,0.25); border-radius:999px; padding:6px;\">\n        <button type=\"button\" data-zoom-out\n          disabled=\"true\"\n          aria-label=\"Alejar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&minus;</button>\n        <span data-zoom-percent style=\"min-width:56px; text-align:center; font-size:14px; color:#e7ddc4; letter-spacing:0.05em;\">100%</span>\n        <button\n          disabled=\"false\"\n          data-zoom-in aria-label=\"Acercar\"\n          style=\"width:38px; height:38px; border-radius:50%; border:none; background:transparent; color:#d8d2cd; font-size:20px; cursor:pointer;\"\n        >&#43;</button>\n      </div>\n\n      <div\n        style=\"overflow:hidden; max-width:100vw; max-height:100vh; width:100vw; height:100vh; touch-action:none;\"\n      >\n        <picture>\n          <source srcset=\"/uploads/colombia-estado-soberano-cauca-5-pesos-1882.webp\" type=\"image/webp\" />\n          <img data-zoom-image\n            src=\"/uploads/colombia-estado-soberano-cauca-5-pesos-1882.jpg\"\n            alt=\"Vale al portador de El Estado Soberano del Cauca, vista ampliada\"\n            draggable=\"false\"\n            style=\"display:block; max-width:100vw; max-height:100vh; width:100vw; height:100vh; object-fit:contain; transform:; cursor:zoom-in; user-select:none;\"\n          />\n        </picture>\n      </div>\n\n      <span style=\"position:absolute; bottom:16px; left:50%; transform:translateX(-50%); font-size:14px; letter-spacing:0.06em; color:#b7ab8a; font-style:italic; pointer-events:none;\">Arrastra para mover &middot; Rueda del ratón para ampliar</span>\n    </div>\n  \n\n  \n\n</div>",
