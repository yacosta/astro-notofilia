---
import { getPublishedPosts, metaDescription, titleTag, type PublishedPost } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { toIsoDate } from '../../lib/dates';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostArticle from '../../components/PostArticle.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: PublishedPost<'blog'> };
const { post } = Astro.props;
const d = post.data;
const path = `/blog/${post.slug}/`;
const iso = toIsoDate(d.publishedAt);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  datePublished: iso,
  ...(d.cover ? { image: `${SITE}/uploads/${d.cover}.jpg` } : {}),
  author: { '@type': 'Organization', name: 'Notofilia' },
  publisher: {
    '@type': 'Organization',
    name: 'Notofilia',
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': SITE + path },
  ...(d.sourceUrl ? { isBasedOn: d.sourceUrl } : {}),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: SITE + path },
    ],
  },
};
---
<BlogLayout
  title={titleTag(d.title)}
  description={metaDescription(d.excerpt)}
  path={path}
  ogType="article"
  ogImage={d.cover ? `/uploads/${d.cover}.jpg` : undefined}
  jsonLd={jsonLd}
  keywords={d.keywords}
>
  <PostArticle
    collection="blog"
    post={post}
    sourceLinkLabel="Leer la fuente original"
    backLabel="Volver al Blog"
  />
</BlogLayout>
