---
// Paid identification service — customer intake page (Phase 0).
// Static/prerendered for now: the form is fully built but the submission
// endpoint (/api/checkout → Stripe) and photo upload → R2 are wired in a later
// increment (needs the Cloudflare adapter + D1/R2 bindings + Stripe keys).
// Prices are placeholders ("Precio por confirmar") until set.
import BlogLayout from '../layouts/BlogLayout.astro';

const SITE = 'https://www.notofilia.com';

// Tier definitions. `price` is null until confirmed → renders "Precio por
// confirmar". Set the amount + currency here (e.g. price: 'US$ 15') to go live.
const tiers = [
  {
    id: 'id',
    name: 'Identificación',
    price: null as string | null,
    desc: 'Qué es tu pieza: país, denominación, año, ceca/ensayador, referencia de catálogo, especificaciones físicas, grado estimado y contexto histórico. Incluye informe en línea + PDF + código QR verificable.',
  },
  {
    id: 'id_value',
    name: 'Identificación + Valor estimado',
    price: null as string | null,
    desc: 'Todo lo anterior más un rango de valor de mercado estimado, con razonamiento según el estado de conservación y referencias comparables.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Identificación numismática asistida por IA y revisada por un experto',
  serviceType: 'Identificación de monedas y billetes',
  provider: { '@type': 'Organization', name: 'Notofilia', url: SITE + '/' },
  areaServed: 'Worldwide',
  description:
    'Sube fotos de tu moneda o billete y recibe un informe de identificación asistido por IA y revisado por un experto, con especificaciones, contexto histórico y valor estimado opcional.',
  url: SITE + '/identificar/',
};

// Shared field classes
const labelCls = 'block text-[14px] tracking-[0.02em] text-cream-dim mb-1.5 font-medium';
const inputCls =
  'w-full min-h-[44px] px-4 py-2 bg-transparent border border-[rgba(231,222,201,0.35)] rounded-lg text-cream font-serif text-[16px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2';
const legendCls = 'font-display font-normal text-[clamp(19px,2.6vw,24px)] text-cream mb-4';
---
<BlogLayout
  title="Identifica tu moneda o billete · Notofilia"
  description="Servicio de identificación numismática asistido por IA y revisado por un experto. Sube fotos de tu moneda o billete y recibe un informe con especificaciones y contexto."
  path="/identificar/"
  jsonLd={jsonLd}
>
  <div class="max-w-[760px] mx-auto px-6 pt-12 pb-16">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-6" aria-label="Migas de pan">
      <a class="text-muted" href="/">Inicio</a> <span aria-hidden="true">/</span> <span>Identificación</span>
    </nav>

    <h1 class="font-display font-normal text-[clamp(30px,5vw,46px)] text-cream mt-0 mb-4 leading-[1.1]">
      Identifica tu moneda o billete
    </h1>
    <p class="text-[clamp(18px,2.4vw,21px)] text-cream-dim mt-0 mb-6 leading-[1.5] max-w-[60ch]">
      Sube fotos de tu pieza y recibe un informe de identificación <strong class="text-cream">asistido por IA y revisado por un experto</strong>. Respuesta en un plazo de <strong class="text-cream">3 días hábiles</strong>.
    </p>
    <p class="text-[14px] text-muted mt-0 mb-10 leading-[1.6] max-w-[60ch]">
      Es una opinión de identificación con fines informativos; no constituye una certificación oficial, tasación vinculante ni garantía de autenticidad.
    </p>

    <form action="/api/checkout" method="post" enctype="multipart/form-data" class="flex flex-col gap-10">
      <!-- Tier -->
      <fieldset class="border-0 p-0 m-0">
        <legend class={legendCls}>1 · Elige un servicio</legend>
        <div class="flex flex-col gap-4">
          {tiers.map((t) => (
            <label class="block border border-[rgba(231,222,201,0.25)] rounded-lg p-5 cursor-pointer transition-colors has-[:checked]:border-cream has-[:checked]:bg-[rgba(231,222,201,0.06)] focus-within:outline focus-within:outline-2 focus-within:outline-cream focus-within:outline-offset-2">
              <span class="flex items-start gap-3">
                <input type="radio" name="tier" value={t.id} required class="mt-1.5 w-5 h-5 accent-[#e7ddc4] shrink-0" />
                <span class="flex-1">
                  <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="font-display text-[19px] text-cream">{t.name}</span>
                    <span class="text-[15px] font-semibold text-gold-light">{t.price ?? 'Precio por confirmar'}</span>
                  </span>
                  <span class="block text-[14px] text-muted mt-2 leading-[1.6]">{t.desc}</span>
                </span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Item type -->
      <fieldset class="border-0 p-0 m-0">
        <legend class={legendCls}>2 · ¿Qué vas a identificar?</legend>
        <div class="flex flex-wrap gap-4">
          <label class="inline-flex items-center gap-2 border border-[rgba(231,222,201,0.25)] rounded-full px-5 min-h-[44px] cursor-pointer transition-colors has-[:checked]:border-cream has-[:checked]:bg-[rgba(231,222,201,0.06)] focus-within:outline focus-within:outline-2 focus-within:outline-cream">
            <input type="radio" name="item_type" value="coin" required class="w-4 h-4 accent-[#e7ddc4]" />
            <span class="text-[15px] text-cream-dim">Moneda</span>
          </label>
          <label class="inline-flex items-center gap-2 border border-[rgba(231,222,201,0.25)] rounded-full px-5 min-h-[44px] cursor-pointer transition-colors has-[:checked]:border-cream has-[:checked]:bg-[rgba(231,222,201,0.06)] focus-within:outline focus-within:outline-2 focus-within:outline-cream">
            <input type="radio" name="item_type" value="banknote" required class="w-4 h-4 accent-[#e7ddc4]" />
            <span class="text-[15px] text-cream-dim">Billete</span>
          </label>
        </div>
      </fieldset>

      <!-- Photos -->
      <fieldset class="border-0 p-0 m-0">
        <legend class={legendCls}>3 · Fotos de la pieza</legend>
        <p class="text-[14px] text-muted mt-0 mb-4 leading-[1.6]">
          Fotos nítidas y bien iluminadas de ambas caras, sobre fondo neutro. Buenas fotos = mejor identificación.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class={labelCls} for="obverse">Anverso (frente) <span class="text-gold-light" aria-hidden="true">*</span></label>
            <input type="file" id="obverse" name="obverse" accept="image/*" required
              class="block w-full text-[14px] text-muted file:mr-4 file:min-h-[44px] file:px-4 file:rounded-lg file:border file:border-[rgba(231,222,201,0.35)] file:bg-transparent file:text-cream-dim file:font-serif file:cursor-pointer" />
          </div>
          <div>
            <label class={labelCls} for="reverse">Reverso (dorso) <span class="text-gold-light" aria-hidden="true">*</span></label>
            <input type="file" id="reverse" name="reverse" accept="image/*" required
              class="block w-full text-[14px] text-muted file:mr-4 file:min-h-[44px] file:px-4 file:rounded-lg file:border file:border-[rgba(231,222,201,0.35)] file:bg-transparent file:text-cream-dim file:font-serif file:cursor-pointer" />
          </div>
        </div>
      </fieldset>

      <!-- Optional measurements -->
      <fieldset class="border-0 p-0 m-0">
        <legend class={legendCls}>4 · Medidas <span class="text-[15px] text-muted font-serif">(opcional)</span></legend>
        <p class="text-[14px] text-muted mt-0 mb-4 leading-[1.6]">Si las tienes a mano, mejoran la precisión —sobre todo en monedas.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class={labelCls} for="weight_g">Peso (g)</label>
            <input type="text" inputmode="decimal" id="weight_g" name="weight_g" placeholder="27,07" class={inputCls} />
          </div>
          <div>
            <label class={labelCls} for="dimensions">Diámetro / dimensiones (mm)</label>
            <input type="text" id="dimensions" name="dimensions" placeholder="39" class={inputCls} />
          </div>
        </div>
      </fieldset>

      <!-- Contact -->
      <fieldset class="border-0 p-0 m-0">
        <legend class={legendCls}>5 · Tus datos</legend>
        <div class="flex flex-col gap-5">
          <div>
            <label class={labelCls} for="customer_name">Nombre <span class="text-gold-light" aria-hidden="true">*</span></label>
            <input type="text" id="customer_name" name="customer_name" required autocomplete="name" class={inputCls} />
          </div>
          <div>
            <label class={labelCls} for="customer_email">Correo electrónico <span class="text-gold-light" aria-hidden="true">*</span></label>
            <input type="email" id="customer_email" name="customer_email" required autocomplete="email" class={inputCls} />
            <p class="text-[13px] text-muted mt-1.5">Enviaremos el informe a esta dirección.</p>
          </div>
          <div>
            <label class={labelCls} for="notes">Notas <span class="text-[13px] text-muted">(procedencia, dudas, etc.)</span></label>
            <textarea id="notes" name="notes" rows="4" class={`${inputCls} min-h-[112px] resize-y`}></textarea>
          </div>
        </div>
      </fieldset>

      <!-- Consent -->
      <label class="flex items-start gap-3 text-[14px] text-muted leading-[1.6]">
        <input type="checkbox" name="consent" required class="mt-1 w-5 h-5 accent-[#e7ddc4] shrink-0" />
        <span>
          He leído y acepto la <a href="/politica-privacidad-cookies/" class="text-cream underline">Política de Privacidad y Cookies</a>. Entiendo que este es un servicio de identificación con fines informativos y no constituye una certificación oficial, tasación vinculante ni garantía de autenticidad.
        </span>
      </label>

      <!-- Submit -->
      <div>
        <button type="submit"
          class="inline-flex items-center justify-center min-h-[48px] px-8 py-3 bg-cream text-bg border border-cream rounded-full font-serif font-semibold text-[15px] tracking-[0.08em] uppercase cursor-pointer transition-colors hover:bg-cream-dim hover:border-cream-dim focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2">
          Continuar al pago &rarr;
        </button>
        <p class="text-[13px] text-muted mt-3">El pago seguro y la entrega del informe se activarán próximamente.</p>
      </div>
    </form>
  </div>
</BlogLayout>
