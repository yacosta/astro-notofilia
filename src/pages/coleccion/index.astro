---
/**
 * Global collection hub — /coleccion/
 * Replaces the obsolete-U.S. catalog formerly served at this path.
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import CookieBanner from '../../components/CookieBanner.astro';
import PreFooter from '../../components/PreFooter.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { lookupEn } from '../../lib/html-i18n';
import { SITE } from '../../lib/site';
import {
  FEATURED_ENTRIES,
  RECENT_PIECES,
  hubLead,
  hubLeadEn,
} from '../../lib/catalog-hub';
import {
  getCollectionStats,
  INVENTORY_VOCABULARY_ES,
  INVENTORY_VOCABULARY_EN,
  inventoryProperties,
} from '../../lib/stats';

const catalogIndex = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'public/data/catalog-index.json'), 'utf8'),
) as {
  countries: Array<{ name: string; count: number; slug: string }>;
  items: Array<{
    country?: string;
    issuer?: string;
    material?: string;
    kind?: string;
  }>;
};

const stats = await getCollectionStats();
const lead = hubLead(stats);
const leadEn = hubLeadEn(stats);
const title = 'Colección Virtual de Billetes y Monedas | Notofilia';
const description =
  `Explora ${stats.billetes} billetes en ${stats.fichas} fichas y ${stats.monedas} monedas de ${stats.paises} países.`;

const countries = catalogIndex.countries ?? [];
const catalogItems = catalogIndex.items ?? [];

const uniqueSorted = (values: Array<string | undefined>) =>
  [...new Set(values.map((v) => (v || '').trim()).filter(Boolean))].sort((a, b) =>
    a.localeCompare(b, 'es', { sensitivity: 'base' }),
  );

const issuerOptions = uniqueSorted(catalogItems.map((item) => item.issuer));
const materialOptions = uniqueSorted(catalogItems.map((item) => item.material));
const countryOptions = uniqueSorted([
  ...countries.map((c) => c.name),
  ...catalogItems.map((item) => item.country),
]);

const filterParams = Astro.url.searchParams;
const selectedPais = filterParams.get('pais') || '';
const selectedEmisor = filterParams.get('emisor') || '';
const selectedMaterial = filterParams.get('material') || '';
const selectedTipo = filterParams.get('tipo') || '';
const selectedOrden = filterParams.get('orden') || 'newest';
const selectedQ = filterParams.get('q') || '';
const selectedDesde = filterParams.get('desde') || '';
const selectedHasta = filterParams.get('hasta') || '';
const selectedDenom = filterParams.get('denom') || '';
const selectedCondicion = filterParams.get('condicion') || '';
const selectedCatalogo = filterParams.get('catalogo') || '';
const selectedVista = filterParams.get('vista') === 'lista' ? 'list' : 'grid';

const countryList = countries.slice(0, 40).map((c, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: c.name,
  url: `${SITE}/coleccion/${c.slug}/`,
  item: {
    '@type': 'CreativeWork',
    name: `Catálogo: ${c.name}`,
    url: `${SITE}/coleccion/${c.slug}/`,
  },
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Notofilia',
          item: `${SITE}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Colección Virtual',
          item: `${SITE}/coleccion/`,
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/coleccion/#page`,
      name: 'Colección Virtual de Billetes y Monedas',
      url: `${SITE}/coleccion/`,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE}/#website` },
      about: {
        '@type': 'Thing',
        name: 'Notafilia y numismática',
      },
      mainEntity: { '@id': `${SITE}/coleccion/#itemlist` },
      additionalProperty: [
        {
          '@type': 'PropertyValue',
          name: 'Disponibilidad',
          value: 'No está a la venta — colección privada documentada',
        },
        ...inventoryProperties(stats),
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE}/coleccion/#itemlist`,
      name: 'Índice de catálogos por país y tema',
      numberOfItems: stats.paises,
      itemListElement: countryList,
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      path="/coleccion/"
      robots="index, follow, max-image-preview:large"
      ogType="website"
      ogTitle="Colección Virtual de Billetes y Monedas — Notofilia"
      ogDescription={description}
      ogImage="/uploads/state-bank-new-brunswick-1-dollar.jpg"
      jsonLd={jsonLd}
      loadDcRuntime={false}
    />
    <link rel="stylesheet" href="/catalog-fonts.css" />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      html, body, #dc-root, #dc-root > .sc-host { height: auto !important; }
      body { margin: 0; background: #0a0a09; }
      x-dc { display: none; }
      img { max-width: 100%; height: auto; }
      ::selection { background: rgba(138, 109, 59, 0.25); }
    </style>
    <style>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .hub {
        color: var(--color-cream-dim);
        background:
          radial-gradient(circle at 50% -8%, rgba(138, 109, 59, 0.12), transparent 34rem),
          var(--color-bg);
        font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
      }
      .hub-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 64px var(--page-gutter, 24px) 96px;
      }
      .hub h1 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.05;
        color: #d8d2cd;
        margin: 0 0 20px;
        max-width: 28ch;
      }
      .hub-lead {
        font-size: clamp(18px, 1.8vw, 21px);
        line-height: 1.7;
        color: #d8d2cd;
        max-width: 42rem;
        margin: 0 0 40px;
      }
      .hub-search {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin: 0 0 56px;
      }
      .hub-search input[type='search'] {
        flex: 1 1 280px;
        min-height: 52px;
        padding: 14px 18px;
        font: inherit;
        font-size: 18px;
        color: #1c1a15;
        background: #d8d2cd;
        border: 1px solid rgba(10, 10, 9, 0.12);
        border-radius: 3px;
      }
      .hub-search input[type='search']:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .hub-search button {
        min-height: 52px;
        min-width: 44px;
        padding: 12px 22px;
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #0a0a09;
        background: #e7ddc4;
        border: 1px solid transparent;
        border-radius: 3px;
        cursor: pointer;
      }
      .hub-search button:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .hub-section {
        margin: 0 0 72px;
        padding-top: 48px;
        border-top: 1px solid rgba(231, 222, 201, 0.18);
      }
      .hub-kicker {
        display: block;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #b7ab8a;
        margin-bottom: 14px;
      }
      .hub h2 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1.15;
        color: #d8d2cd;
        margin: 0 0 12px;
      }
      .hub-section-lead {
        font-size: 18px;
        line-height: 1.65;
        color: #b7ab8a;
        max-width: 40rem;
        margin: 0 0 28px;
      }
      .featured-grid,
      .country-grid,
      .recent-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 18px 28px;
      }
      .featured-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      }
      .featured-grid a,
      .country-grid a {
        display: block;
        min-height: 44px;
        padding-top: 14px;
        border-top: 2px solid rgba(216, 210, 205, 0.35);
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .featured-grid a:hover,
      .country-grid a:hover {
        border-color: #e7ddc4;
      }
      .featured-grid a:focus-visible,
      .country-grid a:focus-visible,
      .recent-grid a:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 4px;
      }
      .featured-title,
      .country-name {
        display: block;
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(18px, 1.2vw, 22px);
        color: #d8d2cd;
        margin-bottom: 6px;
      }
      .featured-desc,
      .country-count {
        display: block;
        font-size: 15px;
        line-height: 1.5;
        color: #b7ab8a;
      }
      .country-grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      }
      .recent-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      }
      .recent-grid a {
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        min-height: 44px;
      }
      .recent-grid picture {
        display: block;
        overflow: hidden;
        border-radius: 3px;
        background: #fff;
        aspect-ratio: 4 / 3;
      }
      .recent-grid img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.4s ease;
      }
      .recent-grid a:hover img {
        transform: scale(1.03);
      }
      @media (prefers-reduced-motion: reduce) {
        .recent-grid img { transition: none; }
        .recent-grid a:hover img { transform: none; }
      }
      .recent-title {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(17px, 1.1vw, 20px);
        color: #d8d2cd;
      }
      .recent-desc {
        font-size: 15px;
        line-height: 1.55;
        color: #b7ab8a;
      }

      :global(#catalog-browser[data-loading] .catalog-results::before) {
        content: 'Cargando catálogo…';
        display: block;
        color: #b7ab8a;
        margin-bottom: 16px;
      }
      .filter-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 16px;
        align-items: end;
        margin-bottom: 20px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 14px 16px;
        width: 100%;
      }
      .filter-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .filter-field label {
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #b7ab8a;
        font-weight: 600;
      }
      .filter-field input,
      .filter-field select {
        min-height: 44px;
        padding: 10px 12px;
        font: inherit;
        font-size: 15px;
        color: #1c1a15;
        background: #d8d2cd;
        border: 1px solid rgba(10, 10, 9, 0.12);
        border-radius: 3px;
      }
      .filter-field input:focus-visible,
      .filter-field select:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 8px;
      }
      .filter-actions button,
      .view-toggle button {
        min-height: 44px;
        min-width: 44px;
        padding: 10px 16px;
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #d8d2cd;
        background: transparent;
        border: 1px solid rgba(231, 222, 201, 0.35);
        border-radius: 3px;
        cursor: pointer;
      }
      .view-toggle button[aria-pressed='true'] {
        color: #0a0a09;
        background: #e7ddc4;
        border-color: #e7ddc4;
      }
      .view-toggle button:focus-visible,
      .filter-actions button:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .result-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        align-items: center;
        justify-content: space-between;
        margin: 24px 0 16px;
      }
      :global(#catalog-result-count) {
        font-size: 15px;
        color: #b7ab8a;
      }
      :global(.catalog-results) {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      :global(.catalog-country-group + .catalog-country-group) {
        margin-top: 56px;
      }
      :global(.catalog-country-kicker) {
        display: block;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #b7ab8a;
        margin-bottom: 10px;
      }
      :global(.catalog-country-title) {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(22px, 2.6vw, 30px);
        line-height: 1.15;
        color: #d8d2cd;
        margin: 0 0 24px;
      }
      :global(.catalog-result-list) {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      :global(.catalog-results[data-view='grid'] .catalog-result-list) {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 24px;
      }
      :global(.catalog-results[data-view='list'] .catalog-result-list) {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      :global(.catalog-result-link) {
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.018), transparent 42%),
          #161410;
        border: 1px solid rgba(231, 222, 201, 0.14);
        border-radius: 3px;
        overflow: hidden;
        min-height: 44px;
        transition: border-color 0.2s ease, transform 0.15s ease;
      }
      :global(.catalog-result-link:hover) {
        border-color: rgba(231, 222, 201, 0.4);
        transform: translateY(-2px);
      }
      :global(.catalog-result-link:focus-visible) {
        outline: 2px solid #e7ddc4;
        outline-offset: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        :global(.catalog-result-link) { transition: none; }
        :global(.catalog-result-link:hover) { transform: none; }
      }
      :global(.catalog-results[data-view='list'] .catalog-result-link) {
        flex-direction: row;
        align-items: stretch;
      }
      :global(.catalog-result-media) {
        display: block;
        background: #fff;
        aspect-ratio: 4 / 3;
      }
      :global(.catalog-results[data-view='list'] .catalog-result-media) {
        width: 140px;
        min-width: 140px;
        aspect-ratio: auto;
        align-self: stretch;
      }
      :global(.catalog-result-media picture),
      :global(.catalog-result-media img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      :global(.catalog-result-body) {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px 18px 20px;
      }
      :global(.catalog-result-meta) {
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #b7ab8a;
      }
      :global(.catalog-result-title) {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(17px, 1.1vw, 20px);
        line-height: 1.2;
        color: #d8d2cd;
      }
      :global(.catalog-result-sub),
      :global(.catalog-result-ref) {
        font-size: 14px;
        line-height: 1.45;
        color: #b7ab8a;
      }
      :global(.catalog-result-ref) {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      :global(#catalog-empty) {
        color: #b7ab8a;
        font-size: 17px;
        margin: 24px 0 0;
      }
      @media (max-width: 640px) {
        .hub-inner { padding-top: 48px; }
        :global(.catalog-results[data-view='list'] .catalog-result-media) {
          width: 96px;
          min-width: 96px;
        }
      }
    </style>
  </head>
  <body>
    <a
      href="#main-content"
      class="absolute left-[-9999px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
      data-i18n
      data-en="Skip to main content"
    >Saltar al contenido principal</a>

    <SiteHeader />

    <div class="hub">
      <main id="main-content" class="hub-inner" tabindex="-1" data-pagefind-meta="url:/coleccion/">
        <h1 data-i18n data-en={`Virtual Collection: ${stats.billetes} banknotes and ${stats.monedas} coins from ${stats.paises} countries`}>Colección Virtual: {stats.billetes} billetes y {stats.monedas} monedas de {stats.paises} países</h1>
        <p class="hub-lead" data-i18n data-en={leadEn}>{lead}</p>
        <p class="hub-lead" style="margin-top:-24px; font-size:17px; color:#b7ab8a;" data-i18n data-en={INVENTORY_VOCABULARY_EN}>
          {INVENTORY_VOCABULARY_ES}
        </p>

        <ul class="featured-grid" style="margin: 0 0 40px;">
          <li>
            <a href="/coleccion/numismatica/">
              <span class="featured-title" data-i18n data-en="Numismatics catalog">Catálogo de numismática</span>
              <span class="featured-desc" data-i18n data-en="Struck coins: colonial gold from Santa Fe de Bogotá.">Monedas acuñadas: oro colonial de Santa Fe de Bogotá.</span>
            </a>
          </li>
          <li>
            <a href="#explorar">
              <span class="featured-title" data-i18n data-en="Notaphily catalog">Catálogo de notafilia</span>
              <span class="featured-desc" data-i18n data-en="Banknotes, specimens, errors, and paper money of the world.">Billetes, specimens, errores y papel moneda del mundo.</span>
            </a>
          </li>
        </ul>

        <form class="hub-search" action="/coleccion/" method="get" role="search">
          <label class="sr-only" for="catalog-search-hero" data-i18n data-en="Search the collection">Buscar en la colección</label>
          <input
            id="catalog-search-hero"
            type="search"
            name="q"
            value={selectedQ}
            placeholder="Buscar país, emisor, Pick, Friedberg, denominación…"
            data-i18n
            data-i18n-target="placeholder"
            data-en="Search country, issuer, Pick, Friedberg, denomination…"
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="submit" data-i18n data-en="Search">Buscar</button>
        </form>

        <section class="hub-section" aria-labelledby="featured-heading">
          <span class="hub-kicker" data-i18n data-en="Featured entry points">Accesos destacados</span>
          <h2 id="featured-heading" data-i18n data-en="Collections and themes">Colecciones y temas</h2>
          <p class="hub-section-lead" data-i18n data-en="Enter by country, material, or type without scrolling the whole index.">
            Entra por país, material o tipología sin recorrer todo el índice.
          </p>
          <ul class="featured-grid">
            {FEATURED_ENTRIES.map((entry) => (
              <li>
                <a href={entry.href}>
                  <span class="featured-title" data-i18n data-en={entry.titleEn}>{entry.title}</span>
                  <span class="featured-desc" data-i18n data-en={entry.descriptionEn}>{entry.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" aria-labelledby="countries-heading">
          <span class="hub-kicker" data-i18n data-en="By country">Por país</span>
          <h2 id="countries-heading" data-i18n data-en="Countries in the collection">Países en la colección</h2>
          <p class="hub-section-lead" data-i18n data-en={`${stats.paises} countries with documented records. The filter opens the browser below.`}>
            {stats.paises} países con fichas documentadas. El filtro abre el explorador abajo.
          </p>
          <ul class="country-grid">
            {countries.map((c) => (
              <li>
                <a
                  href={`/coleccion/?pais=${encodeURIComponent(c.name)}#explorar`}
                  data-filter-pais={c.name}
                >
                  <span class="country-name" data-i18n={lookupEn(c.name) ? true : undefined} data-en={lookupEn(c.name)}>{c.name}</span>
                  <span class="country-count" data-i18n data-en={c.count === 1 ? '1 record' : `${c.count} records`}>
                    {c.count === 1 ? '1 ficha' : `${c.count} fichas`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" aria-labelledby="recent-heading">
          <span class="hub-kicker" data-i18n data-en="Recent">Recientes</span>
          <h2 id="recent-heading" data-i18n data-en="Recently added pieces">Piezas añadidas recientemente</h2>
          <p class="hub-section-lead" data-i18n data-en="Recent highlights from the Virtual Collection.">
            Destacados recientes de la Colección Virtual.
          </p>
          <ul class="recent-grid">
            {RECENT_PIECES.map((item) => (
              <li>
                <a href={item.href}>
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`/uploads/${item.imageBase}-card.webp 440w, /uploads/${item.imageBase}-card-2x.webp 660w`}
                      sizes="(max-width: 640px) 90vw, 280px"
                    />
                    <img
                      src={`/uploads/${item.imageBase}-card.jpg`}
                      alt={item.imageAlt}
                      width="440"
                      height="280"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <span class="recent-title" data-i18n data-en={item.titleEn}>{item.title}</span>
                  <span class="recent-desc" data-i18n data-en={item.descriptionEn}>{item.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" id="explorar" aria-labelledby="browse-heading">
          <span class="hub-kicker" data-i18n data-en="Browse">Explorar</span>
          <h2 id="browse-heading" data-i18n data-en="Full catalog">Catálogo completo</h2>
          <p class="hub-section-lead" data-i18n data-en="Pieces are grouped by country. Filter by issuer, year, denomination, type, material, condition, and catalog reference.">
            Las piezas se agrupan por país. Filtra por emisor, año, denominación, tipo, material, condición y referencia de catálogo.
          </p>

          <div id="catalog-browser" data-loading>
            <form id="catalog-filters" class="filter-toolbar" action="/coleccion/" method="get">
              <div class="filter-grid">
                <div class="filter-field" style="grid-column: 1 / -1;">
                  <label for="catalog-search" data-i18n data-en="Search">Búsqueda</label>
                  <input
                    id="catalog-search"
                    name="q"
                    type="search"
                    value={selectedQ}
                    placeholder="Texto libre…"
                    data-i18n
                    data-i18n-target="placeholder"
                    data-en="Free text…"
                    autocomplete="off"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-pais" data-i18n data-en="Country">País</label>
                  <select id="filter-pais" name="pais">
                    <option value="" data-i18n data-en="All">Todos</option>
                    {countryOptions.map((name) => (
                      <option value={name} selected={selectedPais === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-emisor" data-i18n data-en="Issuer">Emisor</label>
                  <select id="filter-emisor" name="emisor">
                    <option value="" data-i18n data-en="All">Todos</option>
                    {issuerOptions.map((name) => (
                      <option value={name} selected={selectedEmisor === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-tipo" data-i18n data-en="Type">Tipo</label>
                  <select id="filter-tipo" name="tipo">
                    <option value="" selected={selectedTipo === ''}>Todos</option>
                    <option value="banknote" selected={selectedTipo === 'banknote'} data-i18n data-en="Banknote">Billete</option>
                    <option value="coin" selected={selectedTipo === 'coin'} data-i18n data-en="Coin">Moneda</option>
                    <option value="specimen" selected={selectedTipo === 'specimen'}>Specimen</option>
                    <option value="error" selected={selectedTipo === 'error'} data-i18n data-en="Error">Error</option>
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-material" data-i18n data-en="Material">Material</label>
                  <select id="filter-material" name="material">
                    <option value="" data-i18n data-en="All">Todos</option>
                    {materialOptions.map((name) => (
                      <option value={name} selected={selectedMaterial === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-desde" data-i18n data-en="Year from">Año desde</label>
                  <input
                    id="filter-desde"
                    name="desde"
                    type="number"
                    inputmode="numeric"
                    min="1700"
                    max="2100"
                    value={selectedDesde}
                    placeholder="p. ej. 1860"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-hasta" data-i18n data-en="Year to">Año hasta</label>
                  <input
                    id="filter-hasta"
                    name="hasta"
                    type="number"
                    inputmode="numeric"
                    min="1700"
                    max="2100"
                    value={selectedHasta}
                    placeholder="p. ej. 1970"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-denom" data-i18n data-en="Denomination">Denominación</label>
                  <input
                    id="filter-denom"
                    name="denom"
                    type="search"
                    value={selectedDenom}
                    placeholder="peso, dólar…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-condicion" data-i18n data-en="Condition">Condición</label>
                  <input
                    id="filter-condicion"
                    name="condicion"
                    type="search"
                    value={selectedCondicion}
                    placeholder="PMG, AU…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-catalogo" data-i18n data-en="Catalog reference">Referencia de catálogo</label>
                  <input
                    id="filter-catalogo"
                    name="catalogo"
                    type="search"
                    value={selectedCatalogo}
                    placeholder="Pick, Friedberg, KM…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-orden" data-i18n data-en="Sort">Orden</label>
                  <select id="filter-orden" name="orden">
                    <option value="newest" selected={selectedOrden === 'newest'} data-i18n data-en="Newest (year)">Más recientes (año)</option>
                    <option value="year" selected={selectedOrden === 'year'} data-i18n data-en="Issue date">Fecha de emisión</option>
                    <option value="country" selected={selectedOrden === 'country'} data-i18n data-en="Country">País</option>
                    <option value="denom" selected={selectedOrden === 'denom'} data-i18n data-en="Denomination">Denominación</option>
                  </select>
                </div>
              </div>
              <div class="filter-actions">
                <button type="button" id="catalog-clear-filters" data-i18n data-en="Clear filters">Limpiar filtros</button>
                <div class="view-toggle" role="group" aria-label="Vista de resultados" data-i18n data-i18n-target="aria-label" data-en="Results view">
                  <button type="button" data-view="grid" aria-pressed={selectedVista === 'grid' ? 'true' : 'false'} data-i18n data-en="Grid">Cuadrícula</button>
                  <button type="button" data-view="list" aria-pressed={selectedVista === 'list' ? 'true' : 'false'} data-i18n data-en="List">Lista</button>
                </div>
              </div>
            </form>

            <div class="result-meta-row">
              <p id="catalog-result-count" aria-live="polite" data-i18n data-en="Loading…">Cargando…</p>
            </div>
            <p id="catalog-empty" hidden data-i18n data-en="No pieces match those criteria. Try widening the filter.">No hay piezas con esos criterios. Prueba a ampliar el filtro.</p>
            <div id="catalog-results" class="catalog-results" data-view="grid"></div>
          </div>
        </section>
      </main>
    </div>

    <PreFooter />
    <SiteFooter variant="editorial" />
    <CookieBanner />
    <script src="/coleccion-hub.js" defer is:inline></script>
  </body>
</html>
