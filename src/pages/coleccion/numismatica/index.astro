---
/**
 * Dedicated coins catalog — /coleccion/numismatica/
 * Parallel to the global /coleccion/ hub, which is banknote-heavy.
 */
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import CookieBanner from '../../../components/CookieBanner.astro';
import PreFooter from '../../../components/PreFooter.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CatalogHubGrid from '../../../components/catalog/CatalogHubGrid.astro';
import NewWindowHint from '../../../components/NewWindowHint.astro';
import { SITE } from '../../../lib/site';
import { coinCatalogCards, groupedCoinCards } from '../../../lib/coins-catalog';

const cards = coinCatalogCards();
const groups = groupedCoinCards(cards);
const count = cards.length;
const title = 'Catálogo de Numismática | Notofilia';
const description =
  `Catálogo de ${count} monedas documentadas: oro colonial de Santa Fe, cobres de necesidad de la independencia y piezas de comercio.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Notofilia', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Colección Virtual', item: `${SITE}/coleccion/` },
        { '@type': 'ListItem', position: 3, name: 'Numismática', item: `${SITE}/coleccion/numismatica/` },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/coleccion/numismatica/#page`,
      name: 'Catálogo de Numismática',
      url: `${SITE}/coleccion/numismatica/`,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@type': 'Thing', name: 'Numismática' },
      mainEntity: { '@id': `${SITE}/coleccion/numismatica/#itemlist` },
      additionalProperty: [
        {
          '@type': 'PropertyValue',
          name: 'Disponibilidad',
          value: 'No está a la venta — colección privada documentada',
        },
        {
          '@type': 'PropertyValue',
          name: 'Tipo de ficha',
          value: 'Registro de colección virtual',
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE}/coleccion/numismatica/#itemlist`,
      name: 'Índice de monedas de la Colección Virtual',
      numberOfItems: count,
      itemListElement: cards.map((card, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: card.title,
        url: `${SITE}${card.href}`,
        item: {
          '@type': 'CreativeWork',
          name: card.title,
          url: `${SITE}${card.href}`,
        },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="es" data-page-locale="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      path="/coleccion/numismatica/"
      locale="es"
      robots="index, follow, max-image-preview:large"
      ogType="website"
      ogTitle="Catálogo de Numismática — Notofilia"
      ogDescription={description}
      ogImage="/uploads/colombia-2-escudos-felipe-v-santa-fe-bogota.jpg"
      jsonLd={jsonLd}
      loadDcRuntime={false}
    />
    <link rel="stylesheet" href="/catalog-fonts.css" />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: #0a0a09; }
      img { max-width: 100%; height: auto; }
      ::selection { background: rgba(138, 109, 59, 0.25); }
    </style>
    <style>
      .hub {
        color: var(--color-cream-dim);
        background:
          radial-gradient(circle at 50% -8%, rgba(138, 109, 59, 0.12), transparent 34rem),
          var(--color-bg);
        font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
      }
      .hub-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 64px var(--page-gutter, 24px) 96px;
      }
      .hub h1 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.05;
        color: #d8d2cd;
        margin: 0 0 20px;
        max-width: 18ch;
      }
      .hub-lead {
        font-size: clamp(18px, 1.8vw, 21px);
        line-height: 1.7;
        color: #d8d2cd;
        max-width: 42rem;
        margin: 0 0 20px;
      }
      .hub-note {
        font-size: 16px;
        line-height: 1.7;
        color: #b7ab8a;
        max-width: 46rem;
        margin: 0 0 40px;
      }
      .hub-note a {
        color: #d8d2cd;
        text-decoration: underline;
        text-decoration-color: rgba(216, 210, 205, 0.4);
      }
      .hub-note a:focus-visible,
      .split-grid a:focus-visible,
      .hub-more:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 4px;
      }
      .split-grid {
        list-style: none;
        margin: 0 0 56px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px 28px;
      }
      .split-grid a {
        display: block;
        min-height: 44px;
        padding-top: 14px;
        border-top: 2px solid rgba(216, 210, 205, 0.35);
        color: inherit;
        text-decoration: none;
      }
      .split-grid a:hover { border-color: #e7ddc4; }
      .split-title {
        display: block;
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(18px, 1.2vw, 22px);
        color: #d8d2cd;
        margin-bottom: 6px;
      }
      .split-desc {
        display: block;
        font-size: 15px;
        line-height: 1.5;
        color: #b7ab8a;
      }
      .hub-section {
        margin: 0 0 72px;
        padding-top: 48px;
        border-top: 1px solid rgba(231, 222, 201, 0.18);
      }
      .hub-kicker {
        display: block;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #b7ab8a;
        margin-bottom: 14px;
      }
      .hub h2 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1.15;
        color: #d8d2cd;
        margin: 0 0 12px;
      }
      .hub-section-lead {
        font-size: 18px;
        line-height: 1.65;
        color: #b7ab8a;
        max-width: 40rem;
        margin: 0 0 28px;
      }
      .hub-more {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: 8px;
        color: #e7ddc4;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .hub-more:hover { color: #fff; }
      .catalog-hub-grid {
        padding-left: 0 !important;
        padding-right: 0 !important;
        max-width: none !important;
      }
    </style>
  </head>
  <body>
    <a
      href="#main-content"
      class="absolute left-[-10000px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
      data-i18n
      data-en="Skip to main content"
    >Saltar al contenido principal</a>

    <SiteHeader path="/coleccion/numismatica/" />

    <div class="hub">
      <main id="main-content" class="hub-inner" tabindex="-1" data-pagefind-meta="url:/coleccion/numismatica/">
        <h1 data-i18n data-en="Numismatics catalog">Catálogo de Numismática</h1>
        <p class="hub-lead" data-i18n data-en={`${count} coins documented with images, mint data, and catalog references — colonial Bogotá gold, independence-era necessity copper, and international trade pieces.`}>
          {count} monedas documentadas con imágenes, ceca y referencias de catálogo — oro colonial de Bogotá, cobres de necesidad de la independencia y piezas de comercio internacional.
        </p>
        <p class="hub-note">
          <span data-i18n data-en="The Virtual Collection separates">La Colección Virtual separa</span>
          {' '}
          <strong data-i18n data-en="numismatics">numismática</strong>
          {' '}
          <span data-i18n data-en="(struck coins) from"> (monedas acuñadas) de</span>
          {' '}
          <a href="/coleccion/colombia/" data-i18n data-en="notaphily">notafilia</a>
          {' '}
          <span data-i18n data-en="(banknotes and paper money). The colonial Spanish series covers the Santa Fe de Bogotá mint; royalist necessity copper from Santa Marta and world trade coinage are listed by region. Source:">(billetes y papel moneda). La serie colonial española cubre la ceca de Santa Fe de Bogotá; el cobre de necesidad realista de Santa Marta y monedas de comercio del mundo se listan por región. Fuente:</span>
          {' '}
          <a
            href="https://www.enumismatic.com/mints-history/santa-fe/es/la-ceca-de-santa-fe"
            target="_blank"
            rel="noopener noreferrer"
          ><span data-i18n data-en="“The Santa Fe Mint”, eNumismatic">«La Ceca de Santa Fe», eNumismatic</span><NewWindowHint /></a>.
        </p>

        <ul class="split-grid">
          <li>
            <a href="/coleccion/moneda-colonial-espanola/">
              <span class="split-title" data-i18n data-en="Spanish colonial coinage">Moneda colonial española</span>
              <span class="split-desc" data-i18n data-en="Thematic catalog of the Santa Fe de Bogotá mint.">Catálogo temático de la ceca de Santa Fe de Bogotá.</span>
            </a>
          </li>
          <li>
            <a href="/coleccion/colombia/">
              <span class="split-title" data-i18n data-en="Colombia banknotes">Billetes de Colombia</span>
              <span class="split-desc" data-i18n data-en="Free banking, Banco de la República, and notes printed abroad.">Banca libre, Banco de la República y emisiones en el extranjero.</span>
            </a>
          </li>
        </ul>

        <section class="hub-section" aria-labelledby="coins-heading">
          <span class="hub-kicker" data-i18n data-en="Coin collection">Colección de monedas</span>
          <h2 id="coins-heading" data-i18n data-en="Documented coins">Monedas documentadas</h2>
          <p class="hub-section-lead" data-i18n data-en={`${groups.length} groups. Each record links the piece, mint, and catalog references.`}>
            {groups.length} grupos. Cada ficha enlaza la pieza, la ceca y las referencias de catálogo.
          </p>
          <CatalogHubGrid cards={cards} labelledBy="coins-heading" headingLevel={3} />
          <a class="hub-more" href="/coleccion/moneda-colonial-espanola/" data-i18n data-en="See the Spanish colonial catalog">Ver el catálogo colonial español</a>
        </section>
      </main>
    </div>

    <PreFooter />
    <SiteFooter variant="editorial" />
    <CookieBanner />
  </body>
</html>
