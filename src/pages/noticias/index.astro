---
import { SITE } from '../../lib/site';
import { getPublishedPosts } from '../../lib/posts';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCollectionIndex from '../../components/PostCollectionIndex.astro';

const posts = await getPublishedPosts('noticias');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Noticias de Numismática y Notafilia',
  url: `${SITE}/noticias/`,
  description:
    'Noticias y artículos sobre numismática y notafilia: subastas, emisiones y hallazgos para coleccionistas.',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Noticias', item: `${SITE}/noticias/` },
    ],
  },
};
---
<BlogLayout
  title="Noticias de Numismática y Notafilia · Notofilia"
  description="Noticias y artículos sobre numismática y notafilia: emisiones, hallazgos y valor de billetes y monedas de colección de Colombia y del mundo."
  path="/noticias/"
  jsonLd={jsonLd}
  keywords={[
    'billetes raros', 'monedas raras', 'billetes de la república de colombia',
    'diferencia entre numismática y notafilia', 'cómo empezar una colección de billetes',
    'guía para principiantes colección billetes colombia', 'billetes más valiosos de colombia 2026',
    'personajes en los billetes de colombia', 'cómo identificar billetes falsos colombia',
  ]}
>
  <PostCollectionIndex
    collection="noticias"
    heading="Noticias de Numismática y Notafilia"
    intro="Una selección de noticias, hallazgos y notas sobre monedas y billetes históricos."
    emptyMessage="Muy pronto publicaremos las primeras noticias."
    posts={posts}
    showSource
  />
</BlogLayout>
