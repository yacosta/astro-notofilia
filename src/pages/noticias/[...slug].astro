---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
  const posts = await getCollection('noticias', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

type Props = { post: CollectionEntry<'noticias'> };
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;

const SITE = 'https://www.notofilia.com';
const path = `/noticias/${post.slug}/`;
const iso = d.publishedAt.toISOString().slice(0, 10);
const fmt = d.publishedAt.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric' });
const desc = d.excerpt.length > 150 ? d.excerpt.slice(0, 147) + '…' : d.excerpt;
const titleTag = (d.title.length > 48 ? d.title.slice(0, 48) + '…' : d.title) + ' · Notofilia';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.excerpt,
  datePublished: iso,
  ...(d.cover ? { image: `${SITE}/uploads/${d.cover}.jpg` } : {}),
  author: { '@type': 'Organization', name: 'Notofilia' },
  publisher: { '@type': 'Organization', name: 'Notofilia', logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': SITE + path },
  ...(d.sourceUrl ? { isBasedOn: d.sourceUrl } : {}),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Noticias', item: `${SITE}/noticias/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: SITE + path },
    ],
  },
};
---
<BlogLayout
  title={titleTag}
  description={desc}
  path={path}
  ogType="article"
  ogImage={d.cover ? `/uploads/${d.cover}.jpg` : undefined}
  jsonLd={jsonLd}
>
  <article class="wrap post">
    <nav class="crumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a> <span aria-hidden="true">/</span>
      <a href="/noticias/">Noticias</a> <span aria-hidden="true">/</span>
      <span>{d.title}</span>
    </nav>

    <header class="post-head">
      <div class="meta">
        <time datetime={iso}>{fmt}</time>
        {d.source && <span aria-hidden="true">·</span>}
        {d.source && <span class="src">{d.source}</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="excerpt">{d.excerpt}</p>
    </header>

    {d.cover && (
      <figure class="cover">
        <Cover base={d.cover} alt={d.coverAlt ?? d.title} eager ratio="16 / 9" />
        {d.coverAlt && <figcaption>{d.coverAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {d.sourceUrl && (
      <p class="source-out">
        <a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
          Leer la nota original{d.source ? ` en ${d.source}` : ''} &rarr;
        </a>
      </p>
    )}

    <p class="back"><a href="/noticias/">&larr; Volver a Noticias</a></p>
  </article>
</BlogLayout>

<style>
  .post { padding-top: 48px; max-width: 760px; }
  .crumbs { font-size: 14px; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 24px; }
  .crumbs a { color: var(--muted); }
  .meta {
    display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline;
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px;
  }
  h1 {
    font-family: 'Montenegrin Gothic One', serif; font-weight: 400;
    font-size: clamp(28px, 4.5vw, 42px); color: var(--cream); margin: 0 0 16px; line-height: 1.12;
  }
  .post-head .excerpt {
    font-style: italic; font-size: clamp(19px, 2.4vw, 23px); color: var(--cream-dim);
    margin: 0 0 36px; line-height: 1.5;
  }
  .cover { margin: 0 0 40px; }
  .cover :global(picture) { display: block; border-radius: 4px; overflow: hidden; }
  .cover figcaption { font-size: 13px; color: var(--muted); margin-top: 10px; text-align: center; font-style: italic; }
  .prose { font-size: 20px; line-height: 1.75; color: var(--cream-dim); }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(strong) { color: var(--cream); font-weight: 600; }
  .prose :global(a) { color: var(--cream); }
  .prose :global(h2) {
    font-family: 'Montenegrin Gothic One', serif; font-weight: 400;
    font-size: clamp(22px, 3vw, 28px); color: var(--cream); margin: 40px 0 16px;
  }
  .source-out {
    margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--line);
    font-size: 16px; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .source-out a { color: var(--muted); font-weight: 600; }
  .source-out a:hover { color: var(--cream); }
  .back { margin: 40px 0 0; }
  .back a { color: var(--muted); }
</style>
