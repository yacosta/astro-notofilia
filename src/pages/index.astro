---
// Server-rendered homepage. Content is baked into HTML at build time; small
// Vanilla scripts handle the hero crossfade and ES/EN toggle.
// Spanish is the server-rendered default; the toggle swaps [data-i18n] strings.
import { getPublishedPosts, type PublishedPost } from '../lib/posts';
import { formatDateShortEs, toIsoDate } from '../lib/dates';
import { SITE } from '../lib/site';
import { hubStats } from '../lib/catalog-hub';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeStatsBar from '../components/HomeStatsBar.astro';
import HomeBrowseStrip from '../components/HomeBrowseStrip.astro';
import HomePostStrip from '../components/HomePostStrip.astro';
import HomeLogrosStrip from '../components/HomeLogrosStrip.astro';
import PreFooter from '../components/PreFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import type { StripItem } from '../components/HomePostStrip.astro';

function toStripItems(
  posts: PublishedPost[],
  base: 'noticias' | 'blog',
): StripItem[] {
  return posts.slice(0, 4).map((p) => ({
    url: `/${base}/${p.slug}/`,
    title: p.data.title,
    source: p.data.source ?? 'Notofilia',
    iso: toIsoDate(p.data.publishedAt),
    dateLabel: formatDateShortEs(p.data.publishedAt),
    cover: p.data.cover,
    coverAlt: p.data.coverAlt ?? '',
  }));
}

const posts = toStripItems(await getPublishedPosts('noticias'), 'noticias');
const blogPosts = toStripItems(await getPublishedPosts('blog'), 'blog');
const stats = hubStats();

const heroImg = `${SITE}/uploads/hero-engraving-01.jpg`;
const heroes = [
  { base: 'hero-slide-guatemala-quetzal', alt: 'Primer plano de un billete de 5 quetzales de Guatemala, con el ave quetzal, estilo numismática y notafilia' },
  { base: 'hero-slide-oman-sultan', alt: 'Primer plano de un billete de 5 riales de Omán, con el retrato del sultán, estilo numismática y notafilia' },
  { base: 'hero-slide-brasil-10', alt: 'Primer plano de un billete de 10 de Brasil, con un retrato grabado y veleros, estilo numismática y notafilia' },
  { base: 'hero-slide-mexico-tren', alt: 'Primer plano de un billete de 100 pesos mexicanos, con la viñeta de un tren de vapor, estilo numismática y notafilia' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Notofilia',
      url: `${SITE}/`,
      logo: `${SITE}/favicon.png`,
      description: 'Colección privada de billetes históricos dedicada al coleccionismo de monedas y billetes (numismática y notafilia) en español.',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Notofilia',
      url: `${SITE}/`,
      publisher: { '@id': `${SITE}/#organization` },
      inLanguage: ['es', 'en'],
      potentialAction: {
        '@type': 'SearchAction',
        target: `${SITE}/buscar/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE}/#webpage`,
      url: `${SITE}/`,
      name: 'Notofilia — Numismática y Notafilia',
      isPartOf: { '@id': `${SITE}/#website` },
      primaryImageOfPage: heroImg,
      inLanguage: 'es',
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Notofilia: Billetes y Numismática | Catálogo y Guías"
      description="Notafilia y numismática: billetes de Colombia y del mundo, monedas antiguas y de colección. Catálogos, guías y valor para coleccionistas en español."
      path="/"
      ogImage="/uploads/hero-engraving-01.jpg"
      ogTitle="Notofilia — Numismática y coleccionismo de billetes"
      ogDescription="Colección privada de billetes históricos de Colombia, Estados Unidos y Ecuador: specimens, errores de imprenta y piezas raras de numismática y notafilia."
      robots="index, follow, max-image-preview:large"
      jsonLd={jsonLd}
      loadDcRuntime={false}
      keywords={[
        'colección de monedas', 'billetes raros', 'monedas raras',
        'catálogo billetes colombia', 'billetes de la república de colombia',
        'billetes de colección banco de la república', 'billetes polímero colombia colección',
        'notafilia billetes Estados Unidos', 'notafilia billetes Polímero Mundial',
      ]}
    >
      <link rel="apple-touch-icon" href="/favicon.png" />
      <link rel="alternate" hreflang="es" href={`${SITE}/`} />
      <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    </BaseHead>
    <style is:global>
      * { box-sizing: border-box; }
      html, body { height: auto !important; }
      .hero-slide { transition: opacity 1.6s ease; }
      ::selection { background: rgba(231, 222, 201, 0.3); }
    </style>
  </head>
  <body class="m-0 bg-bg font-serif">
    <a
      href="#main-content"
      class="absolute top-[-60px] left-4 z-20 bg-cream-dim text-bg font-serif font-semibold text-[15px] tracking-[0.05em] px-5 py-3 rounded-[2px] no-underline transition-[top] duration-150 focus:top-4"
    >Saltar al contenido principal / Skip to main content</a>

    <SiteHeader overlay />

    <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
      <HomeHero slides={heroes} />

      <HomeStatsBar stats={stats} />

      <HomeBrowseStrip />

      <HomeLogrosStrip />

      <HomePostStrip
        headingId="blog-heading"
        heading="Artículos originales"
        headingEn="Original articles"
        items={blogPosts}
        emptyMessage="Muy pronto publicaremos las primeras guías del blog."
        emptyMessageEn="Coming soon: our first blog guides."
        moreHref="/blog/"
        moreLabel="Ver todo el blog"
        moreLabelEn="See the full blog"
        bordered
      />

      <HomePostStrip
        headingId="news-heading"
        heading="Noticias seleccionadas"
        headingEn="Curated news"
        items={posts}
        emptyMessage="Muy pronto, aquí encontrarás las noticias más recientes de subastas, nuevas emisiones y hallazgos numismáticos."
        emptyMessageEn="Coming soon: the latest news on auctions, new issues, and numismatic discoveries."
        moreHref="/noticias/"
        moreLabel="Ver todas las noticias"
        moreLabelEn="See all news"
      />

      <section class="max-w-content mx-auto pt-[88px] px-6 pb-14 grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-12 border-t border-line" aria-labelledby="defs-heading">
        <h2 id="defs-heading" class="sr-only">Definiciones</h2>
        <div>
          <h3 data-i18n data-en="Numismatics" class="font-display font-normal text-[clamp(24px,3vw,32px)] text-cream-dim mt-0 mb-4">Numismática</h3>
          <p data-i18n data-en="A discipline dedicated to the study and collection of coins, medals, and, in its broadest sense, any object used as a means of payment throughout history. It covers the historical, artistic, and technical analysis of minted pieces." class="text-[19px] leading-[1.75] text-cream-dim m-0">Disciplina dedicada al estudio y la colección de monedas, medallas y, en su sentido más amplio, de todo objeto utilizado como medio de pago a lo largo de la historia. Abarca el análisis histórico, artístico y técnico de las piezas acuñadas.</p>
        </div>
        <div>
          <h3 data-i18n data-en="Notaphily" class="font-display font-normal text-[clamp(24px,3vw,32px)] text-cream-dim mt-0 mb-4">Notafilia</h3>
          <p data-i18n data-en="A specialized branch of numismatics focused specifically on the study and collection of banknotes and paper money, including their history, design, engraving, and issues from both public and private entities." class="text-[19px] leading-[1.75] text-cream-dim m-0">Rama especializada de la numismática centrada específicamente en el estudio y la colección de billetes y papel moneda, incluyendo su historia, diseño, grabado y las emisiones de entidades tanto públicas como privadas.</p>
        </div>
      </section>

      <PreFooter />

      <SiteFooter
        variant="home"
        taglineEs="Todos los billetes mostrados en este sitio pertenecen a mi colección privada. Ninguno está a la venta. Simplemente comparto mi pasión por este pasatiempo con el mundo."
        taglineEn="All the banknotes shown on this site are from my private collection. None of these banknotes are for sale. I'm just sharing the love of my hobby with the world."
      />
    </main>

    <CookieBanner />

    <script is:inline>
      // --- Hero crossfade rotation ---
      (function () {
        var slides = Array.prototype.slice.call(document.querySelectorAll('.hero-slide'));
        if (slides.length < 2) return;
        var secondaryIndexes = slides.slice(1).map(function (_, i) { return i + 1; });
        function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
        var order = [0].concat(shuffle(secondaryIndexes.slice()));
        var active = 0;
        function show(idx) { slides.forEach(function (el, i) { el.style.opacity = i === idx ? '1' : '0'; }); }
        function loadDeferredSlides() {
          document.querySelectorAll('[data-deferred-hero]').forEach(function (picture) {
            var source = picture.querySelector('source[data-srcset]');
            var image = picture.querySelector('img[data-src]');
            if (source) {
              source.srcset = source.getAttribute('data-srcset');
              source.removeAttribute('data-srcset');
            }
            if (image) {
              image.src = image.getAttribute('data-src');
              image.removeAttribute('data-src');
            }
            picture.removeAttribute('data-deferred-hero');
          });
        }
        function scheduleDeferredSlides() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadDeferredSlides, { timeout: 2000 });
          } else {
            setTimeout(loadDeferredSlides, 500);
          }
        }
        show(0);
        if (document.readyState === 'complete') scheduleDeferredSlides();
        else window.addEventListener('load', scheduleDeferredSlides, { once: true });
        setInterval(function () {
          active++;
          if (active >= order.length) {
            order = [0].concat(shuffle(secondaryIndexes.slice()));
            active = 0;
          }
          show(order[active]);
        }, 6000);
      })();

      // --- ES/EN language toggle ---
      (function () {
        var es = document.getElementById('lang-es');
        var en = document.getElementById('lang-en');
        if (!es || !en) return;
        var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-i18n]'));
        nodes.forEach(function (n) { n.setAttribute('data-es', n.innerHTML); });
        function setLang(lang) {
          document.documentElement.lang = lang;
          nodes.forEach(function (n) {
            var v = lang === 'en' ? n.getAttribute('data-en') : n.getAttribute('data-es');
            if (v != null) n.innerHTML = v;
          });
          var isEs = lang === 'es';
          es.setAttribute('aria-pressed', String(isEs));
          en.setAttribute('aria-pressed', String(!isEs));
          es.style.background = isEs ? 'rgba(231,222,201,0.92)' : 'transparent';
          es.style.color = isEs ? '#0a0a09' : '#e7ddc4';
          en.style.background = !isEs ? 'rgba(231,222,201,0.92)' : 'transparent';
          en.style.color = !isEs ? '#0a0a09' : '#e7ddc4';
        }
        es.addEventListener('click', function () { setLang('es'); });
        en.addEventListener('click', function () { setLang('en'); });
      })();
    </script>
  </body>
</html>
