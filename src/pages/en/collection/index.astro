---
/**
 * English collection hub — /en/collection/
 * Spanish /coleccion/ is unchanged.
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import CookieBanner from '../../../components/CookieBanner.astro';
import PreFooter from '../../../components/PreFooter.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { lookupEn } from '../../../lib/html-i18n';
import { SITE } from '../../../lib/site';
import { alternateUrl } from '../../../i18n/pairs';
import {
  FEATURED_ENTRIES,
  RECENT_PIECES,
  hubLeadEn,
} from '../../../lib/catalog-hub';
import {
  getCollectionStats,
  INVENTORY_VOCABULARY_EN,
  inventoryProperties,
} from '../../../lib/stats';

function hrefEn(href: string): string {
  const hashIdx = href.indexOf('#');
  const hash = hashIdx >= 0 ? href.slice(hashIdx) : '';
  const noHash = hashIdx >= 0 ? href.slice(0, hashIdx) : href;
  const qIdx = noHash.indexOf('?');
  const query = qIdx >= 0 ? noHash.slice(qIdx) : '';
  const pathOnly = qIdx >= 0 ? noHash.slice(0, qIdx) : noHash;
  const normalized = !pathOnly || pathOnly.endsWith('/') ? pathOnly : `${pathOnly}/`;
  return `${alternateUrl(normalized, 'en') ?? pathOnly}${query}${hash}`;
}

const RECENT_ALT_EN: Record<string, string> = {
  'colombia-banco-de-la-republica-10-pesos-oro-1943':
    'PMG-encapsulated Banco de la República 10 pesos oro, 20 July 1943, Pick 389b, obverse and reverse with portrait of Antonio Nariño',
  'philippines-treasury-certificate-2-pesos-victory-series-66-cc5b2834':
    'Philippines Treasury Certificate of 2 pesos, Victory Series No. 66, obverse and reverse',
  'philippines-treasury-certificate-1-peso-victory-series-66-5c220d39':
    'Philippines Treasury Certificate of 1 peso, Victory Series No. 66, obverse and reverse',
  'colombia-banco-de-rio-hacha-5-pesos-1883':
    'PMG proofs of the Banco de Rio Hacha 5 pesos, 1883, encapsulated obverse and reverse',
  'colombia-banco-hipotecario-5-pesos-1881-38a93057':
    'PMG proofs of the Banco Hipotecario 5 pesos of Bogotá, 1881, encapsulated obverse and reverse',
  '1761-netherland-ducat-utrecht':
    '1761 Utrecht gold ducat in NGC holder, obverse and reverse',
  'mpc-series-681-1-dollar-c10102847':
    'Obverse and reverse of the MPC Series 681 one-dollar note with a USAF pilot and F-100 Super Sabre',
  'us-federal-reserve-note-10-dollars-1934-chicago':
    'Obverse of the Chicago Federal Reserve ten-dollar note, series 1934',
  'ringling-bros-50th-anniversary-baraboo-1-dollar':
    'Obverse and reverse of the Ringling Bros. Baraboo one-dollar scrip, 1933',
  'mpc-series-692-20-dollars-3f285359':
    'Obverse and reverse of the MPC Series 692 twenty-dollar note with Chief Ouray',
};

const catalogIndex = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'public/data/catalog-index.json'), 'utf8'),
) as {
  countries: Array<{ name: string; count: number; slug: string }>;
  items: Array<{
    country?: string;
    issuer?: string;
    material?: string;
    kind?: string;
  }>;
};

const stats = await getCollectionStats();
const leadEn = hubLeadEn(stats);
const title = 'Virtual Collection of Banknotes | Notofilia';
const description = `Explore ${stats.billetes} banknotes across ${stats.fichas} records and ${stats.monedas} coins from ${stats.paises} countries.`;

const countries = catalogIndex.countries ?? [];
const catalogItems = catalogIndex.items ?? [];

const uniqueSorted = (values: Array<string | undefined>) =>
  [...new Set(values.map((v) => (v || '').trim()).filter(Boolean))].sort((a, b) =>
    a.localeCompare(b, 'es', { sensitivity: 'base' }),
  );

const issuerOptions = uniqueSorted(catalogItems.map((item) => item.issuer));
const materialOptions = uniqueSorted(catalogItems.map((item) => item.material));
const countryOptions = uniqueSorted([
  ...countries.map((c) => c.name),
  ...catalogItems.map((item) => item.country),
]);

const filterParams = Astro.url.searchParams;
const selectedPais = filterParams.get('pais') || '';
const selectedEmisor = filterParams.get('emisor') || '';
const selectedMaterial = filterParams.get('material') || '';
const selectedTipo = filterParams.get('tipo') || '';
const selectedOrden = filterParams.get('orden') || 'newest';
const selectedQ = filterParams.get('q') || '';
const selectedDesde = filterParams.get('desde') || '';
const selectedHasta = filterParams.get('hasta') || '';
const selectedDenom = filterParams.get('denom') || '';
const selectedCondicion = filterParams.get('condicion') || '';
const selectedCatalogo = filterParams.get('catalogo') || '';
const selectedVista = filterParams.get('vista') === 'lista' ? 'list' : 'grid';

const countryList = countries.slice(0, 40).map((c, index) => {
  const esPath = `/coleccion/${c.slug}/`;
  const href = alternateUrl(esPath, 'en') ?? esPath;
  const name = lookupEn(c.name) || c.name;
  return {
    '@type': 'ListItem',
    position: index + 1,
    name,
    url: `${SITE}${href}`,
    item: {
      '@type': 'CreativeWork',
      name: `Catalog: ${name}`,
      url: `${SITE}${href}`,
    },
  };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Notofilia',
          item: `${SITE}/en/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Virtual Collection',
          item: `${SITE}/en/collection/`,
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/en/collection/#page`,
      name: 'Virtual Collection of Banknotes and Coins',
      url: `${SITE}/en/collection/`,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/en/#website` },
      about: {
        '@type': 'Thing',
        name: 'Notaphily and numismatics',
      },
      mainEntity: { '@id': `${SITE}/en/collection/#itemlist` },
      additionalProperty: [
        {
          '@type': 'PropertyValue',
          name: 'Availability',
          value: 'Not for sale — documented private collection',
        },
        ...inventoryProperties(stats, 'en'),
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE}/en/collection/#itemlist`,
      name: 'Index of catalogs by country and theme',
      numberOfItems: stats.paises,
      itemListElement: countryList,
    },
  ],
};
---
<!doctype html>
<html lang="en" data-page-locale="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path="/en/collection/"
      locale="en"
      robots="index, follow, max-image-preview:large"
      ogType="website"
      ogTitle="Virtual Collection of Banknotes and Coins — Notofilia"
      ogDescription={description}
      ogImage="/uploads/state-bank-new-brunswick-1-dollar.jpg"
      jsonLd={jsonLd}
      loadDcRuntime={false}
    />
    <link rel="stylesheet" href="/catalog-fonts.css" />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      html, body, #dc-root, #dc-root > .sc-host { height: auto !important; }
      body { margin: 0; background: #0a0a09; }
      x-dc { display: none; }
      img { max-width: 100%; height: auto; }
      ::selection { background: rgba(138, 109, 59, 0.25); }
    </style>
    <style>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .hub {
        color: var(--color-cream-dim);
        background:
          radial-gradient(circle at 50% -8%, rgba(138, 109, 59, 0.12), transparent 34rem),
          var(--color-bg);
        font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
      }
      .hub-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 64px var(--page-gutter, 24px) 96px;
      }
      .hub h1 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.05;
        color: #d8d2cd;
        margin: 0 0 20px;
        max-width: 28ch;
      }
      .hub-lead {
        font-size: clamp(18px, 1.8vw, 21px);
        line-height: 1.7;
        color: #d8d2cd;
        max-width: 42rem;
        margin: 0 0 40px;
      }
      .hub-search {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin: 0 0 56px;
      }
      .hub-search input[type='search'] {
        flex: 1 1 280px;
        min-height: 52px;
        padding: 14px 18px;
        font: inherit;
        font-size: 18px;
        color: #1c1a15;
        background: #d8d2cd;
        border: 1px solid rgba(10, 10, 9, 0.12);
        border-radius: 3px;
      }
      .hub-search input[type='search']:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .hub-search button {
        min-height: 52px;
        min-width: 44px;
        padding: 12px 22px;
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #0a0a09;
        background: #e7ddc4;
        border: 1px solid transparent;
        border-radius: 3px;
        cursor: pointer;
      }
      .hub-search button:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .hub-section {
        margin: 0 0 72px;
        padding-top: 48px;
        border-top: 1px solid rgba(231, 222, 201, 0.18);
        scroll-margin-top: 88px;
      }
      .hub-kicker {
        display: block;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #b7ab8a;
        margin-bottom: 14px;
      }
      .hub h2 {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1.15;
        color: #d8d2cd;
        margin: 0 0 12px;
      }
      .hub-section-lead {
        font-size: 18px;
        line-height: 1.65;
        color: #b7ab8a;
        max-width: 40rem;
        margin: 0 0 28px;
      }
      .featured-grid,
      .country-grid,
      .recent-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 18px 28px;
      }
      .featured-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      }
      .featured-grid a,
      .country-grid a {
        display: block;
        min-height: 44px;
        padding-top: 14px;
        border-top: 2px solid rgba(216, 210, 205, 0.35);
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .featured-grid a:hover,
      .country-grid a:hover {
        border-color: #e7ddc4;
      }
      .featured-grid a:focus-visible,
      .country-grid a:focus-visible,
      .recent-grid a:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 4px;
      }
      .featured-title,
      .country-name {
        display: block;
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(18px, 1.2vw, 22px);
        color: #d8d2cd;
        margin-bottom: 6px;
      }
      .featured-desc,
      .country-count {
        display: block;
        font-size: 15px;
        line-height: 1.5;
        color: #b7ab8a;
      }
      .country-grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      }
      .recent-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      }
      .recent-grid a {
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        min-height: 44px;
      }
      .recent-grid picture {
        display: block;
        overflow: hidden;
        border-radius: 3px;
        background: #fff;
        aspect-ratio: 4 / 3;
      }
      .recent-grid img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.4s ease;
      }
      .recent-grid a:hover img {
        transform: scale(1.03);
      }
      @media (prefers-reduced-motion: reduce) {
        .recent-grid img { transition: none; }
        .recent-grid a:hover img { transform: none; }
      }
      .recent-title {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(17px, 1.1vw, 20px);
        color: #d8d2cd;
      }
      .recent-desc {
        font-size: 15px;
        line-height: 1.55;
        color: #b7ab8a;
      }

      :global(#catalog-browser[data-loading] .catalog-results::before) {
        content: 'Loading catalog…';
        display: block;
        color: #b7ab8a;
        margin-bottom: 16px;
      }
      .filter-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 16px;
        align-items: end;
        margin-bottom: 20px;
      }
      .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 14px 16px;
        width: 100%;
      }
      .filter-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .filter-field label {
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #b7ab8a;
        font-weight: 600;
      }
      .filter-field input,
      .filter-field select {
        min-height: 44px;
        padding: 10px 12px;
        font: inherit;
        font-size: 15px;
        color: #1c1a15;
        background: #d8d2cd;
        border: 1px solid rgba(10, 10, 9, 0.12);
        border-radius: 3px;
      }
      .filter-field input:focus-visible,
      .filter-field select:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .filter-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 8px;
      }
      .filter-actions button,
      .view-toggle button {
        min-height: 44px;
        min-width: 44px;
        padding: 10px 16px;
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #d8d2cd;
        background: transparent;
        border: 1px solid rgba(231, 222, 201, 0.35);
        border-radius: 3px;
        cursor: pointer;
      }
      .view-toggle button[aria-pressed='true'] {
        color: #0a0a09;
        background: #e7ddc4;
        border-color: #e7ddc4;
      }
      .view-toggle button:focus-visible,
      .filter-actions button:focus-visible {
        outline: 2px solid #e7ddc4;
        outline-offset: 3px;
      }
      .result-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        align-items: center;
        justify-content: space-between;
        margin: 24px 0 16px;
      }
      :global(#catalog-result-count) {
        font-size: 15px;
        color: #b7ab8a;
      }
      :global(.catalog-results) {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      :global(.catalog-country-group + .catalog-country-group) {
        margin-top: 56px;
      }
      :global(.catalog-country-kicker) {
        display: block;
        font-size: 14px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #b7ab8a;
        margin-bottom: 10px;
      }
      :global(.catalog-country-title) {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-weight: 400;
        font-size: clamp(22px, 2.6vw, 30px);
        line-height: 1.15;
        color: #d8d2cd;
        margin: 0 0 24px;
      }
      :global(.catalog-result-list) {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      :global(.catalog-results[data-view='grid'] .catalog-result-list) {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 24px;
      }
      :global(.catalog-results[data-view='list'] .catalog-result-list) {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      :global(.catalog-result-link) {
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.018), transparent 42%),
          #161410;
        border: 1px solid rgba(231, 222, 201, 0.14);
        border-radius: 3px;
        overflow: hidden;
        min-height: 44px;
        transition: border-color 0.2s ease, transform 0.15s ease;
      }
      :global(.catalog-result-link:hover) {
        border-color: rgba(231, 222, 201, 0.4);
        transform: translateY(-2px);
      }
      :global(.catalog-result-link:focus-visible) {
        outline: 2px solid #e7ddc4;
        outline-offset: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        :global(.catalog-result-link) { transition: none; }
        :global(.catalog-result-link:hover) { transform: none; }
      }
      :global(.catalog-results[data-view='list'] .catalog-result-link) {
        flex-direction: row;
        align-items: stretch;
      }
      :global(.catalog-result-media) {
        display: block;
        background: #fff;
        aspect-ratio: 4 / 3;
      }
      :global(.catalog-results[data-view='list'] .catalog-result-media) {
        width: 140px;
        min-width: 140px;
        aspect-ratio: auto;
        align-self: stretch;
      }
      :global(.catalog-result-media picture),
      :global(.catalog-result-media img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      :global(.catalog-result-body) {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px 18px 20px;
      }
      :global(.catalog-result-meta) {
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #b7ab8a;
      }
      :global(.catalog-result-title) {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
        font-size: clamp(17px, 1.1vw, 20px);
        line-height: 1.2;
        color: #d8d2cd;
      }
      :global(.catalog-result-sub),
      :global(.catalog-result-ref) {
        font-size: 14px;
        line-height: 1.45;
        color: #b7ab8a;
      }
      :global(.catalog-result-ref) {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      :global(#catalog-empty) {
        color: #b7ab8a;
        font-size: 17px;
        margin: 24px 0 0;
      }
      @media (max-width: 640px) {
        .hub-inner { padding-top: 48px; }
        :global(.catalog-results[data-view='list'] .catalog-result-media) {
          width: 96px;
          min-width: 96px;
        }
      }
    </style>
  </head>
  <body>
    <a
      href="#main-content"
      class="absolute left-[-9999px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
    >Skip to main content</a>

    <SiteHeader locale="en" path="/en/collection/" />

    <div class="hub">
      <main id="main-content" class="hub-inner" tabindex="-1" data-pagefind-meta="url:/en/collection/">
        <h1>Virtual Collection: {stats.billetes} banknotes and {stats.monedas} coins from {stats.paises} countries</h1>
        <p class="hub-lead">{leadEn}</p>
        <p class="hub-lead" style="margin-top:-24px; font-size:17px; color:#b7ab8a;">
          {INVENTORY_VOCABULARY_EN}
        </p>

        <ul class="featured-grid" style="margin: 0 0 40px;">
          <li>
            <a href="/en/collection/numismatics/">
              <span class="featured-title">Numismatics catalog</span>
              <span class="featured-desc">Struck coins: colonial gold, necessity copper, and trade pieces.</span>
            </a>
          </li>
          <li>
            <a href="#explorar">
              <span class="featured-title">Notaphily catalog</span>
              <span class="featured-desc">Banknotes, specimens, errors, and paper money of the world.</span>
            </a>
          </li>
        </ul>

        <form class="hub-search" action="/en/collection/" method="get" role="search">
          <label class="sr-only" for="catalog-search-hero">Search the collection</label>
          <input
            id="catalog-search-hero"
            type="search"
            name="q"
            value={selectedQ}
            placeholder="Search country, issuer, Pick, Friedberg, denomination…"
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="submit">Search</button>
        </form>

        <section class="hub-section" aria-labelledby="featured-heading">
          <span class="hub-kicker">Featured entry points</span>
          <h2 id="featured-heading">Collections and themes</h2>
          <p class="hub-section-lead">
            Enter by country, material, or type without scrolling the whole index.
          </p>
          <ul class="featured-grid">
            {FEATURED_ENTRIES.map((entry) => (
              <li>
                <a href={hrefEn(entry.href)}>
                  <span class="featured-title">{entry.titleEn}</span>
                  <span class="featured-desc">{entry.descriptionEn}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" id="countries" aria-labelledby="countries-heading">
          <span class="hub-kicker">By country</span>
          <h2 id="countries-heading">Countries in the collection</h2>
          <p class="hub-section-lead">
            {stats.paises} countries with documented records. The filter opens the browser below.
          </p>
          <ul class="country-grid">
            {countries.map((c) => (
              <li>
                <a
                  href={`/en/collection/?pais=${encodeURIComponent(c.name)}#explorar`}
                  data-filter-pais={c.name}
                >
                  <span class="country-name">{lookupEn(c.name) || c.name}</span>
                  <span class="country-count">
                    {c.count === 1 ? '1 record' : `${c.count} records`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" id="recent" aria-labelledby="recent-heading">
          <span class="hub-kicker">Recent</span>
          <h2 id="recent-heading">Recently added pieces</h2>
          <p class="hub-section-lead">
            Recent highlights from the Virtual Collection.
          </p>
          <ul class="recent-grid">
            {RECENT_PIECES.map((item) => (
              <li>
                <a href={item.href}>
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`/uploads/${item.imageBase}-card.webp 440w, /uploads/${item.imageBase}-card-2x.webp 660w`}
                      sizes="(max-width: 640px) 90vw, 280px"
                    />
                    <img
                      src={`/uploads/${item.imageBase}-card.jpg`}
                      alt={RECENT_ALT_EN[item.imageBase] ?? lookupEn(item.imageAlt) ?? item.imageAlt}
                      width="440"
                      height="280"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <span class="recent-title">{item.titleEn}</span>
                  <span class="recent-desc">{item.descriptionEn}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="hub-section" id="explorar" aria-labelledby="browse-heading">
          <span class="hub-kicker">Browse</span>
          <h2 id="browse-heading">Full catalog</h2>
          <p class="hub-section-lead">
            Pieces are grouped by country. Filter by issuer, year, denomination, type, material, condition, and catalog reference.
          </p>

          <div id="catalog-browser" data-loading>
            <form id="catalog-filters" class="filter-toolbar" action="/en/collection/" method="get">
              <div class="filter-grid">
                <div class="filter-field" style="grid-column: 1 / -1;">
                  <label for="catalog-search">Search</label>
                  <input
                    id="catalog-search"
                    name="q"
                    type="search"
                    value={selectedQ}
                    placeholder="Free text…"
                    autocomplete="off"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-pais">Country</label>
                  <select id="filter-pais" name="pais">
                    <option value="">All</option>
                    {countryOptions.map((name) => (
                      <option value={name} selected={selectedPais === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-emisor">Issuer</label>
                  <select id="filter-emisor" name="emisor">
                    <option value="">All</option>
                    {issuerOptions.map((name) => (
                      <option value={name} selected={selectedEmisor === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-tipo">Type</label>
                  <select id="filter-tipo" name="tipo">
                    <option value="" selected={selectedTipo === ''}>All</option>
                    <option value="banknote" selected={selectedTipo === 'banknote'}>Banknote</option>
                    <option value="coin" selected={selectedTipo === 'coin'}>Coin</option>
                    <option value="specimen" selected={selectedTipo === 'specimen'}>Specimen</option>
                    <option value="error" selected={selectedTipo === 'error'}>Error</option>
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-material">Material</label>
                  <select id="filter-material" name="material">
                    <option value="">All</option>
                    {materialOptions.map((name) => (
                      <option value={name} selected={selectedMaterial === name}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="filter-field">
                  <label for="filter-desde">Year from</label>
                  <input
                    id="filter-desde"
                    name="desde"
                    type="number"
                    inputmode="numeric"
                    min="1700"
                    max="2100"
                    value={selectedDesde}
                    placeholder="e.g. 1860"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-hasta">Year to</label>
                  <input
                    id="filter-hasta"
                    name="hasta"
                    type="number"
                    inputmode="numeric"
                    min="1700"
                    max="2100"
                    value={selectedHasta}
                    placeholder="e.g. 1970"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-denom">Denomination</label>
                  <input
                    id="filter-denom"
                    name="denom"
                    type="search"
                    value={selectedDenom}
                    placeholder="peso, dollar…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-condicion">Condition</label>
                  <input
                    id="filter-condicion"
                    name="condicion"
                    type="search"
                    value={selectedCondicion}
                    placeholder="PMG, AU…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-catalogo">Catalog reference</label>
                  <input
                    id="filter-catalogo"
                    name="catalogo"
                    type="search"
                    value={selectedCatalogo}
                    placeholder="Pick, Friedberg, KM…"
                  />
                </div>
                <div class="filter-field">
                  <label for="filter-orden">Sort</label>
                  <select id="filter-orden" name="orden">
                    <option value="newest" selected={selectedOrden === 'newest'}>Newest (year)</option>
                    <option value="year" selected={selectedOrden === 'year'}>Issue date</option>
                    <option value="country" selected={selectedOrden === 'country'}>Country</option>
                    <option value="denom" selected={selectedOrden === 'denom'}>Denomination</option>
                  </select>
                </div>
              </div>
              <div class="filter-actions">
                <button type="button" id="catalog-clear-filters">Clear filters</button>
                <div class="view-toggle" role="group" aria-label="Results view">
                  <button type="button" data-view="grid" aria-pressed={selectedVista === 'grid' ? 'true' : 'false'}>Grid</button>
                  <button type="button" data-view="list" aria-pressed={selectedVista === 'list' ? 'true' : 'false'}>List</button>
                </div>
              </div>
            </form>

            <div class="result-meta-row">
              <p id="catalog-result-count" aria-live="polite">Loading…</p>
            </div>
            <p id="catalog-empty" hidden>No pieces match those criteria. Try widening the filter.</p>
            <div id="catalog-results" class="catalog-results" data-view="grid"></div>
          </div>
        </section>
      </main>
    </div>

    <PreFooter locale="en" />
    <SiteFooter variant="editorial" locale="en" />
    <CookieBanner locale="en" />
    <script src="/coleccion-hub.js" defer is:inline></script>
  </body>
</html>
