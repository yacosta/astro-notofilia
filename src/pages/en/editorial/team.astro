---
/**
 * English editor profile — Yezid Acosta. Spanish /editorial/equipo/ is unchanged.
 */
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { SITE } from '../../../lib/site';
import {
  EDITORIAL_TEAM,
  WIKIPEDIA_NOTAFILIA_URL,
  WIKIPEDIA_NOTOFILIA_ARCHIVE_URL,
  personJsonLd,
} from '../../../lib/editorial';

const title = 'Yezid Acosta, editor | Notofilia';
const description =
  'Yezid Acosta edits Notofilia: the private catalog, valuation labels, and corrections.';
const path = '/en/editorial/team/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}${path}#page`,
      name: EDITORIAL_TEAM.name,
      url: `${SITE}${path}`,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE}/en/#website` },
      mainEntity: { '@id': `${SITE}${path}#person` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en/` },
          { '@type': 'ListItem', position: 2, name: 'Editorial policy', item: `${SITE}/en/editorial/` },
          { '@type': 'ListItem', position: 3, name: EDITORIAL_TEAM.name, item: `${SITE}${path}` },
        ],
      },
    },
    {
      ...personJsonLd(),
      url: `${SITE}${path}`,
      '@id': `${SITE}${path}#person`,
      knowsAbout: [
        'Notaphily',
        'Numismatics',
        'Paper money',
        'Collectible banknotes',
        'Numismatic valuation',
      ],
    },
  ],
};
---
<BlogLayout
  locale="en"
  title={title}
  description={description}
  path={path}
  ogType="website"
  jsonLd={jsonLd}
>
  <article class="max-w-content mx-auto px-6 pt-12 pb-4">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-6" aria-label="Breadcrumb">
      <a class="text-muted" href="/en/">Home</a> <span aria-hidden="true">/</span>
      <a class="text-muted" href="/en/editorial/">Editorial policy</a>
      <span aria-hidden="true">/</span>
      <span>{EDITORIAL_TEAM.name}</span>
    </nav>

    <header class="mb-10">
      <p class="m-0 mb-3 text-[13px] tracking-[0.14em] uppercase text-muted">Editor</p>
      <h1 class="font-display font-normal text-[clamp(28px,4.5vw,42px)] text-cream mt-0 mb-4 leading-[1.12]">
        {EDITORIAL_TEAM.name}
      </h1>
      <p class="italic text-[clamp(18px,2.2vw,22px)] text-cream-dim m-0 leading-[1.5]">
        Founder and editor of Notofilia. Responsible for the private catalog, valuation labels, and the correction history.
      </p>
    </header>

    <div class="prose-notofilia text-[19px] leading-[1.75] text-cream-dim">
      <h2>What this profile signs</h2>
      <p>
        When a guide or milestone says “Reviewed by”, it points here. Editorial
        responsibility —facts, figures, sources, and Virtual Collection records— sits with one
        person, not an anonymous collective byline.
      </p>

      <h2>How I work</h2>
      <ul>
        <li>
          I distinguish asking prices, catalog guides, and
          <strong>verified sales</strong> (documented hammers).
        </li>
        <li>
          I prefer primary sources: auction houses, central banks, catalogs, and official
          releases.
        </li>
        <li>
          Material corrections are recorded on the piece itself and summarized in the
          <a href="/en/editorial/#corrections">corrections policy</a>.
        </li>
      </ul>

      <h2>Public profile</h2>
      <ul>
        <li>
          GitHub:{' '}
          <a href="https://github.com/yacosta" target="_blank" rel="noopener noreferrer">
            github.com/yacosta <span class="new-window-hint"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          Editorial contact: <a href="/en/contact/">form</a> or
          <a href="mailto:info@notofilia.com">info@notofilia.com</a>
        </li>
      </ul>

      <h2>Mention on Wikipedia</h2>
      <p>
        The article{' '}
        <a href={WIKIPEDIA_NOTAFILIA_URL} target="_blank" rel="noopener noreferrer">
          Notaphily on Spanish Wikipedia <span class="new-window-hint"> (opens in a new tab)</span>
        </a>{' '}
        lists Notofilia.com under External links. The mention is live. The destination is a{' '}
        <a href={WIKIPEDIA_NOTOFILIA_ARCHIVE_URL} target="_blank" rel="noopener noreferrer">
          May 2013 archive.org snapshot <span class="new-window-hint"> (opens in a new tab)</span>
        </a>{' '}
        of <code>http://www.notofilia.com/</code>, not the current apex, and MediaWiki marks the
        link <code>rel="nofollow"</code>. It is a verifiable encyclopedic mention, not a
        PageRank backlink. Detail in the
        <a href="/en/editorial/#wikipedia">editorial policy</a>.
      </p>

      <h2>Related documents</h2>
      <ul>
        <li>
          <a href="/en/editorial/">Editorial policy and valuation standard</a>
        </li>
        <li>
          <a href="/en/editorial/#corrections">Corrections policy</a>
        </li>
        <li>
          <a href="/en/contact/">Contact</a> to report an error or add a source
        </li>
      </ul>
    </div>
  </article>
</BlogLayout>
