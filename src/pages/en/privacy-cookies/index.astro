---
/**
 * English privacy and cookie policy. Spanish /politica-privacidad-cookies/ is unchanged.
 */
import BlogLayout from '../../../layouts/BlogLayout.astro';
import FeaturePage from '../../../components/FeaturePage.astro';
import PrivacyPolicyBody from '../../../components/PrivacyPolicyBody.astro';
import { PRIVACY_EN_PATH, privacyJsonLd } from '../../../lib/legal';

const title = 'Privacy and Cookie Policy | Notofilia';
const description =
  'How Notofilia handles your data: Mailchimp newsletter, Cloudflare technical cookies, and your GDPR, LOPDGDD and Law 1581 rights.';
---
<BlogLayout
  locale="en"
  title={title}
  description={description}
  path={PRIVACY_EN_PATH}
  ogType="website"
  jsonLd={privacyJsonLd('en')}
>
  <FeaturePage as="div" variant="policy" data-pagefind-meta={`url:${PRIVACY_EN_PATH}`}>
    <PrivacyPolicyBody lang="en" />
  </FeaturePage>
</BlogLayout>
