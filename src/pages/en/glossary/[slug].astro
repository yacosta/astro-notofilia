---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { metaDescription, titleTag } from '../../../lib/posts';
import {
  GLOSSARY_PATH_EN,
  buildGlossaryLookup,
  glossaryTermJsonLdEn,
  glossaryTermPathEn,
  getGlossaryTerms,
  resolveSeeAlsoEn,
  slugifyGlossary,
} from '../../../lib/glossary';
import { GLOSSARY_CATEGORY_EN, UI } from '../../../lib/ui-i18n';

export async function getStaticPaths() {
  const terms = await getGlossaryTerms();
  return terms.map((entry) => ({
    params: { slug: slugifyGlossary(entry.data.termEn) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const terms = await getGlossaryTerms();
const lookup = buildGlossaryLookup(terms);
const seeAlso = resolveSeeAlsoEn(entry.data.seeAlso, lookup);
const path = glossaryTermPathEn(entry.data.termEn);
const jsonLd = glossaryTermJsonLdEn(entry);
const wikipediaUrl = entry.data.wikipediaUrl;
---
<BlogLayout
  locale="en"
  title={titleTag(`${entry.data.termEn} — Glossary`)}
  description={metaDescription(entry.data.definitionEn)}
  path={path}
  jsonLd={jsonLd}
>
  <article class="max-w-none mx-auto px-[var(--page-gutter)] pt-14 pb-6">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-5" aria-label="Breadcrumb">
      <a class="text-muted [text-decoration-color:rgba(183,171,138,0.4)]" href="/en/">Home</a>
      <span aria-hidden="true"> / </span>
      <a class="text-muted [text-decoration-color:rgba(183,171,138,0.4)]" href={GLOSSARY_PATH_EN}>Glossary</a>
      <span aria-hidden="true"> / </span>
      <span>{entry.data.termEn}</span>
    </nav>

    <p class="m-0 mb-3 text-[13px] tracking-[0.14em] uppercase text-muted">
      {GLOSSARY_CATEGORY_EN[entry.data.category] ?? entry.data.category}
    </p>
    <h1 class="font-display font-normal text-[clamp(28px,4.5vw,42px)] text-cream mt-0 mb-2 leading-[1.12]">
      {entry.data.termEn}
    </h1>
    <p lang="es" class="italic text-[clamp(18px,2.2vw,22px)] text-cream-dim m-0 mb-8 leading-[1.5]">
      {entry.data.termEs}
    </p>

    <div class="glossary-card bg-cream-dim border border-[rgba(10,10,9,0.08)] rounded-[3px] py-8 px-[clamp(20px,4vw,40px)]">
      <p class="text-[19px] leading-[1.7] text-ink m-0 mb-4">{entry.data.definitionEn}</p>
      {seeAlso.length > 0 && (
        <p class="text-[15px] text-gold-dark mt-5 mb-0">
          <span>{UI.seeAlso.en}</span>{' '}
          {seeAlso.map((link, index) => (
            <>
              {index > 0 && ', '}
              <a
                href={link.href}
                class="underline [text-decoration-color:rgba(51,46,34,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-2"
              >{link.label}</a>
            </>
          ))}
        </p>
      )}
      {wikipediaUrl && (
        <p class="text-[15px] text-gold-dark mt-5 mb-0">
          <span>{UI.encyclopedia.en}</span>{' '}
          <a
            href={wikipediaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline [text-decoration-color:rgba(51,46,34,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-2"
          >“{entry.data.termEs}” article on Spanish Wikipedia <span class="new-window-hint"> (opens in a new tab)</span></a>
        </p>
      )}
    </div>

    <p class="mt-8 mb-0">
      <a
        href={GLOSSARY_PATH_EN}
        class="inline-flex items-center min-h-11 text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      >← Back to the glossary</a>
    </p>
  </article>
</BlogLayout>
