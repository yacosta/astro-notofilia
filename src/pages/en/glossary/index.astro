---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import FeaturePage from '../../../components/FeaturePage.astro';
import { titleTag } from '../../../lib/posts';
import {
  GLOSSARY_DESCRIPTION_EN,
  GLOSSARY_PATH_EN,
  GLOSSARY_TITLE_EN,
  buildGlossaryLookup,
  glossaryCategories,
  glossaryIndexJsonLdEn,
  glossaryTermPathEn,
  getGlossaryTermsEn,
  resolveSeeAlsoEn,
} from '../../../lib/glossary';
import { GLOSSARY_CATEGORY_EN, UI } from '../../../lib/ui-i18n';

const terms = await getGlossaryTermsEn();
const lookup = buildGlossaryLookup(terms);
const categories = glossaryCategories(terms);
const jsonLd = glossaryIndexJsonLdEn(terms);
---
<BlogLayout
  locale="en"
  title={titleTag(GLOSSARY_TITLE_EN)}
  description={GLOSSARY_DESCRIPTION_EN}
  path={GLOSSARY_PATH_EN}
  jsonLd={jsonLd}
>
  <FeaturePage as="div" variant="index" id="glossary-index">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-5" aria-label="Breadcrumb">
      <a class="text-muted [text-decoration-color:rgba(183,171,138,0.4)]" href="/en/">Home</a>
      <span aria-hidden="true"> / </span>
      <span>Glossary</span>
    </nav>

    <header class="text-center max-w-none mx-auto mb-10">
      <p class="m-0 mb-3.5 text-[14px] tracking-[0.22em] uppercase text-muted">
        A resource for collectors
      </p>
      <h1 class="font-display font-normal text-[clamp(28px,4vw,44px)] text-cream mt-0 mb-4 leading-[1.08]">
        {GLOSSARY_TITLE_EN}
      </h1>
      <p class="text-[clamp(18px,2.2vw,20px)] text-cream-dim m-0 leading-[1.6]">
        {terms.length} coin and banknote terms — design, production, issuing, conservation, and collecting — that appear throughout the Notofilia catalog, with the Spanish equivalent and a short definition.
      </p>
    </header>

    <div class="max-w-none mx-auto mb-7" data-pagefind-ignore>
      <label
        for="glossary-search"
        class="block text-[13px] tracking-[0.14em] uppercase text-muted mb-2.5 text-center"
      >
        Search the glossary
      </label>
      <div class="relative">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          class="absolute top-1/2 left-5 -translate-y-1/2 pointer-events-none"
        >
          <circle cx="11" cy="11" r="7" stroke="#6b521f" stroke-width="2"></circle>
          <line x1="16.4" y1="16.4" x2="21" y2="21" stroke="#6b521f" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <input
          id="glossary-search"
          type="search"
          placeholder="E.g. specimen, vignette, planchet…"
          autocomplete="off"
          aria-describedby="glossary-search-status"
          class="w-full box-border min-h-14 font-serif text-[19px] text-ink bg-[#f2ede2] border-2 border-[rgba(10,10,9,0.12)] rounded-full py-3.5 pr-[52px] pl-[54px] outline-none shadow-[0_10px_26px_rgba(0,0,0,0.28)] focus-visible:border-gold-deep focus-visible:shadow-[0_10px_26px_rgba(0,0,0,0.28),0_0_0_4px_rgba(138,109,59,0.22)]"
        />
        <button
          type="button"
          id="glossary-clear"
          hidden
          aria-label="Clear search"
          class="absolute top-1/2 right-2.5 -translate-y-1/2 w-9 h-9 min-w-11 min-h-11 flex items-center justify-center bg-[rgba(10,10,9,0.08)] border-0 text-gold-dark text-[20px] leading-none cursor-pointer rounded-full hover:bg-[rgba(10,10,9,0.15)] hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-1"
        >×</button>
      </div>
      <p id="glossary-search-status" aria-live="polite" class="text-[14px] text-muted text-center mt-3 mb-0">
        Showing all {terms.length} glossary terms.
      </p>
    </div>

    <div class="flex flex-wrap gap-2.5 justify-center mb-12" role="group" aria-label="Filter by category" data-pagefind-ignore>
      <button
        type="button"
        data-glossary-category=""
        aria-pressed="true"
        class="glossary-chip min-h-11 px-3.5 py-[7px] text-[13px] tracking-[0.08em] uppercase text-gold-dark bg-cream-dim rounded-full border border-transparent cursor-pointer font-serif aria-[pressed=true]:border-gold-deep aria-[pressed=true]:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
      >All</button>
      {categories.map((cat) => (
        <button
          type="button"
          data-glossary-category={cat}
          aria-pressed="false"
          class="glossary-chip min-h-11 px-3.5 py-[7px] text-[13px] tracking-[0.08em] uppercase text-gold-dark bg-cream-dim rounded-full border border-transparent cursor-pointer font-serif aria-[pressed=true]:border-gold-deep aria-[pressed=true]:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
        >{GLOSSARY_CATEGORY_EN[cat] ?? cat}</button>
      ))}
    </div>

    <div class="flex flex-col gap-0">
      {terms.map((entry) => {
        const seeAlso = resolveSeeAlsoEn(entry.data.seeAlso, lookup);
        const searchBlob = [
          entry.data.termEs,
          entry.data.termEn,
          entry.data.definitionEn,
          entry.data.category,
          GLOSSARY_CATEGORY_EN[entry.data.category] ?? '',
        ].join(' ');
        return (
          <article
            id={entry.id}
            data-glossary-term
            data-glossary-cat={entry.data.category}
            data-glossary-search={searchBlob
              .toLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '')}
            class="glossary-card bg-cream-dim border border-[rgba(10,10,9,0.08)] rounded-[3px] py-7 px-[clamp(20px,4vw,40px)] mb-[18px] scroll-mt-[90px]"
          >
            <div class="flex flex-wrap items-baseline gap-2.5 mb-2.5">
              <h2 class="font-display font-normal text-[22px] text-bg m-0">
                <a
                  href={glossaryTermPathEn(entry.data.termEn)}
                  class="no-underline hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-2"
                >{entry.data.termEn}</a>
              </h2>
              <span lang="es" class="text-[17px] italic text-gold-dark">{entry.data.termEs}</span>
              <span class="ml-auto text-[11px] tracking-[0.1em] uppercase text-gold-deep border border-[rgba(138,109,59,0.35)] rounded-full py-[3px] px-2.5">
                {GLOSSARY_CATEGORY_EN[entry.data.category] ?? entry.data.category}
              </span>
            </div>
            <p class="text-[18px] leading-[1.6] text-ink m-0 mb-1.5">{entry.data.definitionEn}</p>
            {seeAlso.length > 0 && (
              <p class="text-[14px] text-gold-dark mt-2.5 mb-0">
                <span>{UI.seeAlso.en}</span>{' '}
                {seeAlso.map((link, index) => (
                  <>
                    {index > 0 && ', '}
                    <a
                      href={link.href}
                      class="underline [text-decoration-color:rgba(51,46,34,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-2"
                    >{link.label}</a>
                  </>
                ))}
              </p>
            )}
          </article>
        );
      })}
    </div>

    <div id="glossary-empty" hidden class="text-center py-8 px-5 text-gold-dark">
      <p class="text-[18px] m-0 mb-3">
        We didn’t find terms for “<span id="glossary-empty-query"></span>”.
      </p>
      <button
        type="button"
        id="glossary-reset"
        class="min-h-11 px-[22px] py-2.5 font-serif text-[16px] text-ink bg-cream-dim border border-[rgba(10,10,9,0.15)] rounded cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-gold-deep focus-visible:outline-offset-2"
      >View the whole glossary</button>
    </div>

    <p class="text-[14px] leading-[1.6] text-muted text-center mt-8 mb-0">
      Terms marked as suggested complement the vocabulary already used in the catalog with standard words from international collecting.
    </p>
  </FeaturePage>
</BlogLayout>

<script src="../../../client/glossary-filter.js"></script>

<style>
  #glossary-search::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
</style>
