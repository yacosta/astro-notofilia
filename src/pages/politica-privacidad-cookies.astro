---
/**
 * Privacy and cookie policy (ES default, EN toggle). Canonical URL is
 * /politica-privacidad-cookies/; legacy .dc variants 301 here.
 */
import BlogLayout from '../layouts/BlogLayout.astro';
import { SITE } from '../lib/site';

const title = 'Política de Privacidad y Cookies | Notofilia';
const description =
  'Política de privacidad y cookies de notofilia.com: qué datos recopilamos, con qué finalidad, y cómo ejercer tus derechos (RGPD, LOPDGDD, Ley 1581).';
const path = '/politica-privacidad-cookies/';
const keywords = [
  'politica de privacidad',
  'politica de cookies',
  'notofilia',
  'proteccion de datos',
  'rgpd',
  'lopdgdd',
  'ley 1581',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Notofilia', item: `${SITE}/` },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Política de Privacidad y Cookies',
          item: `${SITE}${path}`,
        },
      ],
    },
    {
      '@type': 'WebPage',
      name: 'Política de Privacidad y Cookies',
      url: `${SITE}${path}`,
      inLanguage: ['es', 'en'],
      isPartOf: { '@type': 'WebSite', name: 'Notofilia', url: `${SITE}/` },
    },
  ],
};

const articleClass =
  'text-cream-dim bg-[var(--surface-artifact)] border border-[var(--rule-artifact)] rounded-[var(--radius-surface)] p-[clamp(24px,4vw,44px)]';
const h2Class = 'font-display font-normal text-[24px] text-cream mt-8 mb-3';
const pClass = 'text-[17px] leading-[1.7] m-0 mb-2.5';
const tableHead = 'text-left px-3 py-2.5 font-semibold';
const td = 'px-3 py-2.5';
---
<BlogLayout title={title} description={description} path={path} ogType="website" jsonLd={jsonLd} keywords={keywords}>
  <div class="max-w-[840px] mx-auto px-5 pt-16 pb-10" data-privacy-root data-pagefind-meta="url:/politica-privacidad-cookies/">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-5" aria-label="Miga de pan">
      <a class="text-muted" href="/">Notofilia</a>
      <span class="text-muted mx-2" aria-hidden="true">/</span>
      <span data-privacy-crumb>Política de Privacidad y Cookies</span>
    </nav>

    <div class="flex items-start justify-between gap-5 flex-wrap mb-2.5">
      <h1 data-privacy-title class="font-display font-normal text-[clamp(28px,4vw,42px)] text-cream m-0">
        Política de Privacidad y Cookies
      </h1>
      <div
        role="group"
        aria-label="Selector de idioma / Language selector"
        class="shrink-0 flex items-center bg-[rgba(10,10,9,0.35)] border border-[rgba(231,222,201,0.35)] rounded-full p-[3px]"
      >
        <button
          type="button"
          data-privacy-lang="es"
          aria-pressed="true"
          aria-label="Ver página en español"
          class="min-h-11 border-0 rounded-full font-serif font-semibold text-[13px] tracking-[0.14em] px-[18px] cursor-pointer bg-[rgba(231,222,201,0.9)] text-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
        >ES</button>
        <button
          type="button"
          data-privacy-lang="en"
          aria-pressed="false"
          aria-label="View page in English"
          lang="en"
          class="min-h-11 border-0 rounded-full font-serif font-semibold text-[13px] tracking-[0.14em] px-[18px] cursor-pointer bg-transparent text-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
        >EN</button>
      </div>
    </div>
    <p data-privacy-updated class="text-[16px] text-muted m-0 mb-9">Última actualización: 13 de julio de 2026</p>

    <article data-privacy-panel="es" class={articleClass}>
      <p class="text-[18px] leading-[1.65] m-0 mb-6">
        Esta Política de Privacidad y Cookies (la &laquo;Política&raquo;) explica cómo notofilia.com (&laquo;el Sitio&raquo;, &laquo;nosotros&raquo;) recopila, utiliza y protege los datos personales de quienes visitan o interactúan con el Sitio, en cumplimiento del Reglamento (UE) 2016/679 (RGPD), la Ley Orgánica 3/2018 (LOPDGDD) y, para usuarios en Colombia, la Ley 1581 de 2012.
      </p>
      <h2 class={h2Class}>1. Responsable del tratamiento</h2>
      <ul class="text-[17px] leading-[1.7] m-0 mb-2 pl-[22px]">
        <li><strong>Titular:</strong> Notofilia</li>
        <li><strong>Domicilio:</strong> 407 Lincoln Rd. Suite 6H PMB 7209, Miami Beach, Florida, 33139, Estados Unidos</li>
        <li><strong>Correo de contacto:</strong> info@notofilia.com</li>
      </ul>
      <h2 class={h2Class}>2. Datos que recopilamos y finalidades</h2>
      <p class={pClass}><strong>Formulario de suscripción:</strong> nombre y correo electrónico, con la finalidad de enviarle novedades del Sitio. Gestionado por nuestro proveedor de email marketing, <strong>Mailchimp (Intuit Inc., EE. UU.)</strong>. Al suscribirse, sus datos se transfieren a EE. UU. bajo las salvaguardas contractuales de Mailchimp.</p>
      <p class={pClass}><strong>Google Analytics 4:</strong> si acepta las cookies analíticas, recopilamos identificadores de cookie (_ga, _ga_*), IP truncada, dispositivo/navegador, páginas visitadas, duración de sesión y fuente de referencia.</p>
      <p class={pClass}><strong>Cloudflare Web Analytics:</strong> analítica sin cookies ni identificadores personales; solo métricas agregadas. No requiere consentimiento.</p>
      <p class="text-[17px] leading-[1.7] m-0"><strong>Cookies técnicas de seguridad:</strong> Cloudflare instala cookies estrictamente necesarias (ej. __cf_bm) para la seguridad del Sitio, exentas de consentimiento.</p>
      <h2 class={h2Class}>3. Base jurídica de cada tratamiento</h2>
      <div class="overflow-x-auto mb-2">
        <table class="w-full border-collapse text-[16px]">
          <thead>
            <tr class="border-b-2 border-[rgba(231,222,201,0.25)]">
              <th scope="col" class={tableHead}>Tratamiento</th>
              <th scope="col" class={tableHead}>Base jurídica</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Envío de newsletter</td><td class={td}>Consentimiento (art. 6.1.a RGPD)</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Cookies analíticas (GA4)</td><td class={td}>Consentimiento (art. 6.1.a RGPD)</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Cloudflare Web Analytics</td><td class={td}>No aplica (sin datos personales)</td></tr>
            <tr><td class={td}>Cookies técnicas de seguridad</td><td class={td}>Interés legítimo (art. 6.1.f RGPD)</td></tr>
          </tbody>
        </table>
      </div>
      <h2 class={h2Class}>4. Destinatarios y encargados del tratamiento</h2>
      <p class="text-[17px] leading-[1.7] m-0">Sus datos pueden ser tratados por <strong>Mailchimp — Intuit Inc.</strong> (newsletter), <strong>Google LLC</strong> (Google Analytics 4) y <strong>Cloudflare, Inc.</strong> (alojamiento, seguridad y analítica agregada). No cedemos ni vendemos sus datos a terceros con fines comerciales.</p>
      <h2 class={h2Class}>5. Transferencias internacionales</h2>
      <p class="text-[17px] leading-[1.7] m-0">La transferencia de datos a Google LLC (EE. UU.) se ampara en el Marco de Privacidad de Datos UE-EE. UU., reconocido por la Comisión Europea como garantía adecuada (art. 45 RGPD). Si el proveedor de email marketing está fuera del EEE, la transferencia se ampara en las Cláusulas Contractuales Tipo u otro mecanismo equivalente.</p>
      <h2 class={h2Class}>6. Plazos de conservación</h2>
      <ul class="text-[17px] leading-[1.7] m-0 pl-[22px]">
        <li>Datos de suscriptores: mientras la suscripción esté activa; eliminados o anonimizados en 30 días tras la baja.</li>
        <li>Cookies de Google Analytics (_ga, _ga_*): hasta 2 años.</li>
        <li>Cookies técnicas de seguridad (__cf_bm): hasta 30 minutos.</li>
        <li>Registros de servidor con fines de seguridad: hasta 12 meses.</li>
      </ul>
      <h2 class={h2Class}>7. Derechos del usuario</h2>
      <p class={pClass}>Usted tiene derecho a acceder, rectificar, suprimir, oponerse, solicitar la portabilidad, limitar el tratamiento y retirar su consentimiento en cualquier momento. Puede ejercerlos escribiendo a <strong>info@notofilia.com</strong>.</p>
      <p class="text-[17px] leading-[1.7] m-0">Si considera que sus derechos no han sido atendidos, puede reclamar ante la <strong>Agencia Española de Protección de Datos (AEPD)</strong> — aepd.es, la <strong>Superintendencia de Industria y Comercio (SIC)</strong> de Colombia — sic.gov.co, o la autoridad de su país de residencia.</p>
      <h2 class={h2Class}>8. Política de cookies</h2>
      <div class="overflow-x-auto mb-3.5">
        <table class="w-full border-collapse text-[15px]">
          <thead>
            <tr class="border-b-2 border-[rgba(231,222,201,0.25)]">
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Nombre</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Proveedor</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Finalidad</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Duración</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Tipo</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">_ga</td><td class="px-2.5 py-2.5">Google Analytics</td><td class="px-2.5 py-2.5">Distinguir usuarios únicos</td><td class="px-2.5 py-2.5">2 años</td><td class="px-2.5 py-2.5">Analítica</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">_ga_*</td><td class="px-2.5 py-2.5">Google Analytics</td><td class="px-2.5 py-2.5">Estado de sesión y visitas</td><td class="px-2.5 py-2.5">2 años</td><td class="px-2.5 py-2.5">Analítica</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">__cf_bm</td><td class="px-2.5 py-2.5">Cloudflare</td><td class="px-2.5 py-2.5">Seguridad, mitigar tráfico malicioso</td><td class="px-2.5 py-2.5">30 min</td><td class="px-2.5 py-2.5">Necesaria</td></tr>
            <tr><td class="px-2.5 py-2.5">—</td><td class="px-2.5 py-2.5">Cloudflare Web Analytics</td><td class="px-2.5 py-2.5">Métricas agregadas, sin identificar</td><td class="px-2.5 py-2.5">No aplica</td><td class="px-2.5 py-2.5">No requiere consentimiento</td></tr>
          </tbody>
        </table>
      </div>
      <p class={pClass}>Puede retirar su consentimiento en &laquo;Configuración de cookies&raquo; en el pie de página, o eliminando las cookies del navegador para este dominio. También puede bloquearlas desde la configuración de Chrome, Firefox, Safari o Edge, aunque esto puede afectar cookies técnicas necesarias.</p>
      <h2 class={h2Class}>9. Baja de la newsletter</h2>
      <p class="text-[17px] leading-[1.7] m-0">Todos los correos incluyen un enlace de &laquo;darse de baja&raquo; al final del mensaje. Al usarlo, dejará de recibir comunicaciones de forma inmediata.</p>
      <h2 class={h2Class}>10. Cambios en esta política</h2>
      <p class="text-[17px] leading-[1.7] m-0">Podemos actualizar esta Política ante cambios legislativos, técnicos o de servicio. Publicaremos cualquier cambio en esta misma página, indicando la fecha de la última actualización.</p>
      <p class="text-[14px] leading-[1.6] text-muted mt-9 mb-0 italic">Nota: este documento es una plantilla informativa general y no constituye asesoramiento jurídico. Se recomienda su revisión por un profesional del derecho especializado en protección de datos.</p>
    </article>

    <article data-privacy-panel="en" lang="en" hidden class={articleClass}>
      <p class="text-[18px] leading-[1.65] m-0 mb-6">
        This Privacy and Cookie Policy (the &ldquo;Policy&rdquo;) explains how notofilia.com (&ldquo;the Site,&rdquo; &ldquo;we&rdquo;) collects, uses, and protects the personal data of visitors, in compliance with Regulation (EU) 2016/679 (GDPR), Spain&rsquo;s LOPDGDD, and, for users in Colombia, Law 1581 of 2012.
      </p>
      <h2 class={h2Class}>1. Data controller</h2>
      <ul class="text-[17px] leading-[1.7] m-0 mb-2 pl-[22px]">
        <li><strong>Owner:</strong> Notofilia</li>
        <li><strong>Address:</strong> 407 Lincoln Rd. Suite 6H PMB 7209, Miami Beach, Florida, 33139, United States</li>
        <li><strong>Contact email:</strong> info@notofilia.com</li>
      </ul>
      <h2 class={h2Class}>2. Data we collect and purposes</h2>
      <p class={pClass}><strong>Subscription form:</strong> first name and email, to send Site updates. Managed by our email marketing provider, <strong>Mailchimp (Intuit Inc., USA)</strong>. By subscribing, your data is transferred to the USA under Mailchimp&rsquo;s contractual safeguards.</p>
      <p class={pClass}><strong>Google Analytics 4:</strong> if you accept analytics cookies, we collect cookie identifiers (_ga, _ga_*), truncated IP, device/browser, pages visited, session duration, and referral source.</p>
      <p class={pClass}><strong>Cloudflare Web Analytics:</strong> cookie-free analytics with no personal identifiers; only aggregated metrics. No consent required.</p>
      <p class="text-[17px] leading-[1.7] m-0"><strong>Technical security cookies:</strong> Cloudflare places strictly necessary cookies (e.g. __cf_bm) for Site security, exempt from consent.</p>
      <h2 class={h2Class}>3. Legal basis for each processing activity</h2>
      <div class="overflow-x-auto mb-2">
        <table class="w-full border-collapse text-[16px]">
          <thead>
            <tr class="border-b-2 border-[rgba(231,222,201,0.25)]">
              <th scope="col" class={tableHead}>Processing activity</th>
              <th scope="col" class={tableHead}>Legal basis</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Newsletter sending</td><td class={td}>Consent (Art. 6(1)(a) GDPR)</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Analytics cookies (GA4)</td><td class={td}>Consent (Art. 6(1)(a) GDPR)</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class={td}>Cloudflare Web Analytics</td><td class={td}>Not applicable (no personal data)</td></tr>
            <tr><td class={td}>Technical security cookies</td><td class={td}>Legitimate interest (Art. 6(1)(f) GDPR)</td></tr>
          </tbody>
        </table>
      </div>
      <h2 class={h2Class}>4. Recipients and data processors</h2>
      <p class="text-[17px] leading-[1.7] m-0">Your data may be processed by <strong>Mailchimp — Intuit Inc.</strong> (newsletter), <strong>Google LLC</strong> (Google Analytics 4), and <strong>Cloudflare, Inc.</strong> (hosting, security, aggregated analytics). We do not sell or share your data with third parties for commercial purposes.</p>
      <h2 class={h2Class}>5. International data transfers</h2>
      <p class="text-[17px] leading-[1.7] m-0">Transfers to Google LLC (U.S.) rely on the EU-U.S. Data Privacy Framework, recognized by the European Commission as providing adequate protection (Art. 45 GDPR). If the email marketing provider is based outside the EEA, the transfer relies on Standard Contractual Clauses or an equivalent mechanism.</p>
      <h2 class={h2Class}>6. Data retention periods</h2>
      <ul class="text-[17px] leading-[1.7] m-0 pl-[22px]">
        <li>Subscriber data: while the subscription is active; deleted or anonymized within 30 days of unsubscribing.</li>
        <li>Google Analytics cookies (_ga, _ga_*): up to 2 years.</li>
        <li>Technical security cookies (__cf_bm): up to 30 minutes.</li>
        <li>Server logs kept for security purposes: up to 12 months.</li>
      </ul>
      <h2 class={h2Class}>7. User rights</h2>
      <p class={pClass}>You may access, rectify, erase, object to, request portability of, restrict processing of, and withdraw consent for your data at any time, by writing to <strong>info@notofilia.com</strong>.</p>
      <p class="text-[17px] leading-[1.7] m-0">If your rights are not adequately addressed, you may file a complaint with the <strong>Spanish Data Protection Agency (AEPD)</strong> — aepd.es, the <strong>Superintendence of Industry and Commerce (SIC)</strong> of Colombia — sic.gov.co, or your country&rsquo;s data protection authority.</p>
      <h2 class={h2Class}>8. Cookie policy</h2>
      <div class="overflow-x-auto mb-3.5">
        <table class="w-full border-collapse text-[15px]">
          <thead>
            <tr class="border-b-2 border-[rgba(231,222,201,0.25)]">
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Name</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Provider</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Purpose</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Duration</th>
              <th scope="col" class="text-left px-2.5 py-2.5 font-semibold">Type</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">_ga</td><td class="px-2.5 py-2.5">Google Analytics</td><td class="px-2.5 py-2.5">Distinguishes unique users</td><td class="px-2.5 py-2.5">2 years</td><td class="px-2.5 py-2.5">Analytics</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">_ga_*</td><td class="px-2.5 py-2.5">Google Analytics</td><td class="px-2.5 py-2.5">Session state and visit counts</td><td class="px-2.5 py-2.5">2 years</td><td class="px-2.5 py-2.5">Analytics</td></tr>
            <tr class="border-b border-[rgba(231,222,201,0.12)]"><td class="px-2.5 py-2.5">__cf_bm</td><td class="px-2.5 py-2.5">Cloudflare</td><td class="px-2.5 py-2.5">Security, mitigates malicious traffic</td><td class="px-2.5 py-2.5">30 min</td><td class="px-2.5 py-2.5">Necessary</td></tr>
            <tr><td class="px-2.5 py-2.5">—</td><td class="px-2.5 py-2.5">Cloudflare Web Analytics</td><td class="px-2.5 py-2.5">Aggregated metrics, no identifiers</td><td class="px-2.5 py-2.5">Not applicable</td><td class="px-2.5 py-2.5">No consent required</td></tr>
          </tbody>
        </table>
      </div>
      <p class={pClass}>You can withdraw consent via &ldquo;Cookie Settings&rdquo; in the footer, or by clearing this domain&rsquo;s cookies from your browser. You can also block cookies via Chrome, Firefox, Safari, or Edge settings, though this may affect strictly necessary cookies.</p>
      <h2 class={h2Class}>9. Newsletter unsubscribe</h2>
      <p class="text-[17px] leading-[1.7] m-0">Every email includes an &ldquo;unsubscribe&rdquo; link at the bottom. Clicking it stops our communications immediately.</p>
      <h2 class={h2Class}>10. Changes to this policy</h2>
      <p class="text-[17px] leading-[1.7] m-0">We may update this Policy to reflect legislative, technical, or service changes. Any changes will be published on this same page, indicating the last update date.</p>
      <p class="text-[14px] leading-[1.6] text-muted mt-9 mb-0 italic">Note: this document is a general informational template and does not constitute legal advice. Review by a data-protection legal professional is recommended.</p>
    </article>
  </div>

  <script is:inline>
    (function () {
      const root = document.querySelector('[data-privacy-root]');
      if (!root) return;
      const buttons = Array.from(root.querySelectorAll('[data-privacy-lang]'));
      const panels = {
        es: root.querySelector('[data-privacy-panel="es"]'),
        en: root.querySelector('[data-privacy-panel="en"]'),
      };
      const title = root.querySelector('[data-privacy-title]');
      const crumb = root.querySelector('[data-privacy-crumb]');
      const updated = root.querySelector('[data-privacy-updated]');
      const labels = {
        es: {
          title: 'Política de Privacidad y Cookies',
          crumb: 'Política de Privacidad y Cookies',
          updated: 'Última actualización: 13 de julio de 2026',
        },
        en: {
          title: 'Privacy and Cookie Policy',
          crumb: 'Privacy and Cookie Policy',
          updated: 'Last updated: July 13, 2026',
        },
      };

      function setLang(lang) {
        const next = lang === 'en' ? 'en' : 'es';
        Object.keys(panels).forEach(function (key) {
          if (!panels[key]) return;
          panels[key].hidden = key !== next;
        });
        buttons.forEach(function (btn) {
          const on = btn.getAttribute('data-privacy-lang') === next;
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          btn.classList.toggle('bg-[rgba(231,222,201,0.9)]', on);
          btn.classList.toggle('text-bg', on);
          btn.classList.toggle('bg-transparent', !on);
          btn.classList.toggle('text-cream', !on);
        });
        const copy = labels[next];
        if (title) title.textContent = copy.title;
        if (crumb) crumb.textContent = copy.crumb;
        if (updated) updated.textContent = copy.updated;
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setLang(btn.getAttribute('data-privacy-lang'));
        });
      });
    })();
  </script>
</BlogLayout>
