---
/**
 * Privacy and cookie policy (Spanish). English lives at /en/privacy-cookies/.
 * Canonical URL is /politica-privacidad-cookies/; legacy .dc variants 301 here.
 */
import BlogLayout from '../layouts/BlogLayout.astro';
import FeaturePage from '../components/FeaturePage.astro';
import PrivacyPolicyBody from '../components/PrivacyPolicyBody.astro';
import { PRIVACY_ES_PATH, privacyJsonLd } from '../lib/legal';

const title = 'Política de Privacidad y Cookies | Notofilia';
const description =
  'Cómo Notofilia trata sus datos: boletín Mailchimp, cookies técnicas de Cloudflare y sus derechos (RGPD, LOPDGDD, Ley 1581).';
---
<BlogLayout
  title={title}
  description={description}
  path={PRIVACY_ES_PATH}
  ogType="website"
  jsonLd={privacyJsonLd('es')}
>
  <FeaturePage as="div" variant="policy" data-privacy-root data-pagefind-meta={`url:${PRIVACY_ES_PATH}`}>
    <PrivacyPolicyBody lang="es" />
  </FeaturePage>
</BlogLayout>
