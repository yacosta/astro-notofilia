---
/**
 * Dedicated author / editorial-team profile.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import { SITE } from '../../lib/site';
import { EDITORIAL_TEAM, EDITORIAL_POLICY_URL, CORRECTION_POLICY_URL } from '../../lib/editorial';

const title = 'Equipo editorial | Notofilia';
const description =
  'Quién revisa y firma los textos de Notofilia: política editorial, valoración y correcciones.';
const path = EDITORIAL_TEAM.path;
const keywords = [
  'equipo editorial Notofilia',
  'autor Notofilia',
  'política editorial',
  'correcciones numismáticas',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}${path}#page`,
      name: EDITORIAL_TEAM.name,
      url: `${SITE}${path}`,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': `${SITE}${path}#person` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Política editorial', item: EDITORIAL_POLICY_URL },
          { '@type': 'ListItem', position: 3, name: 'Equipo editorial', item: `${SITE}${path}` },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': `${SITE}${path}#person`,
      name: EDITORIAL_TEAM.name,
      url: `${SITE}${path}`,
      jobTitle: EDITORIAL_TEAM.jobTitle,
      worksFor: {
        '@type': 'Organization',
        name: 'Notofilia',
        url: SITE,
      },
      knowsAbout: [
        'Notafilia',
        'Numismática',
        'Papel moneda',
        'Billetes de colección',
        'Valoración numismática',
      ],
    },
  ],
};
---
<BlogLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  jsonLd={jsonLd}
  keywords={keywords}
>
  <article class="max-w-content mx-auto px-6 pt-12 pb-4">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-6" aria-label="Migas de pan">
      <a class="text-muted" href="/">Inicio</a> <span aria-hidden="true">/</span>
      <a class="text-muted" href="/editorial/">Política editorial</a>
      <span aria-hidden="true">/</span>
      <span>Equipo editorial</span>
    </nav>

    <header class="mb-10">
      <p class="m-0 mb-3 text-[13px] tracking-[0.14em] uppercase text-muted">Autoría</p>
      <h1 class="font-display font-normal text-[clamp(28px,4.5vw,42px)] text-cream mt-0 mb-4 leading-[1.12]">
        {EDITORIAL_TEAM.name}
      </h1>
      <p class="italic text-[clamp(18px,2.2vw,22px)] text-cream-dim m-0 leading-[1.5]">
        Firma colectiva responsable de la revisión editorial, el etiquetado de valoraciones
        y el historial de correcciones en Notofilia.
      </p>
    </header>

    <div class="prose-notofilia text-[19px] leading-[1.75] text-cream-dim">
      <h2>Qué firma este perfil</h2>
      <p>
        Cuando una noticia, guía o logro indica “Revisado por”, apunta a este perfil. No es un
        seudónimo de marketing: concentra la responsabilidad editorial del sitio sobre hechos,
        cifras y fuentes.
      </p>

      <h2>Cómo trabajamos</h2>
      <ul>
        <li>
          Distinguimos precios de anuncio, guías de catálogo y
          <strong>ventas verificadas</strong> (remates documentados).
        </li>
        <li>
          Preferimos fuentes primarias: casas de subastas, bancos centrales, catálogos y
          comunicados oficiales.
        </li>
        <li>
          Las correcciones materiales se registran en la propia pieza y se resumen en la
          <a href={CORRECTION_POLICY_URL}>política de correcciones</a>.
        </li>
      </ul>

      <h2>Documentos relacionados</h2>
      <ul>
        <li>
          <a href="/editorial/">Política editorial y estándar de valoración</a>
        </li>
        <li>
          <a href="/editorial/#correcciones">Política de correcciones</a>
        </li>
        <li>
          <a href="/contacto/">Contacto</a> para reportar un error o aportar una fuente
        </li>
      </ul>
    </div>
  </article>
</BlogLayout>
