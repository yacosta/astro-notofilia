---
/**
 * Named editor profile — Yezid Acosta.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import NewWindowHint from '../../components/NewWindowHint.astro';
import { SITE } from '../../lib/site';
import {
  EDITORIAL_TEAM,
  EDITORIAL_POLICY_URL,
  CORRECTION_POLICY_URL,
  WIKIPEDIA_NOTAFILIA_URL,
  WIKIPEDIA_NOTOFILIA_ARCHIVE_URL,
  personJsonLd,
} from '../../lib/editorial';

const title = 'Yezid Acosta, editor | Notofilia';
const description =
  'Yezid Acosta edita Notofilia: catálogo privado, etiquetado de valoraciones y correcciones.';
const path = EDITORIAL_TEAM.path;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${SITE}${path}#page`,
      name: EDITORIAL_TEAM.name,
      url: `${SITE}${path}`,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: { '@id': `${SITE}${path}#person` },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: 'Política editorial', item: EDITORIAL_POLICY_URL },
          { '@type': 'ListItem', position: 3, name: EDITORIAL_TEAM.name, item: `${SITE}${path}` },
        ],
      },
    },
    {
      ...personJsonLd(),
      knowsAbout: [
        'Notafilia',
        'Numismática',
        'Papel moneda',
        'Billetes de colección',
        'Valoración numismática',
      ],
    },
  ],
};
---
<BlogLayout
  title={title}
  description={description}
  path={path}
  ogType="website"
  jsonLd={jsonLd}
>
  <article class="max-w-content mx-auto px-6 pt-12 pb-4">
    <nav class="text-[14px] tracking-[0.06em] text-muted mb-6" aria-label="Migas de pan" data-i18n data-i18n-target="aria-label" data-en="Breadcrumb">
      <a class="text-muted" href="/" data-i18n data-en="Home">Inicio</a> <span aria-hidden="true">/</span>
      <a class="text-muted" href="/editorial/" data-i18n data-en="Editorial policy">Política editorial</a>
      <span aria-hidden="true">/</span>
      <span>{EDITORIAL_TEAM.name}</span>
    </nav>

    <header class="mb-10">
      <p class="m-0 mb-3 text-[13px] tracking-[0.14em] uppercase text-muted" data-i18n data-en="Editor">Editor</p>
      <h1 class="font-display font-normal text-[clamp(28px,4.5vw,42px)] text-cream mt-0 mb-4 leading-[1.12]">
        {EDITORIAL_TEAM.name}
      </h1>
      <p class="italic text-[clamp(18px,2.2vw,22px)] text-cream-dim m-0 leading-[1.5]" data-i18n data-en="Founder and editor of Notofilia. Responsible for the private catalog, valuation labels, and the correction history.">
        Fundador y editor de Notofilia. Responsable del catálogo privado, del etiquetado de
        valoraciones y del historial de correcciones.
      </p>
    </header>

    <div class="prose-notofilia text-[19px] leading-[1.75] text-cream-dim">
      <div data-lang-panel="es">
      <h2>Qué firma este perfil</h2>
      <p>
        Cuando una noticia, guía o logro indica “Revisado por”, apunta a esta página. La
        responsabilidad editorial —hechos, cifras, fuentes y fichas de la Colección Virtual—
        recae en una persona, no en una firma colectiva anónima.
      </p>

      <h2>Cómo trabajo</h2>
      <ul>
        <li>
          Distingo precios de anuncio, guías de catálogo y
          <strong>ventas verificadas</strong> (remates documentados).
        </li>
        <li>
          Prefiero fuentes primarias: casas de subastas, bancos centrales, catálogos y
          comunicados oficiales.
        </li>
        <li>
          Las correcciones materiales se registran en la propia pieza y se resumen en la
          <a href={CORRECTION_POLICY_URL}>política de correcciones</a>.
        </li>
      </ul>

      <h2>Perfil público</h2>
      <ul>
        <li>
          GitHub:{' '}
          <a href="https://github.com/yacosta" target="_blank" rel="noopener noreferrer">
            github.com/yacosta<NewWindowHint />
          </a>
        </li>
        <li>
          Contacto editorial: <a href="/contacto/">formulario</a> o
          <a href="mailto:info@notofilia.com">info@notofilia.com</a>
        </li>
      </ul>

      <h2>Mención en Wikipedia</h2>
      <p>
        El artículo{' '}
        <a href={WIKIPEDIA_NOTAFILIA_URL} target="_blank" rel="noopener noreferrer">
          Notafilia en la Wikipedia en español<NewWindowHint />
        </a>{' '}
        incluye Notofilia.com en Enlaces externos. La mención está viva. El destino es una
        captura de{' '}
        <a href={WIKIPEDIA_NOTOFILIA_ARCHIVE_URL} target="_blank" rel="noopener noreferrer">
          archive.org de mayo de 2013<NewWindowHint />
        </a>{' '}
        de <code>http://www.notofilia.com/</code>, no el apex actual, y MediaWiki marca el
        enlace <code>rel="nofollow"</code>. Es una mención enciclopédica verificable, no un
        backlink de PageRank. Detalle en la
        <a href="/editorial/#wikipedia">política editorial</a>.
      </p>

      <h2>Documentos relacionados</h2>
      <ul>
        <li>
          <a href="/editorial/">Política editorial y estándar de valoración</a>
        </li>
        <li>
          <a href="/editorial/#correcciones">Política de correcciones</a>
        </li>
        <li>
          <a href="/contacto/">Contacto</a> para reportar un error o aportar una fuente
        </li>
      </ul>
      </div>

      <div data-lang-panel="en" lang="en" hidden>
      <h2>What this profile signs</h2>
      <p>
        When a news item, guide, or milestone says “Reviewed by”, it points here. Editorial
        responsibility —facts, figures, sources, and Virtual Collection records— sits with one
        person, not an anonymous collective byline.
      </p>

      <h2>How I work</h2>
      <ul>
        <li>
          I distinguish asking prices, catalog guides, and
          <strong>verified sales</strong> (documented hammers).
        </li>
        <li>
          I prefer primary sources: auction houses, central banks, catalogs, and official
          releases.
        </li>
        <li>
          Material corrections are recorded on the piece itself and summarized in the
          <a href={CORRECTION_POLICY_URL}>corrections policy</a>.
        </li>
      </ul>

      <h2>Public profile</h2>
      <ul>
        <li>
          GitHub:{' '}
          <a href="https://github.com/yacosta" target="_blank" rel="noopener noreferrer">
            github.com/yacosta<NewWindowHint />
          </a>
        </li>
        <li>
          Editorial contact: <a href="/contacto/">form</a> or
          <a href="mailto:info@notofilia.com">info@notofilia.com</a>
        </li>
      </ul>

      <h2>Mention on Wikipedia</h2>
      <p>
        The article{' '}
        <a href={WIKIPEDIA_NOTAFILIA_URL} target="_blank" rel="noopener noreferrer">
          Notaphily on Spanish Wikipedia<NewWindowHint />
        </a>{' '}
        lists Notofilia.com under External links. The mention is live. The destination is a{' '}
        <a href={WIKIPEDIA_NOTOFILIA_ARCHIVE_URL} target="_blank" rel="noopener noreferrer">
          May 2013 archive.org snapshot<NewWindowHint />
        </a>{' '}
        of <code>http://www.notofilia.com/</code>, not the current apex, and MediaWiki marks the
        link <code>rel="nofollow"</code>. It is a verifiable encyclopedic mention, not a
        PageRank backlink. Detail in the
        <a href="/editorial/#wikipedia">editorial policy</a>.
      </p>

      <h2>Related documents</h2>
      <ul>
        <li>
          <a href="/editorial/">Editorial policy and valuation standard</a>
        </li>
        <li>
          <a href="/editorial/#correcciones">Corrections policy</a>
        </li>
        <li>
          <a href="/contacto/">Contact</a> to report an error or add a source
        </li>
      </ul>
      </div>
    </div>
  </article>
</BlogLayout>
