---
/**
 * Cookie consent banner. Shown until the visitor accepts or rejects analytics.
 * Escape rejects non-essential cookies; focus moves to the accept button on open
 * (deferred one frame after display so focus does not force a sync reflow).
 *
 * Position is fixed via an inline style (not only a Tailwind class) so the
 * banner stays out of document flow even before the stylesheet applies —
 * preventing the CLS spike from a late-styled overlay pushing content.
 * Markup is server-rendered into the initial HTML; JS only toggles visibility,
 * and opening is deferred until after `load` + idle so it stays off the LCP path.
 */
---
<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-label="Aviso de cookies"
  class="fixed left-0 right-0 bottom-0 z-[80] flex justify-center p-4"
  style="position:fixed;left:0;right:0;bottom:0;z-index:80;display:none;justify-content:center;padding:16px;box-sizing:border-box;"
>
  <div class="w-full max-w-[720px] bg-panel border border-line rounded-lg shadow-[0_24px_60px_rgba(0,0,0,0.55)] px-6 py-[22px] flex flex-col gap-4">
    <p class="font-serif text-[16px] leading-[1.6] text-cream-dim m-0">
      Usamos cookies técnicas necesarias para el funcionamiento del Sitio y, solo con su permiso, cookies analíticas (Google Analytics 4) para entender cómo se usa el contenido. Puede aceptar todas, rechazar las no esenciales, o leer más en nuestra
      <a href="/politica-privacidad-cookies/" class="text-cream [text-decoration-color:rgba(231,222,201,0.4)]">Política de Privacidad y Cookies</a>.
    </p>
    <div class="flex flex-wrap gap-[10px] justify-end">
      <button
        id="cookie-reject"
        type="button"
        class="min-h-[44px] px-[22px] py-[11px] font-serif font-semibold text-[14px] tracking-[0.1em] uppercase text-cream-dim bg-transparent border border-line-input rounded-full cursor-pointer"
      >Rechazar no esenciales</button>
      <button
        id="cookie-accept"
        type="button"
        class="min-h-[44px] px-[26px] py-[11px] font-serif font-semibold text-[14px] tracking-[0.1em] uppercase text-bg bg-cream border border-cream rounded-full cursor-pointer"
      >Aceptar todas</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'notofilia_cookie_consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner || banner.dataset.initialized === 'true') return;
    banner.dataset.initialized = 'true';
    var accept = document.getElementById('cookie-accept');
    var reject = document.getElementById('cookie-reject');
    var stored;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    function choose(v) {
      try { localStorage.setItem(KEY, v); } catch (e) {}
      banner.style.display = 'none';
      if (v === 'accepted') window.dispatchEvent(new CustomEvent('notofilia:cookies-accepted'));
    }
    function focusAccept() {
      // Focus after the display change has been committed in a prior frame so
      // focus() does not force a synchronous layout (PageSpeed "forced reflow").
      if (!accept) return;
      try { accept.focus({ preventScroll: true }); }
      catch (e) { accept.focus(); }
    }
    function openBanner() {
      // Keep position:fixed (and the rest of the overlay box model) intact —
      // only toggle display so neighbors never reflow.
      banner.style.display = 'flex';
      requestAnimationFrame(function () {
        requestAnimationFrame(focusAccept);
      });
    }
    function scheduleOpen() {
      // Defer past first paint / LCP so the banner script is not on the critical path.
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(openBanner, { timeout: 1500 });
      } else {
        window.setTimeout(openBanner, 0);
      }
    }
    if (stored !== 'accepted' && stored !== 'rejected') {
      if (document.readyState === 'complete') scheduleOpen();
      else window.addEventListener('load', scheduleOpen, { once: true });
    }
    if (accept) accept.addEventListener('click', function () { choose('accepted'); });
    if (reject) reject.addEventListener('click', function () { choose('rejected'); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && banner.style.display === 'flex') choose('rejected');
    });
  })();
</script>
