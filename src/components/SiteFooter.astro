---
/**
 * Shared site footer for natively-Astro pages (homepage + BlogLayout + CatalogLayout).
 * Catalog pages used to keep an inline equivalent in public/SiteFooter.dc.html.
 *
 * Always shows the Colección Virtual stats line (build-time from the catalog collection).
 */
import {
  getCollectionStats,
  formatStatsEn,
  formatStatsEs,
} from '../lib/stats';
import { alternateUrl } from '../i18n/pairs';

export interface Props {
  /** Extra tagline under the copyright line. */
  taglineEs?: string;
  taglineEn?: string;
  /** Optional override for the Colección Virtual stats line. */
  statsLineEs?: string;
  statsLineEn?: string;
  /** Compact centered layout (BlogLayout) vs homepage spacing. */
  variant?: 'home' | 'editorial';
  locale?: import('../lib/ui-i18n').Locale;
}

const {
  taglineEs = 'Numismática y Notafilia — un catálogo y colección virtual de billetes y monedas históricas.',
  taglineEn = 'Numismatics and Notaphily — a catalog and virtual collection of historical banknotes and coins.',
  statsLineEs,
  statsLineEn,
  variant = 'editorial',
  locale = 'es',
} = Astro.props;

const computed = await getCollectionStats();
const statsEs = statsLineEs ?? formatStatsEs(computed);
const statsEn = statsLineEn ?? formatStatsEn(computed);
const isEn = locale === 'en';
const editorialHref = isEn
  ? (alternateUrl('/editorial/', 'en') ?? '/editorial/')
  : '/editorial/';
const privacyHref = isEn
  ? (alternateUrl('/politica-privacidad-cookies/', 'en') ?? '/politica-privacidad-cookies/')
  : '/politica-privacidad-cookies/';

const isHome = variant === 'home';
---
<footer
  class:list={[
    isHome
      ? 'relative z-[1] flex flex-col items-center gap-2 max-w-content mx-auto pt-[72px] px-6 pb-10'
      : 'border-t border-line mt-24 pt-14 pb-10 text-center',
  ]}
>
  <div class:list={[!isHome && 'max-w-content mx-auto px-6 flex flex-col gap-2 items-center']}>
    <span
      data-i18n={isEn ? undefined : true}
      data-en={isEn ? undefined : 'Copyright 2026 Notofilia. All Rights Reserved.'}
      class:list={['text-[13px] tracking-[0.18em] uppercase text-muted', isHome && 'font-serif']}
    >{isEn ? 'Copyright 2026 Notofilia. All Rights Reserved.' : 'Copyright 2026 Notofilia. Todos los derechos reservados.'}</span>
    {taglineEn ? (
      <span
        data-i18n={isEn ? undefined : true}
        data-en={isEn ? undefined : taglineEn}
        class:list={['italic text-[14px] text-cream-soft', isHome && 'font-serif max-w-full text-center']}
      >{isEn ? taglineEn : taglineEs}</span>
    ) : (
      <span class:list={['italic text-[14px] text-cream-soft', isHome && 'font-serif max-w-full text-center']}>
        {taglineEs}
      </span>
    )}
    <p
      class:list={[
        'm-0 mt-1 flex flex-wrap justify-center gap-x-3 gap-y-1',
        isHome && 'font-serif text-[13px]',
      ]}
    >
      <a
        href={editorialHref}
        data-i18n={isEn ? undefined : true}
        data-en={isEn ? undefined : 'Editorial &amp; valuation policy'}
        class:list={[
          'text-muted underline [text-decoration-color:rgba(183,171,138,0.4)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]',
          !isHome && 'text-[13px]',
        ]}
      >{isEn ? 'Editorial & valuation policy' : 'Política editorial y valoración'}</a>
      <a
        href={privacyHref}
        data-i18n={isEn ? undefined : true}
        data-en={isEn ? undefined : 'Privacy &amp; Cookie Policy'}
        class:list={[
          'text-muted underline [text-decoration-color:rgba(183,171,138,0.4)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]',
          !isHome && 'text-[13px]',
        ]}
      >{isEn ? 'Privacy & Cookie Policy' : 'Política de Privacidad y Cookies'}</a>
    </p>
    <p class:list={['font-serif text-[13px] tracking-[0.1em] text-muted text-center m-0 mt-2', isHome && 'max-w-full']}>
      <strong data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'Virtual Collection:'} class="font-bold text-gold-light">{isEn ? 'Virtual Collection:' : 'Colección Virtual:'}</strong>
      {' '}
      <span data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : statsEn}>{isEn ? statsEn : statsEs}</span>
    </p>
    <p
      class:list={[
        'm-0 mt-2 text-center text-[13px] tracking-[0.04em] text-muted',
        isHome && 'font-serif',
      ]}
    >
      <span data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'Page designed by'}>{isEn ? 'Page designed by' : 'Página diseñada por'}</span>
      {' '}
      <a
        href="https://cybercon-solutions.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      >CYBERCON SOLUTIONS</a>
      {' '}
      <span data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'with much'}>{isEn ? 'with much' : 'con mucho'}</span>
      {' '}
      <span class="footer-heart" role="img" aria-label={isEn ? 'love' : 'amor'} data-i18n={isEn ? undefined : true} data-i18n-target={isEn ? undefined : 'aria-label'} data-en={isEn ? undefined : 'love'}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path
            fill="#e07a6a"
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
      </span>
    </p>
  </div>
</footer>
