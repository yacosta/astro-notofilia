---
/**
 * Shared site footer — curated hub columns plus collection stats.
 */
import {
  getCollectionStats,
  formatStatsEn,
  formatStatsEs,
} from '../lib/stats';
import { FOOTER_COLUMNS } from '../lib/nav';
import { alternateUrl } from '../i18n/pairs';
import { lookupEn } from '../lib/html-i18n';

export interface Props {
  taglineEs?: string;
  taglineEn?: string;
  statsLineEs?: string;
  statsLineEn?: string;
  variant?: 'home' | 'editorial';
  locale?: import('../lib/ui-i18n').Locale;
}

const {
  taglineEs = 'Numismática y Notafilia — un catálogo y colección virtual de billetes y monedas históricas.',
  taglineEn = 'Numismatics and Notaphily — a catalog and virtual collection of historical banknotes and coins.',
  statsLineEs,
  statsLineEn,
  variant = 'editorial',
  locale = 'es',
} = Astro.props;

const computed = await getCollectionStats();
const statsEs = statsLineEs ?? formatStatsEs(computed);
const statsEn = statsLineEn ?? formatStatsEn(computed);
const isEn = locale === 'en';
const isHome = variant === 'home';

function hrefFor(href: string): string {
  if (!isEn) return href;
  const queryIdx = href.indexOf('?');
  const hashIdx = href.indexOf('#');
  let cut = href.length;
  if (queryIdx >= 0) cut = Math.min(cut, queryIdx);
  if (hashIdx >= 0) cut = Math.min(cut, hashIdx);
  const pathPart = href.slice(0, cut) || '/';
  const rest = href.slice(cut);
  const mapped = alternateUrl(pathPart, 'en');
  if (!mapped) return href;
  return mapped + rest;
}

function labelFor(label: string, labelEn?: string): string {
  if (!isEn) return label;
  return labelEn || lookupEn(label) || label;
}

const linkClass =
  'inline-flex items-center min-h-11 text-cream-soft no-underline hover:text-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]';
---
<footer
  class:list={[
    isHome
      ? 'relative z-[1] max-w-content mx-auto pt-[72px] px-[var(--page-gutter)] pb-10'
      : 'border-t border-line mt-24 pt-14 pb-10',
  ]}
>
  <nav
    class:list={['footer-nav', !isHome && 'max-w-content mx-auto px-[var(--page-gutter)]']}
    aria-label={isEn ? 'Footer' : 'Pie de página'}
  >
    <div class="footer-nav__grid">
      {FOOTER_COLUMNS.map((column) => (
        <div>
          <p class="footer-nav__heading">{labelFor(column.label, column.labelEn)}</p>
          <ul class="footer-nav__list">
            {column.links.map((link) => (
              <li>
                <a class={linkClass} href={hrefFor(link.href)}>{labelFor(link.label, link.labelEn)}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </nav>

  <div class:list={['footer-meta', !isHome && 'max-w-content mx-auto px-[var(--page-gutter)]']}>
    <span class:list={['text-[13px] tracking-[0.18em] uppercase text-muted', isHome && 'font-serif']}>
      {isEn ? 'Copyright 2026 Notofilia. All Rights Reserved.' : 'Copyright 2026 Notofilia. Todos los derechos reservados.'}
    </span>
    <span class:list={['italic text-[14px] text-cream-soft', isHome && 'font-serif max-w-full text-center']}>
      {isEn ? taglineEn : taglineEs}
    </span>
    <p class:list={['font-serif text-[13px] tracking-[0.1em] text-muted text-center m-0 mt-2', isHome && 'max-w-full']}>
      <strong class="font-bold text-gold-light">{isEn ? 'Virtual Collection:' : 'Colección Virtual:'}</strong>
      {' '}
      <span>{isEn ? statsEn : statsEs}</span>
    </p>
    <p class:list={['m-0 mt-2 text-center text-[13px] tracking-[0.04em] text-muted', isHome && 'font-serif']}>
      <span>{isEn ? 'Page designed by' : 'Página diseñada por'}</span>
      {' '}
      <a
        href="https://cybercon-solutions.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      >CYBERCON SOLUTIONS<span class="italic">{isEn ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span></a>
      {' '}
      <span>{isEn ? 'with much' : 'con mucho'}</span>
      {' '}
      <span class="footer-heart" role="img" aria-label={isEn ? 'love' : 'amor'}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path
            fill="#e07a6a"
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
      </span>
    </p>
  </div>
</footer>

<style>
  .footer-nav__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px 32px;
    margin-bottom: 40px;
  }
  .footer-nav__heading {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: #b7ab8a;
  }
  .footer-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
</style>
