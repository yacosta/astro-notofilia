---
/**
 * Featured Colección Virtual milestones shown on /logros/.
 * Cards are interaction containers (link + image), not decorative chrome.
 */
const highlights = [
  {
    href: '/coleccion/pop-art/',
    title: 'Pop Art',
    description: 'Catálogo de billetes y moneda alterados con estética pop en la colección Notofilia.',
    imageBase: 'rency-pele-bicycle-kick-2-dolares-v3',
    imageAlt: 'Billete de dos dólares intervenido con Pelé — The King, pieza del catálogo Pop Art',
  },
  {
    href: '/coleccion/certificados-de-pago-militar/10-dolares-serie-641/',
    title: 'MPC Serie 641 — Diez Dólares',
    description: 'Certificado de Pago Militar de Vietnam (1965–1968), con la Estatua de la Libertad en el reverso.',
    imageBase: 'mpc-series-641-10-dollars',
    imageAlt: 'Anverso del MPC Serie 641 de diez dólares usado en Vietnam',
  },
] as const;
---
<section class="mt-12 mb-4" aria-labelledby="logros-destacados-heading">
  <h2
    id="logros-destacados-heading"
    class="font-display font-normal text-[clamp(22px,3vw,28px)] text-cream mt-0 mb-3 leading-[1.2]"
  >
    Destacados de la Colección Virtual
  </h2>
  <p class="text-[17px] text-cream-dim mt-0 mb-8 max-w-[60ch]">
    Piezas y catálogos recientes para explorar desde Logros del Mes.
  </p>
  <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10">
    {highlights.map((item) => (
      <li class="highlight-card">
        <a
          class="group block no-underline text-inherit h-full min-h-[44px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
          href={item.href}
        >
          <picture>
            <source
              type="image/webp"
              srcset={`/uploads/${item.imageBase}-640.webp 640w, /uploads/${item.imageBase}.webp 1200w`}
              sizes="(max-width: 640px) 100vw, 360px"
            />
            <img
              src={`/uploads/${item.imageBase}.jpg`}
              alt={item.imageAlt}
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
              class="block w-full h-auto object-cover bg-panel rounded-[4px]"
              style="aspect-ratio:16 / 10;"
            />
          </picture>
          <div class="pt-4 mt-4 border-t-2 border-muted">
            <h3 class="font-display font-normal text-[clamp(19px,2vw,22px)] text-cream mt-0 mb-2 leading-[1.25] group-hover:text-white">
              {item.title}
            </h3>
            <p class="text-[16px] text-cream-dim mt-0 mb-3">{item.description}</p>
            <span class="text-[14px] tracking-[0.08em] uppercase text-muted font-semibold">
              Ver en el catálogo &rarr;
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .highlight-card :global(picture) { display: block; overflow: hidden; border-radius: 4px; }
  .highlight-card :global(img) { transition: transform 0.4s ease; }
  .highlight-card:hover :global(img) { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .highlight-card :global(img) { transition: none; }
    .highlight-card:hover :global(img) { transform: none; }
  }
</style>
