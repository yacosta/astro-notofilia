---
/**
 * Shared listing page for blog / noticias collections.
 */
import Cover from './Cover.astro';
import { COLLECTIONS } from '../lib/collections';
import { formatDateLongEs, toIsoDate } from '../lib/dates';
import type { PostCollection, PublishedPost } from '../lib/posts';

export interface Props {
  collection: PostCollection;
  heading: string;
  intro: string;
  emptyMessage: string;
  posts: PublishedPost[];
  /** Show source next to the date (noticias). */
  showSource?: boolean;
}

const { collection, heading, intro, emptyMessage, posts, showSource = false } = Astro.props;
const basePath = `/${collection}/`;
const label = COLLECTIONS[collection].label;
---
<div class="max-w-content mx-auto px-6 pt-14 pb-6">
  <nav class="text-[14px] tracking-[0.06em] text-muted mb-5" aria-label="Migas de pan">
    <a class="text-muted [text-decoration-color:rgba(183,171,138,0.4)]" href="/">Inicio</a>
    <span aria-hidden="true">/</span> <span>{label}</span>
  </nav>
  <h1 class="font-display font-normal text-[clamp(30px,5vw,46px)] text-cream mt-0 mb-[14px] leading-[1.1]">
    {heading}
  </h1>
  <p class="text-[clamp(18px,2.4vw,22px)] text-cream-dim mt-0 mb-11 max-w-[60ch]">
    {intro}
  </p>

  {posts.length === 0 ? (
    <p class="text-muted">{emptyMessage}</p>
  ) : (
    <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-x-8 gap-y-10">
      {posts.map((post) => (
        <li class="card">
          <a class="group block no-underline text-inherit h-full" href={`${basePath}${post.slug}/`}>
            {post.data.cover && (
              <Cover base={post.data.cover} alt={post.data.coverAlt ?? ''} ratio="16 / 10" />
            )}
            <div class="pt-4 mt-4 border-t-2 border-muted">
              <div class="flex flex-wrap gap-2 items-baseline text-[13px] tracking-[0.06em] uppercase text-muted mb-2">
                <time datetime={toIsoDate(post.data.publishedAt)}>
                  {formatDateLongEs(post.data.publishedAt)}
                </time>
                {showSource && post.data.source && <span aria-hidden="true">·</span>}
                {showSource && post.data.source && <span>{post.data.source}</span>}
              </div>
              <h2 class="font-display font-normal text-[clamp(19px,2vw,22px)] text-cream mt-0 mb-2 leading-[1.25] group-hover:text-white">
                {post.data.title}
              </h2>
              <p class="text-[16px] text-cream-dim mt-0 mb-3">{post.data.excerpt}</p>
              <span class="text-[14px] tracking-[0.08em] uppercase text-muted font-semibold">Leer más &rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .card :global(picture) { display: block; overflow: hidden; border-radius: 4px; }
  .card :global(img) { transition: transform 0.4s ease; }
  .card:hover :global(img) { transform: scale(1.03); }
</style>
