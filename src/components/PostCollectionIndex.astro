---
/**
 * Shared listing page for blog / noticias collections.
 */
import Cover from './Cover.astro';
import SourceCredit from './SourceCredit.astro';
import { COLLECTIONS } from '../lib/collections';
import { formatDateLongEn, formatDateLongEs, toIsoDate } from '../lib/dates';
import { lookupEn } from '../lib/html-i18n';
import type { PostCollection, PublishedPost } from '../lib/posts';
import { UI } from '../lib/ui-i18n';

export interface Props {
  collection: PostCollection;
  heading: string;
  intro: string;
  emptyMessage: string;
  posts: PublishedPost[];
  /** Show “Fuente:” with a link to the original outlet (noticias). */
  showSource?: boolean;
}

const {
  collection,
  heading,
  intro,
  emptyMessage,
  posts,
  showSource = false,
} = Astro.props;
const basePath = `/${collection}/`;
const meta = COLLECTIONS[collection];
const label = meta.label;
---
<div class="max-w-content mx-auto px-[var(--page-gutter)] pt-14 pb-6">
  <nav class="text-[14px] tracking-[0.06em] text-muted mb-5" aria-label="Migas de pan" data-i18n data-i18n-target="aria-label" data-en={UI.crumbs.en}>
    <a class="text-muted [text-decoration-color:rgba(183,171,138,0.4)]" href="/" data-i18n data-en={UI.home.en}>{UI.home.es}</a>
    <span aria-hidden="true">/</span> <span data-i18n data-en={meta.labelEn}>{label}</span>
  </nav>
  <h1 class="font-display font-normal text-[clamp(30px,5vw,46px)] text-cream mt-0 mb-[14px] leading-[1.1]" data-i18n data-en={meta.headingEn}>
    {heading}
  </h1>
  <p class="text-[clamp(18px,2.4vw,22px)] text-cream-dim mt-0 mb-11" data-i18n data-en={meta.introEn}>
    {intro}
  </p>

  {posts.length === 0 ? (
    <p class="text-muted" data-i18n data-en={meta.emptyMessageEn}>{emptyMessage}</p>
  ) : (
    <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-x-8 gap-y-10">
      {posts.map((post) => (
        <li class="card">
          {post.data.cover && (
            <Cover base={post.data.cover} alt={post.data.coverAlt ?? ''} ratio="16 / 10" />
          )}
          <div class="pt-4 mt-4 border-t-2 border-muted">
            <div class="flex flex-wrap gap-2 items-baseline text-[13px] tracking-[0.06em] uppercase text-muted mb-2">
              <time datetime={toIsoDate(post.data.publishedAt)} data-i18n data-en={formatDateLongEn(post.data.publishedAt)}>
                {formatDateLongEs(post.data.publishedAt)}
              </time>
            </div>
            {showSource && post.data.source && post.data.sourceUrl && (
              <SourceCredit
                source={post.data.source}
                sourceUrl={post.data.sourceUrl}
                class="mb-2"
              />
            )}
            <a class="group block no-underline text-inherit" href={`${basePath}${post.id}/`}>
              <h2 class="font-display font-normal text-[clamp(19px,2vw,22px)] text-cream mt-0 mb-2 leading-[1.25] group-hover:text-white" data-i18n={lookupEn(post.data.title) ? true : undefined} data-en={lookupEn(post.data.title)}>
                {post.data.title}
              </h2>
              <p class="text-[16px] text-cream-dim mt-0 mb-3" data-i18n={lookupEn(post.data.excerpt) ? true : undefined} data-en={lookupEn(post.data.excerpt)}>{post.data.excerpt}</p>
              <span class="text-[14px] tracking-[0.08em] uppercase text-muted font-semibold" data-i18n data-en={UI.readMore.en}>{UI.readMore.es}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .card :global(picture) { display: block; overflow: hidden; border-radius: 4px; }
  .card :global(img) { transition: transform 0.4s ease; }
  .card:hover :global(img) { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .card :global(img) { transition: none; }
    .card:hover :global(img) { transform: none; }
  }
</style>
