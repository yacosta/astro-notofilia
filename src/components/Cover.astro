---
// Renders a cover image via Cloudflare Image Transformations (see src/lib/img.ts):
// a single responsive <img> whose URLs negotiate AVIF/WebP (format=auto) and
// resize per screen (width=). Source is the <base>.jpg master in public/uploads/.
//
// fit="cover" (default): fills a fixed aspect-ratio box, cropping as needed —
//   good for wide illustrations/photos.
// fit="contain": shows the whole image at its natural size, centered, capped so
//   it never upscales — good for banknote scans (which are ~square and would be
//   cropped and blurred by a 16:9 crop).
import { cdnImg, cdnSrcset } from '../lib/img';
export interface Props {
  base: string;       // image base name under /uploads (no extension)
  alt: string;
  eager?: boolean;    // load eagerly (above-the-fold hero)
  ratio?: string;     // CSS aspect-ratio for fit="cover", default 16/10
  fit?: 'cover' | 'contain';
  width?: number;     // intrinsic width hint (reduces CLS)
  height?: number;    // intrinsic height hint (reduces CLS)
}
const {
  base,
  alt,
  eager = false,
  ratio = '16 / 10',
  fit = 'cover',
  width,
  height,
} = Astro.props;
const src = `/uploads/${base}.jpg`;
const quality = fit === 'contain' ? 82 : 78;
const widths = fit === 'contain' ? [400, 640, 1024, 2000] : [400, 640, 1024];
const sizes = fit === 'contain' ? '(max-width: 1128px) 100vw, 1128px' : '(max-width: 720px) 100vw, 720px';
---
{fit === 'contain' ? (
  <img
    src={cdnImg(src, { width: 1024, quality })}
    srcset={cdnSrcset(src, widths, quality)}
    sizes={sizes}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width={width}
    height={height}
    class="block w-full h-auto mx-auto rounded-[4px] bg-panel"
    style="max-width: min(100%, 1128px);"
  />
) : (
  <img
    src={cdnImg(src, { width: 1024, quality })}
    srcset={cdnSrcset(src, widths, quality)}
    sizes={sizes}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width={width}
    height={height}
    class="block w-full h-auto object-cover bg-panel"
    style={`aspect-ratio:${ratio};`}
  />
)}
