---
/**
 * Native site header — server-rendered navigation with a lightweight drawer
 * and Pagefind loaded only when search is opened.
 *
 * Optional `locale` bakes English chrome on `/en/` pages (crawlers, no-JS).
 * Language switcher is an `<a href>` from `switchUrl()` — works with JS off.
 * EN nav uses `alternateUrl(href, 'en') ?? href` (unpaired fichas stay Spanish).
 */
import { DRAWER_PRIMARY_LINKS, DRAWER_TRAILING_LINKS, NAV_SECTIONS, PRIMARY_LINKS } from '../lib/nav';
import { lookupEn } from '../lib/html-i18n';
import { alternateUrl, getPair, switchUrl, type Locale } from '../i18n/pairs';
import { t } from '../lib/ui-i18n';

export interface Props {
  /** When true, header overlays the hero (homepage). Otherwise in normal flow. */
  overlay?: boolean;
  locale?: Locale;
  /** Same pathname passed to BaseHead (trailing slash, `/` for Spanish home). */
  path: string;
}

const { overlay = false, locale = 'es', path } = Astro.props;
const isEn = locale === 'en';
const switchTarget: Locale = isEn ? 'es' : 'en';
const switchHref = switchUrl(path, switchTarget);
const pair = getPair(path);
const homeOfTarget = switchTarget === 'en' ? '/en/' : '/';
const fallbackKind = pair ? undefined : switchHref === homeOfTarget ? 'home' : 'section';
const fallbackTitle = fallbackKind === 'home'
  ? (switchTarget === 'en' ? 'English homepage' : 'Inicio en español')
  : fallbackKind === 'section'
    ? (switchTarget === 'en' ? 'English version of this section' : 'Versión en español de esta sección')
    : undefined;

/** Honest nav: paired English URL when it exists; unpaired fichas stay Spanish. */
function hrefFor(href: string): string {
  if (!isEn) return href;
  const queryIdx = href.indexOf('?');
  const hashIdx = href.indexOf('#');
  let cut = href.length;
  if (queryIdx >= 0) cut = Math.min(cut, queryIdx);
  if (hashIdx >= 0) cut = Math.min(cut, hashIdx);
  const pathPart = href.slice(0, cut) || '/';
  const rest = href.slice(cut);
  const mapped = alternateUrl(pathPart, 'en');
  if (!mapped) return href;
  return mapped + rest;
}

function labelFor(label: string, labelEn?: string): string {
  if (!isEn) return label;
  return labelEn || lookupEn(label) || label;
}
---
<header
  id="site-header"
  class:list={['site-header', overlay && 'site-header--overlay']}
  data-overlay={overlay ? 'true' : undefined}
>
  <nav class="site-header__bar" aria-label={isEn ? 'Main navigation' : 'Navegación principal'}>
    <a class="site-header__brand" href={hrefFor('/')}>
      <span class="site-header__brand-name">NOTOFILIA</span>
      <span class="site-header__brand-tag" data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'Numismatics and Notaphily'}>{isEn ? 'Numismatics and Notaphily' : 'Numismática y Notafilia'}</span>
    </a>

    <div class="site-header__search">
      <button
        type="button"
        id="site-search-toggle"
        class="site-header__icon-btn"
        aria-expanded="false"
        aria-controls="site-search-panel"
        aria-label={isEn ? 'Open search' : 'Abrir búsqueda'}
        data-i18n={isEn ? undefined : true}
        data-i18n-target={isEn ? undefined : 'aria-label'}
        data-en={isEn ? undefined : 'Open search'}
      >
        <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.3"></circle>
          <line x1="11.6" y1="11.6" x2="16" y2="16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
        </svg>
      </button>
      <div id="site-search-panel" class="site-header__search-panel" hidden>
        {/* /en/search/ is deferred; keep the Spanish search page even on EN chrome. */}
        <form class="site-header__search-form" action="/buscar/" method="get" role="search">
          <label class="sr-only" for="site-search-input" data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'Search the site'}>{isEn ? 'Search the site' : 'Buscar en el sitio'}</label>
          <input
            id="site-search-input"
            name="q"
            type="search"
            placeholder={isEn ? 'Search banknotes, profiles…' : 'Buscar billetes, perfiles…'}
            data-i18n={isEn ? undefined : true}
            data-i18n-target={isEn ? undefined : 'placeholder'}
            data-en={isEn ? undefined : 'Search banknotes, profiles…'}
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="submit" data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : 'Search'}>{t('search', locale)}</button>
        </form>
        <div
          id="site-search-results"
          class="site-header__search-results"
          role="listbox"
          aria-label={isEn ? 'Search results' : 'Resultados de búsqueda'}
          data-i18n={isEn ? undefined : true}
          data-i18n-target={isEn ? undefined : 'aria-label'}
          data-en={isEn ? undefined : 'Search results'}
          hidden
        ></div>
      </div>
    </div>

    <div class="site-header__actions">
      <a
        class="site-header__coleccion-link"
        href={hrefFor('/coleccion/')}
        data-i18n={isEn ? undefined : true}
        data-en={isEn ? undefined : 'Collection'}
      >{t('collection', locale)}</a>
      <div
        class="site-header__lang"
        role="group"
        aria-label={isEn ? 'Language' : 'Idioma'}
      >
        {isEn ? (
          <a
            class="site-header__lang-btn"
            href={switchHref}
            hreflang="es"
            lang="es"
            title={fallbackTitle}
            data-i18n-fallback={fallbackKind}
          >ES<span class="sr-only"> — Español</span></a>
        ) : (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="es">ES<span class="sr-only"> — Español</span></span>
        )}
        {isEn ? (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="en">EN<span class="sr-only"> — English</span></span>
        ) : (
          <a
            class="site-header__lang-btn"
            href={switchHref}
            hreflang="en"
            lang="en"
            title={fallbackTitle}
            data-i18n-fallback={fallbackKind}
          >EN<span class="sr-only"> — English</span></a>
        )}
      </div>
      <button
        type="button"
        id="site-menu-toggle"
        class="site-header__menu-btn"
        aria-expanded="false"
        aria-controls="site-menu-drawer"
        aria-haspopup="dialog"
        aria-label={isEn ? 'Open menu' : 'Abrir menú'}
        data-i18n={isEn ? undefined : true}
        data-i18n-target={isEn ? undefined : 'aria-label'}
        data-en={isEn ? undefined : 'Open menu'}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  {!overlay && <div class="site-header__spacer" aria-hidden="true"></div>}

  <div id="site-menu-backdrop" class="site-header__backdrop" hidden></div>
  <div
    id="site-menu-drawer"
    class="site-header__drawer"
    role="dialog"
    aria-modal="true"
    aria-label={isEn ? 'Site menu' : 'Menú del sitio'}
    data-i18n={isEn ? undefined : true}
    data-i18n-target={isEn ? undefined : 'aria-label'}
    data-en={isEn ? undefined : 'Site menu'}
    hidden
  >
    <div class="site-header__drawer-head">
      <span>NOTOFILIA</span>
      <button
        type="button"
        id="site-menu-close"
        aria-label={isEn ? 'Close menu' : 'Cerrar menú'}
        data-i18n={isEn ? undefined : true}
        data-i18n-target={isEn ? undefined : 'aria-label'}
        data-en={isEn ? undefined : 'Close menu'}
      >&times;</button>
    </div>

    <ul class="site-header__primary">
      {DRAWER_PRIMARY_LINKS.map((link) => (
        <li>
          <a href={hrefFor(link.href)} data-i18n={!isEn && link.labelEn ? true : undefined} data-en={!isEn ? link.labelEn : undefined}>{labelFor(link.label, link.labelEn)}</a>
        </li>
      ))}
    </ul>

    <div class="site-header__accordions">
      {NAV_SECTIONS.map((section) => (
        <details class="site-header__accordion" id={`nav-sec-${section.id}`}>
          <summary>
            <span class="site-header__accordion-label" data-i18n={!isEn && section.labelEn ? true : undefined} data-en={!isEn ? section.labelEn : undefined}>{labelFor(section.label, section.labelEn)}</span>
            <span class="site-header__caret" aria-hidden="true">▾</span>
          </summary>
          <div class="site-header__accordion-panel">
            {section.description && (
              <p
                class="site-header__accordion-desc"
                data-i18n={!isEn && (section.descriptionEn || lookupEn(section.description)) ? true : undefined}
                data-en={!isEn ? (section.descriptionEn || lookupEn(section.description)) : undefined}
              >{isEn ? (section.descriptionEn || lookupEn(section.description) || section.description) : section.description}</p>
            )}
            {section.links.length > 0 && (
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a
                      class:list={[{ 'site-header__accordion-lead': Boolean(link.lead) }]}
                      href={hrefFor(link.href)}
                      data-i18n={!isEn && (link.labelEn || lookupEn(link.label)) ? true : undefined}
                      data-en={!isEn ? (link.labelEn || lookupEn(link.label)) : undefined}
                    >
                      {labelFor(link.label, link.labelEn)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {section.groups?.map((group) => (
              <details class="site-header__accordion site-header__accordion--nested" id={`nav-sec-${group.id}`}>
                <summary>
                  <span class="site-header__accordion-label" data-i18n={!isEn && (group.labelEn || lookupEn(group.label)) ? true : undefined} data-en={!isEn ? (group.labelEn || lookupEn(group.label)) : undefined}>{labelFor(group.label, group.labelEn)}</span>
                  <span class="site-header__caret" aria-hidden="true">▾</span>
                </summary>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        class:list={[{ 'site-header__accordion-lead': Boolean(link.lead) }]}
                        href={hrefFor(link.href)}
                        data-i18n={!isEn && (link.labelEn || lookupEn(link.label)) ? true : undefined}
                        data-en={!isEn ? (link.labelEn || lookupEn(link.label)) : undefined}
                      >
                        {labelFor(link.label, link.labelEn)}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </details>
      ))}
    </div>

    <ul class="site-header__primary site-header__primary--last">
      {DRAWER_TRAILING_LINKS.map((link) => (
        <li>
          <a href={hrefFor(link.href)} data-i18n={!isEn && link.labelEn ? true : undefined} data-en={!isEn ? link.labelEn : undefined}>{labelFor(link.label, link.labelEn)}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

{/* No-JS fallback: primary destinations remain in the document via the drawer
    markup above when opened with CSS :target, plus always-visible Colección. */}
<noscript>
  <nav class="site-header__noscript" aria-label={isEn ? 'Primary links without JavaScript' : 'Enlaces principales sin JavaScript'}>
    <ul>
      {PRIMARY_LINKS.map((link) => (
        <li><a href={hrefFor(link.href)} data-i18n={!isEn && link.labelEn ? true : undefined} data-en={!isEn ? link.labelEn : undefined}>{labelFor(link.label, link.labelEn)}</a></li>
      ))}
    </ul>
  </nav>
</noscript>

<script src="../client/site-header.js"></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .site-header__bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 68px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 0 max(20px, calc((100% - 1400px) / 2 + 20px));
    box-sizing: border-box;
    background: rgba(10, 10, 9, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(231, 222, 201, 0.12);
  }
  .site-header--overlay .site-header__bar {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--overlay.is-scrolled .site-header__bar {
    background: rgba(10, 10, 9, 0.82);
    border-bottom-color: rgba(231, 222, 201, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-header__spacer { height: 68px; }
  .site-header__brand {
    justify-self: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1;
    color: #d8d2cd;
    min-height: 44px;
    justify-content: center;
  }
  .site-header__brand:focus-visible {
    outline: 2px solid #e7ddc4;
    outline-offset: 4px;
  }
  .site-header__brand-name {
    font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
    font-size: 28px;
    letter-spacing: 0.1em;
  }
  .site-header__brand-tag {
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-style: italic;
    font-size: 13px;
    letter-spacing: 0.08em;
    margin-top: 3px;
    color: #d8d2cd;
  }
  .site-header__search {
    justify-self: center;
    position: relative;
  }
  .site-header__icon-btn,
  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: #e7ddc4;
    cursor: pointer;
  }
  .site-header__icon-btn:focus-visible,
  .site-header__menu-btn:focus-visible,
  .site-header__coleccion-link:focus-visible {
    outline: 2px solid #e7ddc4;
    outline-offset: 3px;
  }
  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-header__lang {
    display: flex;
    align-items: center;
    background: rgba(10, 10, 9, 0.35);
    border: 1px solid rgba(231, 222, 201, 0.35);
    border-radius: 999px;
    padding: 3px;
  }
  .site-header__lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: none;
    background: transparent;
    color: #e7ddc4;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    padding: 0 16px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
    text-decoration: none;
    line-height: 1;
  }
  a.site-header__lang-btn {
    cursor: pointer;
  }
  .site-header__lang-btn.is-active {
    background: rgba(231, 222, 201, 0.92);
    color: #0a0a09;
  }
  .site-header__lang-btn:focus-visible {
    outline: 2px solid #e7ddc4;
    outline-offset: 2px;
  }
  .site-header__coleccion-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    color: #e7ddc4;
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .site-header__menu-btn {
    flex-direction: column;
    gap: 5px;
    width: 44px;
  }
  .site-header__menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: #e7ddc4;
  }
  .site-header__menu-btn span:last-child {
    width: 15px;
    align-self: flex-end;
    margin-right: 11px;
  }
  .site-header__search-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    width: min(380px, 88vw);
    background: rgba(10, 10, 9, 0.96);
    border: 1px solid rgba(231, 222, 201, 0.15);
    border-radius: 8px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
    padding: 10px;
    z-index: 110;
  }
  .site-header__search-form {
    display: flex;
    gap: 8px;
  }
  .site-header__search-form input {
    flex: 1;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid rgba(231, 222, 201, 0.25);
    border-radius: 4px;
    background: #161410;
    color: #e7ddc4;
    font: inherit;
    font-size: 15px;
  }
  .site-header__search-form button {
    min-height: 44px;
    padding: 0 14px;
    border: none;
    border-radius: 4px;
    background: #e7ddc4;
    color: #0a0a09;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    cursor: pointer;
  }
  .site-header__search-results {
    margin-top: 8px;
    max-height: 280px;
    overflow-y: auto;
  }
  .site-header__search-results a {
    display: block;
    padding: 11px 12px;
    color: #e7ddc4;
    text-decoration: none;
    border-radius: 4px;
    font-size: 15px;
  }
  .site-header__search-results a:hover,
  .site-header__search-results a:focus-visible {
    background: rgba(231, 222, 201, 0.12);
  }
  .site-header__search-empty {
    display: block;
    padding: 12px;
    color: #a89b7c;
    font-style: italic;
    font-size: 14px;
  }
  .site-header__backdrop {
    position: fixed;
    inset: 0;
    z-index: 118;
    background: rgba(10, 10, 9, 0.55);
    backdrop-filter: blur(3px);
  }
  .site-header__drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 119;
    width: min(420px, 92vw);
    overflow-y: auto;
    background: #d8d2cd;
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.5);
    color: #1c1a15;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
  }
  .site-header__drawer-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    background: #d8d2cd;
    border-bottom: 1px solid rgba(10, 10, 9, 0.1);
    font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
    letter-spacing: 0.1em;
  }
  .site-header__drawer-head button {
    all: unset;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5c4e33;
    font-size: 28px;
  }
  .site-header__drawer-head button:focus-visible {
    outline: 2px solid #5c4e33;
    outline-offset: 2px;
  }
  .site-header__primary {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__primary a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 24px;
    color: #1c1a15;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(10, 10, 9, 0.08);
  }
  .site-header__primary--last {
    border-top: 1px solid rgba(10, 10, 9, 0.08);
  }
  .site-header__primary--last a {
    border-bottom: 0;
  }
  .site-header__primary a:hover,
  .site-header__accordion a:hover {
    color: #5c4e33;
  }
  .site-header__accordions {
    border-bottom: 1px solid rgba(10, 10, 9, 0.08);
  }
  .site-header__accordion {
    border-bottom: 1px solid rgba(10, 10, 9, 0.08);
  }
  .site-header__accordion:last-child {
    border-bottom: 0;
  }
  .site-header__accordion > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 18px 24px;
    cursor: pointer;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: #1c1a15;
  }
  .site-header__accordion > summary::-webkit-details-marker {
    display: none;
  }
  .site-header__accordion > summary::marker {
    content: '';
  }
  .site-header__accordion > summary:hover {
    color: #5c4e33;
  }
  .site-header__accordion > summary:focus-visible {
    outline: 2px solid #5c4e33;
    outline-offset: -2px;
  }
  .site-header__caret {
    flex-shrink: 0;
    font-size: 13px;
    color: #b7ab8a;
    transform: rotate(0deg);
    transition: transform 0.15s ease;
  }
  .site-header__accordion[open] > summary > .site-header__caret {
    transform: rotate(180deg);
  }
  .site-header__accordion-panel {
    padding: 4px 0 10px;
  }
  .site-header__accordion-desc {
    margin: 0;
    padding: 0 24px 8px;
    font-size: 14px;
    line-height: 1.45;
    color: #5c4e33;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 400;
  }
  .site-header__accordion ul {
    list-style: none;
    margin: 0;
    padding: 0 24px 10px;
  }
  .site-header__accordion a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 0;
    color: #332e22;
    text-decoration: none;
    font-size: 16px;
    letter-spacing: 0;
    text-transform: none;
    font-weight: 400;
  }
  .site-header__accordion-lead {
    font-size: 17px;
    font-weight: 600;
    color: #1c1a15;
  }
  .site-header__accordion--nested {
    border-top: 1px solid rgba(10, 10, 9, 0.08);
    border-bottom: 0;
  }
  .site-header__accordion--nested > summary {
    padding: 16px 24px;
    font-size: 14px;
    letter-spacing: 0.14em;
    color: #5c4e33;
  }
  .site-header__accordion--nested > summary:hover {
    background: rgba(10, 10, 9, 0.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__caret {
      transition: none;
