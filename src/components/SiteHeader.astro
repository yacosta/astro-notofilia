---
/**
 * Native site header — desktop mega menu + mobile drawer.
 * Search and ES/EN switching stay server-rendered and work with JS off.
 */
import {
  COLLECTION_MENU,
  CONTACT_LINK,
  DRAWER_TRAILING_LINKS,
  HOME_LINK,
  PRIMARY_LINKS,
  PRIMARY_MENUS,
  RESOURCES_MENU,
} from '../lib/nav';
import { lookupEn } from '../lib/html-i18n';
import { alternateUrl, getPair, switchUrl, type Locale } from '../i18n/pairs';
import { t } from '../lib/ui-i18n';

export interface Props {
  overlay?: boolean;
  locale?: Locale;
  path: string;
}

const { overlay = false, locale = 'es', path } = Astro.props;
const isEn = locale === 'en';
const switchTarget: Locale = isEn ? 'es' : 'en';
const switchHref = switchUrl(path, switchTarget);
const pair = getPair(path);
const homeOfTarget = switchTarget === 'en' ? '/en/' : '/';
const fallbackKind = pair ? undefined : switchHref === homeOfTarget ? 'home' : 'section';
const fallbackTitle = fallbackKind === 'home'
  ? (switchTarget === 'en' ? 'English homepage' : 'Inicio en español')
  : fallbackKind === 'section'
    ? (switchTarget === 'en' ? 'English version of this section' : 'Versión en español de esta sección')
    : undefined;

function hrefFor(href: string): string {
  if (!isEn) return href;
  const queryIdx = href.indexOf('?');
  const hashIdx = href.indexOf('#');
  let cut = href.length;
  if (queryIdx >= 0) cut = Math.min(cut, queryIdx);
  if (hashIdx >= 0) cut = Math.min(cut, hashIdx);
  const pathPart = href.slice(0, cut) || '/';
  const rest = href.slice(cut);
  const mapped = alternateUrl(pathPart, 'en');
  if (!mapped) return href;
  return mapped + rest;
}

function labelFor(label: string, labelEn?: string): string {
  if (!isEn) return label;
  return labelEn || lookupEn(label) || label;
}

const searchPlaceholder = isEn ? 'Search banknotes, coins, guides…' : 'Buscar billetes, monedas, guías…';
const searchAction = '/buscar/';
---
<header
  id="site-header"
  class:list={['site-header', overlay && 'site-header--overlay']}
  data-overlay={overlay ? 'true' : undefined}
>
  <nav class="site-header__bar" aria-label={isEn ? 'Main navigation' : 'Navegación principal'}>
    <a class="site-header__brand" href={hrefFor('/')}>
      <span class="site-header__brand-name">NOTOFILIA</span>
      <span class="site-header__brand-tag">{isEn ? 'Numismatics and Notaphily' : 'Numismática y Notafilia'}</span>
    </a>

    <ul class="site-header__desktop" id="site-desktop-nav">
      {PRIMARY_MENUS.map((menu) => (
        <li class="site-header__item" data-nav-item={menu.id}>
          <a
            class="site-header__top-link"
            href={hrefFor(menu.href)}
            data-nav-parent={menu.id}
          >{labelFor(menu.label, menu.labelEn)}</a>
          <button
            type="button"
            class="site-header__caret-btn"
            aria-expanded="false"
            aria-controls={`nav-panel-${menu.id}`}
            aria-label={isEn ? `Open ${menu.labelEn || menu.label} menu` : `Abrir menú de ${menu.label}`}
          >
            <span class="site-header__caret" aria-hidden="true">▾</span>
          </button>
          <div
            id={`nav-panel-${menu.id}`}
            class:list={['site-header__panel', menu.id === 'collection' && 'site-header__panel--mega']}
            hidden
          >
            {menu.groups.map((group) => (
              <div class="site-header__panel-col">
                <p class="site-header__panel-heading" id={`nav-h-${menu.id}-${group.id}`}>
                  {labelFor(group.label, group.labelEn)}
                </p>
                <ul aria-labelledby={`nav-h-${menu.id}-${group.id}`}>
                  {group.links.map((link) => (
                    <li>
                      {link.children?.length ? (
                        <div class="site-header__panel-accordion">
                          <div class="site-header__panel-split">
                            <a
                              class:list={[{ 'site-header__panel-lead': Boolean(link.lead) }]}
                              href={hrefFor(link.href)}
                            >
                              {labelFor(link.label, link.labelEn)}
                            </a>
                            <button
                              type="button"
                              class="site-header__panel-split-toggle"
                              aria-expanded="false"
                              aria-controls={`nav-panel-sub-${link.href.replace(/[^a-z0-9]+/gi, '-')}`}
                              aria-label={
                                isEn
                                  ? `Show ${link.labelEn || link.label} sections`
                                  : `Mostrar secciones de ${link.label}`
                              }
                            >
                              <span class="site-header__caret" aria-hidden="true">▾</span>
                            </button>
                          </div>
                          <ul
                            id={`nav-panel-sub-${link.href.replace(/[^a-z0-9]+/gi, '-')}`}
                            class="site-header__panel-sub"
                            hidden
                          >
                            {link.children.map((child) => (
                              <li>
                                <a href={hrefFor(child.href)}>
                                  {labelFor(child.label, child.labelEn)}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : (
                        <a
                          class:list={[{ 'site-header__panel-lead': Boolean(link.lead) }]}
                          href={hrefFor(link.href)}
                        >
                          {labelFor(link.label, link.labelEn)}
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </li>
      ))}
      <li class="site-header__item">
        <a class="site-header__top-link" href={hrefFor(CONTACT_LINK.href)}>
          {labelFor(CONTACT_LINK.label, CONTACT_LINK.labelEn)}
        </a>
      </li>
    </ul>

    <div class="site-header__search">
      <button
        type="button"
        id="site-search-toggle"
        class="site-header__icon-btn"
        aria-expanded="false"
        aria-controls="site-search-panel"
        aria-label={isEn ? 'Open search' : 'Abrir búsqueda'}
      >
        <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="currentColor" stroke-width="1.3"></circle>
          <line x1="11.6" y1="11.6" x2="16" y2="16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
        </svg>
      </button>
      <div id="site-search-panel" class="site-header__search-panel" hidden>
        <form class="site-header__search-form" action={searchAction} method="get" role="search">
          <label class="sr-only" for="site-search-input">{isEn ? 'Search the site' : 'Buscar en el sitio'}</label>
          <input
            id="site-search-input"
            name="q"
            type="search"
            placeholder={searchPlaceholder}
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="submit">{t('search', locale)}</button>
        </form>
        <div
          id="site-search-results"
          class="site-header__search-results"
          role="listbox"
          aria-label={isEn ? 'Search results' : 'Resultados de búsqueda'}
          hidden
        ></div>
      </div>
    </div>

    <div class="site-header__actions">
      <div
        class="site-header__lang"
        role="group"
        aria-label={isEn ? 'Language' : 'Idioma'}
      >
        {isEn ? (
          <a
            class="site-header__lang-btn"
            href={switchHref}
            hreflang="es"
            lang="es"
            title={fallbackTitle}
            data-i18n-fallback={fallbackKind}
          >ES<span class="sr-only"> — Español</span></a>
        ) : (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="es">ES<span class="sr-only"> — Español</span></span>
        )}
        {isEn ? (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="en">EN<span class="sr-only"> — English</span></span>
        ) : (
          <a
            class="site-header__lang-btn"
            href={switchHref}
            hreflang="en"
            lang="en"
            title={fallbackTitle}
            data-i18n-fallback={fallbackKind}
          >EN<span class="sr-only"> — English</span></a>
        )}
      </div>
      <button
        type="button"
        id="site-menu-toggle"
        class="site-header__menu-btn"
        aria-expanded="false"
        aria-controls="site-menu-drawer"
        aria-haspopup="dialog"
        aria-label={isEn ? 'Open menu' : 'Abrir menú'}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  {!overlay && <div class="site-header__spacer" aria-hidden="true"></div>}

  <div id="site-menu-backdrop" class="site-header__backdrop" hidden></div>
  <div
    id="site-menu-drawer"
    class="site-header__drawer"
    role="dialog"
    aria-modal="true"
    aria-label={isEn ? 'Site menu' : 'Menú del sitio'}
    hidden
  >
    <div class="site-header__drawer-head">
      <span>NOTOFILIA</span>
      <button
        type="button"
        id="site-menu-close"
        aria-label={isEn ? 'Close menu' : 'Cerrar menú'}
      >&times;</button>
    </div>

    <form class="site-header__drawer-search" action={searchAction} method="get" role="search">
      <label class="sr-only" for="site-drawer-search">{isEn ? 'Search the collection' : 'Buscar en la colección'}</label>
      <input
        id="site-drawer-search"
        name="q"
        type="search"
        placeholder={isEn ? 'Search the collection' : 'Buscar en la colección'}
        autocomplete="off"
        enterkeyhint="search"
      />
      <button type="submit">{t('search', locale)}</button>
    </form>

    <ul class="site-header__primary">
      <li>
        <a href={hrefFor(HOME_LINK.href)}>{labelFor(HOME_LINK.label, HOME_LINK.labelEn)}</a>
      </li>
    </ul>

    <div class="site-header__accordions">
      <div class="site-header__drawer-split" id={`nav-sec-${COLLECTION_MENU.id}`}>
        <a class="site-header__drawer-split-link" href={hrefFor(COLLECTION_MENU.href)}>
          {labelFor(COLLECTION_MENU.label, COLLECTION_MENU.labelEn)}
        </a>
        <button
          type="button"
          class="site-header__drawer-split-toggle"
          aria-expanded="false"
          aria-controls="nav-drawer-collection"
          aria-label={isEn ? 'Show collection links' : 'Mostrar enlaces de la colección'}
        >
          <span class="site-header__caret" aria-hidden="true">▾</span>
        </button>
      </div>
      <div id="nav-drawer-collection" class="site-header__accordion-panel" hidden>
        {COLLECTION_MENU.groups.map((group) => (
          <div class="site-header__drawer-group">
            <p class="site-header__drawer-group-label">{labelFor(group.label, group.labelEn)}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  {link.children?.length ? (
                    <div class="site-header__accordion--nested">
                      <div class="site-header__drawer-split">
                        <a
                          class:list={[
                            'site-header__drawer-split-link',
                            { 'site-header__accordion-lead': Boolean(link.lead) },
                          ]}
                          href={hrefFor(link.href)}
                        >
                          {labelFor(link.label, link.labelEn)}
                        </a>
                        <button
                          type="button"
                          class="site-header__drawer-split-toggle"
                          aria-expanded="false"
                          aria-controls={`nav-drawer-${link.href.replace(/[^a-z0-9]+/gi, '-')}`}
                          aria-label={
                            isEn
                              ? `Show ${link.labelEn || link.label} sections`
                              : `Mostrar secciones de ${link.label}`
                          }
                        >
                          <span class="site-header__caret" aria-hidden="true">▾</span>
                        </button>
                      </div>
                      <div
                        id={`nav-drawer-${link.href.replace(/[^a-z0-9]+/gi, '-')}`}
                        class="site-header__accordion-panel site-header__nested-panel"
                        hidden
                      >
                        <ul>
                          {link.children.map((child) => (
                            <li>
                              <a href={hrefFor(child.href)}>
                                {labelFor(child.label, child.labelEn)}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  ) : (
                    <a
                      class:list={[{ 'site-header__accordion-lead': Boolean(link.lead) }]}
                      href={hrefFor(link.href)}
                    >
                      {labelFor(link.label, link.labelEn)}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <details class="site-header__accordion" id={`nav-sec-${RESOURCES_MENU.id}`}>
        <summary>
          <span class="site-header__accordion-label">{labelFor(RESOURCES_MENU.label, RESOURCES_MENU.labelEn)}</span>
          <span class="site-header__caret" aria-hidden="true">▾</span>
        </summary>
        <div class="site-header__accordion-panel">
          <ul>
            {RESOURCES_MENU.groups[0].links.map((link) => (
              <li>
                <a href={hrefFor(link.href)}>{labelFor(link.label, link.labelEn)}</a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>

    <ul class="site-header__primary site-header__primary--last">
      {DRAWER_TRAILING_LINKS.map((link) => (
        <li>
          <a href={hrefFor(link.href)}>{labelFor(link.label, link.labelEn)}</a>
        </li>
      ))}
    </ul>

    <div class="site-header__drawer-lang">
      <p class="site-header__drawer-lang-label">{isEn ? 'Language' : 'Idioma'}</p>
      <div class="site-header__lang" role="group" aria-label={isEn ? 'Language' : 'Idioma'}>
        {isEn ? (
          <a class="site-header__lang-btn" href={switchHref} hreflang="es" lang="es">ES<span class="sr-only"> — Español</span></a>
        ) : (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="es">ES<span class="sr-only"> — Español</span></span>
        )}
        {isEn ? (
          <span class="site-header__lang-btn is-active" aria-current="page" lang="en">EN<span class="sr-only"> — English</span></span>
        ) : (
          <a class="site-header__lang-btn" href={switchHref} hreflang="en" lang="en">EN<span class="sr-only"> — English</span></a>
        )}
      </div>
    </div>
  </div>
</header>

<noscript>
  <nav class="site-header__noscript" aria-label={isEn ? 'Primary links without JavaScript' : 'Enlaces principales sin JavaScript'}>
    <ul>
      {PRIMARY_LINKS.map((link) => (
        <li><a href={hrefFor(link.href)}>{labelFor(link.label, link.labelEn)}</a></li>
      ))}
    </ul>
  </nav>
</noscript>

<script src="../client/site-header.js"></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .site-header__bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 68px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 12px;
    padding: 0 max(20px, calc((100% - 1400px) / 2 + 20px));
    box-sizing: border-box;
    background: rgba(10, 10, 9, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(231, 222, 201, 0.12);
  }
  .site-header--overlay .site-header__bar {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--overlay.is-scrolled .site-header__bar {
    background: rgba(10, 10, 9, 0.82);
    border-bottom-color: rgba(231, 222, 201, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .site-header__spacer { height: 68px; }
  .site-header__brand {
    justify-self: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1;
    color: #d8d2cd;
    min-height: 44px;
    justify-content: center;
  }
  .site-header__brand:focus-visible,
  .site-header__top-link:focus-visible,
  .site-header__caret-btn:focus-visible,
  .site-header__icon-btn:focus-visible,
  .site-header__menu-btn:focus-visible,
  .site-header__panel a:focus-visible {
    outline: 2px solid #e7ddc4;
    outline-offset: 3px;
  }
  .site-header__brand-name {
    font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
    font-size: 28px;
    letter-spacing: 0.1em;
  }
  .site-header__brand-tag {
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-style: italic;
    font-size: 13px;
    letter-spacing: 0.08em;
    margin-top: 3px;
    color: #d8d2cd;
  }
  .site-header__desktop {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: stretch;
    align-items: stretch;
    gap: 2px;
    min-width: 0;
  }
  .site-header__item {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
  }
  .site-header__top-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px 0 12px;
    color: #e7ddc4;
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .site-header__caret-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-left: -8px;
    padding: 0;
    border: none;
    background: none;
    color: #e7ddc4;
    cursor: pointer;
  }
  .site-header__caret {
    font-size: 13px;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  .site-header__item.is-open > .site-header__caret-btn .site-header__caret,
  .site-header__accordion[open] > summary > .site-header__caret,
  .site-header__drawer-split-toggle[aria-expanded='true'] .site-header__caret,
  .site-header__panel-split-toggle[aria-expanded='true'] .site-header__caret {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__caret { transition: none; }
  }
  .site-header__panel {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    padding: 16px 20px 18px;
    background: #d8d2cd;
    color: #1c1a15;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
    z-index: 120;
  }
  .site-header__panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 12px;
  }
  .site-header__panel[hidden] {
    display: none;
  }
  .site-header__panel--mega:not([hidden]) {
    display: grid;
    grid-template-columns: repeat(2, minmax(220px, 1fr));
    align-items: start;
    gap: 8px 28px;
    width: min(720px, 92vw);
    max-height: min(70vh, 36rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 22px 24px 24px;
  }
  .site-header__panel-col {
    min-width: 0;
  }
  .site-header__panel-heading {
    margin: 0 0 8px;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    color: #5c4e33;
  }
  .site-header__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 0;
    color: #332e22;
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.35;
    white-space: normal;
  }
  .site-header__panel a:hover {
    color: #5c4e33;
  }
  .site-header__panel-lead {
    font-weight: 700;
    color: #1c1a15;
  }
  .site-header__panel-split {
    display: grid;
    grid-template-columns: 1fr 44px;
    align-items: stretch;
  }
  .site-header__panel-split-toggle {
    border: none;
    background: transparent;
    color: #5c4e33;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
  }
  .site-header__panel-split-toggle:focus-visible {
    outline: 2px solid #5c4e33;
    outline-offset: 2px;
  }
  .site-header__panel-sub {
    margin: 0 0 6px;
    padding: 0 0 0 14px;
    border-left: 2px solid rgba(92, 78, 51, 0.28);
  }
  .site-header__panel-sub[hidden] {
    display: none;
  }
  .site-header__panel-sub a {
    font-size: 15px;
    min-height: 44px;
  }
  .site-header__search {
    justify-self: end;
    position: relative;
  }
  .site-header__icon-btn,
  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: #e7ddc4;
    cursor: pointer;
  }
  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .site-header__lang {
    display: flex;
    align-items: center;
    background: rgba(10, 10, 9, 0.35);
    border: 1px solid rgba(231, 222, 201, 0.35);
    border-radius: 999px;
    padding: 3px;
  }
  .site-header__lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: none;
    background: transparent;
    color: #e7ddc4;
    font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    padding: 0 16px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
    text-decoration: none;
    line-height: 1;
  }
  a.site-header__lang-btn { cursor: pointer; }
  .site-header__lang-btn.is-active {
    background: rgba(231, 222, 201, 0.92);
    color: #0a0a09;
  }
  .site-header__lang-btn:focus-visible {
