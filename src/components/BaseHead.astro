---
/**
 * Shared <head> SEO block for natively-Astro pages.
 * Import once per document; callers pass page-specific metadata.
 */
import '../styles/global.css';
import { absoluteUrl, keywordsContent } from '../lib/site';
import WebVitals from './WebVitals.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  /** Override Open Graph / Twitter title when it should differ from <title>. */
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: unknown;
  keywords?: string[];
  robots?: string;
  /** Extra <link rel="alternate" hreflang> etc. via default slot. */
  author?: string;
  /**
   * Load the legacy dc-runtime (`support.js`) for pages that still embed
   * BanknoteCard / other dc-import components. Native Astro chrome does not need it.
   */
  loadDcRuntime?: boolean;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogImage,
  ogTitle,
  ogDescription,
  jsonLd,
  keywords,
  robots = 'index, follow',
  author = 'Notofilia',
  loadDcRuntime = false,
} = Astro.props;

const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage ?? '/favicon.png');
const kw = keywords?.length ? keywordsContent(keywords) : '';
const shareTitle = ogTitle ?? title;
const shareDescription = ogDescription ?? description;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Nested routes: <base> makes the shared dc-runtime header's relative links resolve from root. -->
<base href="/" />
<!-- Critical self-hosted fonts: preload only the faces used above the fold
     on most pages (display + body regular). Italic loads via @font-face when
     first needed, avoiding three competing font preloads on every document. -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/uploads/fonts/SourceSans3-Variable-Latin.woff2"
  crossorigin
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/uploads/fonts/MontenegrinGothicOne-Regular.woff2"
  crossorigin
/>
{loadDcRuntime && (
  <script src="/support.js" defer is:inline></script>
)}
<!-- WebMCP is agent-only — keep it entirely off the critical request chain. -->
<script is:inline>
  (function () {
    function loadWebmcp() {
      var s = document.createElement('script');
      s.src = '/webmcp.js';
      s.async = true;
      document.head.appendChild(s);
    }
    function schedule() {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadWebmcp, { timeout: 4000 });
      } else {
        window.setTimeout(loadWebmcp, 2000);
      }
    }
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  })();
</script>
<title>{title}</title>
<meta name="description" content={description} />
{kw ? <meta name="keywords" content={kw} /> : null}
<meta name="author" content={author} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.png" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Notofilia" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={shareDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={shareDescription} />
<meta name="twitter:image" content={image} />
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
<WebVitals />
<slot />
