---
/**
 * Full-bleed homepage hero: rotating banknote slides, brand lockup,
 * and task-oriented CTAs. Interface language lives in SiteHeader.
 */
import type { CollectionStats } from '../lib/stats';
import { formatStatsEn, formatStatsEs } from '../lib/stats';

export interface HeroSlide {
  base: string;
  alt: string;
}

export interface Props {
  slides: HeroSlide[];
  stats: CollectionStats;
}

const { slides, stats } = Astro.props;
const statsEs = formatStatsEs(stats);
const statsEn = formatStatsEn(stats);
const transparentPixel =
  'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
---
<div class="relative w-full min-h-screen">
  {slides.map((h, i) => {
    const lcpSrcset = `/uploads/${h.base}-480.webp 480w, /uploads/${h.base}-768.webp 768w`;
    const deferredSrcset = `/uploads/${h.base}-480.webp`;
    const imageSrc = i === 0 ? `/uploads/${h.base}-768.jpg` : `/uploads/${h.base}-480.jpg`;
    const srcset = i === 0 ? lcpSrcset : deferredSrcset;
    return (
      <picture data-deferred-hero={i > 0 ? '' : undefined}>
        <source
          srcset={i === 0 ? srcset : undefined}
          data-srcset={i > 0 ? srcset : undefined}
          sizes={i === 0 ? '100vw' : undefined}
          type="image/webp"
        />
        <img
          class="hero-slide absolute inset-0 w-full h-full object-cover object-[50%_40%] [filter:contrast(1.2)_brightness(0.85)_saturate(1.1)]"
          data-hero={i}
          src={i === 0 ? imageSrc : transparentPixel}
          data-src={i > 0 ? imageSrc : undefined}
          alt={i === 0 ? h.alt : ''}
          width="768"
          height="284"
          fetchpriority={i === 0 ? 'high' : 'low'}
          decoding="async"
          style={`opacity:${i === 0 ? 1 : 0};`}
        />
      </picture>
    );
  })}
  <div
    class="absolute inset-0"
    style="background:radial-gradient(ellipse 90% 75% at 50% 42%, rgba(10,10,9,0.35) 0%, rgba(10,10,9,0.72) 60%, rgba(6,6,5,0.94) 100%);"
  ></div>
  <div
    class="absolute inset-0"
    style="background:linear-gradient(180deg, rgba(6,6,5,0.55) 0%, rgba(6,6,5,0.15) 22%, rgba(6,6,5,0.15) 78%, rgba(6,6,5,0.6) 100%);"
  >  </div>

  <div
    class="relative z-[1] min-h-screen flex flex-col items-center justify-center text-center px-6 py-16 outline-none"
  >
    <div class="flex items-center gap-4 mb-7">
      <span class="w-14 h-px bg-cream-faint"></span>
      <span class="font-serif italic font-medium text-[17px] tracking-[0.28em] uppercase text-cream-dim">Notofilia.com</span>
      <span class="w-14 h-px bg-cream-faint"></span>
    </div>
    <p class="font-display font-normal text-[clamp(48px,9vw,120px)] leading-[0.95] tracking-[0.04em] text-cream-dim m-0 [text-shadow:0_2px_24px_rgba(0,0,0,0.55)]">
      NOTOFILIA
    </p>
    <div class="flex items-center gap-[14px] my-6">
      <span class="w-[34px] h-px bg-cream-faint/80"></span>
      <span class="w-[7px] h-[7px] bg-cream-dim rotate-45"></span>
      <span class="w-[34px] h-px bg-cream-faint/80"></span>
    </div>
    <h1
      data-i18n
      data-en="A private collection of historical banknotes and coins"
      class="font-serif font-medium text-[clamp(22px,2.8vw,34px)] leading-[1.25] text-cream m-0 max-w-[22ch]"
    >Una colección privada de billetes y monedas históricas</h1>
    <p
      data-i18n
      data-en="Detailed images, catalog references, and monetary histories from around the world."
      class="font-serif text-[clamp(16px,1.5vw,19px)] leading-[1.6] text-cream-dim mt-4 mb-0 max-w-[40rem]"
    >Imágenes detalladas, referencias de catálogo e historias monetarias de Colombia, Estados Unidos, Puerto Rico y el mundo.</p>
    <p
      data-i18n
      data-en={statsEn}
      class="font-serif text-[clamp(15px,1.4vw,17px)] tracking-[0.06em] text-cream-dim mt-3 mb-0"
    >{statsEs}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/coleccion/"
        data-i18n
        data-en="Explore the collection"
        class="inline-flex items-center justify-center min-h-[48px] px-7 py-3 bg-cream text-bg no-underline font-serif font-semibold text-[15px] tracking-[0.1em] uppercase focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      >Explorar la colección</a>
      <a
        href="/buscar/"
        data-i18n
        data-en="Search for a piece"
        class="inline-flex items-center justify-center min-h-[48px] px-7 py-3 border border-cream text-cream no-underline font-serif font-semibold text-[15px] tracking-[0.1em] uppercase focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      >Buscar una pieza</a>
    </div>
  </div>

  <div class="absolute bottom-7 left-0 right-0 z-[2] flex justify-center px-6">
    <button
      id="hero-motion-toggle"
      type="button"
      class="hero-motion-toggle inline-flex items-center justify-center gap-2 min-h-[44px] px-4 py-2 border border-line-input bg-bg/45 text-cream font-serif text-[13px] tracking-[0.08em] cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
      aria-pressed="false"
      hidden
    >Pausar diapositivas</button>
  </div>
</div>
