---
/**
 * Homepage cream-band post strip (noticias or blog). Uses a 4-up grid on
 * desktop and horizontal snap-scroll on mobile — pure Tailwind utilities.
 */
export interface StripItem {
  url: string;
  title: string;
  source: string;
  iso: string;
  dateLabel: string;
  cover?: string;
  coverAlt: string;
}

export interface Props {
  headingId: string;
  heading: string;
  /** English string for the ES/EN chrome toggle. Article cards stay Spanish-only. */
  headingEn?: string;
  items: StripItem[];
  emptyMessage: string;
  emptyMessageEn?: string;
  moreHref: string;
  moreLabel: string;
  moreLabelEn?: string;
  /** Top border between stacked cream bands. */
  bordered?: boolean;
}

const {
  headingId, heading, headingEn, items, emptyMessage, emptyMessageEn,
  moreHref, moreLabel, moreLabelEn, bordered = false,
} = Astro.props;
---
<section
  aria-labelledby={headingId}
  class:list={['bg-cream-dim py-[72px] px-6', bordered && 'border-t border-ink/12']}
>
  <div class="max-w-content mx-auto">
    <h2 id={headingId} data-i18n={headingEn ? true : undefined} data-en={headingEn} class="font-display font-normal text-[clamp(24px,3vw,32px)] text-panel mt-0 mb-8 text-center">
      {heading}
    </h2>
    {items.length > 0 ? (
      <div class="mb-8 flex gap-4 overflow-x-auto snap-x snap-mandatory px-1 md:grid md:grid-cols-4 md:gap-7 md:overflow-visible md:snap-none md:px-0 [scrollbar-width:thin]">
        {items.map((it) => (
          <article class="w-[85%] shrink-0 snap-center border-t-2 border-panel pt-4 md:w-auto md:shrink">
            {it.cover && (
              <picture>
                <source
                  srcset={`/uploads/${it.cover}-card.webp 440w, /uploads/${it.cover}-card-2x.webp 660w`}
                  sizes="(max-width: 767px) 85vw, 220px"
                  type="image/webp"
                />
                <img
                  src={`/uploads/${it.cover}-card.jpg`}
                  alt={it.coverAlt}
                  loading="lazy"
                  decoding="async"
                  width="440"
                  height="280"
                  class="block w-full h-[140px] object-cover rounded-[3px] mb-3"
                />
              </picture>
            )}
            <div class="flex flex-wrap items-baseline gap-[10px] mb-1.5">
              <time datetime={it.iso} class="text-[13px] tracking-[0.08em] uppercase text-gold-deep">{it.dateLabel}</time>
              <span class="text-[13px] text-gold-dark">&middot; {it.source}</span>
            </div>
            <h3 class="font-display font-normal text-[clamp(17.6px,1.1rem+0.3vw,19px)] tracking-[0.02em] text-panel mt-0 mb-1.5 text-balance break-words">
              {it.title}
            </h3>
            <a href={it.url} data-i18n data-en="Read more &rarr;" class="text-[15px] text-gold-deep [text-decoration-color:rgba(107,82,31,0.4)]">Leer más &rarr;</a>
          </article>
        ))}
      </div>
    ) : (
      <p data-i18n={emptyMessageEn ? true : undefined} data-en={emptyMessageEn} class="text-[18px] leading-[1.6] text-ink text-center mt-0 mb-8">{emptyMessage}</p>
    )}
    <p class="text-center m-0">
      <a
        href={moreHref}
        data-i18n={moreLabelEn ? true : undefined}
        data-en={moreLabelEn}
        class="inline-flex items-center min-h-[44px] border border-panel text-panel no-underline text-[15px] tracking-[0.1em] uppercase font-semibold px-7 py-3 rounded-full"
      >{moreLabel}</a>
    </p>
  </div>
</section>
