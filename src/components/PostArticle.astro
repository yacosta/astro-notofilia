---
/**
 * Shared article page for a single blog / noticias post.
 */
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import { formatDateLongEs, toIsoDate } from '../lib/dates';
import type { PostCollection } from '../lib/posts';

export interface Props {
  collection: PostCollection;
  post: CollectionEntry<'blog'> | CollectionEntry<'noticias'>;
  /** CTA label for external source link. */
  sourceLinkLabel: string;
  /** Back-link label under the article. */
  backLabel: string;
}

const { collection, post, sourceLinkLabel, backLabel } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const iso = toIsoDate(d.publishedAt);
const fmt = formatDateLongEs(d.publishedAt);
const basePath = `/${collection}/`;
const label = collection === 'blog' ? 'Blog' : 'Noticias';
const coverFit = d.coverFit ?? 'cover';
---
<article class="max-w-content mx-auto px-6 pt-12">
  <nav class="text-[14px] tracking-[0.06em] text-muted mb-6" aria-label="Migas de pan">
    <a class="text-muted" href="/">Inicio</a> <span aria-hidden="true">/</span>
    <a class="text-muted" href={basePath}>{label}</a> <span aria-hidden="true">/</span>
    <span>{d.title}</span>
  </nav>

  <header>
    <div class="flex flex-wrap gap-2 items-baseline text-[13px] tracking-[0.08em] uppercase text-muted mb-3">
      <time datetime={iso}>{fmt}</time>
      {d.source && <span aria-hidden="true">·</span>}
      {d.source && <span>{d.source}</span>}
    </div>
    <h1 class="font-display font-normal text-[clamp(28px,4.5vw,42px)] text-cream mt-0 mb-4 leading-[1.12]">
      {d.title}
    </h1>
    <p class="italic text-[clamp(19px,2.4vw,23px)] text-cream-dim mt-0 mb-9 leading-[1.5]">{d.excerpt}</p>
  </header>

  {d.cover && (
    <figure class="cover mt-0 mb-10">
      <Cover
        base={d.cover}
        alt={d.coverAlt ?? d.title}
        eager
        ratio="16 / 9"
        fit={coverFit}
      />
      {(d.coverCaption || d.coverAlt) && (
        <figcaption class="text-[13px] text-muted mt-[10px] text-center italic">
          {d.coverCaption ?? d.coverAlt}
        </figcaption>
      )}
    </figure>
  )}

  <div class="prose-notofilia text-[20px] leading-[1.75] text-cream-dim">
    <Content />
  </div>

  {d.sourceUrl && (
    <p class="mt-10 pt-6 border-t border-line text-[16px] tracking-[0.04em] uppercase">
      <a class="text-muted font-semibold hover:text-cream" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">
        {sourceLinkLabel}{d.source ? ` en ${d.source}` : ''} &rarr;
      </a>
    </p>
  )}

  <p class="mt-10"><a class="text-muted" href={basePath}>&larr; {backLabel}</a></p>
</article>

<style>
  .cover :global(picture) { display: block; border-radius: 4px; overflow: hidden; }
</style>
