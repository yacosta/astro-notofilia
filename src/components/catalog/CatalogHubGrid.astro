---
/**
 * Hub card grid — replaces dc-import BanknoteCard lists.
 */
import type { CatalogCard } from '../../lib/catalog-record';
import CatalogBanknoteCard from './CatalogBanknoteCard.astro';

interface Props {
  cards: CatalogCard[];
  thinNote?: boolean;
}

const { cards, thinNote = false } = Astro.props;
const showThinNote = thinNote && cards.length > 0 && cards.length <= 2;
const inventoryLabel = cards.length === 1 ? '1 pieza documentada' : `${cards.length} piezas documentadas`;
---
{
  cards.length > 0 ? (
    <section class="catalog-hub-grid max-w-[1180px] mx-auto px-[var(--page-gutter,24px)] pb-16" aria-label="Fichas del catálogo">
      {showThinNote ? (
        <aside
          class="catalog-inventory-status mb-8"
          aria-label="Estado del catálogo"
          data-pagefind-ignore
        >
          <span>Catálogo en crecimiento</span>
          <strong>{inventoryLabel}</strong>
          <p>
            Esta sección muestra únicamente fichas con imágenes y datos verificados. Se ampliará a
            medida que se documenten nuevas piezas.
          </p>
        </aside>
      ) : null}
      <ul class="m-0 p-0 list-none grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-6">
        {cards.map((card) => (
          <li>
            <CatalogBanknoteCard card={card} />
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
