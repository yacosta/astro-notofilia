---
/**
 * Hub card grid — replaces dc-import BanknoteCard lists.
 * Optional `group` / `groupKicker` on cards render reign or theme sections.
 */
import type { CatalogCard } from '../../lib/catalog-record';
import CatalogBanknoteCard from './CatalogBanknoteCard.astro';
import { lookupEn } from '../../lib/html-i18n';
import { t, type Locale } from '../../lib/ui-i18n';

interface Props {
  cards: CatalogCard[];
  thinNote?: boolean;
  labelledBy?: string;
  /** Group headings. Use 3 when this grid sits under an existing page h2. */
  headingLevel?: 2 | 3;
  locale?: Locale;
}

const { cards, thinNote = false, labelledBy, headingLevel = 2, locale = 'es' } = Astro.props;
const isEn = locale === 'en';
const GroupHeading = headingLevel === 3 ? 'h3' : 'h2';
const showThinNote = thinNote && cards.length > 0 && cards.length <= 2;
const inventoryLabel = cards.length === 1 ? t('onePiece', locale) : `${cards.length} ${t('pieces', locale)}`;
const inventoryLabelEn = cards.length === 1 ? t('onePiece', 'en') : `${cards.length} ${t('pieces', 'en')}`;
const hasGroups = cards.some((card) => Boolean(card.group));

type CardGroup = { name: string; nameEn?: string; kicker?: string; kickerEn?: string; cards: CatalogCard[] };

const groups: CardGroup[] = [];
if (hasGroups) {
  const seen = new Map<string, CardGroup>();
  for (const card of cards) {
    const name = card.group || t('otherPieces', 'es');
    let group = seen.get(name);
    if (!group) {
      group = {
        name,
        nameEn: card.groupEn ?? lookupEn(name),
        kicker: card.groupKicker,
        kickerEn: card.groupKickerEn ?? (card.groupKicker ? lookupEn(card.groupKicker) : undefined),
        cards: [],
      };
      seen.set(name, group);
      groups.push(group);
    }
    group.cards.push(card);
  }
} else {
  groups.push({ name: '', cards });
}

function groupLabel(group: CardGroup): string {
  if (!isEn) return group.name;
  return group.nameEn ?? lookupEn(group.name) ?? group.name;
}

function kickerLabel(group: CardGroup): string | undefined {
  if (!group.kicker) return undefined;
  if (!isEn) return group.kicker;
  return group.kickerEn ?? lookupEn(group.kicker) ?? group.kicker;
}
---
{
  cards.length > 0 ? (
    <section
      class="catalog-hub-grid max-w-[1180px] mx-auto px-[var(--page-gutter,24px)] pb-16"
      aria-label={labelledBy ? undefined : t('hubCards', locale)}
      data-i18n={labelledBy || isEn ? undefined : true}
      data-i18n-target={labelledBy || isEn ? undefined : 'aria-label'}
      data-en={labelledBy || isEn ? undefined : t('hubCards', 'en')}
      aria-labelledby={labelledBy}
    >
      {showThinNote ? (
        <aside
          class="catalog-inventory-status mb-8"
          aria-label={t('catalogStatus', locale)}
          data-i18n={isEn ? undefined : true}
          data-i18n-target={isEn ? undefined : 'aria-label'}
          data-en={isEn ? undefined : t('catalogStatus', 'en')}
          data-pagefind-ignore
        >
          <span data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : t('growing', 'en')}>{t('growing', locale)}</span>
          <strong data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : inventoryLabelEn}>{inventoryLabel}</strong>
          <p data-i18n={isEn ? undefined : true} data-en={isEn ? undefined : t('thinNote', 'en')}>
            {t('thinNote', locale)}
          </p>
        </aside>
      ) : null}
      {groups.map((group) => (
        group.name ? (
          <section class="catalog-hub-group">
            {group.kicker ? (
              <span
                class="catalog-hub-kicker"
                data-i18n={!isEn && (group.kickerEn || lookupEn(group.kicker)) ? true : undefined}
                data-en={!isEn ? (group.kickerEn || lookupEn(group.kicker)) : undefined}
              >{kickerLabel(group)}</span>
            ) : null}
            <GroupHeading
              class="catalog-hub-group-title"
              data-i18n={!isEn && (group.nameEn || lookupEn(group.name)) ? true : undefined}
              data-en={!isEn ? (group.nameEn || lookupEn(group.name)) : undefined}
            >{groupLabel(group)}</GroupHeading>
            <ul class="m-0 p-0 list-none grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-6">
              {group.cards.map((card) => (
                <li>
                  <CatalogBanknoteCard card={card} locale={locale} />
                </li>
              ))}
            </ul>
          </section>
        ) : (
          <ul class="m-0 p-0 list-none grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-6">
            {group.cards.map((card) => (
              <li>
                <CatalogBanknoteCard card={card} locale={locale} />
              </li>
            ))}
          </ul>
        )
      ))}
    </section>
  ) : null
}

<style>
  .catalog-hub-group + .catalog-hub-group {
    margin-top: 64px;
  }
  .catalog-hub-kicker {
    display: block;
    font-size: 14px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #b7ab8a;
    margin-bottom: 14px;
  }
  .catalog-hub-group-title {
    font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif;
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    color: #d8d2cd;
    margin: 0 0 32px;
  }
</style>
