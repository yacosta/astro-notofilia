---
/**
 * Accessible country/issuer (or collection) breadcrumb for catalog records.
 */
import type { CatalogRecord } from '../../lib/catalog-record';
import { lookupEn } from '../../lib/html-i18n';
import { UI } from '../../lib/ui-i18n';

interface Props {
  crumbs: CatalogRecord['breadcrumb'];
}

const { crumbs } = Astro.props;
---
<nav class="catalog-record-crumbs" aria-label="Migas de pan" data-i18n data-i18n-target="aria-label" data-en={UI.crumbs.en}>
  <ol class="m-0 p-0 list-none flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] tracking-[0.06em] text-muted">
    {
      crumbs.map((crumb, index) => {
        const isLast = index === crumbs.length - 1;
        const en = lookupEn(crumb.name);
        return (
          <li class="inline-flex items-center gap-x-2">
            {index > 0 && <span aria-hidden="true">/</span>}
            {crumb.href && !isLast ? (
              <a
                class="text-muted underline [text-decoration-color:rgba(183,171,138,0.4)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
                href={crumb.href}
                data-i18n={en ? true : undefined}
                data-en={en}
              >
                {crumb.name}
              </a>
            ) : (
              <span
                aria-current={isLast ? 'page' : undefined}
                data-i18n={en ? true : undefined}
                data-en={en}
              >{crumb.name}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
