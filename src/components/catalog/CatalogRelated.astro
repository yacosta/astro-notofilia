---
/**
 * Prev/next + related pieces for a catalog record.
 */
import type { CatalogRecord } from '../../lib/catalog-record';
import { lookupEn } from '../../lib/html-i18n';
import { alternateUrl } from '../../i18n/pairs';
import { UI, type Locale } from '../../lib/ui-i18n';

interface Props {
  record: CatalogRecord;
  locale?: Locale;
}

const { record, locale = 'es' } = Astro.props;
const isEn = locale === 'en';
const related = record.related ?? [];
const hasNav = Boolean(record.previous || record.next || related.length);

function hrefFor(path: string): string {
  return isEn ? (alternateUrl(path, 'en') ?? path) : path;
}

function titleFor(title: string): string {
  return isEn ? (lookupEn(title) ?? title) : title;
}
---
{
  hasNav && (
    <section
      class="catalog-record-nav grid gap-6"
      aria-label={isEn ? UI.recordNav.en : UI.recordNav.es}
      data-i18n={isEn ? undefined : true}
      data-i18n-target={isEn ? undefined : 'aria-label'}
      data-en={isEn ? undefined : UI.recordNav.en}
    >
      {
        (record.previous || record.next) && (
          <nav
            class="flex flex-wrap justify-between gap-4"
            aria-label={isEn ? UI.prevNext.en : UI.prevNext.es}
            data-i18n={isEn ? undefined : true}
            data-i18n-target={isEn ? undefined : 'aria-label'}
            data-en={isEn ? undefined : UI.prevNext.en}
          >
            {
              record.previous ? (
                <a
                  class="min-h-11 inline-flex items-center text-[15px] text-gold-light underline [text-decoration-color:rgba(183,171,138,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
                  href={hrefFor(record.previous.href)}
                  rel="prev"
                >
                  ← <span data-i18n={!isEn && lookupEn(record.previous.title) ? true : undefined} data-en={!isEn ? lookupEn(record.previous.title) : undefined}>{titleFor(record.previous.title)}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              record.next ? (
                <a
                  class="min-h-11 inline-flex items-center text-[15px] text-gold-light underline [text-decoration-color:rgba(183,171,138,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
                  href={hrefFor(record.next.href)}
                  rel="next"
                >
                  <span data-i18n={!isEn && lookupEn(record.next.title) ? true : undefined} data-en={!isEn ? lookupEn(record.next.title) : undefined}>{titleFor(record.next.title)}</span> →
                </a>
              ) : null
            }
          </nav>
        )
      }
      {
        related.length > 0 && (
          <div>
            <h2
              class="m-0 mb-3 font-display font-normal text-[clamp(22px,3vw,28px)] text-cream"
              data-i18n={isEn ? undefined : true}
              data-en={isEn ? undefined : UI.related.en}
            >
              {isEn ? UI.related.en : UI.related.es}
            </h2>
            <ul class="m-0 p-0 list-none grid gap-2">
              {
                related.map((item) => (
                  <li>
                    <a
                      class="min-h-11 inline-flex items-center text-[16px] text-gold-light underline [text-decoration-color:rgba(183,171,138,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
                      href={hrefFor(item.href)}
                      data-i18n={!isEn && lookupEn(item.title) ? true : undefined}
                      data-en={!isEn ? lookupEn(item.title) : undefined}
                    >
                      {titleFor(item.title)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        )
      }
    </section>
  )
}
