---
export interface Props {
  slug: string;
}

const { slug } = Astro.props;
// Turnstile site keys are intentionally public; the secret stays in Cloudflare.
const siteKey = '0x4AAAAAAD40VfPOxkjwgdld';
---
<section class="mt-16 pt-10 border-t border-line" aria-labelledby="comments-heading" data-comments-root>
  <h2 id="comments-heading" class="font-display font-normal text-[clamp(25px,3.5vw,34px)] text-cream mt-0 mb-3" data-i18n data-en="Comments">
    Comentarios
  </h2>
  <p class="text-[16px] text-muted mt-0 mb-8" data-i18n data-en="Share your view. Comments appear after they are reviewed.">
    Comparte tu opinión. Los comentarios se publican después de ser revisados.
  </p>

  <div data-comments-list aria-live="polite" aria-busy="true">
    <p class="text-[16px] text-muted" data-i18n data-en="Loading comments…">Cargando comentarios…</p>
  </div>

  <form data-comment-form class="mt-10 grid gap-5" hidden={!siteKey}>
    <div>
      <label for={`comment-name-${slug}`} class="block text-[15px] text-cream mb-2" data-i18n data-en="Name">Nombre</label>
      <input
        id={`comment-name-${slug}`}
        name="name"
        type="text"
        minlength="2"
        maxlength="60"
        autocomplete="name"
        required
        class="w-full min-h-[48px] px-4 py-3 bg-panel border border-line-input rounded-[4px] text-cream font-serif text-[17px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
      />
    </div>

    <div>
      <label for={`comment-body-${slug}`} class="block text-[15px] text-cream mb-2" data-i18n data-en="Comment">Comentario</label>
      <textarea
        id={`comment-body-${slug}`}
        name="comment"
        minlength="3"
        maxlength="1500"
        rows="5"
        required
        class="w-full px-4 py-3 bg-panel border border-line-input rounded-[4px] text-cream font-serif text-[17px] leading-[1.5] resize-y focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
      ></textarea>
    </div>

    <div
      class="cf-turnstile min-h-[65px]"
      data-sitekey={siteKey}
      data-theme="dark"
      data-size="flexible"
      data-action="comment"
    ></div>

    <div>
      <button
        type="submit"
        class="min-h-[48px] px-7 py-3 bg-cream text-bg border border-cream rounded-full font-serif font-semibold text-[15px] tracking-[0.08em] uppercase cursor-pointer disabled:opacity-60 disabled:cursor-wait focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2"
        data-i18n
        data-en="Send comment"
      >Enviar comentario</button>
    </div>
    <p data-comment-status class="text-[15px] mt-0" role="status" aria-live="polite"></p>
  </form>

  {!siteKey && (
    <p class="text-[15px] text-muted" data-i18n data-en="Comments will be available soon.">Los comentarios estarán disponibles próximamente.</p>
  )}
</section>

{siteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
)}

<script define:vars={{ slug }} is:inline>
  const root = document.querySelector('[data-comments-root]');
  const list = root?.querySelector('[data-comments-list]');
  const form = root?.querySelector('[data-comment-form]');
  const status = root?.querySelector('[data-comment-status]');
  const endpoint = `/api/comments/${encodeURIComponent(slug)}`;

  const copy = {
    es: {
      empty: 'Aún no hay comentarios publicados.',
      loadFail: 'No se pudieron cargar los comentarios.',
      sending: 'Enviando…',
      sendFail: 'No se pudo enviar el comentario.',
    },
    en: {
      empty: 'No comments have been published yet.',
      loadFail: 'Comments could not be loaded.',
      sending: 'Sending…',
      sendFail: 'The comment could not be sent.',
    },
  };
  function isEn() {
    return document.documentElement.getAttribute('data-page-locale') === 'en'
      || document.documentElement.lang === 'en';
  }
  function langCopy() {
    return isEn() ? copy.en : copy.es;
  }
  function dateLocale() {
    return isEn() ? 'en' : 'es';
  }

  const renderComments = (comments) => {
    if (!list) return;
    list.replaceChildren();
    list.setAttribute('aria-busy', 'false');

    if (!comments.length) {
      const empty = document.createElement('p');
      empty.className = 'text-[16px] text-muted';
      empty.textContent = langCopy().empty;
      list.append(empty);
      return;
    }

    const items = document.createElement('ol');
    items.className = 'list-none m-0 p-0 grid gap-6';
    comments.forEach((comment) => {
      const item = document.createElement('li');
      item.className = 'border-l-2 border-line pl-5';

      const meta = document.createElement('p');
      meta.className = 'text-[14px] text-muted mt-0 mb-2';
      const date = new Intl.DateTimeFormat(dateLocale(), { dateStyle: 'long' })
        .format(new Date(comment.createdAt));
      meta.textContent = `${comment.authorName} · ${date}`;

      const body = document.createElement('p');
      body.className = 'text-[17px] text-cream-dim whitespace-pre-wrap mt-0 mb-0';
      body.textContent = comment.body;
      item.append(meta, body);
      items.append(item);
    });
    list.append(items);
  };

  const loadComments = async () => {
    try {
      const response = await fetch(endpoint, { headers: { accept: 'application/json' } });
      if (!response.ok) throw new Error('Comments request failed');
      const data = await response.json();
      renderComments(data.comments || []);
    } catch {
      if (!list) return;
      list.setAttribute('aria-busy', 'false');
      list.innerHTML = '<p class="text-[16px] text-muted">' + langCopy().loadFail + '</p>';
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = form.querySelector('button[type="submit"]');
    const data = new FormData(form);
    const turnstileToken = data.get('cf-turnstile-response');

    submit.disabled = true;
    status.textContent = langCopy().sending;
    status.className = 'text-[15px] text-muted mt-0';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          comment: data.get('comment'),
          turnstileToken,
        }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || langCopy().sendFail);

      form.reset();
      if (window.turnstile) window.turnstile.reset();
      status.textContent = result.message;
      status.className = 'text-[15px] text-cream mt-0';
    } catch (error) {
      status.textContent = error.message || langCopy().sendFail;
      status.className = 'text-[15px] text-[#ffb4a8] mt-0';
      if (window.turnstile) window.turnstile.reset();
    } finally {
      submit.disabled = false;
    }
  });

  loadComments();
</script>
