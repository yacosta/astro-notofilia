---
// Base layout for the natively-Astro editorial section (Noticias + Blog).
// Server-rendered static HTML, styled with Tailwind utilities against the
// shared palette tokens, carrying SEO + accessibility requirements.
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PreFooter from '../components/PreFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { EDITORIAL_TEAM } from '../lib/editorial';
import { t } from '../lib/ui-i18n';

export interface Props {
  title: string;
  description: string;
  path: string;
  locale?: import('../lib/ui-i18n').Locale;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: unknown;
  author?: string;
}

const {
  title,
  description,
  path,
  locale = 'es',
  ogType = 'website',
  ogImage,
  jsonLd,
  author = EDITORIAL_TEAM.name,
} = Astro.props;
---
<!doctype html>
<html lang={locale} data-page-locale={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      locale={locale}
      ogType={ogType}
      ogImage={ogImage}
      jsonLd={jsonLd}
      author={author}
      loadDcRuntime={false}
    />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      html, body { height: auto !important; }
      a { color: var(--color-cream); }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body class="m-0 bg-bg text-cream-dim font-serif text-[19px] leading-[1.7] antialiased max-[640px]:text-[18px]">
    <a
      class="absolute left-[-9999px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
      href="#main-content"
    >{t('skip', locale)}</a>
    <SiteHeader locale={locale} path={path} />
    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
      <slot />
    </main>
    <PreFooter locale={locale} />
    <SiteFooter variant="editorial" locale={locale} />
    <CookieBanner locale={locale} />
  </body>
</html>
