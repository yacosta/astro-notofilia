---
// Base layout for the natively-Astro "Noticias" section.
// Server-rendered static HTML (no client runtime), styled to match the site's
// dark/warm palette and display typography, and carrying the standing SEO +
// accessibility requirements: single <h1> per page (supplied by the page),
// semantic landmarks, skip link, canonical, Open Graph + Twitter, JSON-LD.
export interface Props {
  title: string;          // <title> — keep <= 60 chars
  description: string;    // meta description — keep <= 150 chars
  path: string;           // canonical path, e.g. "/noticias/"
  ogType?: 'website' | 'article';
  ogImage?: string;       // absolute path under /uploads, optional
  jsonLd?: unknown;       // structured data object(s)
}
const SITE = 'https://www.notofilia.com';
const { title, description, path, ogType = 'website', ogImage, jsonLd } = Astro.props;
const canonical = SITE + path;
const image = ogImage ? SITE + ogImage : SITE + '/favicon.png';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/glosario/', label: 'Glosario' },
  { href: '/noticias/', label: 'Noticias' },
  { href: '/contacto/', label: 'Contacto' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Notofilia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Notofilia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:global>
      @font-face {
        font-family: 'Montenegrin Gothic One';
        src: url('/uploads/fonts/MontenegrinGothicOne-Regular.ttf') format('truetype');
        font-weight: 400; font-display: swap;
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        src: url('/uploads/fonts/CormorantGaramond-Variable.ttf') format('truetype');
        font-weight: 300 700; font-display: swap;
      }
      :root {
        --bg: #0a0a09; --panel: #1c1a15; --cream: #e7ddc4; --cream-dim: #d8d2cd;
        --muted: #b7ab8a; --line: rgba(231, 222, 201, 0.14);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--cream-dim);
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 19px; line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--cream); }
      img { max-width: 100%; height: auto; }
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 200;
        background: var(--cream); color: var(--bg); padding: 10px 16px;
        border-radius: 0 0 6px 0; font-weight: 600; text-decoration: none;
      }
      .skip:focus { left: 0; }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
      /* header */
      .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(10, 10, 9, 0.85);
        position: sticky; top: 0; z-index: 100;
        backdrop-filter: blur(12px);
      }
      .site-header .wrap {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; min-height: 68px; flex-wrap: wrap;
      }
      .brand { display: flex; flex-direction: column; text-decoration: none; line-height: 1; }
      .brand b {
        font-family: 'Montenegrin Gothic One', serif; font-weight: 400;
        letter-spacing: 0.16em; font-size: 22px; color: var(--cream);
      }
      .brand span {
        font-style: italic; font-size: 13px; letter-spacing: 0.06em;
        color: var(--cream-dim); margin-top: 3px;
      }
      .site-nav { display: flex; gap: 6px; flex-wrap: wrap; }
      .site-nav a {
        display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px;
        text-transform: uppercase; letter-spacing: 0.12em; font-size: 13px;
        font-weight: 600; color: var(--cream-dim); text-decoration: none; border-radius: 4px;
      }
      .site-nav a:hover { color: var(--cream); }
      .site-nav a[aria-current='page'] { color: var(--cream); }
      .site-nav a:focus-visible, .brand:focus-visible, .site-footer a:focus-visible {
        outline: 2px solid var(--cream); outline-offset: 3px;
      }
      main { min-height: 60vh; }
      /* footer */
      .site-footer {
        border-top: 1px solid var(--line); margin-top: 96px;
        padding: 56px 0 40px; text-align: center;
      }
      .site-footer .wrap { display: flex; flex-direction: column; gap: 8px; }
      .site-footer .cr {
        font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
      }
      .site-footer .dis { font-style: italic; font-size: 14px; color: rgba(216, 207, 184, 0.65); }
      .site-footer a { color: var(--muted); }
      @media (max-width: 640px) {
        body { font-size: 18px; }
        .site-header .wrap { min-height: 0; padding-top: 12px; padding-bottom: 12px; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main-content">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <b>NOTOFILIA</b>
          <span>Numismática y Notafilia</span>
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span class="cr">Copyright 2026 Notofilia. Todos los derechos reservados.</span>
        <span class="dis">Numismática y Notafilia — un catálogo y colección virtual de billetes y monedas históricas.</span>
        <a href="/politica-privacidad-cookies/">Política de Privacidad y Cookies</a>
      </div>
    </footer>
  </body>
</html>
