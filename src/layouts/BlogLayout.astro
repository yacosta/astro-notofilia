---
// Base layout for the natively-Astro editorial section (Noticias + Blog).
// Server-rendered static HTML, styled with Tailwind utilities against the
// shared palette tokens, carrying SEO + accessibility requirements.
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PreFooter from '../components/PreFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: unknown;
  keywords?: string[];
}

const { title, description, path, ogType = 'website', ogImage, jsonLd, keywords } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      ogImage={ogImage}
      jsonLd={jsonLd}
      keywords={keywords}
      loadDcRuntime={false}
    />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      html, body { height: auto !important; }
      a { color: var(--color-cream); }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body class="m-0 bg-bg text-cream-dim font-serif text-[19px] leading-[1.7] antialiased max-[640px]:text-[18px]">
    <a
      class="absolute left-[-9999px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
      href="#main-content"
    >Saltar al contenido</a>
    <SiteHeader />
    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
      <slot />
    </main>
    <PreFooter />
    <SiteFooter variant="editorial" />
    <CookieBanner />
  </body>
</html>
