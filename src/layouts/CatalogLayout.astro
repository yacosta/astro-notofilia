---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieBanner from '../components/CookieBanner.astro';
import PreFooter from '../components/PreFooter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CatalogRecordSurface from '../components/catalog/CatalogRecordSurface.astro';
import CatalogHubGrid from '../components/catalog/CatalogHubGrid.astro';
import type { CatalogCard, CatalogRecord } from '../lib/catalog-record';
import { withColombiaGroup } from '../lib/colombia-catalog';
import { compareByFirstYear } from '../lib/catalog-year';
import { absoluteUrl } from '../lib/site';
import { withI18nMarkup } from '../lib/html-i18n';
import { UI } from '../lib/ui-i18n';

export interface Props {
  title: string;
  description: string;
  path: string;
  robots?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: unknown;
  styles?: string;
  template: string;
  logic?: string;
  /** Phase 3 structured catalog-record model. */
  record?: CatalogRecord;
}

function colombiaHubCards(cards: CatalogCard[]): CatalogCard[] {
  return cards
    .map((card, index) => ({ card: withColombiaGroup(card), index }))
    .sort((a, b) => compareByFirstYear(a.card, b.card) || a.index - b.index)
    .map(({ card }) => card);
}

const props = Astro.props;
const record = props.record;
const rawCards = record?.cards ?? [];
const cards =
  props.path === '/coleccion/colombia/' ? colombiaHubCards(rawCards) : rawCards;
const isHub = record?.render === 'astro-hub' || cards.length > 0;
// Phase 3: catalog pages no longer load the custom dc-runtime (`support.js`).
const catalogShell = `<div class="catalog-shell">${withI18nMarkup(props.template)}</div>`;
const canonical = absoluteUrl(props.path);
---
<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={props.title}
      description={props.description}
      path={props.path}
      robots={props.robots}
      ogType={props.ogType}
      ogTitle={props.ogTitle}
      ogDescription={props.ogDescription}
      ogImage={props.ogImage}
      jsonLd={props.jsonLd}
      loadDcRuntime={false}
    >
      <link rel="alternate" hreflang="es" href={canonical} />
      <link rel="alternate" hreflang="x-default" href={canonical} />
    </BaseHead>
    <link rel="stylesheet" href="/catalog-fonts.css" />
    <script src="/catalog-zoom.js" defer is:inline></script>
    {props.styles && <style is:global set:html={props.styles} />}
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: #0a0a09; }
      img { max-width: 100%; height: auto; }

      .catalog-shell {
        color: var(--text-secondary);
        background:
          radial-gradient(circle at 50% -8%, rgba(138, 109, 59, 0.12), transparent 34rem),
          var(--surface-page);
        font-family: 'Source Sans 3', 'Source Sans 3 Fallback', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
      }
      .catalog-shell [style*="Montenegrin Gothic One"] {
        font-family: 'Montenegrin Gothic One', 'Montenegrin Gothic One Fallback', Georgia, serif !important;
      }
      .catalog-shell > [style*="min-height:100vh"] {
        min-height: auto !important;
        background: transparent !important;
        font-family: inherit !important;
      }
      .catalog-shell main {
        padding-left: var(--page-gutter) !important;
        padding-right: var(--page-gutter) !important;
      }
      .catalog-shell [style*="background:#d8d2cd"],
      .catalog-shell [style*="background: rgb(216, 210, 205)"] {
        color: var(--text-secondary) !important;
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.018), transparent 42%),
          var(--surface-artifact) !important;
        border: 1px solid var(--rule-artifact) !important;
        border-radius: var(--radius-surface) !important;
        box-shadow: var(--shadow-artifact) !important;
      }
      .catalog-shell [style*="color:#1c1a15"],
      .catalog-shell [style*="color: #1c1a15"],
      .catalog-shell [style*="color:#221f19"],
      .catalog-shell [style*="color: #221f19"],
      .catalog-shell [style*="color: rgb(34, 31, 25)"],
      .catalog-shell [style*="color: rgb(28, 26, 21)"] {
        color: var(--text-primary) !important;
      }
      .catalog-shell [style*="color:#332e22"],
      .catalog-shell [style*="color: #332e22"],
      .catalog-shell [style*="color: rgb(51, 46, 34)"],
      .catalog-shell [style*="color:#4a4331"],
      .catalog-shell [style*="color: #4a4331"],
      .catalog-shell [style*="color: rgb(74, 67, 49)"] {
        color: var(--text-secondary) !important;
      }
      .catalog-shell [style*="color:#5c4e33"],
      .catalog-shell [style*="color: #5c4e33"],
      .catalog-shell [style*="color: rgb(92, 78, 51)"] {
        color: var(--text-muted) !important;
      }
      .catalog-shell [style*="color:#6b521f"],
      .catalog-shell [style*="color: #6b521f"],
      .catalog-shell [style*="color: rgb(107, 82, 31)"] {
        color: var(--accent-metal) !important;
        text-decoration-color: rgba(203, 191, 157, 0.42) !important;
      }
      .catalog-shell [style*="border-top:1px solid rgba(10,10,9"],
      .catalog-shell [style*="border-bottom:1px solid rgba(10,10,9"] {
        border-color: var(--rule-subtle) !important;
      }
      .catalog-inventory-status {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 6px 14px;
        align-items: baseline;
        margin: 0 0 40px;
        padding: 16px 18px;
        border: 1px solid var(--rule-artifact);
        border-radius: var(--radius-surface);
        background: rgba(255, 255, 255, 0.03);
      }
      .catalog-inventory-status span {
        color: var(--accent-metal);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .catalog-inventory-status strong {
        color: var(--text-primary);
        font-size: 15px;
        font-weight: 600;
      }
      .catalog-inventory-status p {
        grid-column: 1 / -1;
        max-width: 62ch;
        margin: 2px 0 0;
        color: var(--text-muted);
        font-size: 15px;
        line-height: 1.55;
      }
      .catalog-shell a:focus-visible,
      .catalog-shell button:focus-visible {
        outline: 2px solid var(--text-primary) !important;
        outline-offset: 4px !important;
      }
      .catalog-record-meta--visually-hidden {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
      @media (max-width: 640px) {
        .catalog-shell [style*="background:#d8d2cd"],
        .catalog-shell [style*="background: rgb(216, 210, 205)"] {
          box-shadow: 0 18px 46px rgba(0, 0, 0, 0.36) !important;
        }
        .catalog-inventory-status {
          grid-template-columns: 1fr;
          gap: 4px;
          margin-bottom: 36px;
        }
        .catalog-inventory-status p {
          grid-column: 1;
          margin-top: 6px;
        }
      }
    </style>
  </head>
  <body>
    <a
      href="#main-content"
      class="absolute left-[-9999px] top-0 z-[200] bg-cream text-bg px-4 py-[10px] rounded-br-[6px] font-semibold no-underline focus:left-0"
      data-i18n
      data-en={UI.skipMain.en}
    >{UI.skipMain.es}</a>
    <SiteHeader />
    {
      record ? (
        <CatalogRecordSurface record={record} path={props.path} mode="augment">
          <div set:html={catalogShell} />
          {isHub && <CatalogHubGrid cards={cards} thinNote />}
        </CatalogRecordSurface>
      ) : (
        <>
          <div set:html={catalogShell} />
          {isHub && <CatalogHubGrid cards={cards} thinNote />}
        </>
      )
    }
    <PreFooter />
    <SiteFooter variant="editorial" />
    <CookieBanner />
  </body>
</html>
